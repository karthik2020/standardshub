  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  summary={metadata.summary}
  subtitle={metadata.nativeTitle}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage — Why This Separate Provision Is Legally Necessary" },
        { id: "s2", label: "Scope — §264a(1) Partnerships Specifically" },
        { id: "s3", label: "The Core Extension — Every Provision From §331 Through §335" },
        { id: "s4", label: "Worked Example — a GmbH &amp; Co. KG's General Partner Facing §331 Exposure" },
        { id: "s5", label: "The Adapted Täterkreis — Personally Liable Partners, or Their Representative Bodies" },
