---
import StandardLayout from "../../../layouts/StandardLayout.astro";
import standards from "../../../data/standards.json";
import StandardCard from "../../../components/StandardCard.astro";
import { palette } from "../../../data/standardVisuals";
import { FRAMEWORK_CONFIG, getFramework } from "../../../data/frameworks";

const framework = getFramework("ifrssustainability")!;

const grouped = /** @type {Record<string, any[]>} */ ({});

for (const item of standards.IFRSSustainability) {
  const category = item.category;
  if (!grouped[category]) {
    grouped[category] = [];
  }
  grouped[category].push(item);
}
---

<StandardLayout code={framework.code} title={`${framework.fullName} (${framework.code})`} framework="IFRS" hasToc={false}>

  <h1>{framework.fullName}</h1>

  <p class="category-description">
    {framework.description}
  </p>

  <div class="standards-group">
    <h2 class="standards-group-title">Standards</h2>
    <div class="standards-grid">

      {
        standards.IFRSSustainability.filter((item) => !item.status).map((item, index) => (

          <StandardCard
            href={item.url}
            code={item.code}
            title={item.title}
            framework={framework.id}
            theme={palette[index % palette.length]}
          />

        ))
      }

    </div>
  </div>

</StandardLayout>




