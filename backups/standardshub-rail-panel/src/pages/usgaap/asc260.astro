import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc260.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Basic EPS" },
        { id: "s4", label: "Diluted EPS — the As-If-Converted Principle" },
        { id: "s5", label: "Treasury Stock Method — Options & Warrants" },
        { id: "s6", label: "If-Converted Method — Convertible Securities" },
        { id: "s7", label: "Antidilution" },
        { id: "s8", label: "Contingently Issuable Shares" },
        { id: "s9", label: "The Two-Class Method" },
        { id: "s10", label: "Presentation Requirements" },
        { id: "s11", label: "Worked Example — Basic EPS" },
        { id: "s12", label: "Worked Example — Diluted EPS If-Converted Method" },
        { id: "s13", label: "Worked Example — the Two-Class Method" },
        { id: "s14", label: "Disclosure Requirements" },
        { id: "s15", label: "Critical Judgments & Estimates" },
        { id: "s16", label: "ASC 260 vs IAS 33 — the Two-Class Method Divergence" },
        { id: "s17", label: "Statement Mapping" },
        { id: "s18", label: "Related Topics" },
        { id: "s19", label: "Glossary" },
        { id: "history", label: "History & Development" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="hub"><div class="hub-box"><div class="hub-title">ASC 260 — Earnings Per Share</div><div class="hub-sub">Extended reference poster · US GAAP · Subtopic: 260-10 Overall · Counterpart of IAS 33 · USD examples</div></div></div>

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci"><div class="ctitle ci">The most widely watched single number in financial reporting</div><div class="principle">Earnings per share condenses an entity's overall performance into a single, per-share figure investors use constantly for valuation and comparison. ASC 260 exists to ensure this figure is calculated CONSISTENTLY and MEANINGFULLY — particularly capturing the POTENTIAL dilutive effect of securities that could convert into common shares, so users see both a "basic" and a fully "diluted" view of earnings capacity per share.</div></div>
      <div class="card cs"><div class="ctitle cs">A genuine product of joint FASB-IASB standard-setting</div><div class="principle">ASC 260 and its IFRS counterpart, IAS 33, emerged from an EARLY 2000s joint FASB-IASB convergence project specifically targeting EPS mechanics — as a result, the two standards are among the MOST closely aligned pairs in the entire Codification, sharing nearly identical treasury stock method, if-converted method, and antidilution mechanics, with the two-class method (Section 9) standing out as the principal remaining divergence.</div></div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Public companies (and public common-stock-holding entities) primarily</div><div class="principle">ASC 260 applies to entities whose common stock or potential common stock is PUBLICLY HELD, or that have filed (or are in the process of filing) with the SEC. PRIVATE companies are generally NOT required to present EPS, though many elect to do so voluntarily — broadly mirroring IAS 33's own scope, which similarly focuses mandatory application on entities whose shares are publicly traded or in the process of being issued to the public.</div></div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Basic EPS</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">The starting-point calculation</div>
      <div class="formula-box"><div class="f-label">BASIC EPS FORMULA</div><div class="f-eq">Basic EPS = (Net income attributable to common shareholders − Preferred dividends) ÷ Weighted-average common shares outstanding</div></div>
      <div class="principle">The WEIGHTED-AVERAGE number of common shares outstanding reflects shares actually outstanding during each portion of the period, time-weighted — the identical mechanical concept IAS 33 uses.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Diluted EPS — the As-If-Converted Principle</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Capturing the maximum potential dilution</div><div class="principle">DILUTED EPS reflects the POTENTIAL dilution that could occur if all DILUTIVE potential common shares (stock options, warrants, convertible securities, contingently issuable shares) were converted into common stock — computed AS IF such conversion had occurred at the beginning of the period (or issuance date, if later). This "as-if-converted" principle is identical in substance to IAS 33's own diluted EPS mechanics.</div></div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Treasury Stock Method — Options &amp; Warrants</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">The same method used under IAS 33</div><div class="principle">For OPTIONS and WARRANTS, the TREASURY STOCK METHOD assumes the proceeds from exercise are used to REPURCHASE shares at the AVERAGE MARKET PRICE during the period — the net INCREMENTAL shares (shares issued upon exercise minus shares assumed repurchased) are added to the diluted EPS denominator. This is the SAME method, applied the SAME way, under IAS 33 — one of the most precisely converged mechanics between the two frameworks.</div></div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>If-Converted Method — Convertible Securities</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">Also identical in substance to IAS 33</div><div class="principle">For CONVERTIBLE preferred stock and CONVERTIBLE debt, the IF-CONVERTED method assumes conversion occurred at the beginning of the period: convertible preferred dividends are ADDED BACK to the numerator (since they would no longer be paid), convertible debt's after-tax INTEREST expense is added back to the numerator, and the AS-IF-CONVERTED common shares are added to the denominator — again, the same fundamental mechanic IAS 33 applies.</div></div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Antidilution</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Excluding securities that would improve, not worsen, EPS</div><div class="principle">A potential common share is EXCLUDED from the diluted EPS calculation if including it would be ANTIDILUTIVE — i.e. if it would INCREASE EPS (or decrease loss per share) rather than reduce it. Each potential common share category is tested INDIVIDUALLY for dilutive effect, and antidilutive securities are simply left out entirely, consistent with IAS 33's identical antidilution testing principle.</div></div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Contingently Issuable Shares</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Included based on conditions as of period end</div><div class="principle">Shares issuable upon the satisfaction of specified CONDITIONS (e.g. an earnings target, a market price target) are included in DILUTED EPS based on the number of shares that WOULD be issuable if the end of the reporting period were the end of the contingency period — broadly mirroring IAS 33's own treatment of contingently issuable shares.</div></div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>The Two-Class Method</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">A distinctly US GAAP concept, with no IAS 33 equivalent</div><div class="principle">When an entity has PARTICIPATING SECURITIES — securities (such as certain preferred stock, or unvested share-based payment awards) that participate in DIVIDENDS with common stock according to a predetermined formula — ASC 260 REQUIRES the TWO-CLASS METHOD: earnings are ALLOCATED between common stock and the participating securities based on their respective rights to receive dividends (and undistributed earnings), and EPS is computed for EACH class separately. <strong>IAS 33 has NO directly equivalent named method</strong> — participating instruments under IFRS are analysed under general EPS principles without an equivalent formal "two-class" allocation methodology, making this the single most significant EPS-specific divergence between the two frameworks.</div></div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Presentation Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Face-of-statement disclosure</div><div class="principle">Basic and diluted EPS must be presented on the FACE of the Income Statement, for INCOME FROM CONTINUING OPERATIONS and for NET INCOME, with equal prominence — and separately for discontinued operations, if applicable, either on the face or in the notes. This mirrors IAS 33's own face-of-statement presentation requirement closely.</div></div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>Worked Example — Basic EPS</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">A straightforward calculation</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Net income with preferred dividends</div><div class="wk-body">Net income for the year is $20,000,000. Preferred dividends of $2,000,000 were declared. The weighted-average number of common shares outstanding during the year was 9,000,000.</div><div class="wk-answer">Basic EPS = ($20,000,000 &minus; $2,000,000) &divide; 9,000,000 = <strong>$2.00 per share</strong>.</div></div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Worked Example — Diluted EPS If-Converted Method</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Adjusting for convertible debt</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Convertible bonds</div><div class="wk-body">Continuing the example above (net income $20,000,000, preferred dividends $2,000,000, 9,000,000 weighted-average common shares), the entity also has $10,000,000 of 5% convertible bonds outstanding all year, convertible into 800,000 common shares, with a 25% tax rate.</div><div class="wk-answer">After-tax interest add-back = $10,000,000 × 5% × (1 &minus; 25%) = $375,000.<br>Diluted EPS numerator = $20,000,000 &minus; $2,000,000 + $375,000 = $18,375,000.<br>Diluted EPS denominator = 9,000,000 + 800,000 = 9,800,000.<br>Diluted EPS = $18,375,000 &divide; 9,800,000 = <strong>$1.87 per share</strong> (rounded) — lower than basic EPS of $2.00, confirming the convertible bonds are DILUTIVE and correctly included.</div></div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Worked Example — the Two-Class Method</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Allocating earnings between common stock and a participating security</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Participating preferred stock</div><div class="wk-body">An entity has net income of $10,000,000, 4,000,000 weighted-average common shares outstanding, and participating preferred stock entitled to dividends on an as-if-converted basis equivalent to 1,000,000 common shares (no separate convertible feature complications). Total shares on a combined basis: 5,000,000.</div><div class="wk-answer">Under the two-class method, the $10,000,000 is ALLOCATED between common and participating preferred based on their PARTICIPATION RIGHTS: common stock's share = $10,000,000 × (4,000,000 &divide; 5,000,000) = $8,000,000. Basic EPS for common stock = $8,000,000 &divide; 4,000,000 = <strong>$2.00 per share</strong> — computed by ALLOCATION rather than by the if-converted method IAS 33 preparers would more likely apply to an economically similar instrument.</div></div>
      </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">What ASC 260 requires</div><div class="check-list"><span>Basic and diluted EPS reconciliation, showing the numerator and denominator adjustments between the two</span><span>Securities excluded from diluted EPS because they were antidilutive, and the potential number of shares involved</span><span>A description of participating securities and the two-class method allocation, where applicable</span></div>
      </div>
    </div>

    <div class="section-header" id="s15"><span class="num">15</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether a security is a genuine "participating security" triggering the two-class method</span><span>Whether contingency conditions for contingently issuable shares would be met if the period end were the end of the contingency period</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Average market price used in the treasury stock method calculation</span><span>Weighted-average share counts where share issuances/repurchases occur mid-period</span></div></div></div>
      </div>
    </div>

    <div class="section-header" id="s16"><span class="num">16</span><h2>ASC 260 vs IAS 33 — the Two-Class Method Divergence</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Comparison — ASC 260 vs IAS 33</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span>US GAAP (ASC 260)</span><span>IFRS (IAS 33)</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Treasury stock method (options/warrants)</span><span>Yes, identical mechanics</span><span>Yes — fully converged</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>If-converted method (convertibles)</span><span>Yes, identical mechanics</span><span>Yes — fully converged</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Two-class method for participating securities</span><span>SPECIFICALLY REQUIRED, with its own defined allocation methodology</span><span>No equivalent named method — participating instruments assessed under general EPS principles instead</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Scope (public vs private entities)</span><span>Mandatory for public entities/SEC filers; optional for private companies</span><span>Mandatory for entities whose shares are publicly traded or in the process of being issued publicly — a closely parallel scope test</span></div>
      </div>
      <div class="note">Given the joint development history, ASC 260 and IAS 33 are among the closest-converged standard pairs across the two frameworks — the two-class method is genuinely the standout exception rather than the norm.</div>
      </div>
    </div>

    <div class="section-header" id="s17"><span class="num">17</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Where every ASC 260 event lands</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
      <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Basic and diluted EPS computation</span><span><span class="badge bp">IS</span></span><span>Presented on the face of the Income Statement</span></div>
      <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Antidilutive securities excluded</span><span>Notes only</span><span>Disclosed but not reflected in the reported diluted EPS figure</span></div>
      </div>
      </div>
    </div>

    <div class="section-header" id="s18"><span class="num">18</span><h2>Related Topics</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
      <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 225</span><span>Requires face-of-statement EPS presentation, whose computation this Topic governs</span></div>
      <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASC 718</span><span>Compensation—Stock Compensation — supplies the share-based payment awards frequently subject to the treasury stock method</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 480</span><span>Distinguishing Liabilities from Equity — determines whether a convertible instrument is even within EPS's equity-linked scope</span></div>
      </div>
      </div>
      <div class="card cn"><div class="ctitle cn">Quick-reference glossary preview</div>
      <div class="glossary-item"><div class="glossary-term">Participating security</div><div class="glossary-def">A security entitled to participate in dividends with common stock according to a predetermined formula, triggering the two-class method.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Potential common shares</div><div class="glossary-def">Securities or contracts that could result in the issuance of common stock, such as options, warrants, and convertible securities.</div></div>
      </div>
    </div>

    <div class="section-header" id="s19"><span class="num">19</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>

    <Glossary entries={[
      { term: "Treasury stock method", definition: "A method assuming option/warrant exercise proceeds are used to repurchase shares at the average market price, with only the net incremental shares added to diluted EPS." },
      { term: "If-converted method", definition: "A method assuming convertible securities converted at the start of the period, adding back the related dividends/interest to the numerator and the as-if-converted shares to the denominator." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.ASC260 || []} />
  </section>
</StandardPageLayout>
