---
import StandardLayout from "../../layouts/StandardLayout.astro";
import type { StandardSummary } from "../../data/standards";
import StandardCard from "../../components/StandardCard.astro";
import { FRAMEWORK_CONFIG, getFramework } from "../../data/frameworks";
import FrameworkSwitcher from "../../components/FrameworkSwitcher.astro";
import FrameworkToolbar from "../../components/FrameworkToolbar.astro";
import FrameworkHero from "../../components/FrameworkHero.astro";
import standards from "../../data/standards.json";
import { palette } from "../../data/standardVisuals";

const framework = getFramework("asbj")!;
const asbjStandards: StandardSummary[] = standards.ASBJ ?? [];

const activeItems = asbjStandards.filter(
  (item) => !item.status || item.status === "Upcoming" || item.status === "Amended" || item.status === "Active"
);
const historicalItems = asbjStandards.filter(
  (item) => item.status && (item.status === "Superseded" || item.status === "Withdrawn" || item.status === "Historical Reference")
);

const ASBJ_FAMILY_DESCRIPTIONS: Record<string, string> = {
  "ASBJ Statements": "Accounting Standards issued by the ASBJ.",
  "JMIS Standards": "Japan's Modified International Standards.",
  "Implementation Guidance": "Guidance on applying ASBJ statements.",
  "Practical Solutions": "Practical solutions issued by the ASBJ."
};
---

<StandardLayout code={framework.code} title={`${framework.fullName} (${framework.code})`} framework={framework.code} hasToc={false}>

  <FrameworkHero frameworkId={framework.id} />
  <FrameworkSwitcher activeId={framework.id} />
  <FrameworkToolbar frameworkId={framework.id} />
<div id="no-standards-results" class="no-standards-results" style="display: none;">
    <div class="no-results-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </div>
    <h3>No matching standards found</h3>
    <p>We couldn't find any standards matching your search term. Try searching for a different code or keyword.</p>
  </div>

  <div id="number-view">

    <div class="standards-group">
      <h2 class="standards-group-title">Active Standards</h2>
      <div class="standards-grid">

        {
          activeItems.map((item, index) => (
            <StandardCard
              href={item.url}
              code={item.code}
              title={item.title}
              framework={framework.id as any}
              theme={palette[index % palette.length]}
            />
          ))
        }

        {activeItems.length === 0 && (
          <p class="standards-empty">
            No standards have been added yet. Switch to Category view to browse the ASBJ document families.
          </p>
        )}

      </div>
    </div>

    <div class="standards-divider"></div>

    <div class="standards-group">
      <h2 class="standards-group-title">Historical Standards</h2>
      <div class="standards-grid">

        {
          historicalItems.map((item, index) => (
            <StandardCard
              href={item.url}
              code={item.code}
              title={item.title}
              framework={framework.id as any}
              theme={palette[index % palette.length]}
            />
          ))
        }

        {historicalItems.length === 0 && (
          <p class="standards-empty">
            No historical standards to display.
          </p>
        )}

      </div>
    </div>

  </div>

  <div id="category-view" style="display:none;">
    <div class="standards-grid">
    {
      (framework.categories ?? []).map((category, index) => (
        <a href={`#${category.replace(/[^a-zA-Z0-9]/g, "-").toLowerCase()}`} class="standard-card" style={`--icon-bg: ${framework.light}; --icon-color: ${framework.dark};`}>
          <div class="standard-top">
            <div class="standard-icon" set:html={`<i class="fa-solid fa-${framework.faIcon}"></i>`} />
            <div class="standard-code">{category}</div>
          </div>
          <div class="standard-title">{ASBJ_FAMILY_DESCRIPTIONS[category]}</div>
          <div class="standard-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))
    }
    </div>
  </div>

  

</StandardLayout>
