---
import StandardLayout from "../../layouts/StandardLayout.astro";
import IconChipCallout from "../../components/prototype/IconChipCallout.astro";
import "../../styles/prototype-chip.css";
---

<StandardLayout code="PROT2" title="Callout & Formula Box — Chip Prototype" framework="Design">
  <p class="text-supporting">
    <strong>Design prototype only (variant 2).</strong> This page is independent of the
    bead prototype and does not modify it, any accounting page, or any existing stylesheet.
    Here the Lucide icon lives in a small chip anchored to the top-left corner of the panel,
    flush against the border so it grows out of it and merges with the panel. The chip behaves
    like the first character of the paragraph: the first line starts beside it and wrapped
    lines continue underneath at the normal line spacing. Both layouts below use identical
    sample content so the two variants can be compared directly.
  </p>

  <h2 class="pc2-section-title">Variant A — Outlined Chip</h2>
  <p class="pc2-sub">Chip fill and border match the panel; the icon uses the panel's accent colour. The chip reads as a continuation of the panel.</p>

  <div class="pc2-grid">
    <div>
      <div class="pc2-cell-label">1 &middot; Information Box</div>
      <IconChipCallout variant="info" >
        <strong style="font-weight:600">Qualitative characteristics in action:</strong>
        the lower-of-cost-and-NRV test balances relevance (reflecting a genuine decline in
        recoverable value) against faithful representation (never allowing inventory to be
        carried above what it can realistically generate).
      </IconChipCallout>
    </div>

    <div>
      <div class="pc2-cell-label">2 &middot; Warning Box</div>
      <IconChipCallout variant="warn" >
        <strong style="font-weight:600">A common exam trap:</strong> students sometimes try
        to net investment income against the general borrowing pool — the netting rule applies
        exclusively to specific, traceable borrowings, not the general facility.
      </IconChipCallout>
    </div>

    <div>
      <div class="pc2-cell-label">3 &middot; Success Box</div>
      <IconChipCallout variant="suc" >
        <strong style="font-weight:600">Correct application confirmed:</strong> when the
        construction-phase operating loss is incurred, it is recognised immediately in profit
        or loss and is not capitalised into the asset's carrying amount.
      </IconChipCallout>
    </div>

    <div>
      <div class="pc2-cell-label">4 &middot; Danger Box</div>
      <IconChipCallout variant="danger" >
        <strong style="font-weight:600">Never restate prior periods for an estimate
        change</strong> — even when the effect is material. Retrospectively "correcting" a
        genuine change in estimate would misrepresent the information available to management
        at the time.
      </IconChipCallout>
    </div>

    <div style="grid-column: 1 / -1;">
      <div class="pc2-cell-label">5 &middot; Formula / Key Concept Box</div>
      <IconChipCallout variant="formula" >
        <span class="pc-formula-label" style="font-size:12px;font-weight:500;color:#52617a;margin-bottom:4px;display:block;">Depreciation charge (straight line)</span>
        <span class="pc-formula-eq" style="font-weight:500;color:#111827;">Annual depreciation = (Cost &minus; Residual value) &divide; Useful life</span>
        <span class="text-supporting" style="display:block;margin-top:6px;">Applied prospectively; a change in estimate (life or residual value) is never restated against prior periods under IAS 8.</span>
      </IconChipCallout>
    </div>
  </div>

  <h2 class="pc2-section-title">Variant B — Filled Chip</h2>
  <p class="pc2-sub">Same shape and corner anchoring as Variant A; only the colours change — the chip is filled with the accent colour and the icon is white.</p>

  <div class="pc2-grid">
    <div>
      <div class="pc2-cell-label">1 &middot; Information Box</div>
      <IconChipCallout variant="info" filled>
        <strong style="font-weight:600">Qualitative characteristics in action:</strong>
        the lower-of-cost-and-NRV test balances relevance (reflecting a genuine decline in
        recoverable value) against faithful representation (never allowing inventory to be
        carried above what it can realistically generate).
      </IconChipCallout>
    </div>

    <div>
      <div class="pc2-cell-label">2 &middot; Warning Box</div>
      <IconChipCallout variant="warn" filled>
        <strong style="font-weight:600">A common exam trap:</strong> students sometimes try
        to net investment income against the general borrowing pool — the netting rule applies
        exclusively to specific, traceable borrowings, not the general facility.
      </IconChipCallout>
    </div>

    <div>
      <div class="pc2-cell-label">3 &middot; Success Box</div>
      <IconChipCallout variant="suc" filled>
        <strong style="font-weight:600">Correct application confirmed:</strong> when the
        construction-phase operating loss is incurred, it is recognised immediately in profit
        or loss and is not capitalised into the asset's carrying amount.
      </IconChipCallout>
    </div>

    <div>
      <div class="pc2-cell-label">4 &middot; Danger Box</div>
      <IconChipCallout variant="danger" filled>
        <strong style="font-weight:600">Never restate prior periods for an estimate
        change</strong> — even when the effect is material. Retrospectively "correcting" a
        genuine change in estimate would misrepresent the information available to management
        at the time.
      </IconChipCallout>
    </div>

    <div style="grid-column: 1 / -1;">
      <div class="pc2-cell-label">5 &middot; Formula / Key Concept Box</div>
      <IconChipCallout variant="formula" filled>
        <span class="pc-formula-label" style="font-size:12px;font-weight:500;color:#52617a;margin-bottom:4px;display:block;">Depreciation charge (straight line)</span>
        <span class="pc-formula-eq" style="font-weight:500;color:#111827;">Annual depreciation = (Cost &minus; Residual value) &divide; Useful life</span>
        <span class="text-supporting" style="display:block;margin-top:6px;">Applied prospectively; a change in estimate (life or residual value) is never restated against prior periods under IAS 8.</span>
      </IconChipCallout>
    </div>
  </div>
</StandardLayout>
