import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/asbe/asbe40.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Scope" },
        { id: "s3", label: "3. Joint Control — the Threshold Requirement" },
        { id: "s4", label: "4. Two Types of Joint Arrangement" },
        { id: "s5", label: "5. Joint Operations — Recognising Your Own Share Directly" },
        { id: "s6", label: "6. Joint Ventures — the Equity Method" },
        { id: "s7", label: "7. Classifying an Arrangement — Structure, Terms, and Other Facts" },
        { id: "s8", label: "8. Worked Example — a Joint Operation" },
        { id: "s9", label: "9. Worked Example — a Joint Venture" },
        { id: "s10", label: "10. Disclosure Requirements" },
        { id: "s11", label: "11. Critical Judgments &amp; Estimates" },
        { id: "s12", label: "12. Relationship to IFRS 11" },
        { id: "s13", label: "13. Statement Mapping" },
        { id: "s14", label: "14. Related Standards" },
        { id: "s15", label: "15. Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
<div class="hub-sub">Extended reference poster · Chinese GAAP (ASBE / CAS) · 合营安排 · Joint operations vs joint ventures, converged with IFRS 11 · RMB examples</div></div></div>



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Two genuinely different accounting outcomes based on the arrangement's rights and obligations</div><div class="principle">ASBE No. 40 governs ARRANGEMENTS in WHICH TWO or MORE parties HAVE JOINT control — CLASSIFYING each ARRANGEMENT as EITHER a "JOINT OPERATION" or a "JOINT VENTURE," EACH requiring a GENUINELY different accounting TREATMENT. THE Standard is CLOSELY converged with IFRS 11 internationally.</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Arrangements subject to joint control</div><div class="principle">This Standard applies to ARRANGEMENTS where TWO or MORE parties HAVE joint CONTROL — DECISIONS about RELEVANT activities REQUIRING the UNANIMOUS consent of the PARTIES sharing CONTROL.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Joint Control — the Threshold Requirement</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Unanimous consent required for relevant decisions</div><div class="text-supporting">JOINT control EXISTS ONLY where DECISIONS about the ARRANGEMENT'S RELEVANT activities REQUIRE the UNANIMOUS consent of the PARTIES sharing CONTROL — a HIGHER threshold than MERE significant INFLUENCE (see the COMPANION ASBE No. 2 poster), since NO single PARTY can UNILATERALLY direct the ARRANGEMENT'S key DECISIONS.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Two Types of Joint Arrangement</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Joint operations vs joint ventures</div>
<div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Type</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Joint operation</span><span>Parties have RIGHTS to the ASSETS and OBLIGATIONS for the LIABILITIES of the ARRANGEMENT DIRECTLY</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Joint venture</span><span>Parties have RIGHTS to the NET assets of the ARRANGEMENT (TYPICALLY through a SEPARATE legal VEHICLE)</span></div>
</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Joint Operations — Recognising Your Own Share Directly</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Line-by-line recognition of the operator's own interest</div><div class="text-supporting">A JOINT OPERATOR recognises ITS OWN share of the ASSETS, LIABILITIES, revenue, and EXPENSES of the JOINT operation DIRECTLY, LINE-by-line — CONSISTENT with ITS OWN direct RIGHTS and OBLIGATIONS UNDER the arrangement, RATHER than APPLYING the equity METHOD.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Joint Ventures — the Equity Method</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">The same treatment as an associate</div><div class="text-supporting">A JOINT VENTURER accounts FOR its INTEREST in a JOINT venture USING the EQUITY method — the SAME approach APPLIED to associates UNDER ASBE No. 2 (see the COMPANION poster), adjusting the INVESTMENT for the VENTURER'S share of the JOINT venture'S profit OR loss and OTHER equity changes.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Classifying an Arrangement — Structure, Terms, and Other Facts</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Legal form is a starting point, not the final answer</div><div class="text-supporting">CLASSIFYING an ARRANGEMENT as a JOINT operation OR joint VENTURE requires CONSIDERING the ARRANGEMENT'S STRUCTURE (WHETHER a SEPARATE legal VEHICLE exists), its LEGAL form, the CONTRACTUAL terms AGREED by the PARTIES, and ANY other RELEVANT facts and CIRCUMSTANCES — a SEPARATE legal VEHICLE is a NECESSARY, but NOT sufficient, CONDITION for JOINT venture CLASSIFICATION.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — a Joint Operation</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Recognising a direct share of assets and liabilities</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A jointly operated pipeline</div><div class="wk-body">Two companies jointly operate a pipeline under an unincorporated contractual arrangement, each entitled to 50% of the pipeline's capacity and directly liable for 50% of its operating costs, with no separate legal entity established.</div><div class="wk-answer">EACH company recognises ITS OWN 50% share of the PIPELINE'S assets, LIABILITIES, revenue, and EXPENSES DIRECTLY WITHIN its OWN financial STATEMENTS — a JOINT OPERATION, GIVEN the DIRECT rights and OBLIGATIONS involved.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — a Joint Venture</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Applying the equity method to a jointly controlled entity</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A jointly owned incorporated venture</div><div class="wk-body">Two companies establish a separate incorporated joint venture company, each holding 50% of its shares, with joint control over its relevant activities requiring unanimous consent.</div><div class="wk-answer">EACH company accounts FOR its 50% interest USING the EQUITY method — recognising ITS SHARE of the JOINT venture'S profit or LOSS as INVESTMENT income, RATHER than recognising a DIRECT share of the UNDERLYING assets and LIABILITIES.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What ASBE No. 40 requires</div><div class="check-list"><span>Classification of the arrangement as a joint operation or joint venture, and the basis for that judgement</span><span>Nature, extent, and financial effects of interests in joint arrangements</span></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether an arrangement is genuinely subject to joint control</span><span>Classifying an arrangement as a joint operation or joint venture</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Fair value of a joint venture investee's identifiable net assets, where relevant to impairment assessment</span></div></div></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IFRS 11</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASBE 40 vs IFRS 11</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASBE 40</span><span style="color:var(--color-text-info);">IFRS 11</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Joint operation vs joint venture split</span><span>YES</span><span>YES — converged</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Joint venture measurement</span><span>Equity method</span><span>Equity method — converged</span></div>
</div>
<div class="note">A GENUINELY thoroughly CONVERGED standard, MIRRORING IFRS 11'S own TWO-category classification CLOSELY.</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every joint arrangement event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Joint operation share</span><span><span class="badge bs">BS</span> <span class="badge bp">IS</span></span><span>Line-by-line recognition of own share</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Joint venture interest</span><span><span class="badge bs">BS</span> <span class="badge bp">IS</span></span><span>Equity method — single-line investment</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASBE No. 2</span><span>Long-term Equity Investments — supplies the equity method mechanics this Standard applies to joint ventures</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Joint operation</div><div class="glossary-def">A joint arrangement in which the parties have direct rights to the assets and obligations for the liabilities, recognised line-by-line.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Joint venture</div><div class="glossary-def">A joint arrangement in which the parties have rights only to the net assets, typically through a separate legal vehicle, accounted for using the equity method.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (Chinese GAAP / ASBE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet (资产负债表) </div><div class="litem"><span class="badge bp">IS</span> Income Statement (利润表) </div><div class="litem"><span class="badge bo">SCOE</span> Statement of Changes in Owners' Equity (所有者权益变动表) </div><div class="litem"><span class="badge bc">CFS</span> Cash Flow Statement (现金流量表)</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.asbe40 || []} />
  </section>
</StandardPageLayout>
