---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas30.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & Definitions" },
        { id: "s2", label: "Classes & Significance for Financial Position" },
        { id: "s3", label: "Fair Value Designation Disclosures" },
        { id: "s4", label: "Significance for Financial Performance" },
        { id: "s5", label: "Other Disclosures – Accounting Policies, Hedging & Fair Value" },
        { id: "s6", label: "Concessionary Loans" },
        { id: "s7", label: "Nature & Extent of Risks – Qualitative & Quantitative" },
        { id: "s8", label: "Credit Risk" },
        { id: "s9", label: "Liquidity Risk" },
        { id: "s10", label: "Market Risk" },
        { id: "s11", label: "Effective Date & Amendment Timeline" },
        { id: "s12", label: "Relationship to IFRS 7" },
        { id: "s13", label: "Statement / Process Mapping" },
        { id: "s14", label: "Related Standards" },
        { id: "s15", label: "Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 30 Financial Instruments: Disclosures is the current, active standard issued by the IPSASB for disclosing the significance of financial instruments and the entity's risk exposures. Effective for periods beginning on or after 1 January 2013. The current Standard comprises paras. 1–53."
    historical="IPSAS 30 is the IPSASB's adaptation of IFRS 7 Financial Instruments: Disclosures for the public sector – with public-sector guidance on concessionary loans (added emphasis) and explicit linkage to IPSAS 28 (presentation) and IPSAS 41 (recognition/measurement)."
    link=""
    linkText=""
  />

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; Definitions (paras. 1–8)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Objective &amp; scope</div>
      <div class="principle">Requires an entity to disclose the significance of its financial instruments and the exposures to which it is exposed – for both qualitative and quantitative risk information. Applies to all financial instruments except those held for trading under IPSAS 41 unless they are designated for hedge accounting.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Key definitions</div>
      <div class="glossary-item"><div class="glossary-term">Financial instrument</div><div class="glossary-def">A contract that gives rise to a financial asset of one entity and a financial liability or equity instrument of another.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Notional amount</div><div class="glossary-def">The nominal or face amount by which the interest payments are determined – not the carrying amount.</div></div>
    </div>
  </div>

  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Scope exclusions (para. 3)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.6fr 1.4fr;"><span>Excluded</span><span>Instead, see…</span></div>
        <div class="tr" style="grid-template-columns:1.6fr 1.4fr;"><span>Pension/retirement plan assets</span><span>IPSAS 19 (where applicable)</span></div>
        <div class="tr alt" style="grid-template-columns:1.6fr 1.4fr;"><span>Insurance contracts</span><span>IPSAS 44</span></div>
        <div class="tr" style="grid-template-columns:1.6fr 1.4fr;"><span>Interest-bearing gov't loans (concessionary)</span><span>IPSAS 30 para. 25 (special disclosure)</span></div>
      </div>
      <div class="callout info callout--flush">Disclosure is entity-wide: ALL financial instruments on or off the face of the statement of financial position.</div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Classes &amp; Significance for Financial Position (paras. 9–13)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Required lines (para. 9)</div>
      <div class="td-table">
        <div class="th cols-1-2-fit"><span>Disclosure</span><span>Content</span></div>
        <div class="tr cols-1-2-fit"><span>Nature of FI</span><span>Kinds of instruments and risk exposures</span></div>
        <div class="tr alt cols-1-2-fit"><span>Rolling reconciliation</span><span>Movements in carrying amount by class</span></div>
        <div class="tr cols-1-2-fit"><span>Significance</span><span>Amounts derecognised during the period</span></div>
      </div>
      <div class="check-list"><span>Classify by instrument & exposure</span><span>Reconcile opening→closing</span><span>Show derecognised amounts</span></div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Fair Value Designation Disclosures (paras. 14–19)</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card ci">
      <div class="ctitle ci">FV hierarchy (para. 14)</div>
      <div class="principle">Disclose the level (1, 2 or 3) within the fair-value hierarchy for EACH class of financial assets and liabilities, with a reconciliation of movements in level 3. Required for every FV measurement (not just FVTPL).</div>
      <div class="cross-list"><span>Level 1</span><span>Quoted prices (active market)</span><span>Level 2</span><span>Observable inputs other than Level 1</span><span>Level 3</span><span>Unobservable inputs</span></div>
    </div>
  </div>

  <!-- ============ SECTION 4 ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Significance for Financial Performance (paras. 20–24)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Impact lines (para. 20)</div>
      <div class="principle">For each class of financial assets/liabilities: disclose the amount of interest income/expenses, realised/unrealised gains/losses and impairment recognised in the period, and the manner of determining the impaired/unrealised portion. </div>
      <div class="callout warn">For assets measured at amortised cost: disclose EIR and any write-downs/write-ups separately.</div>
    </div>
  </div>

  <!-- ============ SECTION 5 ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Other Disclosures – Accounting Policies, Hedging &amp; Fair Value (paras. 26–28)</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card cw">
      <div class="ctitle cw">Narrative anchors (para. 26)</div>
      <div class="principle">Describe the accounting policy for financial instruments, how hedging is applied (and which hedge model – IPSAS 29 legacy vs IPSAS 41), significant fair-value measurement judgements, and the nature/scope of de-designations. </div>
      <div class="glossary-item"><div class="glossary-term">Accounting policy</div><div class="glossary-def">The specific principles and methods that govern measurement and recognition.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 6 ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Concessionary Loans (paras. 25–26)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Public-sector special (para. 25)</div>
      <div class="td-table">
        <div class="th cols-1-2-fit"><span>Disclosure</span><span>Content</span></div>
        <div class="tr cols-1-2-fit"><span>Nature &amp; terms</span><span>Interest rate below market, grace, forgiveness</span></div>
        <div class="tr alt cols-1-2-fit"><span>Aggregate amount</span><span>Outstanding and committed concessionary loans</span></div>
      </div>
      <div class="callout info callout--flush">IPSAS 30 gives concessionary loans heightened public-sector attention because below-market lending is common in government.</div>
    </div>
  </div>

  <!-- ============ SECTION 7 ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Nature &amp; Extent of Risks – Qualitative &amp; Quantitative (paras. 27–29)</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card cd">
      <div class="ctitle cd">The big three risks (para. 27)</div>
      <div class="principle">Disclose the NATURE of exposure to credit risk, liquidity risk and market risk, and the QUANTITATIVE carrying amounts and notionals by class – including how exposures are measured, concentrations, and limits/capital charges where applicable.</div>
      <div class="check-list"><span>Nature + amount for each risk</span><span>Concentrations (counterparty / sector)</span><span>Limits & hedging status</span></div>
    </div>
  </div>

  <!-- ============ SECTION 8 ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Credit Risk (paras. 30–32)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card cw">
      <div class="ctitle cw">Default exposure (para. 30)</div>
      <div class="principle">Disclose the extent of credit risk exposure: total carrying amount by segment and the 5 largest counterparties. Include maturity analysis, collateral held, and whether ECL/expected-credit-loss model applies.</div>
      <div class="callout info callout--flush">Concentrations matter more for public sector given sovereign/soil exposure to single counterparties.</div>
    </div>
  </div>

  <!-- ============ SECTION 9 ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Liquidity Risk (paras. 33–34)</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card ci">
      <div class="ctitle ci">Cash-flow mismatches (para. 33)</div>
      <div class="td-table">
        <div class="th cols-1-2-fit"><span>Analysis</span><span>Ledger</span></div>
        <div class="tr cols-1-2-fit"><span>Contractual maturities</span><span>Financial liabilities by time bucket</span></div>
        <div class="tr alt cols-1-2-fit"><span>Liquid assets pledged</span><span>Collateral / cash held</span></div>
      </div>
      <div class="callout warn">Disaggregate by currency for entities with foreign operations.</div>
    </div>
  </div>

  <!-- ============ SECTION 10 ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Market Risk (paras. 35–36)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card cd">
      <div class="ctitle cd">FV sensitivity (para. 35)</div>
      <div class="principle">Disclose the effect on profit or loss of a reasonably probable change in key market variables (interest rate, FX, equity) on financial instruments – typically via a sensitivity table. State the method, inputs, and assumptions used.</div>
        <div class="glossary-item"><div class="glossary-term">Value-at-Risk</div><div class="glossary-def">A statistical estimate of potential loss over a target horizon at a given confidence level.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 11 ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Effective Date &amp; Amendment Timeline</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Timeline</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.2fr;"><span>Date</span><span>Event</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>Dec 2011</span><span>Issued</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.2fr;"><span>1 Jan 2013</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>2025</span><span>Amended (latest)</span></div>
      </div>
      <div class="callout info callout--flush">Amendment relates to IFRS 7:2016 'Classification and Measurement' updates reflected in IPSAS 30 consequent amendments.</div>
    </div>
  </div>

  <!-- ============ SECTION 12 ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IFRS 7</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Mapping (para. 43)</div>
      <div class="principle">IPSAS 30 is the IPSASB's adaptation of IFRS 7 Financial Instruments: Disclosures. The disclosures mirror IFRS 7 (classes, FV hierarchy, significance for P/L, risk exposures) but add public-sector emphasis on concessionary loans and government-specific risk concentration commentary.</div>
      <div class="cross-list"><span>IFRS 7 classes</span><span>IPSAS 30 same</span><span>IFRS 7 FV hierarchy</span><span>IPSAS 30 same</span><span>IFRS 7 risk disclosures</span><span>IPSAS 30 same (concessionary loans added)</span></div>
    </div>
  </div>

  <!-- ============ SECTION 13 ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Statement / Process Mapping (para. 43)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Where it flows</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.4fr 1.3fr;"><span>Process</span><span>Ledger</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>FV hierarchy build</span><span>Valuation → Disclosure Engine (Level 1/2/3)</span></div>
        <div class="tr alt" style="grid-template-columns:1.4fr 1.3fr;"><span>Risk dashboards</span><span>Treasury Mgmt → Credit/Liquidity/Mkt modules</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Concessionary loan register</span><span>Loans Ledger → IPSAS 30 para. 25</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 14 ============ -->
  <div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">See also</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 2fr;"><span>Standard</span><span>Relation</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 28</span><span>Presentation of FI</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IPSAS 41</span><span>Recognition &amp; measurement of FI</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IFRS 7</span><span>Direct equivalent</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 15 ============ -->
  <div class="section-header" id="s15"><span class="num">15</span><h2>Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Credit risk</div><div class="glossary-def">Risk that a counterparty will not meet its obligations.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Liquidity risk</div><div class="glossary-def">Risk that an entity cannot meet short-term cash obligations.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Market risk</div><div class="glossary-def">Risk of loss from movement in market prices (interest, FX, equity).</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Fair value hierarchy</div><div class="glossary-def">Three-level binning of FV inputs (1 quoted, 3 unobservable).</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Concessionary loan</div><div class="glossary-def">A loan at below-market interest or with favourable terms.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Expected credit loss</div><div class="glossary-def">12-month or lifetime loss provision (ECL model).</div></div>
    </div>
  </div>
</StandardPageLayout>

