---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas33.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & Out-of-Scope Circumstances" },
        { id: "s2", label: "Key Definitions" },
        { id: "s3", label: "The Opening Statement of Financial Position" },
        { id: "s4", label: "General Recognition & Accounting Policy Principles" },
        { id: "s5", label: "Three-Year Transitional Relief – Assets & Liabilities" },
        { id: "s6", label: "Three-Year Relief – Revenue & Transfer Expenses" },
        { id: "s7", label: "Deemed Cost – the Core Transitional Tool" },
        { id: "s8", label: "Deemed Cost – Specific Applications" },
        { id: "s9", label: "Exemptions That Do NOT Affect Fair Presentation" },
        { id: "s10", label: "Disclosure During the Period of Transition" },
        { id: "s11", label: "Worked Example – Deemed Cost of Investment Property" },
        { id: "s12", label: "Effective Date & Amendment Timeline" },
        { id: "s13", label: "Relationship to IFRS 1" },
        { id: "s14", label: "Statement / Process Mapping" },
        { id: "s15", label: "Related Standards – Cross-Reference Map" },
        { id: "s16", label: "Quick-Reference Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 33 First-time Adoption of Accrual Basis IPSAS is the current, active standard issued by the IPSASB to guide first-time adopters onto the accrual basis – using deemed cost as the core transitional tool with three-year relief. Effective for periods beginning on or after 1 January 2017 (earlier application encouraged). Paras. 1–70."
    historical="IPSAS 33 is the IPSASB's adaptation of IFRS 1 First-time Adoption for the public sector – but where IFRS 1 permits full retrospective restatement, IPSAS 33 builds a SEPARATE opening statement of financial position using deemed cost and offers a distinctive three-year relief period."
    link=""
    linkText=""
  />

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; Out-of-Scope Circumstances (paras. 1–6)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">A bridge, not a permanent home (para. 1)</div>
      <div class="principle">Guides a FIRST-TIME ADOPTER preparing its statement of financial position on transition to accrual-basis IPSAS – aiming for high-quality, transparent information that is (a) representative and (b) comparable to prior-period cash-basis / mixed-basis reporting.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Key definitions</div>
      <div class="glossary-item"><div class="glossary-term">First-time adopter</div><div class="glossary-def">An entity that presents its first accrual-basis general purpose financial statements.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Deemed cost</div><div class="glossary-def">Monetary amount used to recognise an asset on transition where cost is unknown or unreliable.</div></div>
    </div>
  </div>

  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Out of scope</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.6fr 1.4fr;"><span>Excluded</span><span>Instead, see…</span></div>
        <div class="tr" style="grid-template-columns:1.6fr 1.4fr;"><span>Switch from one IPSAS version to another</span><span>Normal amendment process</span></div>
        <div class="tr alt" style="grid-template-columns:1.6fr 1.4fr;"><span>Change to a different public-sector framework</span><span>IPSAS 33 still applies (first-time to accrual)</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Key Definitions (para. 9)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Core definitions (para. 9)</div>
      <div class="principle">Deemed cost; first-time adopter; date of transition to accrual basis; reporting period. The date of transition is the START of the earliest period for which the entity presents full accrual-basis comparatives.</div>
      <div class="check-list"><span>Date of transition</span><span>Reporting period</span><span>Deemed cost basis</span></div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>The Opening Statement of Financial Position (paras. 15–19)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Opening SOFP (para. 15)</div>
      <div class="principle">The entity RECONSTRUCTS its opening accrual-basis statement of financial position from existing information (books/records, valuations, market data) – it is NOT required to restate prior-period profit/loss line-by-line, but assets and liabilities are recognised, measured and disclosed per IPSAS on the opening date.</div>
      <div class="callout info callout--flush">Two paths: (a) build from cost where known; (b) fall back to deemed cost where cost/history is unavailable.</div>
    </div>
  </div>

  <!-- ============ SECTION 4 ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>General Recognition &amp; Accounting Policy Principles (paras. 20–23)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card cd">
      <div class="ctitle cd">Same rules, new books (para. 20)</div>
      <div class="principle">All IPSAS recognition/measurement requirements apply at the opening date, but the entity is exempt from the 'no hindsight' and 'use prevailing rates' restrictions that bind continuous adopters – it may use hindsight of events after the reporting period to estimate, and may use current market data.</div>
      <div class="cross-list"><span>Full IPSAS recognition applies</span><span>Hindsight permitted</span><span>Current market data allowed</span><span>Prior cash-basis info used to rebuild</span></div>
    </div>
  </div>

  <!-- ============ SECTION 5 ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Three-Year Transitional Relief – Assets &amp; Liabilities (paras. 33–41B)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">Phased-in measurement (para. 33)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.3fr;"><span>Year</span><span>Relief</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.3fr;"><span>Year 1</span><span>Deemed cost for assets; FV less costs to sell allowed</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.3fr;"><span>Year 2</span><span>Same; plus revaluation to FV permitted</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.3fr;"><span>Year 3</span><span>Full accrual-basis measurement required</span></div>
      </div>
      <div class="callout warn">Relief is OPTIONAL – the entity may apply full accrual measurement from year 1.</div>
    </div>
  </div>

  <!-- ============ SECTION 6 ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Three-Year Relief – Revenue &amp; Transfer Expenses, Plus Consequential Exemptions (paras. 42–48)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card ci">
      <div class="ctitle ci">Revenue transition (para. 42)</div>
      <div class="principle">For revenue, the entity may use its cash-basis / mixed-basis records for the first three years and adjust to accrual-basis timing, with a disclosure of the adjustments. Consequent exemptions (e.g. from hedge-accounting documentation) apply only to the transition period.</div>
      <div class="glossary-item"><div class="glossary-term">Transfer expenses</div><div class="glossary-def">Expenditure that gives rise to an asset or reduces a liability – the accrual analogue of cash-basis outlays.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 7 ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Deemed Cost – the Core Transitional Tool (paras. 64–70)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Fallback measure (para. 64)</div>
      <div class="principle">Where the historical cost of an asset cannot be determined reliably, the entity measures it at DEEMED COST – its fair value on the date of transition, adjusted for accumulated depreciation and impairment recognised subsequently. This is the single most-used transition tool.</div>
      <div class="callout info callout--flush">Deemed cost is not 'fair value' forever – subsequent measurement follows the asset's IPSAS model.</div>
    </div>
  </div>

  <!-- ============ SECTION 8 ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Deemed Cost – Specific Applications (paras. 64A, 67–75)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card cw">
      <div class="ctitle cw">Tailored uses (para. 64A)</div>
      <div class="principle">Deemed cost also applies to biological assets (IPSAS 27), intangible heritage assets (IPSAS 31) and investment property (IPSAS 16) where reliable cost records do not exist. The entity may use an independent valuation at the date of transition.</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.2fr;"><span>Asset class</span><span>Deemed-cost basis</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>Biological / heritage</span><span>FV at transition date</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.2fr;"><span>Investment property</span><span>Cost or FV (entity election)</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 9 ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Exemptions That Do NOT Affect Fair Presentation (paras. 63, 153)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Allowed shortcuts (para. 63)</div>
      <div class="principle">The transitional exemptions – deemed cost, three-year relief, hindsight, and the cash-basis revenue carve-out – are designed NOT to affect the entity's fair presentation when applied. Disclose the exemptions used and the resulting impact.</div>
      <div class="check-list"><span>Deemed cost</span><span>Three-year relief</span><span>Hindsight permitted</span><span>Impact disclosed</span></div>
    </div>
  </div>

  <!-- ============ SECTION 10 ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure During the Period of Transition (paras. 151–152F)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Reconciliations (para. 151)</div>
      <div class="principle">Reconcile, for each major class of asset/liability: (a) the previous (cash/mixed-basis) carrying amount to the accrual-basis opening carrying amount, and (b) the opening accrual-basis amount to the close. Disclose the exemptions taken and their quantitative effect.</div>
      <div class="callout warn">A sensitivity to FV changes must also be disclosed where the entity elected FV as deemed cost.</div>
    </div>
  </div>

  <!-- ============ SECTION 11 ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Worked Example – Deemed Cost of Investment Property</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Illustrative (IG39)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.3fr;"><span>Step</span><span>Action</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.3fr;"><span>1. Determine date of transition</span><span>Start of earliest comparative period</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.3fr;"><span>2. Build from records</span><span>Use cost where available</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.3fr;"><span>3. Apply deemed cost</span><span>FV less depreciation on unknown-cost assets</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.3fr;"><span>4. Reconcile</span><span>Prior basis → accrual basis, disclose gap</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 12 ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Effective Date &amp; Amendment Timeline (paras. 153–154Q)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Timeline</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.2fr;"><span>Date</span><span>Event</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>Jan 2015</span><span>Issued</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.2fr;"><span>1 Jan 2017</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>2025</span><span>Amended (latest)</span></div>
      </div>
      <div class="callout info callout--flush">The IPSASB may extend the transition relief period via consequential amendments; check the latest Handbook edition.</div>
    </div>
  </div>

  <!-- ============ SECTION 13 ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IAS/IFRS – Comparison with IFRS 1</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Divergence (para. 155)</div>
      <div class="principle">IPSAS 33 keeps IFRS 1's 'reconstruct the opening SOFP' objective but diverges sharply: it ALLOWS deemed cost and a 3-year measurement relief, and uses the public-sector 'service potential' language; IFRS 1 requires full retrospective restatement throughout.</div>
      <div class="cross-list"><span>IFRS 1 deemed cost</span><span>IPSAS 33 core tool (allowed)</span><span>IFRS 1 3-year relief</span><span>IPSAS 33 distinctive</span></div>
    </div>
  </div>

  <!-- ============ SECTION 14 ============ -->
  <div class="section-header" id="s14"><span class="num">14</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Where it flows</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.4fr 1.3fr;"><span>Process</span><span>Ledger</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Transition project</span><span>Implementation Team → Opening SOFP workbook</span></div>
        <div class="tr alt" style="grid-template-columns:1.4fr 1.3fr;"><span>Asset valuations</span><span>FA Valuation → Asset Register (deemed cost)</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Prior-period bridge</span><span>Disclosure Engine → IPSAS 7200</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 15 ============ -->
  <div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards – Cross-Reference Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">See also</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 2fr;"><span>Standard</span><span>Relation</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 16</span><span>Investment property deemed-cost rules</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IPSAS 31</span><span>Heritage/intangible deemed cost</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 31</span><span>Intangible deemed cost</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IFRS 1</span><span>Conceptual twin</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 16 ============ -->
  <div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">First-time adopter</div><div class="glossary-def">Entity presenting its first accrual-basis GPF statements.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Date of transition</div><div class="glossary-def">Start of the earliest accrual-basis comparative period.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Deemed cost</div><div class="glossary-def">Fallback FV-based measure when cost is unavailable.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Three-year relief</div><div class="glossary-def">Optional phased measurement for assets/liabilities/revenue.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Hindsight</div><div class="glossary-def">Permitted use of post-period information to estimate opening amounts.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Fair presentation</div><div class="glossary-def">Exemptions must not compromise faithful representation.</div></div>
    </div>
  </div>
</StandardPageLayout>

