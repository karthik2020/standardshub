---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ifrs/ifrs2.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Equity-Settled — Recognition & Grant Date Fair Value" },
        { id: "s4", label: "Vesting Conditions — Market vs Non-Market" },
        { id: "s5", label: "Modifications, Cancellations & Forfeitures" },
        { id: "s6", label: "Cash-Settled Share-based Payment" },
        { id: "s7", label: "Choice of Settlement" },
        { id: "s8", label: "Employee Share Purchase Plans & Group Transactions" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IFRS vs US GAAP" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
        { id: "history", label: "History & Development" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why share options are a genuine expense</div>
        <div class="principle">The Conceptual Framework requires an expense to be recognised whenever an entity CONSUMES an economic resource in exchange for goods or services received — receiving employee SERVICE in exchange for share options is no different from paying cash wages, even though no cash changes hands. IFRS 2 exists specifically to stop share-based remuneration being treated as a "free" cost that bypasses the SOPL.</div>
        <div class="elabel">HOW IFRS 2 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Expense recognition</strong> — services received in exchange for equity instruments are recognised as an expense as those services are CONSUMED, matching employee service to the vesting period</span>
          <span><strong>Faithful representation</strong> — omitting share-based payment expense from the SOPL (as was historically common under some old GAAPs) would materially understate an entity's true remuneration cost</span>
          <span><strong>Substance over form</strong> — the SAME underlying instrument (a share option) can create either an EQUITY increase or a LIABILITY, depending on whether the entity or the counterparty controls the settlement method</span>
        </div>
        <div class="note">IFRS 2 was historically controversial precisely because it forced companies to recognise a genuine P&amp;L expense for something many previously treated as having "no cost" — a direct triumph of the Framework's expense-recognition principle over a long-standing accounting convention.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Measurement principles applied</div>
        <div class="principle">IFRS 2's measurement basis differs fundamentally depending on classification — a direct consequence of whether the ultimate settlement obligation is fixed (equity) or variable (liability).</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Classification</span><span>Measurement basis</span></div>
          <div class="tr cols-13-1"><span>Equity-settled</span><span>Fair value AT GRANT DATE, fixed and never remeasured thereafter</span></div>
          <div class="tr alt cols-13-1"><span>Cash-settled</span><span>Fair value REMEASURED at each reporting date until settlement</span></div>
        </div>
        <div class="callout info callout--chip callout--flush"><strong>Qualitative characteristics in action:</strong> fixing equity-settled fair value at grant date reflects <strong>faithful representation</strong> of the ORIGINAL bargain struck with employees — remeasuring it later (as if it were a liability) would introduce volatility unrelated to the entity's actual obligation, since equity holders bear share price risk directly, not the entity.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRS 2 covers</div>
        <div class="principle">IFRS 2 applies to all share-based payment transactions, whether the entity can identify specifically some or all of the goods/services received — including transactions with EMPLOYEES and with OTHER PARTIES (e.g. suppliers, consultants) settled in cash, other assets, or equity instruments.</div>
        <div class="elabel">THREE CATEGORIES</div>
        <div class="check-list">
          <span><strong>Equity-settled</strong> — the entity receives goods/services and settles by issuing its own equity instruments</span>
          <span><strong>Cash-settled</strong> — the entity incurs a liability for amounts based on the price (or value) of its equity instruments</span>
          <span><strong>Transactions with a choice of settlement</strong> — either the entity or the counterparty can choose whether settlement is in cash or equity instruments</span>
        </div>
        <div class="note">IFRS 2 explicitly EXCLUDES share-based payments to acquire goods as part of a business combination consideration under IFRS 3 (specific IFRS 3 rules apply instead), and transactions within the scope of IAS 41 or IAS 2 for the contribution of assets in specific circumstances.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Grant date</div>
          <div class="glossary-def">The date at which the entity and the counterparty AGREE to a share-based payment arrangement, having a shared understanding of the terms and conditions — for arrangements subject to approval, this is the date approval is obtained.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Vesting conditions</div>
          <div class="glossary-def">Conditions that determine whether the entity receives the services entitling the counterparty to receive cash, other assets, or equity instruments — comprising SERVICE conditions and PERFORMANCE conditions (market and non-market).</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Vesting period</div>
          <div class="glossary-def">The period during which all specified vesting conditions of a share-based payment arrangement are to be satisfied.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Grant date fair value</div>
          <div class="glossary-def">The fair value of an equity instrument at the grant date, determined using an option pricing model where market prices are not directly available — used and FIXED for equity-settled transactions.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Equity-Settled — Recognition &amp; Grant Date Fair Value (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">The core recognition mechanics</div>
        <div class="formula-box">
          <div class="f-eq">Total expense = Number of instruments expected to vest × Grant date fair value per instrument, recognised on a STRAIGHT-LINE basis over the vesting period, with a corresponding CREDIT to equity</div>
        </div>
        <div class="text-supporting">The entity recognises goods/services received (and the corresponding increase in equity) DIRECTLY as an expense (for employee/service arrangements), unless the goods/services qualify for recognition as an asset under another Standard.</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Worked example — basic 3-year equity-settled option grant</div>
        <div class="worked">
          <div class="wk-title">Example 1: Share options with a 3-year service condition</div>
          <div class="wk-body">
            On 1 January 20X1, an entity grants 100 share options each to 50 employees, conditional on 3 years' continued service. Grant date fair value: $12 per option. At the end of Year 1, the entity estimates 5 employees will leave before vesting (45 expected to vest); by the end of Year 2, this estimate is revised to 6 leavers (44 expected to vest); by the end of Year 3, 43 employees actually remain and receive their options.
          </div>
          <div class="wk-answer">
            <strong>Year 1</strong>: cumulative expense = 45 × 100 × $12 × (1/3) = <strong>$18,000</strong><br>
            <strong>Year 2</strong>: cumulative expense = 44 × 100 × $12 × (2/3) = $35,200; Year 2 charge = 35,200 − 18,000 = <strong>$17,200</strong><br>
            <strong>Year 3</strong>: cumulative expense = 43 × 100 × $12 × (3/3) = $51,600; Year 3 charge = 51,600 − 35,200 = <strong>$16,400</strong>
          </div>
        </div>
        <div class="note">The estimate of the NUMBER of instruments expected to vest is REVISED each period based on the best available information — but the GRANT DATE FAIR VALUE PER OPTION ($12) is NEVER revised, even if the entity's share price moves dramatically.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Vesting Conditions — Market vs Non-Market (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">The critical distinction — WHERE the condition is reflected</div>
        <div class="td-table">
          <div class="th cols-1-16"><span>Condition type</span><span>Treatment</span></div>
          <div class="tr cols-1-16"><span>Service condition</span><span>Affects the NUMBER of instruments expected to vest, re-estimated each period</span></div>
          <div class="tr alt cols-1-16"><span>Non-market performance condition</span><span>(e.g. a profit target) ALSO affects the NUMBER expected to vest, re-estimated each period, just like a service condition</span></div>
          <div class="tr cols-1-16"><span>Market condition</span><span>(e.g. a specific SHARE PRICE target, or total shareholder return relative to a peer index) is built INTO the GRANT DATE FAIR VALUE calculation itself, using an option pricing model — NEVER re-estimated, and expense is recognised REGARDLESS of whether the market condition is ultimately achieved</span></div>
        </div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: Market condition (share price target) — expense recognised even if the target is missed</div>
          <div class="wk-body">
            An entity grants options vesting only if the share price reaches $25 within 3 years (a market condition). The grant date fair value, already reflecting the probability of achieving this target via an option pricing model, is $8 per option. By the end of Year 3, the share price target was NOT achieved, and the options lapse unexercised.
          </div>
          <div class="wk-answer">
            The FULL expense based on the original $8 grant date fair value is STILL recognised over the vesting period, EVEN THOUGH the options never actually vested — because a market condition is treated as having ALREADY been factored into fair value at grant date, its failure does NOT reverse previously recognised expense.
          </div>
        </div>
        <div class="callout danger callout--chip callout--flush"><strong>This is one of the most frequently tested and counter-intuitive rules in IFRS 2:</strong> failure to satisfy a MARKET condition does NOT result in reversal of expense already recognised, unlike a service or non-market performance condition, which DOES adjust the number expected to vest (and can reduce cumulative expense to nil if nobody ultimately vests).</div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Modifications, Cancellations &amp; Forfeitures</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Modifications — a floor, never a reduction</div>
        <div class="text-supporting">If a modification INCREASES the fair value of the instruments granted (e.g. reducing the exercise price), the entity includes the INCREMENTAL fair value granted in the measurement of the amount recognised for services received. If a modification DECREASES total fair value, the entity CONTINUES to recognise the services received based on the ORIGINAL grant date fair value, as if the modification had not occurred — a decrease in fair value is simply IGNORED for expense purposes.</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Cancellations &amp; forfeitures</div>
        <div class="dot-list">
          <span><strong>Forfeiture</strong> (failure to meet a NON-market vesting condition, e.g. an employee leaves) → treated as if the grant had NEVER been made; cumulative expense already recognised is REVERSED</span>
          <span><strong>Cancellation by the entity</strong> (e.g. buying out unvested options) → treated as an ACCELERATION of vesting; any amount NOT yet recognised is recognised IMMEDIATELY</span>
        </div>
        <div class="note">Cancellation is treated very differently from forfeiture: cancellation ACCELERATES the remaining expense into the current period, while forfeiture (for failing a non-market/service condition) REVERSES the expense already booked.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Cash-Settled Share-based Payment (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Share appreciation rights — remeasured every period</div>
        <div class="principle">For cash-settled transactions, the entity measures the goods/services acquired, and the LIABILITY incurred, at the FAIR VALUE of the liability. Until the liability is settled, the entity REMEASURES the fair value of the liability at EACH reporting date and at the date of settlement, with any changes in fair value recognised in profit or loss for the period.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 3: Share appreciation rights (SARs) over 3 years</div>
          <div class="wk-body">
            An entity grants 200 cash-settled SARs to each of 100 employees, vesting after 3 years of service, entitling each employee to a cash payment based on the share price increase since grant. Fair value of each SAR: Year 1 end $5, Year 2 end $7, Year 3 end (vesting date) $9. 90 employees remain employed through vesting.
          </div>
          <div class="wk-answer">
            <strong>Year 1</strong>: 90 × 200 × $5 × (1/3) = <strong>$30,000</strong> (liability and expense)<br>
            <strong>Year 2</strong>: cumulative = 90 × 200 × $7 × (2/3) = $84,000; Year 2 charge = 84,000 − 30,000 = <strong>$54,000</strong><br>
            <strong>Year 3</strong>: cumulative = 90 × 200 × $9 × (3/3) = $162,000; Year 3 charge = 162,000 − 84,000 = <strong>$78,000</strong>
          </div>
        </div>
        <div class="entry"><span class="dr">Dr</span><div class="etxt">Remuneration expense<div class="badges"><span class="badge bp">SOPL</span></div></div></div>
        <div class="entry"><span class="cr">Cr</span><div class="etxt">Liability — SARs<div class="badges"><span class="badge bs">SOFP</span></div></div></div>
        <div class="note">Unlike equity-settled awards, BOTH the number expected to vest AND the fair value per unit are re-estimated/remeasured every single period — a genuinely different, higher-volatility accounting outcome.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Transactions with a Choice of Settlement</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">Counterparty has the choice</div>
        <div class="text-supporting">Where the COUNTERPARTY has the right to choose whether a share-based payment transaction is settled in cash or equity instruments, the entity has granted a COMPOUND financial instrument, split into a DEBT component (the counterparty's right to demand cash) and an EQUITY component — measured similarly to IAS 32's compound instrument split.</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Entity has the choice</div>
        <div class="text-supporting">Where the ENTITY has the choice of settlement, the entity determines whether it has a PRESENT OBLIGATION to settle in cash (in which case cash-settled accounting applies), or otherwise accounts for the transaction as EQUITY-SETTLED — the classification hinges on whether a genuine cash obligation exists in substance.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Employee Share Purchase Plans &amp; Group Share-based Payment Transactions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Discounted employee share purchase plans</div>
        <div class="text-supporting">Where employees can purchase shares at a DISCOUNT to market price, the discount itself is generally accounted for as a share-based payment expense, UNLESS the plan qualifies for a specific practical exemption for plans with no meaningful discount and no vesting-type conditions attached.</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Group share-based payment arrangements</div>
        <div class="text-supporting">Where a PARENT grants rights to its own equity instruments to employees of a SUBSIDIARY, the subsidiary recognises the SERVICES received as an expense (with a corresponding increase in EQUITY, treated as a capital contribution from the parent), and the parent recognises the increase in equity in its OWN or consolidated financial statements, as appropriate.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures</div>
        <div class="two-col">
          <div>
            <div class="elabel">NATURE &amp; EXTENT DISCLOSURES</div>
            <div class="check-list">
              <span>A description of each type of share-based payment arrangement, including general terms and conditions (vesting requirements, maximum term, method of settlement)</span>
              <span>Number and weighted average exercise prices of share options — outstanding at the start/end of the period, granted, forfeited, exercised, and expired during the period</span>
              <span>Weighted average share price at the date of exercise for options exercised during the period</span>
            </div>
          </div>
          <div>
            <div class="elabel">MEASUREMENT &amp; IMPACT DISCLOSURES</div>
            <div class="check-list">
              <span>How the fair value of goods/services received, or the fair value of equity instruments granted, was determined (inputs to the option pricing model used)</span>
              <span>The total expense recognised in the period for share-based payment transactions</span>
              <span>For cash-settled arrangements: total carrying amount of the liability at the end of the period, and the intrinsic value of vested liabilities</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Classifying a condition as market vs non-market (a critical distinction determining whether it's built into fair value or re-estimated)</span>
              <span>Distinguishing forfeiture from cancellation, given their opposite accounting effects</span>
              <span>Determining whether the entity has a present obligation to settle in cash in a choice-of-settlement arrangement</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Fair value of options/other equity instruments at grant date, using an appropriate option pricing model (e.g. Black-Scholes, binomial) and its inputs (volatility, expected life, risk-free rate)</span>
              <span>Estimated number of instruments expected to vest, revised each period for service and non-market performance conditions</span>
              <span>Fair value of cash-settled liabilities at each subsequent reporting date</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">Option pricing model INPUTS (particularly expected volatility and expected life) can be significantly judgemental, especially for newly listed or unlisted entities without a long trading history — small changes in these assumptions can materially affect the total remuneration expense recognised.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRS vs US GAAP — Key Differences</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison — IFRS 2 vs US GAAP (ASC 718)</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS (IFRS 2)</span><span>US GAAP</span></div>
          <div class="tr cols-12-1-1"><span>Core grant-date fair value approach</span><span>Fair value at grant, fixed for equity-settled</span><span>Very similar approach — broadly converged following a joint standard-setting effort</span></div>
          <div class="tr alt cols-12-1-1"><span>Forfeiture estimates</span><span>Estimate forfeitures and revise each period</span><span>Also permits either estimating forfeitures OR accounting for them as they actually occur, a POLICY CHOICE not available under IFRS 2</span></div>
          <div class="tr cols-12-1-1"><span>Market condition failure</span><span>Expense recognised regardless of whether the market condition is achieved</span><span>Similarly, expense is not reversed for failure to achieve a market condition — largely converged</span></div>
          <div class="tr alt cols-12-1-1"><span>Modification decreasing fair value</span><span>Original grant date fair value continues to be used; decrease ignored</span><span>Broadly similar treatment, converged in substance</span></div>
        </div>
        <div class="note">IFRS 2 and ASC 718 are among the more converged pairs of standards, following a dedicated joint project — the main practical difference is the forfeiture ESTIMATION POLICY CHOICE available under US GAAP (estimate vs actual) that IFRS 2 does not offer, since IFRS mandates the estimation approach.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping — Where Every Share-based Payment Event Lands</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Equity-settled expense recognised each period</span><span><span class="badge bp">SOPL</span> <span class="badge be">Equity</span></span><span>Credited to a separate equity reserve, based on fixed grant date fair value</span></div>
          <div class="tr alt cols-16-1-14"><span>Forfeiture (service/non-market condition not met)</span><span><span class="badge bp">SOPL</span> <span class="badge be">Equity</span></span><span>Cumulative expense reversed, as if the grant never occurred</span></div>
          <div class="tr cols-16-1-14"><span>Market condition not achieved</span><span>—</span><span>No reversal; expense already recognised remains</span></div>
          <div class="tr alt cols-16-1-14"><span>Cancellation by the entity</span><span><span class="badge bp">SOPL</span> <span class="badge be">Equity</span></span><span>Remaining unrecognised expense accelerated immediately</span></div>
          <div class="tr cols-16-1-14"><span>Exercise of vested options</span><span><span class="badge be">Equity</span></span><span>Reserve transferred to share capital/premium; no SOPL impact</span></div>
          <div class="tr alt cols-16-1-14"><span>Cash-settled expense recognised each period</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Liability remeasured to fair value each period</span></div>
          <div class="tr cols-16-1-14"><span>Settlement of a cash-settled award</span><span><span class="badge bs">SOFP</span></span><span>Liability derecognised; cash paid</span></div>
          <div class="tr alt cols-16-1-14"><span>Cash paid on settlement</span><span><span class="badge bs">Cash Flow Statement</span></span><span>Operating or financing activities outflow, per policy</span></div>
          <div class="tr cols-16-1-14"><span>Terms, option pricing inputs, movement reconciliation</span><span><span class="badge bp">Notes</span></span><span>Mandatory disclosure</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards — Cross-Reference Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">How IFRS 2 connects across the IFRS body of literature</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Nature of the connection</span></div>
          <div class="tr cols-08-2"><span>IAS 32</span><span>Supplies the compound instrument split-accounting logic used for choice-of-settlement arrangements where the counterparty controls settlement</span></div>
          <div class="tr alt cols-08-2"><span>IFRS 3</span><span>Share-based payment awards issued as part of business combination consideration follow IFRS 3's own specific rules rather than IFRS 2's general model</span></div>
          <div class="tr cols-08-2"><span>IAS 33</span><span>Employee share options are potential ordinary shares, tested for dilution via the treasury stock method in diluted EPS</span></div>
          <div class="tr alt cols-08-2"><span>IAS 24</span><span>Share-based payment awards to key management personnel must be disclosed as part of KMP compensation, by category</span></div>
          <div class="tr cols-08-2"><span>IAS 12</span><span>Tax deductions for share-based payment often differ from the accounting expense, creating temporary differences and deferred tax consequences</span></div>
          <div class="tr alt cols-08-2"><span>IFRS 13</span><span>Supplies general fair value measurement concepts underlying option pricing model inputs, where relevant</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<Glossary entries={[
      { term: "Market condition", definition: "A condition related to the market price of the entity's equity instruments (e.g. achieving a specified share price) — built into grant date fair value, never re-estimated." },
      { term: "Non-market performance condition", definition: "A condition related to something OTHER than a market price (e.g. a profit or sales target) — affects the NUMBER of instruments expected to vest, re-estimated each period." },
      { term: "Intrinsic value", definition: "The difference between the fair value of shares a counterparty has the right to subscribe for (or receive) and the price it must pay for those shares." },
      { term: "Share appreciation right (SAR)", definition: "A cash-settled instrument entitling the holder to a cash payment based on the increase in the entity's share price over a specified period." },
      { term: "Expected term / expected life", definition: "The expected period an option/SAR is expected to be outstanding before exercise, a key input to the option pricing model used to determine fair value." },
      { term: "Grant date fair value", definition: "The fair value of an equity instrument at the grant date, fixed for equity-settled transactions and never remeasured." }
    ]} />

