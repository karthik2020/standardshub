import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc470.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "s1",
          label: "Conceptual Framework Linkage",
        },
        {
          id: "s2",
          label: "Scope & Applicability",
        },
        {
          id: "s3",
          label: "Initial Measurement",
        },
        {
          id: "s4",
          label: "Debt Issuance Costs — Netted Against the Liability (ASU 2015-03)",
        },
        {
          id: "s5",
          label: "Current vs Noncurrent Classification — Covenant Violations",
        },
        {
          id: "s6",
          label: "Extinguishment vs Modification — the Quantitative 10% Test",
        },
        {
          id: "s7",
          label: "Debt With Conversion Features — the ASU 2020-06 Simplification",
        },
        {
          id: "s8",
          label: "Troubled Debt Restructurings by Debtors (470-60)",
        },
        {
          id: "s9",
          label: "Worked Example — Debt Issuance Cost Presentation",
        },
        {
          id: "s10",
          label: "Worked Example — the 10% Extinguishment/Modification Test",
        },
        {
          id: "s11",
          label: "Worked Example — Current/Noncurrent Classification With a Covenant Violation",
        },
        {
          id: "s12",
          label: "Disclosure Requirements",
        },
        {
          id: "s13",
          label: "Critical Judgments & Estimates",
        },
        {
          id: "s14",
          label: "ASC 470 vs IFRS 9/IAS 32 — Comprehensive Comparison",
        },
        {
          id: "s15",
          label: "Statement Mapping",
        },
        {
          id: "s16",
          label: "Related Topics",
        },
        {
          id: "s17",
          label: "Glossary",
        },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci"><div class="ctitle ci">A present obligation to repay borrowed resources</div><div class="principle">Debt represents a straightforward present obligation to repay borrowed resources, typically with interest — but the accounting complexity in ASC 470 arises almost entirely from EDGE CASES: covenant violations affecting classification, terms that change mid-life (modification vs extinguishment), and instruments carrying conversion or other equity-linked features.</div></div>
      <div class="card cs"><div class="ctitle cs">A mixed picture — some genuine convergence, some real divergence</div><div class="principle">ASC 470 and IFRS 9/IAS 32 are CLOSELY converged on core initial measurement and the extinguishment/modification test, but diverge MEANINGFULLY on convertible debt bifurcation (Section 7, WIDENED by a 2020 US simplification) and on covenant-violation classification timing (Section 5, recently sharpened on the IFRS side too).</div></div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Debt instruments broadly</div><div class="principle">ASC 470 applies to notes, bonds, and other debt instruments issued by an entity, addressing initial measurement, presentation, classification, subsequent modification/extinguishment, and instruments carrying conversion or other embedded features.</div></div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Initial Measurement</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">Proceeds received, net of discount/premium — converged with IFRS 9</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">Debt is initially measured at the PROCEEDS received, adjusted for any discount or premium relative to face value, with the discount/premium subsequently AMORTISED using the EFFECTIVE INTEREST METHOD over the debt's term — the SAME fundamental amortised cost approach IFRS 9 applies to financial liabilities.</div></div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Debt Issuance Costs — Netted Against the Liability (ASU 2015-03)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">A 2015 change that moved US GAAP closer to IFRS</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">ASU 2015-03 changed debt issuance cost presentation: such costs are now presented as a DIRECT DEDUCTION from the carrying amount of the related debt liability (reducing the debt balance), rather than as a SEPARATE deferred asset (the older US practice). This change brought US GAAP into closer alignment with how IFRS 9 has always treated transaction costs — netted directly against the liability and folded into the EFFECTIVE INTEREST RATE calculation.</div></div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Current vs Noncurrent Classification — Covenant Violations</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">A live, actively evolving comparison point</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">If a debt covenant VIOLATION at the balance sheet date gives the lender the RIGHT to demand immediate repayment, the debt is classified as CURRENT — UNLESS the lender has WAIVED that right for a period of MORE than one year from the balance sheet date, or the entity obtains a waiver before the financial statements are ISSUED (a subsequent-event consideration US GAAP has historically permitted to affect classification). <strong>IAS 1</strong> was AMENDED (the "Non-current Liabilities with Covenants" amendments, effective January 2024) to CLARIFY that classification depends SOLELY on rights existing AT the reporting date — a covenant breach with a waiver obtained AFTER the reporting date but BEFORE issuance does NOT retroactively change the classification under the amended IAS 1, a STRICTER position than the more flexible pre-issuance-waiver consideration still generally available under US GAAP.</div></div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Extinguishment vs Modification — the Quantitative 10% Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">A precisely quantified threshold, broadly converged with IFRS</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">When debt terms are changed with the SAME lender, ASC 470-50 requires comparing the PRESENT VALUE of cash flows under the NEW terms (including any fees paid to the lender) to the present value of the REMAINING cash flows under the OLD terms. If the difference is <strong>10% OR MORE</strong>, the change is treated as an EXTINGUISHMENT (old debt derecognised, gain/loss recognised, new debt recorded at fair value); if LESS than 10%, it is a MODIFICATION (no gain/loss recognised; a new effective yield is established prospectively). IFRS 9 applies an ANALOGOUS "substantially different terms" test, ALSO commonly benchmarked against a similar 10% quantitative threshold in practice — one of the more closely CONVERGED specific mechanics in debt accounting, though some nuances differ (e.g. how fees paid to third parties versus the SAME lender are treated).</div></div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Debt With Conversion Features — the ASU 2020-06 Simplification</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">A divergence that WIDENED, not narrowed, after 2020</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">Before ASU 2020-06, US GAAP required SEPARATING certain convertible debt into liability and equity components under specific models (the "beneficial conversion feature" and "cash conversion" models). <strong>ASU 2020-06 ELIMINATED most of this separate accounting</strong> — MOST convertible debt is now accounted for as a SINGLE liability instrument in its entirety (unless a derivative must be bifurcated under ASC 815, or a narrow "substantial premium" model applies). <strong>IAS 32, by contrast, still generally REQUIRES SPLITTING</strong> a compound convertible instrument into SEPARATE liability and equity components at issuance, using a residual-value approach (measuring the liability component first, then allocating the residual to equity). This means the 2020 US simplification actually WIDENED, rather than narrowed, the gap between the two frameworks for convertible debt specifically — a notable, somewhat counterintuitive divergence trend worth remembering.</div></div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Troubled Debt Restructurings by Debtors (470-60)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">A named, separate category not present under IFRS</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">Debtor-side troubled debt restructuring (TDR) accounting continues to apply its OWN specific gain recognition test: if TOTAL future cash payments under the restructured terms are LESS than the original carrying amount, a GAIN is recognised for the difference; otherwise, NO gain is recognised, and the effective interest rate is simply adjusted PROSPECTIVELY. IFRS handles the SAME underlying fact pattern using the same general modification/extinguishment 10% test described in Section 6, WITHOUT a distinctly separate, specially-named "troubled debt restructuring" category — another example of the Codification formalising a dedicated Topic where IFRS applies its general principles instead.</div></div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Debt Issuance Cost Presentation</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Netting costs against the debt balance</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A bond issuance with underwriting fees</div><div class="wk-body">An entity issues $20,000,000 face value of bonds, incurring $300,000 of debt issuance costs (underwriting and legal fees).</div><div class="wk-answer">The bonds are presented on the Balance Sheet at $20,000,000 LESS $300,000 = <strong>$19,700,000</strong> — the issuance costs are NOT recorded as a separate deferred asset, but netted DIRECTLY against the debt balance, with the $300,000 amortised into interest expense over the bond's term via the effective interest method.</div></div>
    </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example — the 10% Extinguishment/Modification Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Determining whether a debt renegotiation is an extinguishment</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Renegotiating terms with the existing lender</div><div class="wk-body">An entity's debt has a present value of remaining cash flows under the OLD terms of $9,000,000. The lender agrees to NEW terms (a lower rate, extended maturity) with a present value, using the ORIGINAL effective rate, of $10,200,000 (including a $50,000 fee paid to the lender).</div><div class="wk-answer">Difference = ($10,200,000 − $9,000,000) ÷ $9,000,000 = 13.3% — EXCEEDING the 10% threshold. The change is treated as an <strong>EXTINGUISHMENT</strong>: the old debt is derecognised, any gain/loss is recognised immediately, and the new debt is recorded at its fair value (here, effectively $10,200,000, adjusted for the fee treatment) as a fresh debt instrument.</div></div>
    </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>Worked Example — Current/Noncurrent Classification With a Covenant Violation</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">A waiver obtained before issuance</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A covenant breach resolved before the financial statements are issued</div><div class="wk-body">At year end, an entity is in violation of a debt covenant, giving the lender the right to demand immediate repayment of $6,000,000 of otherwise long-term debt. Before the financial statements are ISSUED, the entity obtains a waiver from the lender extending relief for more than one year.</div><div class="wk-answer"><strong>Under US GAAP:</strong> the $6,000,000 may be classified as NONCURRENT, since the waiver — obtained before issuance — is considered in determining classification.<br><strong>Under the AMENDED IAS 1 (effective 2024):</strong> classification depends SOLELY on the entity's rights AT the reporting date — since the covenant WAS breached at year end (before the waiver was obtained), the debt would be classified as <strong>CURRENT</strong>, regardless of the subsequent waiver — a genuinely different classification outcome for identical underlying facts.</div></div>
    </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">What ASC 470 requires</div><div class="check-list"><span>Terms, interest rates, and maturities of significant debt obligations, and aggregate maturities for each of the next five years</span><span>Nature of covenants, and any violations existing at the reporting date</span><span>Gains/losses recognised upon debt extinguishment</span><span>Terms of convertible debt, including conversion ratios and triggering events</span></div></div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether a debt modification crosses the 10% quantitative extinguishment threshold</span><span>Whether a waiver obtained before issuance is sufficient to affect current/noncurrent classification</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Fair value of new debt terms in an extinguishment</span><span>Effective interest rate calculations incorporating issuance costs and any discount/premium</span></div></div></div>
    </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>ASC 470 vs IFRS 9/IAS 32 — Comprehensive Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Comparison — ASC 470 vs IFRS 9 and IAS 32</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">US GAAP (ASC 470)</span><span style="color:var(--color-text-info);">IFRS (IFRS 9 / IAS 32)</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Initial measurement / issuance costs</span><span>Amortised cost, costs netted against the liability</span><span>Same approach — closely converged since ASU 2015-03</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Extinguishment vs modification test</span><span>Quantitative 10% present value test</span><span>Analogous "substantially different" test, also commonly benchmarked at 10%</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Convertible debt bifurcation</span><span>MOSTLY eliminated post-ASU 2020-06 — single liability instrument in most cases</span><span>STILL generally required — split into liability and equity components</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Covenant violation classification</span><span>Pre-issuance waivers can support noncurrent classification</span><span>Post-2024 IAS 1 amendment: classification fixed at the reporting date only, regardless of a later waiver</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Troubled debt restructuring (debtor side)</span><span>A specifically named category with its own gain test</span><span>Addressed through general modification/extinguishment principles</span></div>
    </div>
    <div class="note">Convertible debt bifurcation and covenant-violation classification are the two most consequential, and most recently ACTIVE, divergence points — both have moved in the past several years (2020 US simplification; 2024 IFRS clarification), making this an area worth checking for further developments.</div>
    </div>
    </div>

    <div class="section-header" id="s15"><span class="num">15</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Where every ASC 470 event lands</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
      <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Debt issuance</span><span><span class="badge bs">BS</span></span><span>Recognised net of issuance costs</span></div>
      <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Extinguishment gain/loss</span><span><span class="badge bs">BS</span> <span class="badge bp">IS</span></span><span>Recognised immediately when the 10% threshold is crossed</span></div>
      <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Modification (below 10%)</span><span><span class="badge bs">BS</span></span><span>No gain/loss; new effective yield prospectively</span></div>
      <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Covenant violation reclassification</span><span><span class="badge bs">BS</span></span><span>May shift debt from noncurrent to current</span></div>
    </div>
    </div>
    </div>

    <div class="section-header" id="s16"><span class="num">16</span><h2>Related Topics</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
      <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 405</span><span>Supplies the general extinguishment principle (legal release) this Topic's detailed quantitative test builds on</span></div>
      <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASC 480</span><span>Governs whether an instrument with conversion or redemption features is even classified as debt versus equity in the first place</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 815</span><span>Governs bifurcation of embedded derivatives that may still apply to convertible debt after ASU 2020-06</span></div>
    </div>
    </div>
    <div class="card cn"><div class="ctitle cn">Quick-reference glossary preview</div>
    <div class="glossary-item"><div class="glossary-term">10% test</div><div class="glossary-def">The quantitative present-value comparison determining whether a debt modification is treated as an extinguishment or a modification.</div></div>
    <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Beneficial conversion feature (historical)</div><div class="glossary-def">A pre-ASU 2020-06 model requiring separate equity recognition for an in-the-money conversion feature at issuance, largely eliminated for most convertible debt today.</div></div>
    </div>
    </div>

    <div class="section-header" id="s17"><span class="num">17</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
      <div class="glossary-item"><div class="glossary-term">Troubled debt restructuring (debtor side)</div><div class="glossary-def">A debt restructuring granting a concession to a debtor experiencing financial difficulty, governed by ASC 470-60's own gain recognition test.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Debt issuance costs</div><div class="glossary-def">Costs directly incurred in issuing debt (underwriting, legal, registration fees), presented as a direct deduction from the debt's carrying amount.</div></div>
    </div>
    </div>

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.asc470} />
  </section>
</StandardPageLayout>
