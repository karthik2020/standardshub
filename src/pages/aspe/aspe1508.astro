---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe1508.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — Estimates Made at the Balance Sheet Date" },
        { id: "s3", label: "The Two-Condition Disclosure Test" },
        { id: "s4", label: "Condition One — Reasonably Possible Change Within the Near Term" },
        { id: "s5", label: "Condition Two — A Material Effect" },
        { id: "s6", label: "What \"Near Term\" Generally Means" },
        { id: "s7", label: "Common Sources of Measurement Uncertainty" },
        { id: "s8", label: "A Dedicated Standard — Unlike IAS 1's Embedded Treatment" },
        { id: "s9", label: "Worked Example — Disclosing Uncertainty in a Warranty Provision" },
        { id: "s10", label: "Worked Example — an Estimate That Does Not Meet the Disclosure Threshold" },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments &amp; Estimates" },
        { id: "s13", label: "Relationship to IAS 1's Sources of Estimation Uncertainty" },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Standards" },
        { id: "s16", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Flagging estimates genuinely at risk of near-term material change</div><div class="principle">ASPE Section 1508 REQUIRES disclosure OF measurement UNCERTAINTY that EXISTS in the PREPARATION of FINANCIAL statements — SPECIFICALLY, WHERE it IS reasonably POSSIBLE that an ESTIMATE will CHANGE within the NEAR term, and the EFFECT of that CHANGE would BE material. THIS Section GIVES the TOPIC its OWN dedicated, STANDALONE treatment — a GENUINELY distinctive STRUCTURAL choice RELATIVE to IFRS, WHICH addresses SIMILAR ground WITHIN IAS 1'S broader PRESENTATION requirements RATHER than as a SEPARATE standard (Section 8).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — Estimates Made at the Balance Sheet Date</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Any recognized amount involving significant estimation</div><div class="principle">This Section applies to ANY recognized AMOUNT within the FINANCIAL statements THAT required a SIGNIFICANT estimate AS of the BALANCE sheet date — COVERING the VALUATION of CERTAIN assets and LIABILITIES that DEPEND on matters GENUINELY uncertain AT that date.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>The Two-Condition Disclosure Test</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Both conditions must be met together</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.5fr 2.5fr;"><span>Condition</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:0.5fr 2.5fr;"><span>1</span><span>It IS reasonably POSSIBLE that the ESTIMATE could CHANGE by a MATERIAL amount WITHIN the NEAR term</span></div>
<div class="tr alt" style="grid-template-columns:0.5fr 2.5fr;"><span>2</span><span>The EFFECT of that CHANGE, IF it OCCURS, would BE material to the FINANCIAL statements</span></div>
</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Condition One — Reasonably Possible Change Within the Near Term</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">A meaningful likelihood, not a remote possibility</div><div class="text-supporting">"REASONABLY possible" SITS between REMOTE and PROBABLE — a GENUINE, MEANINGFUL likelihood that NEW information OR events COULD cause the ESTIMATE to CHANGE, RATHER than a MERELY theoretical possibility.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Condition Two — A Material Effect</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">The change itself must matter to users</div><div class="text-supporting">EVEN WHERE an ESTIMATE is GENUINELY uncertain, DISCLOSURE is REQUIRED only IF the POTENTIAL change WOULD be MATERIAL — a HIGHLY uncertain but IMMATERIAL estimate DOES NOT trigger THIS Section'S disclosure REQUIREMENT.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>What "Near Term" Generally Means</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Typically interpreted as within one year</div><div class="text-supporting">"NEAR term" is GENERALLY interpreted as WITHIN one YEAR of the BALANCE sheet date — FOCUSING disclosure ON estimates GENUINELY at RISK of near-TERM revision, RATHER than SPECULATIVE, longer-HORIZON uncertainty that IS inherent in VIRTUALLY every long-TERM estimate an ENTERPRISE makes.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Common Sources of Measurement Uncertainty</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Recurring categories across private enterprise financial statements</div><div class="dot-list"><span>Net realizable value of inventory</span><span>Useful lives of long-lived assets, underlying depreciation/amortization estimates</span><span>Contingent liability provisions, including litigation and warranty provisions</span><span>Allowance for doubtful accounts</span><span>Impairment assessments for goodwill and long-lived assets</span></div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>A Dedicated Standard — Unlike IAS 1's Embedded Treatment</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A structural choice giving the topic its own standalone visibility</div><div class="text-supporting">INTERNATIONALLY, IAS 1 addresses "SOURCES of ESTIMATION uncertainty" WITHIN its OWN broader PRESENTATION requirements, RATHER than AS a SEPARATE standard. ASPE, BY contrast, gives THIS topic ITS OWN dedicated SECTION — a STRUCTURAL choice that ELEVATES measurement UNCERTAINTY disclosure to a STANDALONE, explicitly-NAMED requirement, RATHER than ONE requirement AMONG many WITHIN a BROADER presentation STANDARD.</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Disclosing Uncertainty in a Warranty Provision</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Both conditions genuinely met</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A warranty provision with genuine near-term revision risk</div><div class="wk-body">A private manufacturer recognizes a $900,000 warranty provision, based on historical claims data. A newly identified product defect, still under investigation, could reasonably increase this estimate by $400,000 within the next several months — a material amount relative to the company's overall financial statements.</div><div class="wk-answer">BOTH conditions ARE met (a REASONABLY possible NEAR-term change; a MATERIAL potential EFFECT), so the COMPANY discloses the NATURE of the UNCERTAINTY and, WHERE reasonably DETERMINABLE, the POTENTIAL $400,000 EFFECT on the FINANCIAL statements.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example — an Estimate That Does Not Meet the Disclosure Threshold</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Uncertainty exists, but the disclosure threshold is not met</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A routine, well-established estimate</div><div class="wk-body">The same company also estimates a $50,000 allowance for doubtful accounts, based on a stable, well-established historical collection pattern with no indication of near-term change.</div><div class="wk-answer">DESPITE involving AN estimate, THIS balance does NOT meet THIS Section'S disclosure THRESHOLD — THERE is NO reasonably POSSIBLE near-TERM material CHANGE indicated, SO no SPECIFIC measurement uncertainty DISCLOSURE is REQUIRED for this ITEM.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 1508 requires</div><div class="check-list"><span>Nature of the uncertainty affecting the estimate</span><span>The amount of the potential effect on the financial statements, if reasonably determinable</span><span>A statement that determination of the effect is not practicable, where a reliable estimate of the potential effect cannot be made</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether a change in an estimate is genuinely "reasonably possible" within the near term</span><span>Whether the potential effect of a possible change would be material</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Quantifying the potential range of a material near-term estimate revision, where reasonably determinable</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IAS 1's Sources of Estimation Uncertainty</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASPE Section 1508 vs IAS 1</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 1508</span><span style="color:var(--color-text-info);">IAS 1</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Standalone standard</span><span>YES — its own dedicated Section</span><span>NO — embedded within IAS 1's broader disclosure requirements</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Core disclosure principle</span><span>Near-term, material potential change</span><span>Similar — risk of material adjustment within the next financial year</span></div>
</div>
<div class="note">SUBSTANTIVELY similar in SPIRIT, but ASPE'S choice to GIVE this its OWN standalone SECTION reflects a GENERALLY more GRANULAR, topic-by-TOPIC organizational STYLE relative to IFRS'S more CONSOLIDATED presentation standards.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where this Section's requirements apply</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Concept</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Measurement uncertainty disclosures</span><span>Notes only</span><span>No effect on primary financial statement figures</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 1000</span><span>Financial Statement Concepts — supplies the reliability and conservatism concepts underlying this Section's approach to estimation uncertainty</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 3290</span><span>Contingencies — a common source of the measurement uncertainty this Section requires disclosure of</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Measurement uncertainty</div><div class="glossary-def">Uncertainty in a recognized financial statement amount, arising from the estimation involved in its measurement.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Near term</div><div class="glossary-def">The period, generally interpreted as within one year of the balance sheet date, within which an estimate could reasonably change.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  <section id="history">
    <HistoryTimeline items={history.aspe1508 || []} />
  </section>
</StandardPageLayout>
