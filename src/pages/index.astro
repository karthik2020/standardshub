---
import StandardLayout from "../layouts/StandardLayout.astro";
import standards from "../data/standards.json";
---

<StandardLayout code="Home" framework="home">

  <section class="hero">

    <h1>StandardsHub</h1>

    <p>
      Accounting Standards Reference Library
    </p>

    <p class="hero-subtitle">
      Browse IAS, IFRS and Ind AS standards, accounting guidance,
      financial reporting requirements and reference materials.
    </p>

  </section>

  <div class="home-grid">

    <a href="/ias" class="home-card card-ias">
      <h2>IAS</h2>
      <p>{standards.IAS.length} Standards</p>
    </a>

    <a href="/ifrs" class="home-card card-ifrs">
      <h2>IFRS</h2>
      <p>{standards.IFRS.length} Standards</p>
    </a>

    <a href="/indas" class="home-card card-indas">
      <h2>Ind AS</h2>
      <p>{standards.IndAS.length} Standards</p>
    </a>

  </div>

</StandardLayout>


