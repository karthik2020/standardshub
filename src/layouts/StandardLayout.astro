---
import "../styles/site.css";
import "../styles/print.css";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  code: string;
  title: string;
  framework?: string;
  noindex?: boolean;
  hideFramework?: boolean;
}

const {
  code,

  title,

  framework = "",
  noindex = false,
  hideFramework = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title} | StandardsHub</title>
  </head>

  <body>
    <div class="app-shell">
      {hideFramework ? (
        <header class="site-header">
          <div class="header-left">
            <a href="/" class="site-logo">
              <span class="logo-mark"></span>
              <span class="logo-text"> StandardsHub </span>
            </a>
            <nav class="header-breadcrumbs">
              <a href="/" class="crumb breadcrumb-home">
                <span>Home</span>
              </a>
              <span class="breadcrumb-separator">❯</span>
              <span class="breadcrumb-current">
                <span class="breadcrumb-title">{title}</span>
              </span>
            </nav>
          </div>
          <div class="header-right">
            <button class="toolbar-btn" id="printBtn" title="Print"> 🖨 </button>
          </div>
        </header>
      ) : (
        <Header code={code} title={title} framework={framework} />
      )}

      <div class="app-body" data-framework={framework.toLowerCase().replace(/\s+/g, "")}>
        <Sidebar />

        <main class="content">
          <div class="page-body">
            <div class="reading-column">
              <div class="page-content">
                <slot />
              </div>
            </div>

            <aside class="page-toc">
              <slot name="toc" />
            </aside>

            <Footer />
          </div>
        </main>
      </div>
    </div>

    <script is:inline src="/js/sidebar.js"></script>
    <script is:inline src="/js/toc.js"></script>
    <script is:inline src="/js/search.js"></script>
  </body>
</html>
