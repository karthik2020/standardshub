  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Two Categories of Business Combination" },
        { id: "s3", label: "3. The Acquisition Method — Combinations Not Under Common Control" },
        { id: "s4", label: "4. Measuring and Recognising Goodwill" },
        { id: "s5", label: "5. Goodwill — Impairment-Only, Genuinely Aligned With IFRS 3" },
