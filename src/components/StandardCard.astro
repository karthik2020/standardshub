---
/**
 * StandardCard
 *
 * Reusable card component for framework landing pages.
 *
 * Props:
 * - href: string
 * - code: string (e.g. "IAS 16")
 * - title: string
 * - framework: "ias" | "ifrs" | "indas"
 * - status?: string (optional, e.g. "Superseded")
 */

import standards from "../data/standards.json";

interface Props {
  href: string;
  code: string;
  title: string;
  framework: "ias" | "ifrs" | "indas";
  status?: string;
}

const { href, code, title, framework, status: statusProp } = Astro.props;

const iconPath = `/images/standards/${framework}/${code.toLowerCase().replace(/\s+/g, "")}.svg`;
const fallbackPath = `/images/standards/${framework}/default.svg`;

const palette = [
  { bg: "#DBEAFE", color: "#2563EB" },
  { bg: "#DCFCE7", color: "#16A34A" },
  { bg: "#FFEDD5", color: "#EA580C" },
  { bg: "#F3E8FF", color: "#9333EA" },
  { bg: "#CCFBF1", color: "#0F766E" },
  { bg: "#FCE7F3", color: "#DB2777" },
];

function hashCode(str) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i);
    hash = hash & hash;
  }
  return Math.abs(hash);
}

const theme = palette[hashCode(code) % palette.length];

const frameworkKey = framework === "indas" ? "IndAS" : framework.toUpperCase();
const standardData = standards[frameworkKey]?.find((s) => s.code === code);
const resolvedStatus = statusProp ?? standardData?.status;
---

<a href={href} class="standard-card" style={`--icon-bg: ${theme.bg}; --icon-color: ${theme.color};`}>
  <div class="standard-top">
    <div class="standard-icon">
      <img
        src={iconPath}
        alt=""
        loading="lazy"
        onerror={`this.onerror=null;this.src='${fallbackPath}';`}
      />
    </div>

    <div class="standard-code">{code}</div>

    {resolvedStatus && resolvedStatus !== "Active" && (
      <div class={`standard-status standard-status--${resolvedStatus.toLowerCase()}`}>
        {resolvedStatus}
      </div>
    )}
  </div>

  <div class="standard-title">{title}</div>

  <div class="standard-arrow" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </div>
</a>
