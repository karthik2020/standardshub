---
import StandardLayout from "./StandardLayout.astro";
import InformationHeader from "../components/InformationHeader.astro";
import ReferenceGuide from "../components/ReferenceGuide.astro";
import PreviousNextNavigation from "../components/PreviousNextNavigation.astro";
import RelatedStandards from "../components/RelatedStandards.astro";
import BannerNotice from "../components/BannerNotice.astro";
import { getFramework } from "../data/frameworks";
import "../styles/posters/poster-classic.css";

interface Props {
  code: string;
  title: string;
  standardType?: string;
  issued?: string;
  latestAmendment?: string;
  status?: string;
  summary?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: string;
  bannerNotice?: {
    variant: "success" | "warning" | "danger" | "info";
    title: string;
    body: string;
    replacementStandard?: {
      code: string;
      title: string;
      href: string;
    };
  };
  related?: {
    code: string;
    title: string;
    url: string;
    relationship: string;
  }[];
}

const {
  code,
  title,
  standardType = "IAS",
  issued = "",
  latestAmendment = "",
  status = "",
  summary = "",
  description,
  canonical,
  robots,
  ogType,
  ogImage,
  twitterCard,
  bannerNotice,
  related = [],
} = Astro.props;

const frameworkConfig = getFramework(standardType) ?? getFramework("ias")!;

const seoTitle = `${code} ${title}`;
const standard = { code, title, dateModified: latestAmendment || undefined };
---

<StandardLayout
  code={code}
  title={title}
  seoTitle={seoTitle}
  framework={frameworkConfig.code}
  description={description}
  canonical={canonical}
  robots={robots}
  ogType={ogType}
  ogImage={ogImage}
  twitterCard={twitterCard}
  standard={standard}
>
  <Fragment slot="toc">
    <slot name="toc" />
  </Fragment>
  <InformationHeader
    code={code}
    title={title}
    summary={summary}
    issued={issued}
    latestAmendment={latestAmendment}
    status={status}
    framework={frameworkConfig.code}
  />
  {bannerNotice && (
    <div class="standard-banner-notice">
      <BannerNotice
        variant={bannerNotice.variant}
        title={bannerNotice.title}
        body={bannerNotice.body}
        replacementStandard={bannerNotice.replacementStandard}
      />
    </div>
  )}
  <ReferenceGuide>
    <slot />
  </ReferenceGuide>
  <RelatedStandards related={related} framework={frameworkConfig.code as "IAS" | "IFRS" | "Ind AS"} />
  <PreviousNextNavigation current={code} framework={frameworkConfig.code as "IAS" | "IFRS" | "Ind AS"} />
</StandardLayout>

<style>
  /*
    Spacing wrapper for the optional BannerNotice.
    Rendered only when banner metadata exists, so pages without a banner
    receive no extra element and no extra spacing. The bottom margin matches
    the Hero's own rhythm so the banner sits cleanly between Hero and content.
  */
  .standard-banner-notice {
    margin-bottom: var(--space-xl);
  }
</style>