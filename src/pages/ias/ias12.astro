---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ias/ias12.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "s1",
          label: "Conceptual Framework Linkage",
        },
        {
          id: "s2",
          label: "Scope & Applicability",
        },
        {
          id: "s3",
          label: "Current Tax",
        },
        {
          id: "s4",
          label: "Temporary Differences",
        },
        {
          id: "s5",
          label: "Deferred Tax Liabilities",
        },
        {
          id: "s6",
          label: "Deferred Tax Assets",
        },
        {
          id: "s7",
          label: "Measurement of Deferred Tax",
        },
        {
          id: "s8",
          label: "Recognition Outside Profit or Loss",
        },
        {
          id: "s9",
          label: "Disclosure Requirements",
        },
        {
          id: "s10",
          label: "Critical Judgments & Estimates",
        },
        {
          id: "s11",
          label: "IFRS vs US GAAP",
        },
        {
          id: "s12",
          label: "Statement Mapping",
        },
        {
          id: "s13",
          label: "Related Standards",
        },
        {
          id: "s14",
          label: "Glossary",
        },
        {
          id: "history",
          label: "History & Development",
        },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why deferred tax is a genuine Framework asset/liability</div>
        <div class="principle">Tax law and accounting standards frequently recognise income and expenses in DIFFERENT periods. IAS 12 exists to recognise the future tax consequences of these timing differences NOW, as genuine assets and liabilities under the Conceptual Framework – not merely as a reconciling disclosure item.</div>
        <div class="elabel">HOW DEFERRED TAX MAPS TO THE FRAMEWORK'S ELEMENTS</div>
        <div class="check-list">
          <span><strong style="font-weight:600">Deferred tax liability</strong> – a present obligation, arising from a past transaction, requiring an outflow of resources (higher future tax payments) – a genuine Framework liability</span>
          <span><strong style="font-weight:600">Deferred tax asset</strong> – a present economic resource controlled by the entity, from a past event, with the potential to reduce future tax payments – a genuine Framework asset</span>
          <span><strong style="font-weight:600">Past event</strong> – the transaction or event that created the temporary difference (e.g. purchasing an asset depreciated differently for tax and accounting purposes)</span>
        </div>
        <div class="note">IAS 12 uses the BALANCE SHEET (temporary difference) approach rather than the older income-statement (timing difference) approach – a deliberate alignment with the Framework's asset/liability-driven definition of income and expense.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Measurement principles applied by IAS 12</div>
        <div class="principle">Deferred tax is measured using tax rates and laws that have been ENACTED OR SUBSTANTIVELY ENACTED by the reporting date – reflecting the manner in which the entity expects to recover/settle the underlying asset/liability.</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Framework basis</span><span>Used by IAS 12 for…</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Undiscounted, expected settlement value</span><span>Both current and deferred tax – NO discounting to present value, unlike many other long-term liabilities</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Enacted/substantively enacted tax rates</span><span>The rate expected to apply when the asset is realised or liability settled</span></div>
        </div>
        <div class="callout info callout--chip" style="margin-bottom:0;"><strong style="font-weight:600">Qualitative characteristics in action:</strong> the strict prohibition on discounting deferred tax balances trades some theoretical <strong style="font-weight:600">relevance</strong> for greater <strong style="font-weight:600">verifiability and comparability</strong> – discounting would require highly subjective assumptions about the TIMING of reversal that IAS 12 deliberately avoids.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 12 covers</div>
        <div class="principle">IAS 12 prescribes the accounting treatment for income taxes – encompassing ALL domestic and foreign taxes based on taxable profits, including withholding taxes payable by a subsidiary/associate/joint venture on distributions to the reporting entity.</div>
        <div class="elabel">SCOPE INCLUDES</div>
        <div class="text-supporting">Current tax, deferred tax, and the tax consequences of dividends and other distributions.</div>
        <div class="callout warn callout--chip" style="margin-top:9px;margin-bottom:0;">IAS 12 does NOT address methods of accounting for government grants (IAS 20) or investment tax credits – though it DOES address the temporary differences that may arise FROM such grants or credits.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Tax base</div>
          <div class="glossary-def">The amount attributed to an asset or liability for TAX purposes – the amount that will be deductible for tax purposes against any future taxable economic benefits (assets), or the carrying amount less amounts deductible in future periods (liabilities).</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Temporary difference</div>
          <div class="glossary-def">The difference between the carrying amount of an asset/liability in the SOFP and its tax base – either a taxable temporary difference (leads to a deferred tax liability) or a deductible temporary difference (leads to a deferred tax asset).</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Current tax</div>
          <div class="glossary-def">The amount of income taxes payable (recoverable) in respect of the taxable profit (tax loss) for a period.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Taxable profit / tax loss</div>
          <div class="glossary-def">The profit (loss) for a period, determined in accordance with rules established by the TAXATION authorities, upon which income taxes are payable (recoverable).</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Current Tax</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Recognition &amp; measurement mechanics</div>
        <div class="formula-box formula-box--chip">
          <div class="f-eq">Current tax expense = Taxable profit × Applicable tax rate</div>
        </div>
        <div class="text-supporting" style="margin-bottom:9px;">Current tax for the current and prior periods is recognised as a LIABILITY to the extent unpaid. If the amount already paid exceeds the amount due, the excess is recognised as an ASSET.</div>
        <div class="elabel">MEASUREMENT</div>
        <div class="text-supporting">Measured at the amount expected to be paid to (recovered from) the tax authorities, using tax rates and laws enacted or substantively enacted by the reporting date.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Worked example – current tax computation</div>
        <div class="worked">
          <div class="wk-title">Example 1: Accounting profit to current tax liability</div>
          <div class="wk-body">
            Accounting profit before tax: $500,000. Depreciation charged: $80,000. Tax depreciation (capital allowances) claimed: $120,000. Entertainment expenses of $10,000 are non-deductible for tax. Tax rate: 25%.
          </div>
          <div class="wk-answer">
            Accounting profit: 500,000<br>
            + Depreciation added back: +80,000<br>
            − Tax depreciation deducted: −120,000<br>
            + Non-deductible entertainment: +10,000<br>
            = Taxable profit: 470,000<br>
            <strong>Current tax liability</strong> = 470,000 × 25% = <strong style="color:var(--color-text-info);">$117,500</strong>
          </div>
        </div>
        <div class="entry"><span class="dr">Dr</span><div class="etxt">Income tax expense $117,500<div class="badges"><span class="badge bp">SOPL</span></div></div></div>
        <div class="entry"><span class="cr">Cr</span><div class="etxt">Current tax liability $117,500<div class="badges"><span class="badge bs">SOFP</span></div></div></div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Temporary Differences – The Core Mechanic</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identifying temporary differences with a worked example</div>
        <div class="formula-box formula-box--chip">
          <div class="f-eq">Temporary difference = Carrying amount (accounting) − Tax base</div>
        </div>
        <div class="two-col">
          <div>
            <div class="elabel">TAXABLE TEMPORARY DIFFERENCE → DEFERRED TAX LIABILITY</div>
            <div class="text-supporting">Carrying amount > Tax base – e.g. an asset where tax depreciation has been claimed FASTER than accounting depreciation, so future taxable profit will be HIGHER when the asset is used/sold.</div>
          </div>
          <div>
            <div class="elabel">DEDUCTIBLE TEMPORARY DIFFERENCE → DEFERRED TAX ASSET</div>
            <div class="text-supporting">Carrying amount < Tax base – e.g. a provision recognised for accounting purposes but not yet tax-deductible until actually paid, so future taxable profit will be LOWER when the deduction is finally allowed.</div>
          </div>
        </div>
        <div class="worked" style="margin-top:8px;margin-bottom:0;">
          <div class="wk-title">Example 2: PPE temporary difference</div>
          <div class="wk-body">A machine cost $200,000. Accumulated accounting depreciation to date: $40,000 (carrying amount = $160,000). Accumulated tax depreciation to date: $70,000 (tax base = $130,000). Tax rate: 25%.</div>
          <div class="wk-answer">
            <strong>Temporary difference</strong> = 160,000 − 130,000 = <strong style="color:var(--color-text-info);">$30,000 taxable temporary difference</strong> (carrying amount exceeds tax base)<br>
            <strong>Deferred tax liability</strong> = 30,000 × 25% = <strong style="color:var(--color-text-danger);">$7,500</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Deferred Tax Liabilities – Recognition &amp; Exceptions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">General rule and the three recognition exceptions</div>
        <div class="text-supporting" style="margin-bottom:9px;">A deferred tax liability is recognised for ALL taxable temporary differences, EXCEPT to the extent it arises from:</div>
        <div class="cross-list">
          <span>The initial recognition of GOODWILL</span>
          <span>The initial recognition of an asset/liability in a transaction that is NOT a business combination, and at the time of the transaction affects NEITHER accounting profit NOR taxable profit (the "initial recognition exemption")</span>
          <span>Taxable temporary differences associated with investments in subsidiaries, branches, associates, and joint arrangements, WHERE the parent/investor/venturer is able to control the timing of reversal AND it is probable the difference will not reverse in the foreseeable future</span>
        </div>
      </div>

      <div class="card cn">
        <div class="ctitle cn">Worked example – revaluation surplus creates deferred tax</div>
        <div class="worked">
          <div class="wk-title">Example 3: Deferred tax on a PPE revaluation</div>
          <div class="wk-body">
            A building with a carrying amount of $400,000 (tax base also $400,000) is revalued upward to $550,000 under IAS 16's revaluation model. Tax rate: 25%.
          </div>
          <div class="wk-answer">
            <strong>New temporary difference</strong> = 550,000 − 400,000 = <strong style="color:var(--color-text-info);">$150,000</strong><br>
            <strong>Deferred tax liability</strong> = 150,000 × 25% = <strong style="color:var(--color-text-danger);">$37,500</strong>
          </div>
        </div>
        <div class="entry"><span class="dr">Dr</span><div class="etxt">Revaluation surplus $37,500<div class="badges"><span class="badge bo">OCI</span></div></div></div>
        <div class="entry"><span class="cr">Cr</span><div class="etxt">Deferred tax liability $37,500<div class="badges"><span class="badge bs">SOFP</span></div></div></div>
        <div class="note">This is the classic exam example of deferred tax NOT flowing through SOPL – it follows the revaluation surplus into OCI (Section 8).</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Deferred Tax Assets – Recognition &amp; the Probability Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">The recognition threshold</div>
        <div class="principle">A deferred tax asset is recognised for deductible temporary differences, unused tax LOSSES, and unused tax CREDITS, to the extent it is PROBABLE that future taxable profit will be available against which they can be utilised.</div>
        <div class="callout warn callout--chip" style="margin-bottom:0;"><strong style="font-weight:600">This is the single most heavily tested recognition rule in IAS 12</strong> – deferred tax assets are NOT recognised automatically like liabilities; a genuine probability assessment of future taxable profits is required at EVERY reporting date, and unrecognised deferred tax assets are reassessed at each reporting date too (they may become recognisable later).</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Worked example – unused tax losses</div>
        <div class="worked">
          <div class="wk-title">Example 4: Recognising a deferred tax asset on carried-forward losses</div>
          <div class="wk-body">
            An entity has accumulated tax losses of $200,000 carried forward, available to offset against future taxable profits with no expiry. Forecasts show the entity is expected to be reliably profitable going forward, generating sufficient taxable profit within the next 3 years to utilise the full loss. Tax rate: 25%.
          </div>
          <div class="wk-answer">
            Since future taxable profits are judged PROBABLE, the deferred tax asset is recognised:<br>
            <strong>Deferred tax asset</strong> = 200,000 × 25% = <strong style="color:var(--color-text-success);">$50,000</strong>
          </div>
        </div>
        <div class="note">If instead the entity had a history of recent losses with no convincing forecast of future profits, IAS 12 would require CONVINCING OTHER evidence before recognition – a stricter threshold than "probable" alone.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Measurement of Deferred Tax</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Rate and manner of recovery/settlement</div>
        <div class="dot-list">
          <span>Measured using tax rates EXPECTED to apply in the period the asset is realised or liability settled, based on rates ENACTED or SUBSTANTIVELY ENACTED by the reporting date</span>
          <span>Measurement reflects the tax consequences that follow from the MANNER in which the entity expects, at the reporting date, to recover or settle the carrying amount of the related asset/liability (e.g. use vs sale of an asset, if different rates apply)</span>
          <span>NOT discounted to present value, regardless of the expected timing of reversal</span>
        </div>
      </div>

      <div class="card cn">
        <div class="ctitle cn">Worked example – differing rates for use vs sale</div>
        <div class="worked">
          <div class="wk-title">Example 5: Manner of recovery affects the rate applied</div>
          <div class="wk-body">
            A jurisdiction taxes capital gains from asset SALES at 15%, but profits from ongoing USE of an asset at the standard 25% rate. An entity holds land with a $100,000 taxable temporary difference, and management intends to hold and use the land indefinitely rather than sell it.
          </div>
          <div class="wk-answer">
            Since the entity expects to recover the carrying amount through CONTINUING USE, the deferred tax liability is measured using the 25% rate, NOT the 15% capital gains rate – even though the asset (land) could theoretically be sold.<br>
            <strong>Deferred tax liability</strong> = 100,000 × 25% = <strong style="color:var(--color-text-danger);">$25,000</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Recognition Outside Profit or Loss</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">The matching principle – tax follows the item it relates to</div>
        <div class="principle">Current and deferred tax are recognised OUTSIDE profit or loss if the tax relates to items recognised outside profit or loss (either in OCI or directly in equity), in the SAME or a DIFFERENT period.</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.4fr 1fr;"><span>Item</span><span>Related tax recognised in…</span></div>
          <div class="tr" style="grid-template-columns:1.4fr 1fr;"><span>Revaluation surplus (IAS 16/38)</span><span><span class="badge bo">OCI</span></span></div>
          <div class="tr alt" style="grid-template-columns:1.4fr 1fr;"><span>Remeasurement of defined benefit plans (IAS 19)</span><span><span class="badge bo">OCI</span></span></div>
          <div class="tr" style="grid-template-columns:1.4fr 1fr;"><span>FVOCI financial assets (IFRS 9)</span><span><span class="badge bo">OCI</span></span></div>
          <div class="tr alt" style="grid-template-columns:1.4fr 1fr;"><span>Exchange differences on foreign operations (IAS 21)</span><span><span class="badge bo">OCI</span></span></div>
          <div class="tr" style="grid-template-columns:1.4fr 1fr;"><span>Transaction costs of an equity issue</span><span><span class="badge be">Equity</span> (direct)</span></div>
          <div class="tr alt" style="grid-template-columns:1.4fr 1fr;"><span>All other temporary differences (the vast majority)</span><span><span class="badge bp">SOPL</span></span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures</div>
        <div class="two-col">
          <div>
            <div class="elabel">MAJOR COMPONENTS OF TAX EXPENSE</div>
            <div class="check-list">
              <span>Current tax expense; adjustments recognised for current tax of prior periods</span>
              <span>Amount of deferred tax expense/income relating to the origination and reversal of temporary differences, and to changes in tax rates/imposition of new taxes</span>
              <span>Amount of any benefit from a previously unrecognised tax loss, credit, or temporary difference used to reduce current/deferred tax expense</span>
            </div>
          </div>
          <div>
            <div class="elabel">RECONCILIATION &amp; OTHER DISCLOSURES</div>
            <div class="check-list">
              <span>A numerical reconciliation between tax expense and accounting profit multiplied by the applicable tax rate, explaining the differences</span>
              <span>Aggregate current and deferred tax relating to items recognised directly in OCI or equity</span>
              <span>Amount (and expiry date, if any) of deductible temporary differences, unused tax losses, and unused tax credits for which no deferred tax asset is recognised</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether it is "probable" sufficient future taxable profit will be available to utilise deferred tax assets – perhaps the single most subjective judgement in the standard</span>
              <span>The expected manner of recovery of an asset (use vs sale), where different tax rates or bases apply</span>
              <span>Whether a taxable temporary difference on an investment in a subsidiary will reverse in the foreseeable future</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Forecasts of future taxable profits supporting deferred tax asset recognition</span>
              <span>The applicable future tax rate, where substantively enacted but not yet finally enacted legislation exists</span>
              <span>Uncertain tax positions (per IFRIC 23) – whether a tax treatment will be accepted by the tax authority</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip" style="margin-top:8px;margin-bottom:0;">Deferred tax asset recognition is one of the clearest areas where management OPTIMISM can materially inflate reported net assets – auditors and examiners alike scrutinise the quality and timeframe of profit forecasts used to support recognition.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRS vs US GAAP – Key Differences</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison – IAS 12 vs US GAAP (ASC 740)</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IFRS (IAS 12)</span><span style="color:var(--color-text-warning);">US GAAP</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Deferred tax asset recognition threshold</span><span>Recognise IF probable future taxable profit available (net presentation of the asset itself)</span><span>Recognise the FULL gross asset, then assess need for a VALUATION ALLOWANCE if not "more likely than not" to be realised – a two-step, gross-then-allowance approach</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Initial recognition exemption (goodwill)</span><span>Deferred tax NOT recognised on initial recognition of goodwill</span><span>Similarly excludes goodwill in most circumstances, though mechanics differ in detail</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Current/non-current classification</span><span>All deferred tax classified as NON-CURRENT (per IAS 1)</span><span>Also classified as non-current (aligned since ASU 2015-17)</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Uncertain tax positions</span><span>Governed by IFRIC 23 – expected value or most likely amount approach</span><span>Governed by ASC 740-10 (FIN 48) – a two-step recognition/measurement threshold ("more likely than not" to be sustained)</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Substantively enacted rates</span><span>Substantively enacted tax law/rates ARE used</span><span>Only ENACTED tax law/rates are used – substantively enacted is not sufficient</span></div>
        </div>
        <div class="note">The gross-asset-plus-valuation-allowance approach under US GAAP versus IFRS's net "probable" recognition threshold is the most conceptually significant difference – both aim at the same economic outcome but via different mechanics, which can affect presentation even when the net deferred tax asset figure is similar.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping – Where Every Tax Event Lands</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Current tax expense for the period</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Liability recognised for unpaid amount</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Deferred tax on ordinary taxable/deductible temporary differences</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>The vast majority of deferred tax movements</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Deferred tax on a revaluation surplus</span><span><span class="badge bo">OCI</span> <span class="badge bs">SOFP</span></span><span>Follows the related item (IAS 16/38) into OCI, not SOPL</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Deferred tax on remeasurements of defined benefit plans</span><span><span class="badge bo">OCI</span> <span class="badge bs">SOFP</span></span><span>Follows IAS 19 remeasurements into OCI</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Tax effect of share issue costs</span><span><span class="badge be">Equity</span> <span class="badge bs">SOFP</span></span><span>Recognised directly in equity, matching the original cost's treatment</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Change in tax rate – remeasurement of existing deferred tax balances</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Recognised in the period the change is enacted/substantively enacted (generally through SOPL unless the original balance was in OCI/equity)</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Recognition of previously unrecognised deferred tax asset</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Recognised when recovery becomes probable</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Cash tax paid</span><span><span class="badge bs">Cash Flow Statement</span></span><span>Operating activities outflow (IAS 7), unless specifically identifiable with investing/financing</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Movement in deferred tax balances (non-cash)</span><span><span class="badge bs">Cash Flow Statement</span></span><span>Added back/deducted as a non-cash adjustment within operating activities (indirect method)</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Tax rate reconciliation, unrecognised deferred tax assets</span><span><span class="badge bp">Notes</span></span><span>Mandatory disclosure regardless of jurisdiction</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards – Cross-Reference Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">How IAS 12 connects across the IFRS body of literature</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Nature of the connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 16 / IAS 38</span><span>Revaluations create temporary differences via the gap between carrying amount and tax base; related deferred tax follows the revaluation into OCI</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 19</span><span>Remeasurements of defined benefit plans create temporary differences whose deferred tax effect also flows through OCI</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 37</span><span>Provisions recognised for accounting but not yet tax-deductible are a classic source of deductible temporary differences (deferred tax assets)</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 3</span><span>Deferred tax on assets/liabilities acquired in a business combination is recognised as part of the acquisition accounting, EXCEPT for goodwill itself (initial recognition exemption)</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 21</span><span>Exchange differences on translating foreign operations create temporary differences whose deferred tax effect follows into OCI, consistent with the underlying translation reserve</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 8</span><span>Changes in tax rate/law are treated prospectively; retrospective restatements from error correction also require deferred tax recalculation</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 10</span><span>Tax rate changes enacted/substantively enacted AFTER year end but before authorisation are typically non-adjusting events, disclosed rather than reflected in year-end deferred tax balances</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IFRIC 23</span><span>Provides specific guidance on accounting for uncertainty over income tax treatments, supplementing IAS 12's general recognition and measurement principles</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 20</span><span>Government grants themselves are outside IAS 12's direct scope, but any temporary difference they create (e.g. a grant taxable on receipt but recognised as income later) falls within IAS 12</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<Glossary entries={[
      { term: "Accounting profit", definition: "Profit or loss for a period BEFORE deducting tax expense, as reported in the SOPL." },
      { term: "Tax expense (tax income)", definition: "The aggregate amount included in profit or loss for the period in respect of current and deferred tax." },
      { term: "Enacted / substantively enacted", definition: "Tax legislation that has completed (or virtually completed, per specific jurisdictional processes) the legislative process required for it to become law, used as the basis for measuring deferred tax." },
      { term: "Initial recognition exemption", definition: "The exception preventing deferred tax recognition on an asset/liability's first recognition, where the transaction is not a business combination and affects neither accounting nor taxable profit at the time." },
      { term: "Unused tax losses", definition: "Tax losses carried forward from prior periods, available to reduce future taxable profits, subject to jurisdiction-specific rules on expiry and offset restrictions." },
      { term: "Withholding tax", definition: "Tax payable by a subsidiary, associate, or joint venture on distributions to the reporting entity – explicitly within IAS 12's scope." }
    ]} />

<FinancialStatementKey />

