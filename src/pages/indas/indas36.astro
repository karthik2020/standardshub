---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas36.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Indicators of Impairment" },
        { id: "s4", label: "Recoverable Amount – Fair Value Less Costs vs Value in Use" },
        { id: "s5", label: "Cash-Generating Units (CGUs)" },
        { id: "s6", label: "Goodwill Impairment Testing" },
        { id: "s7", label: "Discount Rate Practice & CGU Determination – Indian Application Context" },
        { id: "s8", label: "Reversal of Impairment Losses" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 36 vs IAS 36 – Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical recoverable amount philosophy to IAS 36</div>
        <div class="principle">Ind AS 36 applies the IDENTICAL principle as IAS 36 – an asset's carrying amount should NOT exceed its RECOVERABLE AMOUNT (the higher of fair value less costs of disposal and value in use), with any excess recognised as an IMPAIRMENT LOSS.</div>
        <div class="elabel">HOW IND AS 36 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Prudence</strong> – ensuring assets are not carried at more than can genuinely be recovered – identical to IAS 36</span>
          <span><strong>Discount rate practice</strong> – for value-in-use calculations, Indian practice commonly BUILDS UP discount rates starting from Indian GOVERNMENT SECURITY (G-Sec) yields, given the ABSENCE of a deep, liquid high-quality corporate bond market – a practical application consideration, IDENTICAL in principle to IAS 36's own market-based discount rate requirement, but with a distinctly Indian starting benchmark</span>
        </div>
        <div class="note">Ind AS 36 introduced NO substantive change to the impairment framework relative to IAS 36 – its Indian relevance is most pronounced for discount rate BENCHMARK selection and CGU determination across LARGE, diversified conglomerate structures.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The core recoverable amount formula – identical to IAS 36</div>
        <div class="formula-box formula-box--chip"><div class="f-eq">Recoverable amount = HIGHER of (Fair value less costs of disposal, Value in use)</div></div>
        <div class="callout info callout--chip callout--flush">IDENTICAL formula to IAS 36 – impairment loss = carrying amount − recoverable amount, when carrying amount exceeds recoverable amount.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 36 covers</div>
        <div class="principle">Ind AS 36 applies to most non-financial assets, EXCLUDING inventories, contract assets (Ind AS 115), deferred tax assets, and financial assets within Ind AS 109's scope – IDENTICAL scope to IAS 36.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Value in use</div>
          <div class="glossary-def">IDENTICAL definition to IAS 36 – the present value of future cash flows expected from an asset/CGU.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Cash-generating unit (CGU)</div>
          <div class="glossary-def">IDENTICAL definition to IAS 36 – the smallest identifiable group of assets generating cash inflows largely independent of other assets.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 – INDICATORS ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Indicators of Impairment</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical external/internal indicators to IAS 36</div>
        <div class="text-supporting">External indicators (market value declines, adverse technology/market/economic changes) and internal indicators (obsolescence, worse-than-expected performance) – IDENTICAL to IAS 36, assessed at EACH reporting date.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – RECOVERABLE AMOUNT (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Recoverable Amount – Fair Value Less Costs vs Value in Use</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical to IAS 36</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Recoverable amount determination</div>
          <div class="wk-body">An Indian manufacturing CGU has a carrying amount of ₹80,00,00,000. Its fair value less costs of disposal is estimated at ₹65,00,00,000, while its value in use (discounted future cash flows) is estimated at ₹72,00,00,000.</div>
          <div class="wk-answer">Recoverable amount = HIGHER of ₹65,00,00,000 and ₹72,00,00,000 = ₹72,00,00,000. Since this is LESS than the ₹80,00,00,000 carrying amount, an impairment loss of ₹8,00,00,000 is recognised – an IDENTICAL calculation methodology to how IAS 36 would treat the same CGU globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 – CGUs ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Cash-Generating Units (CGUs)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 36</div>
        <div class="text-supporting">Where an individual asset's recoverable amount cannot be estimated (no largely independent cash inflows), impairment is tested at the CGU level – IDENTICAL to IAS 36, genuinely significant for Indian diversified conglomerates with multiple, interdependent business lines.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 – GOODWILL ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Goodwill Impairment Testing</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 36</div>
        <div class="text-supporting">Goodwill is tested for impairment ANNUALLY (regardless of indicators), allocated to the CGU(s) expected to benefit from the business combination synergies – IDENTICAL to IAS 36, with impairment losses on goodwill NEVER reversed.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 – DISCOUNT RATE / CGU INDIAN CONTEXT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Discount Rate Practice &amp; CGU Determination – Indian Application Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important practical Indian consideration</div>
        <div class="text-supporting">For value-in-use calculations, Indian valuation practice commonly starts from GOVERNMENT SECURITY (G-Sec) yields as the risk-free rate benchmark (given the absence of a deep, liquid high-quality corporate bond market comparable to some developed markets), building up a discount rate with appropriate equity/company-specific risk premiums – an application practice IDENTICAL in underlying principle to IAS 36's own market-based discount rate requirement, but with a distinctly Indian starting point. Separately, LARGE Indian diversified conglomerates (spanning multiple unrelated business lines) face GENUINELY significant CGU identification complexity, requiring careful analysis of cash inflow independence.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 – REVERSAL ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Reversal of Impairment Losses</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 36</div>
        <div class="text-supporting">Impairment losses on assets OTHER than goodwill may be REVERSED if indicators suggest recoverable amount has increased, capped at the carrying amount that would have existed (net of depreciation) had no impairment been recognised – IDENTICAL to IAS 36. Goodwill impairment is NEVER reversed, IDENTICAL prohibition to IAS 36.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 36</div>
        <div class="check-list">
          <span>Impairment losses/reversals recognised, by class of asset and segment</span>
          <span>Key assumptions used in recoverable amount estimation (discount rate, growth rate)</span>
          <span>Goodwill carrying amount by CGU, with sensitivity disclosures</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>CGU identification for diversified conglomerate structures</span>
              <span>Whether impairment indicators exist at each reporting date</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Discount rate selection and build-up methodology</span>
              <span>Future cash flow projections and terminal growth rate assumptions</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">Given the sensitivity of value-in-use calculations to discount rate assumptions, Indian auditors and regulators scrutinise the G-Sec-based build-up methodology closely, particularly for goodwill-heavy CGUs following acquisitions.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 – IND AS 36 vs IAS 36 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 36 vs IAS 36 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 36</span><span>Ind AS 36</span></div>
          <div class="tr cols-12-1-1"><span>Recoverable amount, CGU, goodwill testing framework</span><span>Standard model</span><span>IDENTICAL – no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Discount rate benchmark practice</span><span>Varies by market depth</span><span>Commonly built up from Indian G-Sec yields, given the absence of a deep corporate bond market</span></div>
        </div>
        <div class="note">Ind AS 36 is essentially IDENTICAL to IAS 36 in substance – its distinctive Indian relevance lies in DISCOUNT RATE benchmark practice and CGU complexity for large conglomerates, not any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Impairment loss recognised</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 36 (or OCI/revaluation reserve for revalued assets)</span></div>
          <div class="tr alt cols-16-1-14"><span>Reversal of impairment (non-goodwill)</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 36</span></div>
          <div class="tr cols-16-1-14"><span>Goodwill impairment</span><span><span class="badge bp">P&amp;L</span></span><span>Never reversed, identical to IAS 36</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 36</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 103</span><span>Generates the goodwill subsequently tested for impairment under Ind AS 36</span></div>
          <div class="tr cols-08-2"><span>Ind AS 113</span><span>Supplies fair value measurement principles used in fair value less costs of disposal calculations</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">G-Sec yield</div>
          <div class="glossary-def">Government of India security yield, commonly used as the risk-free rate starting point for Indian discount rate build-ups.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Value in use</div>
          <div class="glossary-def">The present value of future cash flows expected from an asset/CGU, identical to IAS 36.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "G-Sec yield", definition: "Government of India security yield, commonly used as the risk-free rate starting point for Indian discount rate build-ups." },
      { term: "Value in use", definition: "The present value of future cash flows expected from an asset/CGU, identical to IAS 36." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
