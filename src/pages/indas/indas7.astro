---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas7.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "The Three Classifications (with worked example)" },
        { id: "s4", label: "Direct vs Indirect Method" },
        { id: "s5", label: "Interest and Dividends" },
        { id: "s6", label: "Reconciliation of Financing Liabilities" },
        { id: "s7", label: "Indian Working Capital & NBFC Context" },
        { id: "s8", label: "Foreign Currency Cash Flows" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 7 vs IAS 7 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci"><div class="ctitle ci">Identical cash flow classification philosophy to IAS 7</div>
        <div class="principle">Ind AS 7 applies the IDENTICAL principle as IAS 7 — cash flows are classified into OPERATING, INVESTING, and FINANCING activities, providing users information to evaluate changes in net assets, financial structure, and the ability to affect amounts/timing of cash flows.</div>
        <div class="elabel">HOW IND AS 7 MAPS TO THE FRAMEWORK</div>
        <div class="check-list"><span><strong style="font-weight:500">Relevance</strong> — cash flow information complements accrual-based P&amp;L/balance sheet data — identical to IAS 7</span><span><strong style="font-weight:500">Comparability</strong> — the three-category classification enables consistent comparison across entities — identical to IAS 7</span></div>
        <div class="note">Ind AS 7 introduced NO substantive change to the classification model relative to IAS 7 — its Indian relevance is most pronounced for the RBI's own cash flow-adjacent regulatory reporting for banks/NBFCs, layered ALONGSIDE Ind AS 7's own requirements.</div>
      </div>
      <div class="card cs"><div class="ctitle cs">The three classifications — identical to IAS 7</div>
        <div class="td-table"><div class="th" style="grid-template-columns:1fr 1.6fr;"><span>Category</span><span>Nature</span></div>
          <div class="tr" style="grid-template-columns:1fr 1.6fr;"><span>Operating</span><span>Principal revenue-producing activities</span></div>
          <div class="tr alt" style="grid-template-columns:1fr 1.6fr;"><span>Investing</span><span>Acquisition/disposal of long-term assets and other investments</span></div>
          <div class="tr" style="grid-template-columns:1fr 1.6fr;"><span>Financing</span><span>Changes in size/composition of contributed equity and borrowings</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw"><div class="ctitle cw">What Ind AS 7 covers</div><div class="principle">Ind AS 7 requires ALL entities to present a statement of cash flows as an integral part of financial statements — IDENTICAL scope to IAS 7.</div></div>
      <div class="card cd"><div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Cash equivalents</div><div class="glossary-def">IDENTICAL definition to IAS 7 — short-term, highly liquid investments readily convertible to known amounts of cash, subject to insignificant risk of value change.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Working capital cycle</div><div class="glossary-def">The operating cash conversion cycle, particularly relevant for Indian manufacturing/trading companies' operating cash flow analysis.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — THE THREE CLASSIFICATIONS (worked example) ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Three Classifications (with worked example)</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Identical classification approach to IAS 7</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example 1: Classifying an Indian company's cash flows</div><div class="wk-body">An Indian manufacturing company pays ₹50,00,000 for a new factory machine, receives ₹2,00,00,000 from customer collections, and repays ₹75,00,000 of term loan principal to an Indian bank.</div><div class="wk-answer">
        Machine purchase: <strong style="color:var(--color-text-info);">INVESTING</strong> outflow<br>
        Customer collections: <strong style="color:var(--color-text-info);">OPERATING</strong> inflow<br>
        Loan principal repayment: <strong style="color:var(--color-text-info);">FINANCING</strong> outflow<br>
        An IDENTICAL classification methodology to how IAS 7 would categorise the same cash flows for a comparable global manufacturer.
      </div></div>
    </div></div>

    <!-- ============ SECTION 4 — DIRECT VS INDIRECT METHOD ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Direct vs Indirect Method</h2><span class="line"></span></div>
    <div class="grid"><div class="card cs span2"><div class="ctitle cs">Identical choice to IAS 7</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Operating cash flows may be presented using the DIRECT method (major classes of gross cash receipts/payments) or the INDIRECT method (adjusting profit/loss for non-cash items and working capital changes) — IDENTICAL choice to IAS 7, with the indirect method being the PREVALENT choice among Indian preparers, consistent with global practice.</div></div></div>

    <!-- ============ SECTION 5 — INTEREST AND DIVIDENDS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Interest and Dividends</h2><span class="line"></span></div>
    <div class="grid"><div class="card cd span2"><div class="ctitle cd">Identical flexible classification to IAS 7</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Interest and dividends received/paid may be classified as operating, investing, or financing, provided CONSISTENT classification is applied period to period — IDENTICAL to IAS 7, with the SAME common practice of classifying interest/dividends paid as financing and interest/dividends received as investing for non-financial entities.</div></div></div>

    <!-- ============ SECTION 6 — RECONCILIATION OF FINANCING LIABILITIES ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Reconciliation of Financing Liabilities</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Identical to IAS 7</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">A reconciliation between opening and closing balances of liabilities arising from FINANCING activities (including both cash and non-cash changes, e.g. foreign exchange, fair value changes) is required — IDENTICAL to IAS 7's own amendment requirement.</div></div></div>

    <!-- ============ SECTION 7 — INDIAN WORKING CAPITAL & NBFC CONTEXT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Indian Working Capital &amp; NBFC Context</h2><span class="line"></span></div>
    <div class="grid"><div class="card cw span2"><div class="ctitle cw">A practically prominent Indian application area</div>
      <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Indian companies often face LONGER working capital cycles (extended receivable/payable terms common in Indian B2B trade), making operating cash flow analysis under Ind AS 7 particularly significant for lenders and rating agencies (e.g. CRISIL, ICRA) assessing credit risk. For Indian NBFCs specifically, RBI's regulatory reporting also draws on cash flow information, operating ALONGSIDE (not replacing) Ind AS 7's own statement.</div>
    </div></div>

    <!-- ============ SECTION 8 — FOREIGN CURRENCY CASH FLOWS ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Foreign Currency Cash Flows</h2><span class="line"></span></div>
    <div class="grid"><div class="card cn span2"><div class="ctitle cn">Identical to IAS 7</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Foreign currency cash flows are translated using the exchange rate at the DATE of the cash flow (or a suitable weighted average rate) — IDENTICAL to IAS 7, with unrealised exchange differences on cash/cash equivalents presented separately, reconciling opening/closing cash balances.</div></div></div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid"><div class="card cd span2"><div class="ctitle cd">Identical disclosure requirements to IAS 7</div><div class="check-list"><span>Components of cash and cash equivalents</span><span>Reconciliation of financing activity liabilities</span><span>Significant non-cash investing/financing transactions</span></div></div></div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid"><div class="card cn span2"><div class="ctitle cn">Where management judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Classification of interest/dividends (operating vs investing/financing)</span><span>Determining what qualifies as a cash equivalent for short-term Indian money market instruments</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>None typically significant — Ind AS 7 is largely a presentational/reclassification standard</span></div></div></div>
      <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ Indian companies should ensure CONSISTENT classification of bank overdrafts (as cash equivalents vs financing activities) across reporting periods.</div>
    </div></div>

    <!-- ============ SECTION 11 — IND AS 7 vs IAS 7 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 7 vs IAS 7 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Comprehensive comparison table</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IAS 7</span><span style="color:var(--color-text-success);">Ind AS 7</span></div>
        <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Classification model, direct/indirect method choice</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
        <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Financing liabilities reconciliation</span><span>Required</span><span>IDENTICAL</span></div>
        <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Regulatory overlay for banks/NBFCs</span><span>Varies by jurisdiction</span><span>RBI's own regulatory reporting draws on cash flow data alongside Ind AS 7</span></div>
      </div>
      <div class="note">Ind AS 7 is essentially IDENTICAL to IAS 7 in substance — its distinctive Indian relevance lies in working capital cycle characteristics and RBI's parallel regulatory interest, not in any accounting divergence.</div>
    </div></div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid"><div class="card cs span2"><div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
        <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Customer collections</span><span><span class="badge bs">Cash Flow — Operating</span></span><span>Identical to IAS 7</span></div>
        <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Asset purchases</span><span><span class="badge bs">Cash Flow — Investing</span></span><span>Identical to IAS 7</span></div>
        <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Loan repayments, dividend payments</span><span><span class="badge bs">Cash Flow — Financing</span></span><span>Identical to IAS 7</span></div>
      </div>
    </div></div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
        <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 7</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 1</span><span>Requires the cash flow statement as part of the complete set of financial statements</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 21</span><span>Governs the foreign exchange translation rates applied to foreign currency cash flows</span></div>
        </div>
      </div>
      <div class="card cn"><div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Non-cash transaction</div><div class="glossary-def">A financing/investing transaction not involving cash/cash equivalents, disclosed separately rather than in the cash flow statement itself.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">CRISIL / ICRA</div><div class="glossary-def">Prominent Indian credit rating agencies that rely on operating cash flow analysis under Ind AS 7 for credit assessments.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Cash equivalents", definition: "Short-term, highly liquid investments readily convertible to known amounts of cash, subject to insignificant risk of value change — identical to IAS 7." },
      { term: "Working capital cycle", definition: "The operating cash conversion cycle, particularly relevant for Indian manufacturing/trading companies' operating cash flow analysis." },
      { term: "Non-cash transaction", definition: "A financing/investing transaction not involving cash/cash equivalents, disclosed separately rather than in the cash flow statement itself." },
      { term: "CRISIL / ICRA", definition: "Prominent Indian credit rating agencies that rely on operating cash flow analysis under Ind AS 7 for credit assessments." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
