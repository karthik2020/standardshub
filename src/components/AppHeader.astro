---
interface Props {
    breadcrumbs?: string[];
    updated?: string;
}

const { breadcrumbs = ["Home"], updated = "September 2025" } = Astro.props;
---

<header class="app-header">
    <!-- Top Bar -->
    <div class="header-main">
        <div class="header-brand">
            <a href="/">StandardsHub</a>
        </div>

        <div class="header-search">
            <input
                type="search"
                placeholder="Search standards..."
                aria-label="Search"
            />
        </div>

        <div class="header-actions">
            <button title="Decrease font size">A−</button>

            <button title="Increase font size">A+</button>

            <button title="Print page">🖨</button>

            <button title="Dark mode">☀</button>
        </div>
    </div>

    <!-- Context Bar -->
    <div class="header-context">
        <nav class="breadcrumbs">
            {
                breadcrumbs.map((item, index) => (
                    <>
                        <span>{item}</span>
                        {index < breadcrumbs.length - 1 && (
                            <span class="separator">›</span>
                        )}
                    </>
                ))
            }
        </nav>

        <div class="page-meta">
            Updated: {updated}
        </div>
    </div>
</header>
