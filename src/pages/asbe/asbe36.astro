---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/asbe/asbe36.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — Who Counts as a Related Party" },
        { id: "s3", label: "Control, Joint Control, and Significant Influence Relationships" },
        { id: "s4", label: "Key Management Personnel and Close Family Members" },
        { id: "s5", label: "THE GOVERNMENT-RELATED ENTITIES EXEMPTION — A Point of Genuine Alignment" },
        { id: "s6", label: "Why the Exemption Matters for China's State-Owned Enterprise Landscape" },
        { id: "s7", label: "Disclosure of Terms and Conditions" },
        { id: "s8", label: "Worked Example — Identifying a Related Party Under Common Control" },
        { id: "s9", label: "Worked Example — Applying the Government-Related Entities Exemption" },
        { id: "s10", label: "Disclosure Requirements" },
        { id: "s11", label: "Critical Judgments &amp; Estimates" },
        { id: "s12", label: "Relationship to IAS 24" },
        { id: "s13", label: "Statement Mapping" },
        { id: "s14", label: "Related Standards" },
        { id: "s15", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Transparency about relationships that could influence transaction terms</div><div class="principle">ASBE No. 36 governs the DISCLOSURE of RELATIONSHIPS, TRANSACTIONS, and OUTSTANDING balances BETWEEN an ENTERPRISE and its RELATED parties — ENSURING readers UNDERSTAND WHERE a REPORTED transaction MIGHT NOT have been CONDUCTED on PURELY arm's-LENGTH terms. THIS Standard is CLOSELY converged with IAS 24 internationally, INCLUDING a GENUINELY important EXEMPTION relevant to China'S OWN state-enterprise LANDSCAPE (Section 5).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — Who Counts as a Related Party</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A relationship-based, not simply transaction-based, definition</div><div class="principle">A RELATED party is a PERSON or ENTITY that is RELATED to the REPORTING enterprise THROUGH control, JOINT control, SIGNIFICANT influence, OR family/management RELATIONSHIPS — this Standard REQUIRES disclosure WHEREVER SUCH a relationship EXISTS, REGARDLESS of WHETHER any TRANSACTION has ACTUALLY occurred BETWEEN the parties.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Control, Joint Control, and Significant Influence Relationships</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">The core categories of related party</div>
<div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Relationship</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Parent, subsidiaries, fellow subsidiaries</span><span>ENTITIES within the SAME group STRUCTURE, sharing COMMON control</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Associates and joint ventures</span><span>ENTITIES over WHICH the reporting ENTERPRISE (or ITS group) has SIGNIFICANT influence or JOINT control</span></div>
</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Key Management Personnel and Close Family Members</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Individuals with authority and responsibility for planning and control</div><div class="text-supporting">KEY MANAGEMENT personnel — those WITH authority and RESPONSIBILITY for PLANNING, directing, and CONTROLLING the ENTERPRISE'S activities (e.g. DIRECTORS and SENIOR executives) — and THEIR close FAMILY members are TREATED as RELATED parties, GIVEN their POTENTIAL to INFLUENCE, or BE influenced by, the ENTERPRISE.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>THE GOVERNMENT-RELATED ENTITIES EXEMPTION — A Point of Genuine Alignment</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Reduced disclosure for entities under common government control</div><div class="text-supporting">CONSISTENT with IAS 24 (WHICH added an EQUIVALENT exemption IN 2009), ASBE No. 36 PROVIDES a REDUCED disclosure EXEMPTION for an ENTERPRISE that is a GOVERNMENT-related ENTITY, in RESPECT of TRANSACTIONS with OTHER entities that are ALSO government-RELATED, SOLELY BECAUSE both are UNDER common STATE control (RATHER than a SPECIFIC direct RELATIONSHIP between the TWO entities THEMSELVES). GENUINELY NOTABLY, THIS is a POINT of ALIGNMENT, RATHER than a DIVERGENCE — BOTH ASBE and IAS 24 RECOGNISE that TREATING every STATE-owned entity as AUTOMATICALLY related to EVERY other state-OWNED entity (MERELY due to COMMON government OWNERSHIP) would be BOTH impractical and of LIMITED analytical VALUE.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Why the Exemption Matters for China's State-Owned Enterprise Landscape</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A genuinely important practical relief</div><div class="text-supporting">GIVEN the SCALE of STATE ownership ACROSS the Chinese ECONOMY, WITHOUT this EXEMPTION, VIRTUALLY every TRANSACTION a state-OWNED enterprise UNDERTAKES with ANOTHER state-OWNED counterparty (a BANK, a SUPPLIER, a CUSTOMER) WOULD technically REQUIRE related-PARTY disclosure, PRODUCING an OVERWHELMING volume of DISCLOSURE with LIMITED genuine ANALYTICAL value for READERS. THE exemption ALLOWS such ENTITIES to disclose ONLY the NAME of the GOVERNMENT and the NATURE of its RELATIONSHIP, PLUS INFORMATION about INDIVIDUALLY significant TRANSACTIONS, RATHER than EXHAUSTIVE detail on EVERY government-RELATED counterparty.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Disclosure of Terms and Conditions</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Whether transactions were on arm's-length terms</div><div class="text-supporting">FOR related PARTY transactions REQUIRING disclosure, an ENTERPRISE discloses the NATURE of the RELATIONSHIP, the AMOUNT of the TRANSACTIONS, OUTSTANDING balances, and the TERMS and CONDITIONS (INCLUDING WHETHER they were CONDUCTED on TERMS EQUIVALENT to those PREVAILING in ARM'S-length transactions).</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — Identifying a Related Party Under Common Control</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Fellow subsidiaries within the same group</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Two subsidiaries of the same private parent</div><div class="wk-body">Company A and Company B are both wholly-owned subsidiaries of the same private parent company. During the year, Company A sells goods to Company B at a discounted price.</div><div class="wk-answer">COMPANY A and COMPANY B are RELATED parties (FELLOW subsidiaries UNDER common CONTROL) — the TRANSACTION REQUIRES disclosure of ITS nature, AMOUNT, and WHETHER the PRICING reflects ARM'S-length terms.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Applying the Government-Related Entities Exemption</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Reduced disclosure for a state-owned bank transaction</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A state-owned enterprise borrowing from a state-owned bank</div><div class="wk-body">A state-owned manufacturing company obtains a routine commercial loan from a state-owned bank, with no direct ownership or control relationship between the two beyond both being ultimately state-controlled.</div><div class="wk-answer">GIVEN the GOVERNMENT-related entities EXEMPTION, the COMPANY need ONLY disclose the NAME of the GOVERNMENT and the NATURE of the RELATIONSHIP, RATHER than the FULL detailed TRANSACTION disclosure OTHERWISE required — UNLESS the LOAN is INDIVIDUALLY significant, in WHICH case ADDITIONAL detail would be REQUIRED.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What ASBE No. 36 requires</div><div class="check-list"><span>Relationships between parents and subsidiaries, regardless of whether transactions occurred</span><span>Key management personnel compensation</span><span>Nature, amount, and terms of related party transactions and outstanding balances</span></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether an individually significant transaction with a government-related entity requires fuller disclosure</span><span>Identifying key management personnel and their close family members</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Fair value of non-cash consideration in related party transactions</span></div></div></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IAS 24</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASBE 36 vs IAS 24</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASBE 36</span><span style="color:var(--color-text-info);">IAS 24</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>General related party definition</span><span>Control, joint control, significant influence</span><span>Control, joint control, significant influence — converged</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Government-related entities exemption</span><span>Available</span><span>Available (added 2009) — converged</span></div>
</div>
<div class="note">A GENUINELY thoroughly CONVERGED standard, INCLUDING the GOVERNMENT-related entities EXEMPTION — a MEANINGFUL practical relief GIVEN China'S OWN state-enterprise LANDSCAPE.</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every related party disclosure lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Related party transactions/balances</span><span>Notes only</span><span>No effect on primary financial statement figures, unless separately required by another standard</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASBE No. 2</span><span>Long-term Equity Investments — supplies the control and significant influence concepts this Standard's related party definition relies on</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Government-related entities exemption</div><div class="glossary-def">A reduced disclosure exemption for transactions between entities under common government control, absent a specific direct relationship.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Key management personnel</div><div class="glossary-def">Individuals with authority and responsibility for planning, directing, and controlling an enterprise's activities.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (Chinese GAAP / ASBE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet (资产负债表) </div><div class="litem"><span class="badge bp">IS</span> Income Statement (利润表) </div><div class="litem"><span class="badge be">SCOE</span> Statement of Changes in Owners' Equity (所有者权益变动表) </div><div class="litem"><span class="badge bc">CFS</span> Cash Flow Statement (现金流量表)</div></div></div>


</div>
  <section id="history">
    <HistoryTimeline items={history.asbe36 || []} />
  </section>
</StandardPageLayout>
