---
import "../styles/site.css";
import "../styles/print.css";
import FrameworkRail from "../components/FrameworkRail.astro";
import StandardsPanel from "../components/StandardsPanel.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { detectSeoType } from "../utils/seo";
import { getFramework } from "../data/frameworks";
import { ArrowUp, ChevronRight, Sun, Moon } from "@lucide/astro";

interface Props {
  code: string;
  /** Display title used in the header/breadcrumbs. */
  title?: string;
  /** SEO document title prefix. Defaults to `title`. Omit for the home page. */
  seoTitle?: string;
  framework?: string;
  noindex?: boolean;
  hideFramework?: boolean;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: string;
  /** Standard page context used to auto-generate the description. */
  standard?: { code: string; title: string; dateModified?: string };
  /** When false, the TOC column is removed and the content expands to full width. */
  hasToc?: boolean;
}

const {
  code,

  title,

  seoTitle = title,

  framework = "",
  noindex = false,
  hideFramework = false,
  description,
  canonical,
  robots = noindex ? "noindex" : undefined,
  ogType,
  ogImage,
  twitterCard,
  standard,
  hasToc = true,
} = Astro.props;

const frameworkConfig = getFramework(framework) ?? getFramework("ias")!;
const seoType = detectSeoType({ code, framework, standard, hideFramework });
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-adsense-account" content="ca-pub-5486494296150557" />
    <script is:inline>
      (function () {
        try {
          var sidebarTheme = localStorage.getItem("rail-theme") || "light";
          document.documentElement.setAttribute("data-sidebar-theme", sidebarTheme);

          var mode = localStorage.getItem("theme-mode") || "light";
          document.documentElement.setAttribute("data-theme", mode);
        } catch (e) {}
      })();
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GERBZK6FCW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GERBZK6FCW');
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5486494296150557"
      crossorigin="anonymous"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@400..900&display=swap" />
    <Seo
      title={seoTitle}
      description={description}
      canonical={canonical}
      robots={robots}
      ogType={ogType}
      ogImage={ogImage}
      twitterCard={twitterCard}
      standard={standard}
      seoType={seoType}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app-shell">
      {hideFramework ? (
        <header class="site-header">
          <div class="header-left">
            <a href="/" class="site-logo">
              <span class="logo-mark"></span>
              <span class="logo-text"> StandardsHub </span>
            </a>
            <nav class="header-breadcrumbs" aria-label="Breadcrumb">
              <a href="/" class="crumb breadcrumb-home">
                <span>Home</span>
              </a>
              <ChevronRight size={14} strokeWidth={1.5} class="breadcrumb-separator" aria-hidden="true" />
              <span class="breadcrumb-current" aria-current="page">
                <span class="breadcrumb-title">{title}</span>
              </span>
            </nav>
          </div>
          <div class="header-right">
            <button class="toolbar-btn mobile-theme-btn" data-theme-toggle aria-label="Toggle theme" title="Theme">
              <Sun size={16} strokeWidth={2} class="theme-icon theme-icon-sun" />
              <Moon size={16} strokeWidth={2} class="theme-icon theme-icon-moon" />
            </button>
          </div>
        </header>
      ) : (
        <Header code={code} title={title} framework={framework} />
      )}

      <div class="app-body" data-framework={code === "Home" ? "home" : frameworkConfig.id}>
        <div class="reading-progress" aria-hidden="true">
          <div class="reading-progress-bar"></div>
        </div>

        <div class="standards-sidebar sidebar">
          <FrameworkRail />
          <StandardsPanel />
        </div>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <main class="content" id="main" tabindex="-1">
          <div class="page-body" class:list={{"home-layout": code === "Home", "no-toc": !hasToc}}>
            <div class="reading-column">
              <div class="page-content">
                <slot />
              </div>
            </div>

            {hasToc && (
              <aside class="page-toc">
                <slot name="toc" />
              </aside>
            )}
          </div>
          <Footer />
        </main>
      </div>

      <button
        type="button"
        class="back-to-top"
        id="backToTop"
        aria-label="Back to top"
      >
        <ArrowUp size={18} stroke-width={2} absoluteStrokeWidth aria-hidden="true" />
        <span>Top</span>
      </button>

      <button
        class="toc-launcher"
        id="tocLauncher"
        aria-expanded="false"
        aria-controls="mobileTocSheet"
        aria-label="Open table of contents"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="8" y1="6" x2="21" y2="6" />
          <line x1="8" y1="12" x2="21" y2="12" />
          <line x1="8" y1="18" x2="21" y2="18" />
          <line x1="3" y1="6" x2="3.01" y2="6" />
          <line x1="3" y1="12" x2="3.01" y2="12" />
          <line x1="3" y1="18" x2="3.01" y2="18" />
        </svg>
        <span>Contents</span>
      </button>

      <div class="toc-sheet-backdrop" id="tocSheetBackdrop" aria-hidden="true"></div>
    </div>

    <script is:inline defer src="/js/sidebar.js"></script>
    <script is:inline defer src="/js/rail-panel.js"></script>
    <script is:inline defer src="/js/toc.js"></script>
    <script is:inline defer src="/js/toc-mobile.js"></script>
    <script is:inline defer src="/js/back-to-top.js"></script>
    <script is:inline defer src="/js/search.js"></script>
    <script is:inline defer src="/js/reading-progress.js"></script>
    <script is:inline defer src="/js/theme-engine.js"></script>
    <script is:inline defer src="/js/table-short.js"></script>
    <script is:inline defer src="/js/framework-landing.js"></script>
    <script is:inline defer src="/js/webmcp.js"></script>

    <style>
      .skip-link {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, -120%);
        z-index: 1000;
        padding: 10px 18px;
        border-radius: var(--radius-pill);
        background: var(--text);
        color: var(--surface);
        font-size: var(--text-small);
        font-weight: var(--weight-semibold);
        text-decoration: none;
        box-shadow: var(--shadow-md);
        transition: transform var(--duration-fast) var(--ease);
      }

      .skip-link:focus-visible {
        transform: translate(-50%, 12px);
        outline: 2px solid var(--ias);
        outline-offset: 2px;
      }
    </style>
    <script define:vars={{ code, title }}>
      if (code && code.toLowerCase() !== "home") {
        try {
          const recent = JSON.parse(localStorage.getItem("recently-viewed") || "[]");
          const currentItem = { code, title, url: window.location.pathname };
          const filtered = recent.filter(item => item.url !== currentItem.url);
          filtered.unshift(currentItem);
          localStorage.setItem("recently-viewed", JSON.stringify(filtered.slice(0, 5)));
        } catch (e) {
          console.error(e);
        }
      }
    </script>
  </body>
</html>
