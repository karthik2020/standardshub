---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ias/ias18.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Sale of Goods – The Risks/Rewards Test" },
        { id: "s4", label: "Rendering of Services – Stage of Completion" },
        { id: "s5", label: "Interest, Royalties, and Dividends" },
        { id: "s6", label: "Measurement of Revenue" },
        { id: "s7", label: "Multiple-Element Arrangements (Historical)" },
        { id: "s8", label: "Why IAS 18 Was Replaced" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IAS 18 vs Modern IFRS 15" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IAS 18 (issued 1982, revised 1993) governed revenue recognition for sale of goods, rendering of services, and interest/royalties/dividends, based primarily on the transfer of risks and rewards of ownership. It was superseded by IFRS 15 Revenue from Contracts with Customers, effective for periods beginning on or after 1 January 2018, which replaced the risks/rewards test with a control-based five-step model."
    historical="It is retained here for historical reference. For current revenue recognition, always apply IFRS 15."
    link="/ifrs/ifrs15"
    linkText="IFRS 15 Revenue from Contracts with Customers"
  />

  <div class="wrap">
    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Risks and rewards – an earlier proxy for "control"</div>
        <div class="principle">The Conceptual Framework requires income recognition when an entity's assets increase (or liabilities decrease) in a way that increases equity. IAS 18 operationalised this for revenue using a risks and rewards test: revenue from selling goods was recognised when the significant risks and rewards of ownership had transferred to the buyer – a reasonable, but ultimately less precise, proxy for what IFRS 15 later reframed directly as the transfer of control.</div>
        <div class="elabel">HOW IAS 18 MAPPED TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Faithful representation</strong> – recognising revenue only once risks/rewards genuinely transferred avoided overstating income for goods the seller still effectively "owned" in substance</span>
          <span><strong style="font-weight:500">A single-transaction, rather than obligation-based, view</strong> – IAS 18 analysed revenue transaction by transaction (a sale, a service), rather than IFRS 15's more granular performance obligation concept, which could split a single contract into multiple distinct revenue streams</span>
          <span><strong style="font-weight:500">Limited guidance for complex, multi-element arrangements</strong> – IAS 18's relatively brief guidance struggled with increasingly common bundled contracts (software plus support, goods plus installation), a key driver of IFRS 15's much more detailed replacement</span>
        </div>
        <div class="note">IAS 18's risks/rewards test and IFRS 15's control test often produced the same answer in straightforward transactions – the practical divergence mattered most for complex, multi-element, or long-term service arrangements that IAS 18's relatively brief guidance handled less precisely.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">The three revenue categories IAS 18 addressed</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Category</span><span>Recognition trigger</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Sale of goods</span><span>Transfer of significant risks/rewards of ownership</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Rendering of services</span><span>Stage of completion (percentage of completion method)</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Interest, royalties, dividends</span><span>Effective interest method / accrual basis / when the right to receive payment is established</span></div>
        </div>
        <div class="callout info callout--chip" style="margin-bottom:0;">IFRS 15's single five-step model replaced this three-category structure with one unified approach, applied consistently across all types of contracts with customers.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 18 covered</div>
        <div class="principle">IAS 18 applied to accounting for revenue arising from the sale of goods, rendering of services, and use by others of entity assets yielding interest, royalties, and dividends.</div>
        <div class="note">IAS 18 explicitly excluded lease income (IAS 17), insurance contracts, and changes in fair value of financial instruments/biological assets/agricultural produce (IAS 39, IAS 41) – a scope structure broadly carried forward, with refinement, into IFRS 15's own exclusions.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Revenue (original)</div>
          <div class="glossary-def">The gross inflow of economic benefits during the period arising in the course of ordinary activities, when those inflows result in increases in equity, other than increases from equity participants.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Risks and rewards of ownership</div>
          <div class="glossary-def">The exposure to loss/gain associated with holding an asset – the central concept determining when revenue on the sale of goods was recognised.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Sale of Goods – The Risks/Rewards Test (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Five conditions, all required</div>
        <div class="principle">Revenue from the sale of goods was recognised when all of: significant risks/rewards of ownership had transferred; the seller retained neither continuing managerial involvement nor effective control; revenue could be measured reliably; it was probable economic benefits would flow to the entity; and costs incurred (or to be incurred) could be measured reliably.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: A sale with a right of return</div>
          <div class="wk-body">A retailer sells goods for $80,000, allowing customers a 30-day unconditional right of return. Based on extensive historical data, the retailer reliably estimates 5% of sales will be returned.</div>
          <div class="wk-answer">Since the risk of loss (via returns) has been reliably estimated and is not so significant as to prevent revenue recognition, revenue is recognised net of the expected returns: 80,000 × 95% = <strong style="color:var(--color-text-info);">$76,000</strong>, with a $4,000 refund liability recognised – broadly the same outcome IFRS 15 would produce today via its variable consideration and refund liability mechanics, though arrived at through a different conceptual route.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Rendering of Services – Stage of Completion (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">The percentage of completion method</div>
        <div class="principle">Where the outcome of a service transaction could be estimated reliably, revenue was recognised by reference to the stage of completion at the reporting date – the "percentage of completion" method, using surveys of work performed, proportion of costs incurred, or physical proportion of the contract work completed.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 2: Service revenue by stage of completion</div>
          <div class="wk-body">A consultancy firm enters a 12-month advisory contract for a total fee of $600,000. At the reporting date, 40% of the contracted work has been completed, based on hours logged relative to total estimated hours.</div>
          <div class="wk-answer">Revenue recognised = 600,000 × 40% = <strong style="color:var(--color-text-info);">$240,000</strong> – this stage-of-completion approach is conceptually very similar to IFRS 15's own "over time" recognition using an input method, reflecting genuine continuity in the underlying logic despite the standards' different overall structures.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Interest, Royalties, and Dividends</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Three distinct recognition bases</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Interest</strong> – recognised using the effective interest method, a basis carried forward identically into IFRS 9 today</span>
          <span><strong style="font-weight:500">Royalties</strong> – recognised on an accrual basis, in accordance with the substance of the relevant agreement</span>
          <span><strong style="font-weight:500">Dividends</strong> – recognised when the shareholder's right to receive payment is established, a principle retained identically under IFRS 9 today</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Measurement of Revenue</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Fair value of consideration received or receivable</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Revenue was measured at the fair value of consideration received or receivable, taking into account trade discounts and volume rebates – a measurement principle conceptually similar to, though less elaborately developed than, IFRS 15's "transaction price" concept and its detailed variable consideration guidance.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Multiple-Element Arrangements (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Limited, principles-only guidance – a key source of later reform</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IAS 18 stated only briefly that recognition criteria were usually applied separately to each transaction, but sometimes needed to be applied to separately identifiable components of a single transaction (e.g. goods bundled with subsequent servicing) – but offered little detailed guidance on how to identify or measure such components. This gap was one of the clearest drivers of IFRS 15's far more elaborate "distinct performance obligation" and stand-alone selling price allocation framework.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Why IAS 18 Was Replaced</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">A joint IASB/FASB response to widespread diversity and gaps</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Both IAS 18 (IFRS) and the pre-2018 US GAAP revenue guidance suffered from significant industry-specific diversity, numerous interpretations plugging gaps, and inadequate guidance for increasingly common complex, multi-element, and long-term contracts (software, telecoms, construction). The IASB and FASB undertook a genuinely joint project resulting in IFRS 15/ASC 606 – a single, converged, comprehensive revenue standard replacing both IAS 18 and its numerous predecessor US GAAP standards/interpretations.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures under IAS 18</div>
        <div class="check-list">
          <span>Accounting policies adopted for revenue recognition, including methods for determining stage of completion</span>
          <span>The amount of each significant category of revenue (goods, services, interest, royalties, dividends)</span>
          <span>The amount of revenue arising from exchanges of goods/services</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether significant risks/rewards of ownership had genuinely transferred</span>
              <span>Identifying separately identifiable components within a single, bundled transaction</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Stage of completion for service contracts</span>
              <span>Fair value of consideration received/receivable, particularly for non-cash consideration</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip" style="margin-top:8px;margin-bottom:0;">IAS 18's relatively brief guidance for complex, multi-element arrangements was widely regarded as a genuine gap – leading to significant diversity in practice for software, telecoms, and similar bundled-service industries, directly motivating IFRS 15's much more detailed replacement.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IAS 18 vs Modern IFRS 15</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison – IAS 18 (1993 revision) vs current IFRS 15</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IAS 18 (withdrawn)</span><span style="color:var(--color-text-warning);">Current (IFRS 15)</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Core recognition trigger</span><span>Transfer of significant risks and rewards of ownership</span><span>Transfer of control – a more precise, though often similar-in-outcome, concept</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Multi-element arrangements</span><span>Brief, principles-only guidance</span><span>Detailed "distinct performance obligation" identification and stand-alone selling price allocation framework</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Variable consideration</span><span>Not explicitly addressed as a distinct concept</span><span>Explicit estimation methods (expected value/most likely amount) and the "constraint" reliability safeguard</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Over-time vs point-in-time recognition</span><span>Separate categories (goods vs services) with different tests</span><span>A single unified test (Step 5) applicable to all performance obligations, regardless of goods/services distinction</span></div>
        </div>
        <div class="note">The single biggest structural change was unifying what IAS 18 treated as separate categories (goods, services, interest/royalties/dividends) into one consistent five-step model applied universally.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical, Under IAS 18)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Sale of goods – risks/rewards transferred</span><span><span class="badge bp">SOPL</span></span><span>Revenue recognised at fair value of consideration</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Service revenue – stage of completion</span><span><span class="badge bp">SOPL</span></span><span>Percentage of completion method</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Interest income</span><span><span class="badge bp">SOPL</span></span><span>Effective interest method</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Dividend income</span><span><span class="badge bp">SOPL</span></span><span>Recognised when the right to receive is established</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 15</span><span>The direct successor, replacing risks/rewards with control, and adding detailed multi-element guidance</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 11 (also withdrawn)</span><span>Governed long-term construction contracts specifically, also replaced by IFRS 15</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 9</span><span>Continues to govern interest and dividend income recognition</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Stage of completion", definition: "The proportion of total service/contract work completed at the reporting date, used to recognise revenue for services under IAS 18." },
      { term: "Continuing managerial involvement", definition: "Ongoing involvement retained by the seller to the degree usually associated with ownership, preventing revenue recognition even after physical delivery." },
      { term: "Risks and rewards of ownership", definition: "The exposure to loss/gain associated with holding an asset – the central concept determining when revenue on the sale of goods was recognised." },
      { term: "Revenue (original)", definition: "The gross inflow of economic benefits during the period arising in the course of ordinary activities, when those inflows result in increases in equity, other than increases from equity participants." },
      { term: "Effective interest method", definition: "A method of calculating the amortised cost of a financial asset or liability, and of allocating interest income/expense over the relevant periods, carried forward identically into IFRS 9." }
    ]} />

    <FinancialStatementKey />
  </div>
</StandardPageLayout>
