    <PageToc
      items={[
        { id: "s1", label: "Objective, Structure & the Two-Part Framework" },
        { id: "s2", label: "The 2017 Revision — What Changed and Why" },
        { id: "s3", label: "Scope of the Requirements" },
        { id: "s4", label: "Definitions — the Cash Basis & Cash Equivalents" },
        { id: "s5", label: "Cash Controlled by the Reporting Entity — the Treasury Single Account" },
        { id: "s6", label: "Financial Statements — Required Components" },
        { id: "s7", label: "The Statement of Cash Receipts and Payments" },
        { id: "s8", label: "Accounting Policies & Explanatory Notes" },
        { id: "s9", label: "Reporting Period, Timeliness & Authorization Date" },
        { id: "s10", label: "Restrictions on Cash Balances & Undrawn Borrowing Facilities" },
        { id: "s11", label: "Consistency, Comparative Information & Foreign Currency" },
        { id: "s12", label: "Budget & Actual — Definitions & Scope" },
        { id: "s13", label: "Presentation of the Budget Comparison" },
        { id: "s14", label: "Reconciliation of Actual Amounts" },
        { id: "s15", label: "Transitional Provisions & Effective Date (Part 1)" },
        { id: "s16", label: "Illustrative Statement Formats — Government A" },
        { id: "s17", label: "Part 2 Overview — Going Concern & Administered Transactions" },
        { id: "s18", label: "Disclosure of Major Classes of Cash Flows" },
        { id: "s19", label: "Consolidated Financial Statements (Encouraged)" },
        { id: "s20", label: "Joint Arrangements & Hyperinflationary Economies" },
        { id: "s21", label: "Payments by Third Parties & External/Other Assistance" },
        { id: "s22", label: "Required and Encouraged Disclosures & the IPSAS 33 Link" },
        { id: "s23", label: "Relationship to Accrual IPSAS" },
