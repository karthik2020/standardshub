---
import StandardLayout from "../../layouts/StandardLayout.astro";
import standards from "../../data/standards.json";
import StandardCard from "../../components/StandardCard.astro";
import { palette } from "../../data/standardVisuals";
import { getFramework } from "../../data/frameworks";

const framework = getFramework("indas")!;
---

<StandardLayout code={framework.code} title={`${framework.fullName} (${framework.code})`} framework={framework.code}>

  <h1>{framework.fullName}</h1>

  <p class="category-description">
    {framework.description}
  </p>

  <div class="standards-group">
    <h2 class="standards-group-title">Active Standards</h2>
    <div class="standards-grid">

      {
        standards.IndAS.map((item, index) => (

          <StandardCard
            href={item.url}
            code={item.code}
            title={item.title}
            framework={framework.id}
            theme={palette[index % palette.length]}
          />

        ))
      }

    </div>
  </div>

</StandardLayout>
