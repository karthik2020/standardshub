import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe3110.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Scope" },
        { id: "s3", label: "3. Recognition Criteria" },
        { id: "s4", label: "4. Initial Measurement — Fair Value" },
        { id: "s5", label: "5. Capitalization Into the Related Asset" },
        { id: "s6", label: "6. Subsequent Measurement — Accretion of the Liability" },
        { id: "s7", label: "7. Changes in the Estimated Liability" },
        { id: "s8", label: "8. Settlement of the Obligation" },
        { id: "s9", label: "9. Worked Example — Initial Recognition and Capitalization" },
        { id: "s10", label: "10. Worked Example — Accretion Expense Over Time" },
        { id: "s11", label: "11. Disclosure Requirements" },
        { id: "s12", label: "12. Critical Judgments &amp; Estimates" },
        { id: "s13", label: "13. Relationship to IAS 37 / IFRIC 1" },
        { id: "s14", label: "14. Statement Mapping" },
        { id: "s15", label: "15. Related Standards" },
        { id: "s16", label: "16. Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
</div>



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Recognizing the future cost of decommissioning a long-lived asset</div><div class="principle">ASPE Section 3110 requires RECOGNITION of a LIABILITY for a LEGAL obligation ASSOCIATED with the RETIREMENT of a LONG-lived tangible ASSET — SUCH as the FUTURE cost OF decommissioning a FACILITY, RESTORING a SITE, or REMOVING equipment AT the end OF its USEFUL life. THE Section CLOSELY parallels the GENERAL approach ALSO used INTERNATIONALLY under IAS 37/IFRIC 1 and US GAAP ASC 410.</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Legal obligations tied to the retirement of a tangible long-lived asset</div><div class="principle">This Section applies to LEGAL obligations ASSOCIATED with the RETIREMENT of TANGIBLE long-LIVED assets — ARISING from STATUTE, contract, OR common law, RATHER than PURELY discretionary OR voluntary decommissioning PLANS an enterprise MIGHT choose TO undertake.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Recognition Criteria</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A legal obligation with a reasonably estimable fair value</div><div class="text-supporting">A LIABILITY is RECOGNIZED when a LEGAL obligation EXISTS, and a REASONABLE estimate OF its FAIR value CAN be MADE — WHERE fair VALUE cannot BE reasonably ESTIMATED at THE time the OBLIGATION is INCURRED, recognition IS deferred UNTIL a REASONABLE estimate BECOMES possible.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Initial Measurement — Fair Value</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Fair value, or an expected present value technique where fair value is unavailable</div><div class="text-supporting">THE asset RETIREMENT obligation is INITIALLY measured AT fair VALUE — WHERE a MARKET-based fair VALUE is NOT directly OBSERVABLE, an EXPECTED present VALUE technique is USED instead, DISCOUNTING the ESTIMATED future CASH flows required TO settle the OBLIGATION.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Capitalization Into the Related Asset</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Increasing the carrying amount of the related tangible asset</div><div class="text-supporting">THE initial ASSET retirement OBLIGATION liability IS capitalized AS part of the CARRYING amount OF the RELATED long-LIVED asset — SUBSEQUENTLY depreciated OVER that ASSET'S useful LIFE, PER Section 3061'S own GENERAL depreciation PRINCIPLES (see the COMPANION poster).</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Subsequent Measurement — Accretion of the Liability</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A period expense reflecting the passage of time</div><div class="text-supporting">THE liability INCREASES over TIME through "ACCRETION" — RECOGNIZING a PERIOD expense (SIMILAR in NATURE to INTEREST expense) that REFLECTS the PASSAGE of TIME as the DISCOUNTED liability MOVES closer TO its UNDISCOUNTED, ULTIMATE settlement AMOUNT.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Changes in the Estimated Liability</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Adjusting both the liability and the related asset</div><div class="text-supporting">WHERE the TIMING or AMOUNT of ESTIMATED future CASH flows CHANGES (e.g. a REVISED cost ESTIMATE, or a CHANGE in the EXPECTED settlement DATE), BOTH the LIABILITY and the CARRYING amount OF the RELATED asset ARE adjusted — CONSISTENT with the GENERAL approach ALSO used INTERNATIONALLY under IFRIC 1.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Settlement of the Obligation</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Recognizing a gain or loss on settlement</div><div class="text-supporting">UPON settling the OBLIGATION (e.g. ACTUALLY performing the DECOMMISSIONING or RESTORATION work), the ENTERPRISE recognizes a GAIN or LOSS FOR any DIFFERENCE between the LIABILITY'S carrying AMOUNT and the ACTUAL cost INCURRED to SETTLE it.</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Initial Recognition and Capitalization</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Adding the discounted future cost to the asset's carrying amount</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A mining site restoration obligation</div><div class="wk-body">A mining company has a legal obligation to restore a site upon closure in 15 years. The estimated future restoration cost is $2,000,000, with a present value (using an appropriate discount rate) of $780,000.</div><div class="wk-answer">The COMPANY recognizes a $780,000 ASSET retirement OBLIGATION liability, CAPITALIZING the SAME <strong>$780,000</strong> into the CARRYING amount OF the RELATED mining ASSET — SUBSEQUENTLY depreciated OVER the ASSET'S remaining USEFUL life.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example — Accretion Expense Over Time</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">The liability grows each period, reflecting the discount unwinding</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Accreting the liability in year one</div><div class="wk-body">Continuing the prior example, the $780,000 liability carries an effective discount rate of 6% per year.</div><div class="wk-answer">ACCRETION expense FOR the FIRST year = $780,000 × 6% = <strong>$46,800</strong>, INCREASING the LIABILITY to $826,800 AT year-end — RECOGNIZED as a PERIOD expense, SIMILAR in NATURE to INTEREST expense, REFLECTING the PASSAGE of TIME.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 3110 requires</div><div class="check-list"><span>Description of the asset retirement obligation and the associated long-lived asset</span><span>Reconciliation of the beginning and ending liability balance, including accretion and any revisions</span><span>Fair value of assets legally restricted for purposes of settling the obligation, if any</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether a legal obligation genuinely exists, and whether a reasonable fair value estimate can be made</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Timing and amount of future cash flows required to settle the obligation</span><span>Discount rate used in the expected present value calculation</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IAS 37 / IFRIC 1</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASPE Section 3110 vs IAS 37 / IFRIC 1</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 3110</span><span style="color:var(--color-text-info);">IAS 37 / IFRIC 1</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Initial measurement</span><span>Fair value / expected present value</span><span>Best estimate of expenditure required — converged in substance</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Capitalization into related asset</span><span>YES</span><span>YES — converged</span></div>
</div>
<div class="note">A GENUINELY thoroughly CONVERGED standard — the CORE mechanics of RECOGNITION, capitalization, AND accretion CLOSELY mirror the INTERNATIONAL approach, WITH no MEANINGFUL substantive DIVERGENCE to REPORT.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every ARO event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Initial recognition</span><span><span class="badge bs">BS</span></span><span>Liability and corresponding asset capitalization</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Accretion expense</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Recognized each period, similar to interest expense</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 3061</span><span>Property, Plant and Equipment — supplies the depreciation principles applied to the capitalized retirement cost</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 3290</span><span>Contingencies — governs obligations that do not meet this Section's specific legal-obligation recognition criteria</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Accretion</div><div class="glossary-def">The periodic increase in an asset retirement obligation liability reflecting the passage of time, recognized as an expense.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Expected present value technique</div><div class="glossary-def">A measurement approach discounting probability-weighted estimated future cash flows, used when a market-based fair value is not directly observable.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.aspe3110 || []} />
  </section>
</StandardPageLayout>
