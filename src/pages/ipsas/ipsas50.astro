---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas50.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & the 'Free Choice' Policy Framework" },
        { id: "s2", label: "Definitions" },
        { id: "s3", label: "Recognition — the IPSAS 3 Exemption" },
        { id: "s4", label: "Initial Measurement — Elements of Cost" },
        { id: "s5", label: "Subsequent Measurement & Accounting Policy Changes" },
        { id: "s6", label: "Presentation — Classification & Reclassification" },
        { id: "s7", label: "Impairment — Trigger Indicators & the Testing Level" },
        { id: "s8", label: "Disclosure Requirements" },
        { id: "s9", label: "Effective Date & Transition" },
        { id: "s10", label: "Relationship to IFRS 6 & GFS" },
        { id: "s11", label: "Statement / Process Mapping" },
        { id: "s12", label: "Related Standards" },
        { id: "s13", label: "Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 50 Exploration for and Evaluation of Mineral Resources is the current, active standard issued by the IPSASB specifying financial reporting requirements for mineral exploration and evaluation expenditures. Effective for periods beginning on or after 1 January 2027."
    historical="IPSAS 50 is drawn primarily from IFRS 6 Exploration for and Evaluation of Mineral Resources. It grants an explicit exemption from the general accounting policy hierarchy under IPSAS 3, allowing entities to determine their capitalization policies while introducing mandatory tangible/intangible classification, mineral-specific impairment trigger indicators, and pre-reclassification impairment assessments."
    link=""
    linkText=""
  />

  <!-- ============ SECTION 1 — OBJECTIVE, SCOPE & THE "FREE CHOICE" POLICY FRAMEWORK ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; the "Free Choice" Policy Framework (paras. 1–5)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Objective — limited improvements, not a full model</div>
      <div class="principle">Specifies financial reporting for exploration/evaluation of mineral resources. Deliberately makes only LIMITED improvements to existing practice — requiring impairment assessment (per IPSAS 26) and disclosures that help users understand amounts, timing, and cash-flow certainty, WITHOUT prescribing a comprehensive recognition/measurement model.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Scope boundaries — a narrow window</div>
      <div class="cross-list">
        <span>Expenditure BEFORE obtaining legal exploration rights in a specific area</span>
        <span>Expenditure AFTER technical feasibility and commercial viability are DEMONSTRABLE</span>
      </div>
      <div class="text-supporting">This Standard applies ONLY to the narrow window BETWEEN those two points — the genuine exploration/evaluation phase (paras. 4–5). Note IPSAS 45 explicitly cross-references this Standard's scope carve-out for exploration/evaluation asset RECOGNITION/MEASUREMENT (that Standard's &sect;1).</div>
    </div>
  </div>

  <!-- ============ SECTION 2 — DEFINITIONS ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Definitions (para. 6)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">The three core terms</div>
      <div class="glossary-item"><div class="glossary-term">Exploration and evaluation expenditures</div><div class="glossary-def">Expenditures incurred exploring for/evaluating mineral resources BEFORE technical feasibility and commercial viability of extraction are demonstrable.</div></div>
      <div class="glossary-item"><div class="glossary-term">Exploration and evaluation assets</div><div class="glossary-def">Exploration and evaluation expenditures recognized as assets, per the entity's OWN accounting policy.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Exploration for and evaluation of mineral resources</div><div class="glossary-def">The search for minerals, oil, gas, and similar non-regenerative resources — AFTER obtaining legal exploration rights — plus determining technical feasibility and commercial viability of extraction.</div></div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">A deliberately entity-defined scope</div>
      <div class="text-supporting">Notice the circularity by design: an "exploration and evaluation asset" is whatever the entity's OWN policy says it is. This isn't a gap — it's the Standard's central mechanic (&sect;3), reflecting how genuinely varied exploration accounting practice was across jurisdictions when this Standard (and its IFRS 6 predecessor) was developed.</div>
    </div>
  </div>

  <!-- ============ SECTION 3 — RECOGNITION: THE IPSAS 3 EXEMPTION ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Recognition — the IPSAS 3 Exemption (paras. 7–8)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">A genuinely unusual carve-out from the normal accounting policy hierarchy</div>
      <div class="formula-box">
        <div class="f-eq">Entities recognizing exploration/evaluation assets apply IPSAS 3 para. 12 (general policy-setting principles) — but are EXEMPTED from IPSAS 3 paras. 14–15 (the usual hierarchy of authoritative sources for topics with no specific Standard)</div>
      </div>
      <div class="text-supporting">Ordinarily, when no IPSAS directly addresses an item, IPSAS 3 requires management to consult a defined hierarchy (other IPSAS on similar issues, the Conceptual Framework, then other standard-setters' pronouncements). IPSAS 50 deliberately SUSPENDS that hierarchy for exploration/evaluation assets — reflecting the IPSASB's decision to preserve DIVERSITY in existing practice rather than force premature convergence, mirroring IFRS 6's own well-known departure from IAS 8's usual policy-development requirements.</div>
    </div>
  </div>

  <!-- ============ SECTION 4 — INITIAL MEASUREMENT: ELEMENTS OF COST ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Initial Measurement — Elements of Cost (paras. 9–12)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Cost-based, with an entity-defined boundary</div>
      <div class="formula-box">
        <div class="f-eq">Exploration and evaluation assets measured at COST — the entity determines its OWN policy on which expenditures qualify, applied CONSISTENTLY</div>
      </div>
      <div class="dot-list">
        <span>Acquisition of exploration rights</span>
        <span>Topographical, geological, geochemical, geophysical studies</span>
        <span>Exploratory drilling, trenching, sampling</span>
        <span>Technical feasibility/commercial viability evaluation activities</span>
      </div>
      <div class="text-supporting">(A non-exhaustive list — para. 10.) The key judgment: the DEGREE to which expenditure can be associated with finding SPECIFIC mineral resources.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">What's explicitly EXCLUDED</div>
      <div class="callout danger">DEVELOPMENT expenditure is NEVER recognized as an exploration/evaluation asset — once feasibility/viability are demonstrable, that's a DIFFERENT asset category entirely, governed by the Conceptual Framework and IPSAS 31 instead (para. 11).</div>
      <div class="text-supporting">Removal/restoration obligations incurred DURING exploration/evaluation are recognized under IPSAS 19's ordinary provisions framework (para. 12).</div>
    </div>
  </div>

  <!-- ============ SECTION 5 — SUBSEQUENT MEASUREMENT & ACCOUNTING POLICY CHANGES ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Subsequent Measurement &amp; Accounting Policy Changes (paras. 13–15)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Historical cost or fair value — tied to classification</div>
      <div class="formula-box">
        <div class="f-eq">HISTORICAL COST or FAIR VALUE — if fair value, it must be CONSISTENT with the asset's classification (tangible &rarr; IPSAS 45's model; intangible &rarr; IPSAS 31's model) (&sect;6)</div>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Changing policy — a lower bar than usual</div>
      <div class="text-supporting">A policy change is permitted if it makes statements MORE RELEVANT and no less RELIABLE, or MORE RELIABLE and no less relevant — judged using IPSAS 3's criteria (para. 14). Crucially, the change need NOT achieve FULL compliance with those criteria — only demonstrate it moves CLOSER to meeting them (para. 15). This is a genuinely relaxed standard compared to IPSAS 3's usual bar for voluntary policy changes elsewhere in the Handbook.</div>
    </div>
  </div>

  <!-- ============ SECTION 6 — PRESENTATION: CLASSIFICATION & RECLASSIFICATION ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Presentation — Classification &amp; Reclassification (paras. 16–18)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Tangible or intangible — by nature, applied consistently</div>
      <div class="dot-list">
        <span>TANGIBLE examples: vehicles, drilling rigs</span>
        <span>INTANGIBLE examples: drilling rights</span>
      </div>
      <div class="note">Where a tangible asset is CONSUMED developing an intangible one, that consumption becomes part of the INTANGIBLE asset's cost — but the tangible asset itself never converts INTO an intangible asset (para. 17).</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Reclassification — impairment FIRST, always</div>
      <div class="formula-box">
        <div class="f-eq">Once technical feasibility and commercial viability are DEMONSTRABLE &rarr; the asset is no longer classified as exploration/evaluation — but MUST be assessed for impairment (and any loss recognized) BEFORE reclassification</div>
      </div>
      <div class="text-supporting">This ordering matters: it prevents an entity from carrying forward an already-impaired carrying amount into its new asset category unadjusted (para. 18).</div>
    </div>
  </div>

  <!-- ============ SECTION 7 — IMPAIRMENT: TRIGGER INDICATORS & THE TESTING LEVEL ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Impairment — Trigger Indicators &amp; the Testing Level (paras. 19–23)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">A REPLACEMENT trigger test, not IPSAS 26's usual indicators</div>
      <div class="text-supporting">For exploration/evaluation assets SPECIFICALLY, para. 21's four indicators REPLACE IPSAS 26's ordinary impairment indicator list (paras. 25–29 of that Standard) — everything else about measuring/presenting/disclosing the resulting loss still follows IPSAS 26 (paras. 19–20).</div>
      <div class="dot-list">
        <span>The right to explore has EXPIRED, or will expire soon, and won't be renewed</span>
        <span>Substantive further exploration expenditure is NEITHER budgeted NOR planned</span>
        <span>Exploration has NOT found commercially viable quantities, and the entity has decided to DISCONTINUE activities in that area</span>
        <span>Sufficient data exists that even though development is LIKELY to proceed, the carrying amount is UNLIKELY to be recovered in full from development or sale</span>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Testing level — entity-defined, capped at a segment</div>
      <div class="formula-box">
        <div class="f-eq">The entity DETERMINES its own policy for allocating exploration/evaluation assets to cash-generating units (or groups) for impairment testing — but the chosen level can NEVER be LARGER than an IPSAS 18 segment</div>
      </div>
      <div class="text-supporting">The testing level MAY comprise one or more cash-generating units (paras. 22–23) — another instance of this Standard granting entity-level flexibility within an outer boundary, consistent with its overall "limited improvements" philosophy.</div>
    </div>
  </div>

  <!-- ============ SECTION 8 — DISCLOSURE REQUIREMENTS ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Disclosure Requirements (paras. 24–26)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Core disclosure package</div>
      <div class="check-list">
        <span>ACCOUNTING POLICIES for exploration/evaluation expenditures, including exploration/evaluation asset recognition</span>
        <span>AMOUNTS of assets, liabilities, revenue, and expense arising from exploration/evaluation</span>
        <span>OPERATING and INVESTING cash flows arising from exploration/evaluation</span>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Separate class treatment</div>
      <div class="text-supporting">Exploration/evaluation assets are treated as a SEPARATE CLASS of assets, with the disclosures required by EITHER IPSAS 45 or IPSAS 31 applying — whichever matches the entity's own &sect;6 classification (tangible or intangible) (para. 26).</div>
    </div>
  </div>

  <!-- ============ SECTION 9 — EFFECTIVE DATE & TRANSITION ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Effective Date &amp; Transition (paras. 27–29)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cn span2">
      <div class="ctitle cn">The very newest Standard in the entire Handbook</div>
      <div class="principle">Periods beginning on/after <strong>1 January 2027</strong> — the LATEST effective date of any Standard covered in this library so far. Earlier application permitted, with disclosure of that fact (para. 27).</div>
      <div class="text-supporting">A narrow IMPRACTICABILITY exception exists: if applying the &sect;7 impairment-indicator requirements to COMPARATIVE information for periods before 1 January 2027 is impracticable, the entity discloses that fact instead — "impracticable" carries its IPSAS 3 meaning (para. 29). This Standard also makes CONSEQUENTIAL amendments to IPSAS 31 (adding the exploration/evaluation asset scope exclusion referenced throughout this library).</div>
    </div>
  </div>

  <!-- ============ SECTION 10 — RELATIONSHIP TO IFRS 6 & GFS ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Relationship to IAS/IFRS &amp; GFS — Comparison with IFRS 6</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Comparison — IPSAS 50 vs IFRS 6</div>
      <div class="principle">IPSAS 50 is drawn from IFRS 6 (amendments to March 2018), <em>Exploration for and Evaluation of Mineral Resources</em>.</div>
      <div class="text-supporting">A notably SHORT comparison — largely just TERMINOLOGY: IPSAS 50 uses "historical cost" and "impairment of cash-generating assets"; IFRS 6 uses "cost model," "revaluation model," and "impairment of assets."</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Comparison — IPSAS 50 vs GFS</div>
      <div class="dot-list">
        <span>Both require capitalized exploration/evaluation expenditure to be accounted for as exploration/evaluation assets, when the entity elects to capitalize</span>
        <span>IPSAS 50 classifies as tangible/intangible; GFS classifies as a type of INTELLECTUAL PROPERTY PRODUCT</span>
        <span>IPSAS 50's cost elements EXCLUDE a return to fixed capital; GFS INCLUDES one</span>
        <span>Subsequent measurement CAN converge if GFS's market-value approach matches IPSAS 50's market-technique current value choice</span>
        <span>Impairment: IPSAS 50 tests carrying amount vs. recoverable amount; GFS instead treats CONSUMPTION as the decline in current value</span>
        <span>IPSAS 50 includes disclosure requirements GFS lacks</span>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 11 — STATEMENT / PROCESS MAPPING ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Decision map</div>
      <ol class="ordered-list">
        <li>Has the entity obtained LEGAL RIGHTS to explore a specific area, AND is technical feasibility/commercial viability NOT YET demonstrable? If outside this window &rarr; outside this Standard's scope entirely (&sect;1)</li>
        <li>Set an entity-specific accounting POLICY for which expenditures qualify as exploration/evaluation assets — exempted from the usual IPSAS 3 hierarchy (&sect;3)</li>
        <li>Measure at COST initially — excluding development expenditure; recognize removal/restoration obligations under IPSAS 19 (&sect;4)</li>
        <li>Choose HISTORICAL COST or FAIR VALUE for subsequent measurement, consistent with the asset's classification (&sect;5)</li>
        <li>Classify TANGIBLE or INTANGIBLE, by nature, applied consistently (&sect;6)</li>
        <li>Do ANY of the four &sect;7 indicators apply? &rarr; test for impairment under IPSAS 26, at an entity-defined level no larger than a segment (&sect;7)</li>
        <li>Feasibility/viability BECOME demonstrable? &rarr; impair FIRST, then reclassify OUT of this Standard's scope (&sect;6)</li>
      </ol>
    </div>
  </div>

  <div class="grid grid-spaced">
    <div class="card cs span2">
      <div class="ctitle cs">Concept-to-statement mapping table</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>IPSAS 50 concept</span><span>Statement(s)</span><span>Notes</span></div>
        <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Exploration/evaluation asset carrying amount</span><span><span class="badge bs">SOFP</span></span><span>Historical cost or fair value, per entity policy</span></div>
        <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Removal/restoration provision</span><span><span class="badge bs">SOFP</span></span><span>Per IPSAS 19</span></div>
        <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Impairment loss</span><span><span class="badge bp">SOFPerf</span></span><span>Per IPSAS 26, using this Standard's own trigger indicators</span></div>
        <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Operating/investing cash flows</span><span>Cash Flow</span><span>Disclosed separately by activity</span></div>
        <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Accounting policies, amounts by class</span><span><span class="badge be">Notes</span></span><span>Mandatory disclosures, paras. 24–26</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 12 — RELATED STANDARDS ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Related Standards — Cross-Reference Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">How IPSAS 50 connects across the IPSAS body of literature</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:0.7fr 2.2fr;"><span>Standard</span><span>Nature of the connection</span></div>
        <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 3</span><span>Sets the GENERAL policy-development principle applied (para. 12), while paras. 14–15's usual hierarchy is EXEMPTED for this topic (&sect;3); governs the "impracticable" definition for transition (&sect;9)</span></div>
        <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 18</span><span>Caps the maximum impairment-testing level at a segment (&sect;7)</span></div>
        <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 19</span><span>Governs removal/restoration obligation recognition during exploration/evaluation (&sect;4)</span></div>
        <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 26</span><span>Governs the actual impairment measurement/presentation/disclosure mechanics, once this Standard's own trigger indicators are met (&sect;7)</span></div>
        <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 31</span><span>Governs intangible-classified exploration/evaluation assets' subsequent measurement and disclosure; receives a consequential scope-exclusion amendment FROM this Standard (&sect;5, &sect;8, &sect;9)</span></div>
        <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 33</span><span>Governs when this Standard applies for entities adopting accrual IPSAS after the base effective date (&sect;9)</span></div>
        <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 45</span><span>Governs tangible-classified exploration/evaluation assets' subsequent measurement and disclosure; explicitly excludes exploration/evaluation asset recognition/measurement from its own scope (&sect;5, &sect;8)</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 13 — GLOSSARY ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Exploration and evaluation expenditures</div><div class="glossary-def">Expenditures before technical feasibility and commercial viability of extraction are demonstrable.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Exploration and evaluation assets</div><div class="glossary-def">Exploration and evaluation expenditures recognized as assets under the entity's own accounting policy.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Exploration for and evaluation of mineral resources</div><div class="glossary-def">The search for minerals, oil, gas, and similar non-regenerative resources, plus feasibility/viability determination.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Cash-generating unit</div><div class="glossary-def">The smallest identifiable group of assets, held for a commercial return, generating largely independent cash inflows.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Commercial viability</div><div class="glossary-def">The stage where it can be demonstrated that extraction of mineral resources is economically viable.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Technical feasibility</div><div class="glossary-def">The stage where it can be demonstrated that the extraction technology and process are viable.</div></div>
    </div>
  </div>

  <div class="legend">
    <div class="ltitle">Financial statement key</div>
    <div class="lrow">
      <span class="badge bs">SOFP</span> Statement of financial position
      <span class="badge bp">SOFPerf</span> Statement of financial performance
      <span class="badge be">Notes</span> Notes to the financial statements
    </div>
  </div>
</StandardPageLayout>
