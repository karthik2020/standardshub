<style>
  .framework-globe {
    display: inline-flex;
    line-height: 0;
  }

  .framework-globe svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .globe-primary {
    fill: var(--globe-primary);
  }

  .globe-secondary {
    fill: var(--globe-secondary);
  }

  @media (prefers-color-scheme: dark) {
    .framework-globe[data-framework-globe="ias"] {
      --globe-primary: var(--ias-soft);
      --globe-secondary: var(--ias);
    }

    .framework-globe[data-framework-globe="ifrs"] {
      --globe-primary: var(--ifrs-soft);
      --globe-secondary: var(--ifrs);
    }
  }
</style>
