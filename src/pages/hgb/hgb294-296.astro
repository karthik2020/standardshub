  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  summary={metadata.summary}
  subtitle={metadata.nativeTitle}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "§294(1) – Full Inclusion, Regardless of Registered Seat" },
        { id: "s4", label: "§294(3) – the Parent's Legal Right to Information" },
        { id: "s5", label: "Worked Example – Compelling a Reluctant Subsidiary to Cooperate" },
        { id: "s6", label: "§295 – Repealed, With a Genuinely Interesting History" },
        { id: "s7", label: "§296(1) – the Four Grounds for Excluding a Controlled Subsidiary" },
        { id: "s8", label: "Worked Example – Severe and Lasting Restrictions" },
        { id: "s9", label: "Worked Example – Disproportionate Cost or Delay" },
        { id: "s10", label: "Worked Example – Shares Held Exclusively for Resale" },
        { id: "s11", label: "Worked Example – Immateriality and the Aggregation Anti-Abuse Rule" },
        { id: "s12", label: "§296(3) – Justifying an Exclusion in the Konzernanhang" },
        { id: "s13", label: "Critical Judgments &amp; Practical Difficulties" },
        { id: "s14", label: "Relationship to IFRS (IFRS 10) – a Genuine, Significant Divergence" },
