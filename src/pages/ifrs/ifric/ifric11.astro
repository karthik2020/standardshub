---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/ifric/ifric11.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework (Historical)" },
        { id: "s2", label: "Scope & Definitions (Historical)" },
        { id: "s3", label: "Part A — Treasury Share Transactions (Historical)" },
        { id: "s4", label: "Part B — Group Share-Based Payment Transactions (Historical)" },
        { id: "s5", label: "Which Entity Recognises the Expense (Historical)" },
        { id: "s6", label: "Cash-Settled vs Equity-Settled Classification (Historical)" },
        { id: "s7", label: "How This Guidance Became Part of IFRS 2" },
        { id: "s8", label: "Common Historical Application Areas" },
        { id: "s9", label: "Disclosure (Historical)" },
        { id: "s10", label: "Judgments & Estimates (Historical)" },
        { id: "s11", label: "IFRIC 11 vs Current IFRS 2 Approach" },
        { id: "s12", label: "Statement Mapping (Historical)" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IFRIC 11 clarified share-based payment accounting for treasury share transactions and group share-based payment transactions. This guidance was withdrawn and folded directly into IFRS 2's own group or treasury share-based payment requirements via 2009 amendments."
    historical="This poster is retained for historical and comparative reference. For current share-based payment requirements, always apply IFRS 2."
    link="/ifrs/ifrs2"
    linkText="IFRS 2 Share-based Payment"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">A group-structuring clarification, later absorbed into the standard itself</div>
        <div class="principle">IFRIC 11 established that EQUITY-SETTLED accounting under IFRS 2 applied even where the entity granting the rights had NO obligation to settle in cash — for example, a SUBSIDIARY whose employees receive rights to the PARENT's shares was still required to account for this as an EQUITY-SETTLED transaction (with a corresponding capital contribution from the parent), rather than treating it as cash-settled simply because the subsidiary itself had no shares to issue.</div>
        <div class="elabel">WHY THIS ABSORPTION HAPPENED</div>
        <div class="check-list">
          <span><strong>Group structuring clarity</strong> — WITHOUT this clarification, entities within complex group structures might have INCONSISTENTLY classified share-based payments</span>
          <span><strong>Conceptual continuity</strong> — this group or treasury share logic was considered CORE enough to IFRS 2's overall scope that the IASB folded it directly into the standard via 2009 amendments</span>
        </div>
        <div class="note">IFRIC 11 is a genuinely INSTRUCTIVE example, alongside IFRIC 4, 8, and 9, of an interpretation whose SUBSTANCE was absorbed almost entirely into its successor standard's own text.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The two parts of IFRIC 11's guidance</div>
        <div class="td-table">
          <div class="th cols-11-16"><span>Part</span><span>Scenario addressed</span></div>
          <div class="tr cols-11-16"><span>Part A</span><span>An entity granting rights to its OWN equity instruments, potentially settled via treasury shares</span></div>
          <div class="tr alt cols-11-16"><span>Part B</span><span>A PARENT granting rights to its shares to a SUBSIDIARY's employees</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope & Definitions (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRIC 11 covered</div>
        <div class="principle">IFRIC 11 applied to share-based payment arrangements INVOLVING an entity's own equity instruments (potentially settled via market purchase) and arrangements where a PARENT or fellow subsidiary granted rights to employees of ANOTHER group entity.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Treasury shares</div>
          <div class="glossary-def">An entity's own previously issued shares, reacquired and potentially used to settle share-based payment obligations.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Group share-based payment transaction</div>
          <div class="glossary-def">An arrangement where one group entity grants rights to equity instruments to employees of ANOTHER group entity.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Part A — Treasury Share Transactions (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Equity-settled classification confirmed, regardless of settlement mechanism</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IFRIC 11 confirmed that an arrangement where an entity granted rights to its OWN equity instruments was classified as EQUITY-SETTLED even if the entity chose (or was required) to purchase shares from the MARKET to satisfy the obligation, rather than issuing NEW shares — the settlement MECHANISM did not change the fundamental classification.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Part B — Group Share-Based Payment Transactions (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Historical illustration</div>
        <div class="worked">
          <div class="wk-title">Example 1: Parent-granted options to subsidiary employees</div>
          <div class="wk-body">A listed parent company granted share options over its OWN shares to employees of a wholly-owned SUBSIDIARY, with the subsidiary having NO obligation to settle the awards and no shares of its own involved.</div>
          <div class="wk-answer">Under IFRIC 11, the SUBSIDIARY recognised the share-based payment expense as EQUITY-SETTLED (with a CORRESPONDING increase in equity, representing a deemed capital contribution from the parent), even though the subsidiary itself had no obligation to deliver shares.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Which Entity Recognises the Expense (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">The subsidiary recognises the expense; the parent recognises an investment increase</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The SUBSIDIARY receiving employee services recognised the share-based payment EXPENSE in its own (standalone) financial statements, with the PARENT recognising a CORRESPONDING increase in its investment in the subsidiary — a two-sided treatment PRESERVED in IFRS 2's current group transaction guidance.</div>
      </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Cash-Settled vs Equity-Settled Classification (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to the current approach</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The SUBSIDIARY's own classification (equity-settled vs cash-settled in ITS standalone financial statements) depended on WHETHER it had an obligation to settle in cash to its own employees — IDENTICAL classification logic PRESERVED in IFRS 2's current group transaction framework.</div>
      </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>How This Guidance Became Part of IFRS 2</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely instructive absorption case</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The IASB concluded IFRIC 11's group or treasury share transaction logic was FUNDAMENTAL enough to IFRS 2's overall scope that it should be embedded DIRECTLY within the standard. Via 2009 amendments to IFRS 2 (effective for periods beginning on or after 1 January 2010), IFRIC 11's substance was FOLDED INTO IFRS 2 itself, and IFRIC 11 was FORMALLY WITHDRAWN.</div>
      </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Common Historical Application Areas</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where this analysis was most frequently applied</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Multinational groups whose employees at various subsidiaries participate in a GLOBAL parent's equity incentive plan are a common application context — the subsidiary must recognise its OWN share-based payment expense even though shares are ultimately issued by the foreign parent, an application governed today by IFRS 2's own absorbed group transaction guidance.</div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Historical disclosure expectations</div>
        <div class="check-list">
          <span>Nature of group share-based payment arrangements involving the reporting entity</span>
          <span>Basis for equity-settled vs cash-settled classification at the subsidiary level</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Judgments & Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where judgement historically mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether the subsidiary had any obligation to settle awards in cash</span>
              <span>Identifying which group entity bore the ultimate settlement obligation</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Fair value of the parent's equity instruments granted, measured per IFRS 2's general model</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRIC 11 vs Current IFRS 2 Approach</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive historical-to-current comparison</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRIC 11 (historical)</span><span>IFRS 2 (current)</span></div>
          <div class="tr cols-12-1-1"><span>Treasury share settlement classification</span><span>Equity-settled regardless of settlement mechanism</span><span>SUBSTANTIALLY PRESERVED, embedded directly in the standard's own group transaction requirements</span></div>
          <div class="tr alt cols-12-1-1"><span>Group transaction subsidiary classification</span><span>Depends on the subsidiary's own settlement obligation</span><span>IDENTICAL logic, now part of IFRS 2's own text</span></div>
        </div>
        <div class="note">IFRIC 11 stands out, alongside IFRIC 4, 8, and 9, as a withdrawn interpretation whose CORE LOGIC survives almost entirely intact within its parent standard.</div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where IFRIC 11 determinations historically fed into</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Item</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Subsidiary's share-based payment expense</span><span><span class="badge bp">P&L</span> <span class="badge be">Equity</span></span><span>Recognised in the subsidiary's own standalone financial statements</span></div>
          <div class="tr alt cols-16-1-14"><span>Parent's corresponding investment increase</span><span><span class="badge bs">SOFP</span></span><span>Recognised in the parent's own standalone or separate financial statements</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 2</span><span>The CURRENT standard, absorbing IFRIC 11's group or treasury share logic directly</span></div>
          <div class="tr alt cols-08-2"><span>IFRIC 8</span><span>A related historical interpretation on IFRS 2 scope, also absorbed into the standard</span></div>
          <div class="tr cols-08-2"><span>IAS 27</span><span>Governs the parent's separate financial statement investment recognition</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Deemed capital contribution</div>
          <div class="glossary-def">The equity increase a parent recognises corresponding to a subsidiary's share-based payment expense under a group arrangement.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Fellow subsidiary</div>
          <div class="glossary-def">A sister entity within the same group, potentially granting rights to another subsidiary's employees under IFRIC 11's historical Part B scope.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Treasury shares", definition: "An entity's own previously issued shares, reacquired and potentially used to settle share-based payment obligations." },
      { term: "Group share-based payment transaction", definition: "An arrangement where one group entity grants rights to equity instruments to employees of another group entity." },
      { term: "Deemed capital contribution", definition: "The equity increase a parent recognises corresponding to a subsidiary's share-based payment expense under a group arrangement." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRIC11} />
  </section>
</StandardPageLayout>




