---
/*
FrameworkRail

Narrow left column of the two-part standards sidebar. Shows Home plus the
8 core frameworks (IAS, IFRS, Ind AS, US GAAP, UK GAAP, ASBE, ASPE, HGB);
IFRS's sub-frameworks (Sustainability, Publications, for SMEs, IFRIC, SIC)
render as subfolders inside the IFRS panel rather than as their own rail item.
DRS standards appear inside the HGB panel. Japan GAAP is intentionally hidden.

Icons: IAS/IFRS use globe icons; IPSAS uses a book with a globe marker;
all other rail frameworks use a book icon. Flags are shown at the top-right
of national framework rail items.

The active item is resolved server-side from the URL for first paint /
no-JS correctness; rail-panel.js takes over for client-side switching
without a full page reload.
*/

import { FRAMEWORK_CONFIG } from "../data/frameworks";
import FrameworkGlobe from "./FrameworkGlobe.astro";
import FrameworkBook from "./FrameworkBook.astro";
import FrameworkBookGlobe from "./FrameworkBookGlobe.astro";

const RAIL_FRAMEWORKS = ["ias", "ifrs", "ipsas", "indas", "usgaap", "ukgaap", "asbe", "aspe", "hgb"] as const;

const NATIONAL_FRAMEWORKS = new Set(["indas", "usgaap", "ukgaap", "asbe", "aspe", "hgb"]);

const FLAG_MAP: Record<string, string> = {
  indas: "/svg/india-flag.svg",
  usgaap: "/svg/united-flag.svg",
  ukgaap: "/svg/uk-flag.svg",
  asbe: "/svg/china-flag.svg",
  aspe: "/svg/canada-flag.svg",
  hgb: "/svg/germany-flag.svg",
};

function resolveActiveFramework(pathname: string) {
  if (pathname.startsWith("/ifrs") || pathname.startsWith("/ifric") || pathname.startsWith("/sic")) return "ifrs";
  if (pathname.startsWith("/ipsas")) return "ipsas";
  if (pathname.startsWith("/ias")) return "ias";
  if (pathname.startsWith("/indas")) return "indas";
  if (pathname.startsWith("/usgaap")) return "usgaap";
  if (pathname.startsWith("/ukgaap")) return "ukgaap";
  if (pathname.startsWith("/asbe")) return "asbe";
  if (pathname.startsWith("/aspe")) return "aspe";
  if (pathname.startsWith("/japangaap")) return "japangaap";
  if (pathname.startsWith("/hgb") || pathname.startsWith("/germany/drs")) return "hgb";
  return "home";
}

const active = resolveActiveFramework(Astro.url.pathname);
---

<nav class="framework-rail" data-rail aria-label="Frameworks">
  <a
    href="/"
    class="rail-item"
    data-rail-item="home"
    aria-current={active === "home" ? "page" : undefined}
  >
    <span class="rail-icon-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    </span>
    <span>Home</span>
  </a>

  <div class="rail-divider" role="separator"></div>

  {
    RAIL_FRAMEWORKS.map((id) => {
      const fw = FRAMEWORK_CONFIG[id];
      const isNational = NATIONAL_FRAMEWORKS.has(id);
      const isInternational = !isNational;
      const flagSrc = isNational ? FLAG_MAP[id] ?? null : null;

      return (
        <button
          type="button"
          class:list={["rail-item", active === id && "active"]}
          data-rail-item={id}
          aria-current={active === id ? "page" : undefined}
        >
          <span class="rail-icon-wrap">
            {id === "ipsas" ? (
              <FrameworkBookGlobe frameworkId={id} />
            ) : isInternational ? (
              <FrameworkGlobe frameworkId={id} />
            ) : (
              <FrameworkBook frameworkId={id} />
            )}
            {flagSrc && (
              <img
                class="rail-flag"
                src={flagSrc}
                alt=""
                aria-hidden="true"
                width="15"
                height="15"
              />
            )}
          </span>
          <span>{fw.displayName}</span>
        </button>
      );
    })
  }
</nav>
