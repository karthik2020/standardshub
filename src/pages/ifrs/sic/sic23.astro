---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/sic/sic23.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-23 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-23 was withdrawn in March 2003 when the IASB issued a revised IAS 16 Property, Plant and Equipment, which superseded SIC-23 by incorporating major inspection cost treatment directly into IAS 16.14 and .70 as part of component accounting."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ias/ias16"
    linkText="IAS 16 Property, Plant and Equipment"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-23 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-23 addressed</div>
        <div class="principle">SIC-23 addressed whether major inspection or overhaul costs of property, plant and equipment should be capitalised or expensed. It considered whether such costs should be recognised as a separate component of an asset if they were incurred to replace part of an asset, or whether they should be treated as repairs and maintenance.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-23 concluded that major inspection or overhaul costs should be recognised as a replacement component of an asset, capitalised as part of the carrying amount of the asset, if the conditions for recognition were met. The cost should be depreciated over the intervals between inspections or overhauls, and any remaining carrying amount should be derecognised when the asset is inspected or overhauled.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IAS 16 Property, Plant and Equipment</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2003 revision incorporated major inspection cost treatment directly into IAS 16.14 and .70</span></div>
          <div class="tr"><span>Current status</span><span>Withdrawn</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Component accounting", definition: "An approach under IAS 16 where an entity separately depreciates significant parts of an item of property, plant and equipment." },
      { term: "Inspection cost", definition: "A cost incurred to determine whether major servicing is required, or a cost that is part of a planned major inspection programme." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC23} />
  </section>
</StandardPageLayout>




