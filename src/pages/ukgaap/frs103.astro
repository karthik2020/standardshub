---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ukgaap/frs103.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "Continuation of Existing Insurance Accounting Practices" },
        { id: "s4", label: "The Liability Adequacy Test" },
        { id: "s5", label: "Insurance Contract Classification — Significant Insurance Risk" },
        { id: "s6", label: "THE KEY DIVERGENCE — FRS 103 Is Based on the Superseded IFRS 4, Not IFRS 17" },
        { id: "s7", label: "Worked Example — Insurance Risk Classification" },
        { id: "s8", label: "Worked Example — the Liability Adequacy Test" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "FRS 103 vs IFRS 17 — Comprehensive Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">A supplementary standard, continuing existing practice rather than prescribing a new model</div><div class="principle">FRS 103 sits ALONGSIDE FRS 102 (or FRS 101), supplementing the general framework for entities that ISSUE insurance contracts. Rather than PRESCRIBING a comprehensive new measurement model, FRS 103 largely permits INSURERS to CONTINUE their EXISTING accounting practices for insurance liabilities — an approach directly INHERITED from the OLD international standard IFRS 4, which itself was always intended as a TEMPORARY, interim solution pending a more comprehensive international project (which has SINCE concluded internationally with IFRS 17, but which FRS 103 has NOT adopted an equivalent of — Section 6).</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Entities issuing insurance contracts</div><div class="principle">FRS 103 applies to entities that ISSUE insurance contracts (transferring significant insurance risk from a policyholder to the insurer) or REINSURANCE contracts, supplementing whichever primary standard (FRS 102 or FRS 101) otherwise applies to the entity.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Continuation of Existing Insurance Accounting Practices</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">A genuine "grandfather your practice" relief, much like IFRS 4 historically was</div><div class="principle">FRS 103 largely permits an insurer to CONTINUE applying its EXISTING accounting policies for insurance CONTRACTS (measurement of insurance liabilities, recognition of acquisition costs, and so on) — SUBJECT to certain baseline improvements (e.g. the liability adequacy test, Section 4) and PROHIBITIONS on introducing NEW practices that would move FURTHER away from general accounting principles. This "continue existing practice" approach closely MIRRORS how the OLD international standard IFRS 4 operated before being SUPERSEDED internationally by IFRS 17.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>The Liability Adequacy Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">A minimum check that recognised liabilities are sufficient</div><div class="principle">At EACH reporting date, an insurer must assess whether its RECOGNISED insurance liabilities are ADEQUATE, using CURRENT estimates of future cash flows under its insurance contracts. If the assessment shows the CARRYING amount is INADEQUATE, the ENTIRE deficiency is recognised IMMEDIATELY in the Profit and Loss Account — a baseline MINIMUM adequacy check layered on top of whatever EXISTING measurement policy the insurer otherwise applies.</div>
      </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Insurance Contract Classification — Significant Insurance Risk</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">A contract must transfer SIGNIFICANT insurance risk to qualify</div><div class="principle">A contract is classified as an "INSURANCE CONTRACT" under FRS 103 only if it transfers SIGNIFICANT insurance risk — broadly, the possibility that the insurer will need to pay SIGNIFICANTLY MORE in a scenario where an insured event occurs than it would otherwise. Contracts that do NOT transfer significant insurance risk (e.g. purely investment-linked contracts with no meaningful insurance element) are instead accounted for as FINANCIAL INSTRUMENTS under the general FRS 102 (Sections 11/12) framework.</div>
      </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>THE KEY DIVERGENCE — FRS 103 Is Based on the Superseded IFRS 4, Not IFRS 17</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">A second-order divergence — FRS 103 hasn't followed IFRS's own subsequent overhaul</div><div class="principle">Internationally, IFRS 4 (the standard FRS 103 was originally modelled on) has been <strong>SUPERSEDED by IFRS 17</strong> — a WHOLESALE replacement introducing a fundamentally NEW insurance measurement architecture (fulfillment cash flows PLUS a contractual service margin representing unearned profit, released over the coverage period — see the companion ASC 944 poster for full mechanics). <strong>FRS 103 has NOT been updated to incorporate an equivalent of IFRS 17</strong> — UK and Irish insurers reporting under FRS 102/103 CONTINUE to apply FRS 103's OLDER, IFRS-4-STYLE "continue existing practice" approach, UNLESS they separately elect to apply FULL IFRS (which WOULD then require IFRS 17). This is a genuinely NOTABLE, well-recognised divergence — NOT merely between UK GAAP and IFRS in general, but a case where UK GAAP's insurance standard has NOT kept pace with IFRS's OWN subsequent, comprehensive reform of the SAME topic area — mirroring, at the UK-GAAP-vs-IFRS level, a similar structural gap to the one between ASC 944 (US GAAP, largely traditional model with LDTI improvements) and IFRS 17 discussed in the US GAAP poster series.</div>
      </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Worked Example — Insurance Risk Classification</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Distinguishing genuine insurance contracts from investment contracts</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A term life policy vs a pure investment bond</div><div class="wk-body">An insurer issues (a) a term life insurance policy paying a lump sum significantly greater than the accumulated premiums if the policyholder dies during the term, and (b) an investment bond with no life cover element, simply tracking an underlying fund's value.</div><div class="wk-answer">Policy (a) transfers SIGNIFICANT insurance risk (a materially larger payout on death) and is classified as an <strong>INSURANCE CONTRACT</strong> under FRS 103. Policy (b), having NO meaningful insurance risk element, is classified as a <strong>FINANCIAL INSTRUMENT</strong>, accounted for under FRS 102's general financial instruments sections instead.</div></div>
      </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — the Liability Adequacy Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Topping up an inadequate reserve</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A general insurer's claims reserve</div><div class="wk-body">An insurer's recognised insurance liability for a book of motor policies is £40,000,000. A current estimate of future cash flows under these contracts indicates the liability should be £43,500,000.</div><div class="wk-answer">Since the CURRENT estimate (£43,500,000) EXCEEDS the recognised carrying amount (£40,000,000), the insurer recognises the FULL £3,500,000 DEFICIENCY immediately in the Profit and Loss Account — topping up the recognised liability to reflect the adequacy test's result.</div></div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">What FRS 103 requires</div><div class="check-list"><span>Accounting policies for insurance contracts and how they've been applied</span><span>Amounts arising from insurance contracts, and the assumptions underlying their measurement</span><span>Insurance risk exposures and how they're managed</span></div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments & Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether a contract transfers significant insurance risk, warranting classification as an insurance contract</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Current estimates of future cash flows used in the liability adequacy test</span><span>Actuarial assumptions underlying existing insurance liability measurement practices</span></div></div></div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>FRS 103 vs IFRS 17 — Comprehensive Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Comparison — FRS 103 vs IFRS 17</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">FRS 103</span><span style="color:var(--color-text-info);">IFRS 17</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Overall measurement architecture</span><span>Continuation of EXISTING practice, minimal prescription</span><span>Comprehensive NEW architecture — fulfillment cash flows plus contractual service margin</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Day-one profit</span><span>Can arise, depending on existing practice</span><span>EXPLICITLY prevented — deferred in the CSM, released over coverage</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Minimum adequacy check</span><span>Liability adequacy test (Section 4)</span><span>Not a distinct concept — inherent in the fulfillment cash flow remeasurement approach</span></div>
      </div>
      <div class="note">This is a genuinely significant, PRACTICAL divergence for the UK insurance sector — insurers reporting under FRS 102/103 report on a MEANINGFULLY different basis than those (or their group parents) reporting under full IFRS with IFRS 17.</div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Where every FRS 103 event lands</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
      <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Insurance liability measurement</span><span><span class="badge bs">BS / SOFP</span></span><span>Per the insurer's existing, continued accounting policy</span></div>
      <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Liability adequacy deficiency</span><span><span class="badge bs">BS / SOFP</span> <span class="badge bp">P&amp;L / SOPL</span></span><span>Recognised immediately if the test identifies a shortfall</span></div>
      </div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
      <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>FRS 102</span><span>Supplies the general framework FRS 103 supplements, including the treatment of non-insurance-risk-transferring contracts</span></div>
      <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>FRS 104</span><span>Governs interim reporting for entities within the FRS 102/103 suite, including insurers</span></div>
      </div>
      </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
      <div class="glossary-item"><div class="glossary-term">Significant insurance risk</div><div class="glossary-def">The transfer of meaningfully greater potential payout risk that qualifies a contract as an insurance contract under FRS 103.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Liability adequacy test</div><div class="glossary-def">A minimum assessment, at each reporting date, of whether recognised insurance liabilities are sufficient based on current cash flow estimates.</div></div>
      </div>
    </div>

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.frs103 || []} />
  </section>
</StandardPageLayout>
