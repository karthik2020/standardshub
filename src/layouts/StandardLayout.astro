---
import "../styles/site.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title} | StandardsHub</title>
</head>

<body>

  <div class="layout">

    <Sidebar />

    <main class="content">
      <slot />
    </main>

  </div>

  <script is:inline src="/js/sidebar.js"></script>

</body>

</html>