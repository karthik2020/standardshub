---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas34.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Minimum Components of an Interim Report" },
        { id: "s4", label: "The Discrete vs Integral Approach" },
        { id: "s5", label: "Recognition & Measurement Principles" },
        { id: "s6", label: "Seasonal, Cyclical, or Occasional Revenue" },
        { id: "s7", label: "SEBI LODR Quarterly Reporting — The Indian Regulatory Driver" },
        { id: "s8", label: "Materiality for Interim Reporting" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 34 vs IAS 34 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Same interim principles as IAS 34, mandatory Indian trigger</div>
        <div class="principle">Ind AS 34 shares IAS 34's core content — it prescribes the MINIMUM content of an interim financial report and the recognition/measurement principles to be applied, treating each interim period as part of a LARGER annual period (the "integral" view for most items). Where Ind AS 34 genuinely diverges in PRACTICE is that SEBI's LODR Regulations MANDATE quarterly reporting for Indian listed companies using a SPECIFIC prescribed format — a legal trigger and presentation overlay IAS 34 itself does not impose (since IAS 34 leaves the DECISION of whether to require interim reporting to local regulation).</div>
        <div class="elabel">HOW IND AS 34 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Timeliness</strong> — more frequent reporting provides users with more current information — identical rationale to IAS 34</span>
          <span><strong>SEBI LODR format overlay</strong> — Regulation 33 prescribes SPECIFIC line items and a standardised format for Indian listed company quarterly results, going beyond IAS 34's own more flexible minimum content requirements</span>
        </div>
        <div class="note">This is NOT a divergence in Ind AS 34's own accounting PRINCIPLES from IAS 34 — it is a genuinely Indian REGULATORY trigger and presentation overlay, comparable in character to Schedule III's role for Ind AS 1.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The integral view — identical to IAS 34</div>
        <div class="formula-box formula-box--chip"><div class="f-eq">Each interim period = an integral part of the larger annual period (for most recognition/measurement purposes)</div></div>
        <div class="callout info callout--chip callout--flush">IDENTICAL conceptual approach to IAS 34.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 34 covers</div>
        <div class="principle">Ind AS 34 prescribes minimum content and recognition/measurement principles for interim financial reports — IDENTICAL scope to IAS 34. Neither standard itself MANDATES interim reporting; this is left to jurisdictional regulation.</div>
        <div class="note">In India, SEBI's LODR Regulations are the operative TRIGGER for Ind AS 34's mandatory application for listed companies.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Interim period</div>
          <div class="glossary-def">IDENTICAL definition to IAS 34 — a financial reporting period shorter than a full financial year.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">SEBI LODR Regulation 33</div>
          <div class="glossary-def">The specific SEBI regulation prescribing the format and timeline for Indian listed companies' quarterly financial results.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — MINIMUM COMPONENTS ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Minimum Components of an Interim Report</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical minimum components to IAS 34</div>
        <div class="text-supporting">Condensed balance sheet, condensed P&amp;L statement, condensed statement of changes in equity, condensed cash flow statement, and selected explanatory notes — IDENTICAL minimum requirements to IAS 34 (though SEBI LODR's own format may require additional specific line items).</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — DISCRETE VS INTEGRAL (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>The Discrete vs Integral Approach</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical integral view to IAS 34</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Annual bonus accrual across quarters</div>
          <div class="wk-body">An Indian company expects to pay an annual performance bonus of ₹40,00,000, expected to accrue evenly based on cumulative annual performance across all four quarters.</div>
          <div class="wk-answer">₹10,00,000 (₹40,00,000 ÷ 4) is recognised as an EXPENSE in EACH quarter, treating each interim period as an INTEGRAL part of the annual period — an IDENTICAL approach to how IAS 34 would treat the same annual bonus accrual globally, rather than a purely "discrete period" approach that would ignore the annual context.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — RECOGNITION & MEASUREMENT ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Recognition &amp; Measurement Principles</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 34</div>
        <div class="text-supporting">The SAME accounting policies applied in annual financial statements are applied in interim reports — IDENTICAL to IAS 34, with NO separate "interim-only" recognition/measurement basis (other than specific items like income tax, discussed via estimated ANNUAL effective tax rate).</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — SEASONAL/ CYCLICAL REVENUE ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Seasonal, Cyclical, or Occasional Revenue</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 34</div>
        <div class="text-supporting">Revenue that is SEASONAL or CYCLICAL within a financial year is recognised as/when it OCCURS, NOT anticipated or deferred to smooth results across interim periods — IDENTICAL to IAS 34, relevant for Indian sectors with pronounced seasonality (e.g. agriculture-linked FMCG, festive-season retail).</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — SEBI LODR ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>SEBI LODR Quarterly Reporting — The Indian Regulatory Driver</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">The single most important practical Indian consideration</div>
        <div class="text-supporting">SEBI's LODR Regulations REQUIRE every Indian listed company to submit QUARTERLY financial results within a PRESCRIBED timeline (typically 45 days of quarter-end, 60 days for the final quarter), using Regulation 33's SPECIFIC format — which includes particular line items (e.g. EPS, segment information extracts) beyond Ind AS 34's own more flexible minimum content list. This is a genuinely Indian REGULATORY trigger and presentation template, operating ALONGSIDE (not modifying) Ind AS 34's own recognition/measurement principles.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — MATERIALITY ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Materiality for Interim Reporting</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 34</div>
        <div class="text-supporting">Materiality is assessed in relation to INTERIM period financial data (not annual data), which can result in MORE items being disclosed at the interim level relative to their annual significance — IDENTICAL principle to IAS 34.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 34, plus SEBI LODR specifics</div>
        <div class="check-list">
          <span>Statement of compliance with Ind AS 34</span>
          <span>Explanatory notes on significant events/transactions since the last annual report</span>
          <span>SEBI LODR-specific line items (e.g. EPS, segment extracts) per Regulation 33's prescribed format</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Discrete vs integral treatment for specific cost categories</span>
              <span>Materiality assessment at the interim level</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Estimated ANNUAL effective tax rate applied to interim period profit</span>
              <span>Interim inventory/impairment estimates using less complete information than year-end</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">Indian listed companies must balance Ind AS 34's own principles with SEBI LODR's SPECIFIC format and tight filing timelines — a genuinely demanding compliance rhythm distinct from jurisdictions without a comparable mandatory quarterly reporting regime.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 34 vs IAS 34 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 34 vs IAS 34 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 34</span><span>Ind AS 34</span></div>
          <div class="tr cols-12-1-1"><span>Recognition/measurement principles, integral view, minimum components</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Mandatory trigger and presentation format</span><span>Left to jurisdictional regulation — IAS 34 itself is neutral</span><span>SEBI LODR Regulation 33 mandates QUARTERLY reporting for listed companies, in a SPECIFIC prescribed format</span></div>
        </div>
        <div class="note">Ind AS 34's own PRINCIPLES are essentially IDENTICAL to IAS 34 — SEBI LODR's quarterly reporting mandate and format is a genuinely significant Indian REGULATORY overlay, not a modification of Ind AS 34 itself.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Condensed interim P&amp;L</span><span><span class="badge bp">P&amp;L</span></span><span>Identical to IAS 34's minimum content requirement</span></div>
          <div class="tr alt cols-16-1-14"><span>Condensed interim balance sheet</span><span><span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 34</span></div>
          <div class="tr cols-16-1-14"><span>SEBI LODR EPS/segment extracts</span><span><span class="badge bp">P&amp;L</span> <span class="badge bp">Notes</span></span><span>Additional Indian regulatory presentation requirement</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 34</span><span>The global counterpart standard, converged with an Indian regulatory trigger/format overlay</span></div>
          <div class="tr alt cols-08-2"><span>SEBI LODR Regulations, Regulation 33</span><span>Mandates quarterly reporting and prescribes the Indian listed company format</span></div>
          <div class="tr cols-08-2"><span>Ind AS 33</span><span>Supplies the EPS calculation required within SEBI LODR's quarterly format</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Integral view</div>
          <div class="glossary-def">Treating each interim period as part of the larger annual period for most recognition/measurement purposes — identical to IAS 34.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">SEBI</div>
          <div class="glossary-def">Securities and Exchange Board of India — the regulator whose LODR Regulations mandate quarterly reporting for Indian listed companies.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Integral view", definition: "Treating each interim period as part of the larger annual period for most recognition/measurement purposes — identical to IAS 34." },
      { term: "SEBI", definition: "Securities and Exchange Board of India — the regulator whose LODR Regulations mandate quarterly reporting for Indian listed companies." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
