---
// AppShell Layout Component
// Reusable shell structure for StandardsHub v2
// Created as part of Sprint 1.1
---

<!-- Header -->
<header class="app-header">
  <slot name="header" />
</header>

<!-- Breadcrumb navigation -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <slot name="breadcrumb" />
</nav>

<!-- Application layout: three sibling columns -->
<div class="app-layout">
  <!-- Documentation Explorer -->
  <aside class="documentation-explorer" aria-label="Documentation Explorer">
    <slot name="sidebar" />
  </aside>

  <!-- Main Content -->
  <main class="content-slot">
    <slot />
  </main>

  <!-- Table of Contents -->
  <aside class="table-of-contents" aria-label="Table of Contents">
    <slot name="toc" />
  </aside>
</div>

<!-- Footer -->
<footer class="app-footer">
  <slot name="footer" />
</footer>
