---
/*
Journal entry

Minimal two-line debit / credit display.

Props:
- dr
- cr

Renders labelled debit and credit lines with no additional formatting.
*/

interface Props {
  cr: string;
}

const {
  dr,
  cr
} = Astro.props;
---

<div class="journal-entry">

  <div class="je-line">
    <span class="je-dr">Dr</span>
    {dr}
  </div>

  <div class="je-line">
    <span class="je-cr">Cr</span>
    {cr}
  </div>

</div>