---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas23.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Qualifying Assets" },
        { id: "s4", label: "Capitalisation – Specific Borrowings" },
        { id: "s5", label: "Capitalisation – General Borrowings" },
        { id: "s6", label: "Commencement, Suspension, Cessation" },
        { id: "s7", label: "Indian Infrastructure & Real Estate Context" },
        { id: "s8", label: "Investment Income Offset" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 23 vs IAS 23 – Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical mandatory capitalisation philosophy to IAS 23</div>
        <div class="principle">Ind AS 23 applies the IDENTICAL principle as IAS 23 – borrowing costs DIRECTLY ATTRIBUTABLE to the acquisition, construction, or production of a QUALIFYING ASSET are CAPITALISED as part of the asset's cost; all other borrowing costs are expensed as incurred.</div>
        <div class="elabel">HOW IND AS 23 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Faithful representation</strong> – reflecting the TRUE total cost of bringing a qualifying asset to its intended use – identical to IAS 23</span>
          <span><strong>No expensing option</strong> – capitalisation is MANDATORY (not a choice), IDENTICAL to IAS 23's own post-2007 revision removing the prior expensing alternative</span>
        </div>
        <div class="note">Ind AS 23 introduced NO substantive change to this model relative to IAS 23 – its practical Indian relevance is most pronounced for the LARGE infrastructure, real estate, and EPC sectors with long-duration qualifying asset construction periods.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The core rule – identical to IAS 23</div>
        <div class="formula-box"><div class="f-eq">Borrowing costs directly attributable to a qualifying asset = CAPITALISED as part of its cost</div></div>
        <div class="callout info callout--flush">IDENTICAL mandatory rule to IAS 23 – no Indian-specific modification.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 23 covers</div>
        <div class="principle">Ind AS 23 applies to borrowing costs, EXCLUDING those addressed by Ind AS 102 (share-based payment) or capitalised under Ind AS 41's fair value approach – IDENTICAL scope to IAS 23, and EXCLUDING qualifying assets measured at fair value (e.g. biological assets) or inventories manufactured in large quantities on a repetitive basis.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Qualifying asset</div>
          <div class="glossary-def">IDENTICAL definition to IAS 23 – an asset that necessarily takes a SUBSTANTIAL period of time to get ready for its intended use or sale.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Capitalisation rate</div>
          <div class="glossary-def">The weighted average of borrowing costs applicable to GENERAL borrowings outstanding during the period, identical concept to IAS 23.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 – QUALIFYING ASSETS ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Qualifying Assets</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical criteria to IAS 23</div>
        <div class="text-supporting">Examples include inventories requiring substantial time to bring to a saleable condition, manufacturing plants, power generation facilities, and investment properties under construction – IDENTICAL examples to IAS 23, genuinely common for Indian infrastructure and real estate developers.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – CAPITALISATION SPECIFIC BORROWINGS ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Capitalisation – Specific Borrowings (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical to IAS 23</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Specific loan for a qualifying asset</div>
          <div class="wk-body">An Indian real estate developer borrows ₹50,00,00,000 SPECIFICALLY to fund construction of a residential tower, incurring ₹5,00,00,000 of interest during the year, while temporarily investing surplus drawn-down funds to earn ₹40,00,000 of interest income before use.</div>
          <div class="wk-answer">Borrowing costs ELIGIBLE for capitalisation = ₹5,00,00,000 − ₹40,00,000 (temporary investment income) = ₹4,60,00,000 – an IDENTICAL net capitalisation calculation to how IAS 23 would treat the same specific borrowing scenario globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 – CAPITALISATION GENERAL BORROWINGS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Capitalisation – General Borrowings</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical weighted average capitalisation rate approach to IAS 23</div>
        <div class="text-supporting">Where general borrowings fund a qualifying asset, a WEIGHTED AVERAGE capitalisation rate is applied to expenditure on the asset, capped at actual borrowing costs incurred – IDENTICAL methodology to IAS 23.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 – COMMENCEMENT, SUSPENSION, CESSATION ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Commencement, Suspension, Cessation of Capitalisation</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical three-condition test to IAS 23</div>
        <div class="text-supporting">Capitalisation begins when expenditure/borrowing costs are being incurred AND activities to prepare the asset are in progress; SUSPENDED during extended periods of interruption; CEASES when substantially all activities to prepare the asset are complete – IDENTICAL to IAS 23.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 – INDIAN INFRASTRUCTURE & REAL ESTATE ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Indian Infrastructure &amp; Real Estate Sector Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A practically prominent Indian application area</div>
        <div class="text-supporting">India's LARGE infrastructure, power, and real estate development sectors frequently involve MULTI-YEAR construction periods for qualifying assets, making Ind AS 23's capitalisation mechanics genuinely significant for these entities' reported asset costs and profitability during the construction phase. Real estate developers in particular must carefully track project-specific borrowings against Ind AS 115's control transfer criteria (see Ind AS 115 poster) to ensure capitalised interest aligns correctly with the asset's construction timeline.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 – INVESTMENT INCOME OFFSET ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Investment Income Offset</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 23</div>
        <div class="text-supporting">Investment income earned on the TEMPORARY investment of specific borrowings, PENDING their expenditure on the qualifying asset, is DEDUCTED from borrowing costs eligible for capitalisation – IDENTICAL to IAS 23.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 23</div>
        <div class="check-list">
          <span>Amount of borrowing costs capitalised during the period</span>
          <span>Capitalisation rate used for general borrowings</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether an asset meets the "substantial period of time" qualifying asset threshold</span>
              <span>Determining when active development has commenced/suspended/ceased</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Weighted average capitalisation rate for general borrowings</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">Indian real estate developers with MULTIPLE ongoing projects funded by a MIX of specific and general borrowings must carefully allocate borrowing costs, a genuinely common practical complexity.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 – IND AS 23 vs IAS 23 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 23 vs IAS 23 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 23</span><span>Ind AS 23</span></div>
          <div class="tr cols-12-1-1"><span>Mandatory capitalisation model, qualifying asset definition</span><span>Standard model</span><span>IDENTICAL – no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Practical application context</span><span>Varies by jurisdiction/industry</span><span>Especially prominent in India's large infrastructure/real estate development sectors</span></div>
        </div>
        <div class="note">Ind AS 23 is essentially IDENTICAL to IAS 23 in substance – its distinctive Indian relevance lies in the SCALE and FREQUENCY of qualifying asset construction in the infrastructure/real estate sectors, not any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Capitalised borrowing costs</span><span><span class="badge bs">Balance Sheet</span></span><span>Added to the qualifying asset's cost</span></div>
          <div class="tr alt cols-16-1-14"><span>Non-capitalised borrowing costs</span><span><span class="badge bp">P&amp;L</span></span><span>Expensed as incurred, identical to IAS 23</span></div>
          <div class="tr cols-16-1-14"><span>Temporary investment income offset</span><span><span class="badge bs">Balance Sheet</span></span><span>Reduces the amount capitalised</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 23</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 16</span><span>Governs the qualifying asset's overall cost, into which borrowing costs are capitalised</span></div>
          <div class="tr cols-08-2"><span>Ind AS 2</span><span>Applies for qualifying inventories requiring a substantial preparation period</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Substantial period of time</div>
          <div class="glossary-def">The threshold for qualifying asset status – not precisely defined, requiring judgement, identical to IAS 23.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Capitalisation rate</div>
          <div class="glossary-def">The weighted average borrowing cost rate applied to general borrowings-funded qualifying asset expenditure.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Qualifying asset", definition: "An asset that necessarily takes a SUBSTANTIAL period of time to get ready for its intended use or sale – identical definition to IAS 23." },
      { term: "Capitalisation rate", definition: "The weighted average of borrowing costs applicable to general borrowings outstanding during the period – identical concept to IAS 23." },
      { term: "Substantial period of time", definition: "The threshold for qualifying asset status – not precisely defined, requiring judgement, identical to IAS 23." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
