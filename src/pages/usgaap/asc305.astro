---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc305.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "s1",
          label: "Conceptual Framework Linkage",
        },
        {
          id: "s2",
          label: "Scope & Applicability",
        },
        {
          id: "s3",
          label: "Definition of Cash Equivalents",
        },
        {
          id: "s4",
          label: "Restricted Cash — Cross-Reference",
        },
        {
          id: "s5",
          label: "Compensating Balance Arrangements",
        },
        {
          id: "s6",
          label: "Overdrafts",
        },
        {
          id: "s7",
          label: "Worked Example — Classifying Short-Term Investments",
        },
        {
          id: "s8",
          label: "Worked Example — Compensating Balance Disclosure",
        },
        {
          id: "s9",
          label: "Disclosure Requirements",
        },
        {
          id: "s10",
          label: "Critical Judgments & Estimates",
        },
        {
          id: "s11",
          label: "ASC 305 vs IAS 7's Cash Equivalents Definition",
        },
        {
          id: "s12",
          label: "Statement Mapping",
        },
        {
          id: "s13",
          label: "Related Topics",
        },
        {
          id: "s14",
          label: "Glossary",
        },
        {
          id: "history",
          label: "History & Development",
        },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">The most liquid, least judgement-laden asset — until classification questions arise</div><div class="principle">Cash itself requires little measurement judgement, but drawing the LINE between "cash equivalents" and other short-term investments carries real consequences for balance sheet classification and cash flow statement presentation. ASC 305 supplies that boundary definition, working alongside ASC 210 (presentation) and ASC 230 (cash flow statement) to determine what counts as cash for reporting purposes.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Applies to all entities</div><div class="principle">ASC 305 applies to all entities holding cash and short-term investments potentially qualifying as cash equivalents — a foundational, universally applicable Topic underlying both the Balance Sheet and the Statement of Cash Flows.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Definition of Cash Equivalents</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">Short-term, highly liquid, readily convertible</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">Cash equivalents are SHORT-TERM, HIGHLY LIQUID investments that are (a) READILY CONVERTIBLE to known amounts of cash, and (b) SO NEAR their maturity that they present INSIGNIFICANT risk of changes in value due to interest rate movements. Generally, only investments with ORIGINAL MATURITIES of THREE MONTHS OR LESS from the date of purchase qualify — the SAME three-month benchmark used under IAS 7.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Restricted Cash — Cross-Reference</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Addressed primarily in ASC 230, but foundational here too</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">RESTRICTED cash — cash whose use is limited by contract or regulation (e.g. held as loan collateral, or set aside for a specific purpose) — is addressed in detail under ASC 230 (Statement of Cash Flows), particularly following ASU 2016-18's requirement to include restricted cash in the overall cash reconciliation. ASC 305 provides the underlying cash/cash-equivalent DEFINITION that restricted cash guidance builds upon.</div>
      </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Compensating Balance Arrangements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">A distinctly named, specifically disclosed US GAAP concept</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">A COMPENSATING BALANCE is a minimum cash balance an entity agrees to maintain with a lending institution, often as an informal condition of a loan or credit arrangement, effectively restricting the entity's free use of that portion of its cash. ASC 305 specifically flags COMPENSATING BALANCE disclosure — the amount and general terms of such arrangements must be disclosed SEPARATELY from ordinary cash. This specifically NAMED concept and its dedicated disclosure requirement is more distinctly codified under US GAAP than under IAS 7, which addresses similar substance through its more general restricted-cash/undrawn-facility disclosure principles without a specifically named "compensating balance" category.</div>
      </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Overdrafts</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Cross-reference to ASC 210 and ASC 230</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">Bank overdrafts are generally NOT netted against cash and cash equivalents under US GAAP — they are classified as a current LIABILITY (short-term borrowing), consistent with the treatment described in the ASC 210 (Balance Sheet) and ASC 230 (Statement of Cash Flows) posters, in contrast to IAS 7's narrower allowance for netting overdrafts that are repayable on demand and integral to cash management.</div>
      </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Worked Example — Classifying Short-Term Investments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Applying the three-month test</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Two money market instruments purchased on the same date</div><div class="wk-body">On 1 November, an entity purchases a Treasury bill maturing 15 January (2.5 months from purchase) for $2,000,000, and a separate commercial paper investment maturing 1 May (6 months from purchase) for $1,500,000.</div><div class="wk-answer">The Treasury bill QUALIFIES as a cash equivalent (original maturity of 2.5 months, within the three-month threshold). The commercial paper does NOT qualify (original maturity of 6 months) — it is classified as a SHORT-TERM INVESTMENT instead, presented separately from cash and cash equivalents on the Balance Sheet.</div></div>
      </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — Compensating Balance Disclosure</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">A loan arrangement requiring a minimum balance</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A $500,000 minimum balance requirement</div><div class="wk-body">An entity's $5,000,000 line of credit agreement requires it to maintain a minimum $500,000 compensating balance with the lending bank throughout the facility's term.</div><div class="wk-answer">The entity discloses the $500,000 compensating balance requirement and its general terms SEPARATELY in the notes — while the $500,000 typically remains presented WITHIN cash on the Balance Sheet (since it is not formally legally restricted in the same way segregated restricted cash would be), the disclosure alerts users that this portion of reported cash is not, in practice, freely available for other uses.</div></div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">What ASC 305 requires</div><div class="check-list"><span>Policy for determining which highly liquid short-term investments are treated as cash equivalents</span><span>Amount and general terms of compensating balance arrangements</span><span>Nature of any restrictions on cash, cross-referenced with ASC 230's reconciliation requirements</span></div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">The central judgement is SELECTING and CONSISTENTLY APPLYING a policy for which highly liquid investments are treated as cash equivalents — while the three-month benchmark is a common convention, ASC 305 leaves the specific policy choice (and any narrower threshold an entity may elect) to management, applied consistently period to period.</div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>ASC 305 vs IAS 7's Cash Equivalents Definition</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Comparison — ASC 305 vs IAS 7</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">US GAAP (ASC 305)</span><span style="color:var(--color-text-info);">IFRS (IAS 7)</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Core definition</span><span>Short-term, highly liquid, readily convertible, insignificant interest rate risk</span><span>Same core concept and language — genuinely converged</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Three-month original maturity benchmark</span><span>Common convention, not a bright-line rule</span><span>Same convention, also not a strict bright-line rule</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Compensating balance as a named concept</span><span>Specifically named and disclosed</span><span>No equivalent named category — addressed through general restricted-cash disclosure principles</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Bank overdraft netting</span><span>Not permitted — always a liability</span><span>May be netted if repayable on demand and integral to cash management</span></div>
      </div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Where every ASC 305 event lands</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
      <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Classification as cash equivalent vs short-term investment</span><span><span class="badge bs">BS</span></span><span>Determines presentation caption, not measurement</span></div>
      <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Compensating balance disclosure</span><span>Notes only</span><span>No separate balance sheet reclassification typically required</span></div>
      </div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Topics</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
      <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 210</span><span>Governs presentation of cash and cash equivalents on the Balance Sheet</span></div>
      <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASC 230</span><span>Governs restricted cash reconciliation and overdraft classification in the cash flow statement</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 320</span><span>Governs debt securities that fail the cash-equivalent test but still qualify as short-term investments</span></div>
      </div>
      </div>
      <div class="card cn"><div class="ctitle cn">Quick-reference glossary preview</div>
      <div class="glossary-item"><div class="glossary-term">Compensating balance</div><div class="glossary-def">A minimum cash balance an entity agrees to maintain with a lender, effectively restricting free use of that cash.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Original maturity</div><div class="glossary-def">The maturity measured from the date of ACQUISITION by the entity, not the instrument's original issuance date — the relevant reference point for the three-month cash-equivalent test.</div></div>
      </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
      <div class="glossary-item"><div class="glossary-term">Cash equivalents</div><div class="glossary-def">Short-term, highly liquid investments readily convertible to known cash amounts, with insignificant risk of value change, generally with original maturities of three months or less.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Restricted cash</div><div class="glossary-def">Cash whose use is limited by contract or regulation, distinguished from a compensating balance by generally being a formal, legally enforceable restriction.</div></div>
      </div>
    </div>

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.ASC305 || []} />
  </section>
</StandardPageLayout>
