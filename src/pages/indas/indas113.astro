---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas113.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "The Fair Value Definition — Exit Price" },
        { id: "s4", label: "The Fair Value Hierarchy — Levels 1, 2, 3" },
        { id: "s5", label: "Valuation Techniques" },
        { id: "s6", label: "Highest and Best Use — Non-Financial Assets" },
        { id: "s7", label: "Registered Valuers — The Indian Regulatory Context" },
        { id: "s8", label: "Fair Value at Initial Recognition" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "Ind AS 113 vs IFRS 13 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical exit-price philosophy to IFRS 13</div>
        <div class="principle">Ind AS 113 applies the IDENTICAL definition as IFRS 13 — fair value is the price that would be RECEIVED to sell an asset or PAID to transfer a liability in an orderly transaction between MARKET PARTICIPANTS at the measurement date — a market-based, NOT entity-specific, exit price notion.</div>
        <div class="elabel">HOW IND AS 113 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Comparability</strong> — a SINGLE fair value framework applied consistently across all Ind AS standards requiring fair value measurement — identical to IFRS 13</span>
          <span><strong>Faithful representation</strong> — the fair value hierarchy prioritises OBSERVABLE market data over unobservable estimates — identical to IFRS 13</span>
          <span><strong>Interaction with India's valuer regulatory framework</strong> — Ind AS 113's fair value MEASUREMENT principles operate alongside the Companies Act/IBBI's Registered Valuers framework, which governs WHO is legally qualified to perform certain statutory valuations in India — a genuinely important practical, though not accounting-substantive, Indian consideration</span>
        </div>
        <div class="note">Ind AS 113 introduced NO change to the fair value definition relative to IFRS 13 — India's distinctive feature lies in its professional valuer REGULATION, not the accounting framework itself.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The three-level hierarchy — identical to IFRS 13</div>
        <div class="td-table">
          <div class="th cols-06-2"><span>Level</span><span>Input type</span></div>
          <div class="tr cols-06-2"><span>1</span><span>Quoted prices in active markets for IDENTICAL assets/liabilities</span></div>
          <div class="tr alt cols-06-2"><span>2</span><span>Observable inputs OTHER than Level 1 quoted prices</span></div>
          <div class="tr cols-06-2"><span>3</span><span>UNOBSERVABLE inputs</span></div>
        </div>
        <div class="callout info callout--chip callout--flush">IDENTICAL hierarchy structure to IFRS 13.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 113 covers</div>
        <div class="principle">Ind AS 113 applies WHEN another Ind AS requires or permits fair value measurement/disclosure — IDENTICAL "framework, not trigger" scope to IFRS 13, with the SAME scope exclusions (share-based payment, leases, NRV-based inventory measurement).</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Fair value</div><div class="glossary-def">IDENTICAL definition to IFRS 13 — an exit price notion.</div></div>
        <div class="glossary-item"><div class="glossary-term">Registered Valuer</div><div class="glossary-def">A professional registered with IBBI (Insolvency and Bankruptcy Board of India) under the Companies (Registered Valuers and Valuation) Rules, 2017, required for certain statutory Indian valuations.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — FAIR VALUE DEFINITION ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Fair Value Definition — Exit Price</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IFRS 13</div>
        <div class="text-supporting">The PRINCIPAL market (or most advantageous market, absent a principal market) determines the relevant price — IDENTICAL to IFRS 13, with NO Indian-specific modification to the underlying definition.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — FAIR VALUE HIERARCHY ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>The Fair Value Hierarchy</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical classification approach to IFRS 13</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Classifying an Indian company's fair value inputs</div>
          <div class="wk-body">An Indian company holds NSE-listed equity shares (quoted daily), a corporate bond priced using observable yield curves from comparable rated Indian bonds, and an unlisted startup equity investment valued using a discounted cash flow model with company-specific growth assumptions.</div>
          <div class="wk-answer">
            NSE-listed equity: <strong>Level 1</strong> (quoted price, active market)<br>
            Corporate bond: <strong>Level 2</strong> (observable yield curve inputs)<br>
            Unlisted startup investment: <strong>Level 3</strong> (unobservable company-specific assumptions)<br>
            An IDENTICAL classification methodology to how IFRS 13 would categorise the same instruments globally.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — VALUATION TECHNIQUES ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Valuation Techniques</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical three approaches to IFRS 13</div>
        <div class="text-supporting">Market approach, cost approach, income approach — IDENTICAL to IFRS 13, maximising observable inputs and minimising unobservable inputs.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — HIGHEST AND BEST USE ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Highest and Best Use — Non-Financial Assets</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IFRS 13</div>
        <div class="text-supporting">Fair value of a non-financial asset considers a market participant's ability to generate value through its HIGHEST AND BEST USE — IDENTICAL to IFRS 13, relevant for Ind AS 40 investment property and Ind AS 16 revaluations.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — REGISTERED VALUERS ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Registered Valuers — The Indian Regulatory Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important Indian professional regulation layer</div>
        <div class="principle">The Companies (Registered Valuers and Valuation) Rules, 2017 (under IBBI) require CERTAIN statutory valuations (e.g. for company law purposes such as mergers, share allotments) to be performed by a REGISTERED VALUER — a specific professional qualification. This governs WHO may perform certain Indian statutory valuations, operating ALONGSIDE Ind AS 113's own fair value MEASUREMENT methodology, similar in spirit to how SEBI/RBI/IRDAI regulate other specific sectors.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: Registered Valuer requirement for a share swap ratio</div>
          <div class="wk-body">An Indian company undergoing a merger under Sections 230-232 of the Companies Act, 2013 requires a fair value-based share exchange ratio determination.</div>
          <div class="wk-answer">This valuation MUST be performed by a Registered Valuer under IBBI rules — a REGULATORY requirement governing WHO performs the valuation — while the underlying fair value MEASUREMENT PRINCIPLES applied (market participant perspective, valuation techniques, hierarchy) remain governed by Ind AS 113, IDENTICAL to IFRS 13's own framework.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — FAIR VALUE AT INITIAL RECOGNITION ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Fair Value at Initial Recognition</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IFRS 13</div>
        <div class="text-supporting">Transaction price is presumed to equal fair value at initial recognition unless evidence indicates otherwise (e.g. related party transactions, forced transactions) — IDENTICAL to IFRS 13.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IFRS 13</div>
        <div class="check-list">
          <span>Fair value hierarchy classification for each class of asset/liability</span>
          <span>Valuation techniques and inputs used</span>
          <span>Level 3 reconciliation and sensitivity analysis</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Identifying the principal (or most advantageous) market</span>
              <span>Fair value hierarchy level classification</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Level 3 unobservable inputs, particularly for unlisted Indian equity/startup investments</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">For India's large UNLISTED company and startup ecosystem, Level 3 fair value estimation is genuinely prevalent and requires careful, well-documented valuation methodology, often necessitating Registered Valuer involvement for statutory purposes.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 113 VS IFRS 13 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 113 vs IFRS 13 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS 13</span><span>Ind AS 113</span></div>
          <div class="tr cols-12-1-1"><span>Fair value definition & hierarchy</span><span>Exit price, three-level hierarchy</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Statutory valuer qualification requirement</span><span>Varies by jurisdiction</span><span>IBBI's Registered Valuers framework governs WHO may perform certain Companies Act statutory valuations — a genuinely Indian regulatory layer</span></div>
        </div>
        <div class="note">Ind AS 113 is essentially IDENTICAL to IFRS 13 in substance — its distinctive Indian relevance lies in the professional Registered Valuer regulatory requirement, not any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every Ind AS 113 disclosure lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Disclosure item</span><span>Location</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Fair value hierarchy classification</span><span><span class="badge bp">Notes</span></span><span>Identical to IFRS 13</span></div>
          <div class="tr alt cols-16-1-14"><span>Level 3 reconciliation/sensitivity</span><span><span class="badge bp">Notes</span></span><span>Identical to IFRS 13</span></div>
          <div class="tr cols-16-1-14"><span>Fair value adjustment on remeasured asset</span><span><span class="badge bp">P&amp;L</span> <span class="badge bo">OCI</span> <span class="badge bs">Balance Sheet</span></span><span>Location depends on the specific Ind AS requiring the measurement</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 13</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 109 / 40 / 16</span><span>Frequently require fair value measurement using Ind AS 113's framework</span></div>
          <div class="tr cols-08-2"><span>Companies (Registered Valuers and Valuation) Rules, 2017</span><span>Governs who may perform certain Indian statutory valuations</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">IBBI</div><div class="glossary-def">Insolvency and Bankruptcy Board of India — the regulatory body overseeing India's Registered Valuers framework.</div></div>
        <div class="glossary-item"><div class="glossary-term">Principal market</div><div class="glossary-def">The market with the greatest volume/level of activity for the asset/liability — identical concept to IFRS 13.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Fair value", definition: "The price that would be received to sell an asset or paid to transfer a liability in an orderly transaction between market participants at the measurement date — IDENTICAL definition to IFRS 13." },
      { term: "Registered Valuer", definition: "A professional registered with IBBI under the Companies (Registered Valuers and Valuation) Rules, 2017, required for certain statutory Indian valuations." },
      { term: "Principal market", definition: "The market with the greatest volume/level of activity for the asset/liability — identical concept to IFRS 13." },
      { term: "Highest and best use", definition: "The use of a non-financial asset by market participants that would maximise the value of the asset — identical concept to IFRS 13." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
