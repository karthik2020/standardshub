---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/sic/sic14.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-14 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-14 was withdrawn in January 2009 when the IASB issued an amendment to IAS 16 Property, Plant and Equipment, which incorporated the 'separate events' principle for compensation directly into the standard."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ias/ias16"
    linkText="IAS 16 Property, Plant and Equipment"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-14 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-14 addressed</div>
        <div class="principle">SIC-14 addressed the accounting treatment of compensation received from third parties for the impairment or loss of property, plant and equipment. It clarified whether such compensation should be netted against the carrying amount of the impaired or lost asset or recognised as a separate item.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-14 concluded that compensation from third parties for the impairment or loss of PPE items should be treated as a separate event. The compensation receivable should be recognised as an asset when it becomes virtually certain that the compensation will be received, and it should not be netted against the carrying amount of the impaired or lost asset.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IAS 16 Property, Plant and Equipment</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2009 amendment incorporated the 'separate events' principle directly into IAS 16</span></div>
          <div class="tr"><span>Current status</span><span>Withdrawn</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Impairment", definition: "A decrease in the recoverable amount of an asset below its carrying amount, resulting in a loss that must be recognised in profit or loss." },
      { term: "Separate events", definition: "The principle that the impairment or loss of an asset and the receipt of related compensation are treated as distinct accounting events that should not be netted against each other." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC14} />
  </section>
</StandardPageLayout>
