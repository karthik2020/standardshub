---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/ifric/ifric13.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework (Historical)" },
        { id: "s2", label: "Scope & Definitions (Historical)" },
        { id: "s3", label: "Award Credits as a Separately Identifiable Component (Historical)" },
        { id: "s4", label: "Allocating Consideration — Relative Fair Value (Historical)" },
        { id: "s5", label: "Recognising Revenue on Award Redemption (Historical)" },
        { id: "s6", label: "Third-Party Loyalty Programme Operators (Historical)" },
        { id: "s7", label: "How This Guidance Became Part of IFRS 15" },
        { id: "s8", label: "Common Application Sectors" },
        { id: "s9", label: "Disclosure (Historical)" },
        { id: "s10", label: "Judgments & Estimates (Historical)" },
        { id: "s11", label: "IFRIC 13 vs the Current IFRS 15 Approach" },
        { id: "s12", label: "Statement Mapping (Historical)" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IFRIC 13 pioneered the treatment of loyalty award credits as a separate component of a sale, allocating consideration between the initial sale and the award credits based on relative fair value — a multi-element deferred revenue approach that directly foreshadowed IFRS 15's own performance obligation model. This poster is retained for historical/comparative reference."
    historical="This poster is retained for historical and comparative reference. Entities operating loyalty programmes must apply IFRS 15's performance obligation model."
    link="/ifrs/ifrs15"
    linkText="IFRS 15 Revenue from Contracts with Customers"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why loyalty credits are revenue, not marketing expense</div>
        <div class="principle">IFRIC 13 applies the Conceptual Framework's definition of a good or service and the entity's promise to transfer a good or service to a customer. Loyalty award credits are NOT a promotional expense — they represent a FUTURE right that the customer acquires at the point of sale, requiring the entity to defer part of the initial sale proceeds until that right is fulfilled.</div>
        <div class="elabel">THE CORE INSIGHT</div>
        <div class="dot-list">
          <span>The customer pays for the initial goods AND the future award right at the point of sale</span>
          <span>The entity has an OBLIGATION to transfer goods/services when credits are redeemed</span>
          <span>That obligation has a separate fair value that must be determined at the outset</span>
        </div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Deferred revenue as a faithful representation</div>
        <div class="principle">Treating loyalty credits as a separately identifiable component of a sale ensures revenue is recognised only when (or as) the entity satisfies its performance obligations. Deferring part of the initial consideration reflects that the entity has NOT yet fulfilled its promise to provide the future award — matching recognition with satisfaction.</div>
        <div class="note">This approach was the direct forerunner to the performance obligation allocation logic later codified in IFRS 15 — the Conceptual Framework underpinning IFRIC 13's reasoning remains fully consistent with IFRS 15's multi-element approach.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope & Definitions (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRIC 13 covered</div>
        <div class="principle">IFRIC 13 addressed accounting for CREDIT-BASED loyalty programmes operated by an entity, where customers accumulate award credits through purchases and can redeem those credits for FREE or DISCOUNTED goods or services. The interpretation applies whether the entity operates the programme itself or through a THIRD-PARTY operator.</div>
        <div class="elabel">TYPICAL FACT PATTERNS</div>
        <div class="dot-list">
          <span>Supermarket loyalty cards that accumulate points redeemable for groceries</span>
          <span>Airline frequent-flyer programmes where miles redeem for flights</span>
          <span>Hotel chain points programmes redeemable for free nights</span>
          <span>Petrol-station loyalty schemes offering fuel discounts or goods</span>
        </div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Award credit</div>
          <div class="glossary-def">A right granted to a customer as part of a loyalty programme, to receive a free or discounted good or service in the future.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Relative fair value</div>
          <div class="glossary-def">The proportion of the total transaction price allocated to the award credits, based on their stand-alone selling prices relative to the stand-alone selling prices of all goods/services promised.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Award Credits as a Separately Identifiable Component (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">The separately identifiable requirement</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Requirement</span><span>IFRIC 13's guidance</span></div>
          <div class="tr cols-13-1"><span>Stand-alone selling price</span><span>The award credit must have a stand-alone selling price that can be reliably estimated — even if the credit is never sold separately</span></div>
          <div class="tr alt cols-13-1"><span>Individually significant</span><span>The credit must represent a material separately identifiable deliverable, not an incidental part of the transaction</span></div>
          <div class="tr cols-13-1"><span>Economic substance</span><span>The arrangement must, in substance, give the customer a right to future goods/services in exchange for the credit</span></div>
        </div>
        <div class="callout warn callout--flush">⚠️ If the award credit is NOT separately identifiable, the entire transaction price is recognised when the initial goods/services are delivered, and the future award costs are recognised as incurred — a materially different outcome.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Allocating Consideration — Relative Fair Value (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">The allocation mechanics</div>
        <div class="principle">Where the award credit IS separately identifiable, the total transaction price (the amount paid by the customer for the initial purchase) is ALLOCATED between the initial goods/services and the award credits based on their RELATIVE FAIR VALUES. This allocation is performed ONCE at the point of sale — the resulting split is the revenue recognised immediately and the deferred revenue recognised later.</div>
        <div class="formula-box">
          <div class="f-label">ALLOCATION FORMULA</div>
          <div class="f-eq">Deferred revenue = Transaction price × (Stand-alone price of award credits ÷ Stand-alone price of initial goods + award credits)</div>
        </div>
      </div>
      <div class="card cw">
        <div class="ctitle cw">Worked example — allocating transaction price</div>
        <div class="worked">
          <div class="wk-title">Example: Supermarket loyalty programme</div>
          <div class="wk-body">A customer spends £100 on groceries and earns 500 loyalty points. Each point has a stand-alone value of £0.05 (redeemable for £25 of future goods). The stand-alone selling price of the groceries is £100.</div>
          <div class="wk-answer"><strong>Total stand-alone price</strong> = £100 + £25 = £125<br><strong>Deferred revenue</strong> = £100 × (£25 ÷ £125) = £20<br><strong>Revenue recognised immediately</strong> = £100 - £20 = £80</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Recognising Revenue on Award Redemption (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">When the deferred revenue is released</div>
        <div class="principle">Revenue from the deferred portion is recognised ONLY when the award credits are REDEEMED by the customer — at which point the entity satisfies its performance obligation. The amount recognised equals the portion of the deferred revenue RELATING to the credits actually redeemed.</div>
        <div class="elabel">KEY PRINCIPLES</div>
        <div class="dot-list">
          <span>Deferred revenue is NOT recognised when credits expire — only upon actual redemption</span>
          <span>If the fair value of the redeemed goods differs from the originally estimated stand-alone price, the difference is recognised as a cost of sales adjustment</span>
          <span>Breakage (unredeemed credits) is recognised as revenue only when the chance of redemption becomes remote — NOT prospectively at sale</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Third-Party Loyalty Programme Operators (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn">
        <div class="ctitle cn">The third-party operator's position</div>
        <div class="principle">When a THIRD PARTY (not the entity selling the goods) operates the loyalty programme, the entity selling the goods must determine whether the credits represent a separate component of ITS sale, or whether the third-party operator is the party responsible for satisfying the performance obligation. This affects whether the entity allocates part of the transaction price to the credits, or whether the entire amount is revenue with the third-party cost recognised as an expense.</div>
      </div>
      <div class="card ci">
        <div class="ctitle ci">Practical decision tree</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Scenario</span><span>Accounting outcome</span></div>
          <div class="tr cols-13-1"><span>Entity operates the programme</span><span>Allocate part of transaction price to award credits; defer and recognise on redemption</span></div>
          <div class="tr alt cols-13-1"><span>Third party operates programme; entity pays per credit earned</span><span>Recognise entire transaction price as revenue; recognise cost of credits when incurred</span></div>
          <div class="tr cols-13-1"><span>Entity pays fixed fee regardless of redemptions</span><span>Recognise fixed fee as expense when earned by third party</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>How This Guidance Became Part of IFRS 15</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A seamless transition to IFRS 15's performance obligation model</div>
        <div class="principle">When the IASB developed IFRS 15, it explicitly recognised that IFRIC 13's multi-element allocation approach was conceptually correct and operationally workable. Rather than reinventing loyalty programme accounting, IFRS 15 absorbed IFRIC 13's reasoning into its own performance obligation identification and allocation framework — loyalty credits became simply a specific type of performance obligation with a stand-alone selling price.</div>
        <div class="callout info">IFRS 15's Revenue Implementation Guidance specifically cites loyalty programmes as a common example of a separate performance obligation. Entities applying IFRS 15 follow the same allocation logic IFRIC 13 established, but within the broader and more rigorous IFRS 15 contract-level framework.</div>
      </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Common Application Sectors</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Industries where loyalty programmes are most prevalent</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Sector</span><span>Typical programme structure</span><span>IFRIC 13 relevance</span></div>
          <div class="tr cols-16-1-14"><span>Air travel</span><span>Frequent-flyer miles earned per flight, redeemable for flights, upgrades, or partner goods</span><span>Core example — IFRIC 13 specifically references airline programmes in its basis for conclusions</span></div>
          <div class="tr alt cols-16-1-14"><span>Retail grocery</span><span>Points per pound spent, redeemable for products, fuel, or discounts</span><span>High-volume, low-margin programmes where accurate deferred revenue recognition is material</span></div>
          <div class="tr cols-16-1-14"><span>Hospitality</span><span>Points per stay, redeemable for free nights, room upgrades, or experiences</span><span>Significant deferred revenue balances on balance sheets</span></div>
          <div class="tr alt cols-16-1-14"><span>Financial services</span><span>Reward points per card spend, redeemable for travel, cashback, or gift cards</span><span>Credit card programmes are among the most complex due to multi-currency redemption options</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Historical disclosure requirements under IFRIC 13</div>
        <div class="check-list">
          <span>Description of the loyalty programme and the goods/services for which credits can be redeemed</span>
          <span>The method used to determine the stand-alone selling price of the award credits</span>
          <span>The amount of revenue deferred at the beginning and end of the period</span>
          <span>The amount of deferred revenue recognised during the period (redemptions)</span>
          <span>Any breakage recognised as revenue during the period</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Judgments & Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where judgement historically mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Determining whether award credits are separately identifiable from the initial transaction</span>
              <span>Estimating stand-alone selling price when no direct market exists for standalone credits</span>
              <span>Assessing when breakage is remote enough to be recognised as revenue</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Stand-alone selling price of award credits, especially for programmes with variable redemption options</span>
              <span>Expected redemption patterns (breakage rate) affecting timing of revenue recognition</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRIC 13 vs the Current IFRS 15 Approach</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">What changed and what did not</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRIC 13 (historical)</span><span>IFRS 15 (current)</span></div>
          <div class="tr cols-12-1-1"><span>Separate component</span><span>Award credits treated as separately identifiable component</span><span>Award credits treated as a distinct performance obligation</span></div>
          <div class="tr alt cols-12-1-1"><span>Allocation method</span><span>Relative fair value based on stand-alone selling prices</span><span>Relative transaction price allocation based on stand-alone selling prices</span></div>
          <div class="tr cols-12-1-1"><span>Revenue recognition timing</span><span>On redemption of credits</span><span>As (or when) the performance obligation is satisfied</span></div>
          <div class="tr alt cols-12-1-1"><span>Third-party programmes</span><span>Entity pays per credit: entire price is revenue</span><span>Same conclusion — entity accounts for the initial sale only</span></div>
          <div class="tr cols-12-1-1"><span>Withdrawn</span><span>Yes — 2016</span><span>N/A</span></div>
        </div>
        <div class="note">IFRS 15's Revenue Implementation Guidance specifically cites loyalty programmes as a common example of a distinct performance obligation — the conceptual logic is identical to IFRIC 13, just embedded within a broader, more rigorous framework.</div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where IFRIC 13 items historically appeared</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Item</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Revenue from initial sale (allocated portion)</span><span><span class="badge bp">P&L</span></span><span>Recognised at the point of sale</span></div>
          <div class="tr alt cols-16-1-14"><span>Deferred revenue liability for award credits</span><span><span class="badge bs">Balance Sheet</span></span><span>Carried as contract liability until redemption</span></div>
          <div class="tr cols-16-1-14"><span>Revenue recognised on credit redemption</span><span><span class="badge bp">P&L</span></span><span>Released from deferred revenue as credits are redeemed</span></div>
          <div class="tr alt cols-16-1-14"><span>Cost of goods sold on redemption</span><span><span class="badge bp">P&L</span></span><span>Recognised when redeemed goods/services are provided</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 15</span><span>The current successor standard that absorbed IFRIC 13's multi-element logic</span></div>
          <div class="tr alt cols-08-2"><span>IAS 18</span><span>The predecessor revenue standard IFRIC 13 originally supplemented</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Breakage</div>
          <div class="glossary-def">The portion of award credits expected never to be redeemed; recognised as revenue only when the chance of redemption becomes remote.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Deferred revenue</div>
          <div class="glossary-def">Revenue allocated to award credits at the point of sale, deferred until the credits are redeemed or expire.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Award credit", definition: "A right granted to a customer as part of a loyalty programme, to receive a free or discounted good or service in the future." },
      { term: "Relative fair value", definition: "The proportion of the total transaction price allocated to award credits, based on their stand-alone selling prices relative to all promised goods/services." },
      { term: "Separately identifiable component", definition: "A good or service promised to a customer that is distinct from other promises in the contract, meeting the criteria of being capable of being distinct and separately identifiable." },
      { term: "Breakage", definition: "The expected portion of award credits that will never be redeemed; recognised as revenue only when redemption becomes remote." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRIC13} />
  </section>
</StandardPageLayout>




