---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas33.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Basic EPS — The Core Formula" },
        { id: "s4", label: "Weighted Average Number of Shares" },
        { id: "s5", label: "Diluted EPS — Potential Ordinary Shares" },
        { id: "s6", label: "The Treasury Stock Method for Options" },
        { id: "s7", label: "CCPS & ESOP Dilution — Indian Application Context" },
        { id: "s8", label: "Restatement for Bonus Issues & Splits" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 33 vs IAS 33 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical comparability philosophy to IAS 33</div>
        <div class="principle">Ind AS 33 applies the IDENTICAL principle as IAS 33 — EPS provides a STANDARDISED measure of an entity's PER-SHARE performance, enabling comparison across entities and reporting periods, presented for BOTH basic and diluted measures on the face of the P&amp;L statement.</div>
        <div class="elabel">HOW IND AS 33 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Comparability</strong> — a standardised calculation methodology enabling cross-entity comparison — identical to IAS 33</span>
          <span><strong>Widespread Indian application</strong> — India's LARGE venture-funded startup and listed company ecosystem, with prevalent CCPS and ESOP structures, makes DILUTED EPS calculation GENUINELY significant and often complex in Indian practice</span>
        </div>
        <div class="note">Ind AS 33 introduced NO substantive change to the EPS calculation methodology relative to IAS 33 — its Indian relevance is most pronounced for the FREQUENCY and complexity of dilutive instrument structures.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The core basic EPS formula — identical to IAS 33</div>
        <div class="formula-box formula-box--chip"><div class="f-eq">Basic EPS = (Profit attributable to ordinary equity holders) ÷ (Weighted average number of ordinary shares outstanding)</div></div>
        <div class="callout info callout--chip callout--flush">IDENTICAL formula to IAS 33.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 33 covers</div>
        <div class="principle">Ind AS 33 applies to entities whose ordinary shares/potential ordinary shares are PUBLICLY TRADED, or that are in the process of issuing such instruments — IDENTICAL scope to IAS 33. Other entities MAY voluntarily apply it.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Potential ordinary share</div>
          <div class="glossary-def">IDENTICAL definition to IAS 33 — a financial instrument that MAY entitle its holder to ordinary shares (e.g. CCPS, ESOPs, convertible bonds).</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">ESOP</div>
          <div class="glossary-def">Employee Stock Option Plan — a common Indian dilutive instrument, requiring treasury stock method application for diluted EPS.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — BASIC EPS (worked example) ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Basic EPS — The Core Formula</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 33</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Basic EPS calculation</div>
          <div class="wk-body">An Indian listed company reports profit attributable to ordinary equity holders of ₹50,00,00,000, with a weighted average of 10,00,00,000 ordinary shares outstanding during the year.</div>
          <div class="wk-answer">Basic EPS = ₹50,00,00,000 ÷ 10,00,00,000 = ₹5.00 per share — an IDENTICAL calculation methodology to how IAS 33 would compute the same figures globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 4 — WEIGHTED AVERAGE SHARES ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Weighted Average Number of Shares</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical time-weighting approach to IAS 33</div>
        <div class="text-supporting">Shares are weighted by the PORTION of the period they were outstanding, with shares issued for consideration weighted from the date consideration is receivable — IDENTICAL to IAS 33.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 — DILUTED EPS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Diluted EPS — Potential Ordinary Shares</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 33</div>
        <div class="text-supporting">Diluted EPS adjusts basic EPS for the DILUTIVE effect of ALL potential ordinary shares (convertible instruments, options, warrants), but ONLY if their inclusion DECREASES EPS (i.e., is dilutive, not anti-dilutive) — IDENTICAL to IAS 33.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — TREASURY STOCK METHOD (worked example) ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>The Treasury Stock Method for Options</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 33</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: ESOP dilution using the treasury stock method</div>
          <div class="wk-body">An Indian company has 20,00,000 outstanding ESOP options with an exercise price of ₹40, while the average market price of the shares during the period is ₹100.</div>
          <div class="wk-answer">Under the TREASURY STOCK METHOD, assumed proceeds from exercise (20,00,000 × ₹40 = ₹8,00,00,000) are assumed used to repurchase shares at the average market price (₹8,00,00,000 ÷ ₹100 = 8,00,000 shares), meaning the INCREMENTAL dilutive shares added to the diluted EPS denominator = 20,00,000 − 8,00,000 = 12,00,000 shares — an IDENTICAL methodology to how IAS 33 would treat the same option pool globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 — CCPS & ESOP DILUTION ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>CCPS &amp; ESOP Dilution — Indian Application Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important, practically prevalent Indian application area</div>
        <div class="text-supporting">Given CCPS's dominance in Indian venture funding (see Ind AS 32 poster, Section 7) and the widespread use of ESOP pools in Indian startups/listed companies, DILUTED EPS calculation genuinely requires careful, often COMPLEX analysis of MULTIPLE potential ordinary share categories simultaneously — CCPS conversion terms, ESOP treasury stock method, and any convertible debt — all under the IDENTICAL Ind AS 33 methodology applied to comparable IFRS structures globally, but with a distinctly HIGH FREQUENCY of application in Indian corporate practice.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — RESTATEMENT ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Restatement for Bonus Issues &amp; Splits</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 33</div>
        <div class="text-supporting">EPS for ALL periods presented is RESTATED for bonus issues, share splits, or consolidations, as if they had occurred at the BEGINNING of the earliest period presented — IDENTICAL to IAS 33, relevant for common Indian bonus share issuances.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 33</div>
        <div class="check-list">
          <span>Basic and diluted EPS on the face of the P&amp;L statement, with equal prominence</span>
          <span>Reconciliation of numerator and denominator used for basic/diluted EPS</span>
          <span>Instruments excluded from diluted EPS as anti-dilutive</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Determining whether a potential ordinary share is dilutive or anti-dilutive</span>
              <span>Sequencing multiple dilutive instruments correctly (most dilutive first)</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Average market price for treasury stock method calculations</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">When MULTIPLE dilutive instruments exist (common for Indian companies with CCPS, ESOPs, and convertible debt simultaneously), they must be RANKED from most to least dilutive and included sequentially, a genuinely common source of calculation complexity.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 33 vs IAS 33 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 33 vs IAS 33 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 33</span><span>Ind AS 33</span></div>
          <div class="tr cols-12-1-1"><span>Basic/diluted EPS calculation methodology</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Practical application context</span><span>Varies by jurisdiction/market</span><span>Especially prominent given India's CCPS-dominant venture funding and widespread ESOP structures</span></div>
        </div>
        <div class="note">Ind AS 33 is essentially IDENTICAL to IAS 33 in substance — its distinctive Indian relevance lies in the FREQUENCY and complexity of dilutive instrument structures, not any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every Ind AS 33 figure lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Item</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Basic and diluted EPS</span><span><span class="badge bp">P&amp;L</span></span><span>Presented on the FACE of the statement, equal prominence</span></div>
          <div class="tr alt cols-16-1-14"><span>EPS reconciliation details</span><span><span class="badge bp">Notes</span></span><span>Identical to IAS 33</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 33</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 32</span><span>Determines the liability/equity classification of instruments feeding into EPS calculations</span></div>
          <div class="tr cols-08-2"><span>Ind AS 102</span><span>Governs ESOP accounting, feeding the diluted EPS treasury stock method calculation</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Treasury stock method</div>
          <div class="glossary-def">The methodology for calculating incremental dilutive shares from options, identical to IAS 33.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Anti-dilutive</div>
          <div class="glossary-def">An instrument that would INCREASE EPS (or decrease loss per share) if included — excluded from diluted EPS, identical to IAS 33.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Treasury stock method", definition: "The methodology for calculating incremental dilutive shares from options, identical to IAS 33." },
      { term: "Anti-dilutive", definition: "An instrument that would INCREASE EPS (or decrease loss per share) if included — excluded from diluted EPS, identical to IAS 33." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
