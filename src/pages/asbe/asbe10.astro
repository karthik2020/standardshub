>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — the Fund's Own Financial Statements" },
        { id: "s3", label: "What an Enterprise Annuity Is" },
        { id: "s4", label: "Distinguishing This Standard From ASBE No. 9" },
        { id: "s5", label: "Measurement of Fund Assets — Fair Value Throughout" },
        { id: "s6", label: "The Fund's Financial Statements" },
        { id: "s7", label: "A Genuinely Rare Standard-Level Treatment Internationally" },
        { id: "s8", label: "Worked Example — Measuring Fund Financial Assets at Fair Value" },
        { id: "s9", label: "Worked Example — Contrasting the Employer's and the Fund's Own Accounting" },
        { id: "s10", label: "Disclosure Requirements" },
        { id: "s11", label: "Critical Judgments &amp; Estimates" },
        { id: "s12", label: "Relationship to IAS 26" },
