---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/sic/sic10.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "Grant vs Equity Distinction" },
        { id: "s4", label: "Grant vs Loan Distinction" },
        { id: "s5", label: "Recognition in Profit or Loss" },
        { id: "s6", label: "Non-monetary Government Assistance" },
        { id: "s7", label: "Disclosure" },
        { id: "s8", label: "Judgments & Estimates" },
        { id: "s9", label: "SIC-10 vs IFRS" },
        { id: "s10", label: "Statement Mapping" },
        { id: "s11", label: "Related Standards" },
        { id: "s12", label: "Glossary" },
      ]}
    />
  </Fragment>

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why SIC-10 exists as a bridge interpretation</div>
        <div class="principle">IAS 20 distinguishes between government GRANTS and government ASSISTANCE. A grant involves the transfer of resources by government in return for past or future compliance with certain conditions. Assistance that does NOT relate to specific operating activities does not fit neatly into the grant model — SIC-10 clarifies that such assistance is still a grant under IAS 20, not something that falls outside the standard entirely.</div>
        <div class="note">Without SIC-10, entities could have taken the position that assistance not tied to specific operating activities was outside IAS 20's scope, leading to inconsistent accounting and potential over-statement of income.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Broad scope of IAS 20 confirmed</div>
        <div class="principle">IAS 20 applies to ALL government grants, whether relating to specific operating activities or not. SIC-10's key contribution is confirming this breadth — the standard's scope is not narrowed by the nature or linkage of the assistance to the entity's operations.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope & Definitions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What SIC-10 covers</div>
        <div class="principle">SIC-10 applies to government assistance that does NOT relate to specific operating activities — for example, a government subsidy to relocate operations to a designated area, or general support to an industry facing restructuring. Such assistance is accounted for as a government grant under IAS 20.</div>
        <div class="elabel">TYPICAL FACT PATTERNS</div>
        <div class="dot-list">
          <span>Government subsidy to relocate operations to a designated area</span>
          <span>General support to an industry facing restructuring</span>
          <span>Direct government contributions not linked to specific expenses</span>
          <span>Government forgiveness of loans not tied to operational performance</span>
        </div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions</div>
        <div class="glossary-item">
          <div class="glossary-term">Government grant</div>
          <div class="glossary-def">A transfer of resources by government in return for past or future compliance with certain conditions regarding the operating activities of the entity.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Government assistance</div>
          <div class="glossary-def">Action by government designed to provide an economic benefit specific to an entity or range of entities qualifying under certain criteria.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Grant vs Equity Distinction</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Distinguishing grants from equity contributions</div>
        <div class="td-table">
          <div class="th cols-1-2"><span>Indicator</span><span>Grant</span></div>
          <div class="tr cols-1-2"><span>Source of funds</span><span>Government (taxation power, sovereign authority)</span></div>
          <div class="tr alt cols-1-2"><span>Voting rights</span><span>No voting rights conferred</span></div>
          <div class="tr cols-1-2"><span>Repayment obligation</span><span>Usually no repayment required; conditions rather than repayment</span></div>
          <div class="tr alt cols-1-2"><span>Profit participation</span><span>No entitlement to dividends or residual assets</span></div>
        </div>
        <div class="callout warn callout--flush">Distinguishing a grant from an equity contribution is critical because grants are normally recognised in profit or loss on a systematic basis, while equity contributions remain in equity unless they represent a government grant that must be matched to costs.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Grant vs Loan Distinction</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">When is assistance a loan rather than a grant?</div>
        <div class="principle">Government assistance is NOT a government grant under IAS 20 if it is a loan that is repayable — even if the interest rate is below market. SIC-10 confirms that forgiveness of such a loan IS a government grant once and when forgiveness occurs.</div>
        <div class="elabel">KEY RULES</div>
        <div class="dot-list">
          <span>Below-market-interest loans are NOT grants; they are measured at the benefit of the below-market rate</span>
          <span>Loan forgiveness IS a government grant recognised when the forgiveness occurs</span>
          <span>The benefit of the below-market rate is recognised as a government grant over the life of the loan</span>
        </div>
      </div>
      <div class="card ci">
        <div class="ctitle ci">Practical mechanics</div>
        <div class="worked">
          <div class="wk-title">Example: Below-market loan</div>
          <div class="wk-body">An entity receives a 5-year loan from the government at 2% when market rate is 7%. The loan proceeds are $1m.</div>
          <div class="wk-answer">The benefit of the below-market rate is the differential between the present value of the repayments at market rate and the present value at the grant rate. This benefit is recognised as a government grant over the life of the loan using the EIR method.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Recognition in Profit or Loss</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">Systematic recognition on a matching basis</div>
        <div class="principle">IAS 20 requires grants to be recognised in profit or loss on a systematic basis over the periods in which the entity recognises the related costs for which the grant is intended to compensate. For grants of a non-recurring nature, this is typically the periods in which the related costs are incurred.</div>
        <div class="formula-box">
          <div class="f-label">MATCHING PRINCIPLE</div>
          <div class="f-eq">Grant income recognised in SOPL = RELATED COSTS incurred in the same period, matched to the grant benefit</div>
        </div>
      </div>
      <div class="card cw">
        <div class="ctitle cw">Default treatment</div>
        <div class="elabel">SIC-10 CONFIRMS</div>
        <div class="dot-list">
          <span>Grants related to specific operating activities are recognised systematically over the periods of the related costs</span>
          <span>Grants NOT related to specific operating activities are ALSO recognised on a systematic basis — in the periods in which the related costs are recognised</span>
          <span>The default method of systematic recognition is straight-line over the relevant periods</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Non-monetary Government Assistance</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Government-provided assets at below-market value</div>
        <div class="principle">Where the government provides an asset (such as land or a building) at a below-market price, the entity must recognise both the asset and the grant element. The asset is measured at the fair value of the consideration paid, and the grant is the balance (fair value less consideration paid).</div>
        <div class="worked">
          <div class="wk-title">Example: Government land grant</div>
          <div class="wk-body">Government transfers land with a fair value of $10m to an entity for a nominal $100. The entity receives the land as a government grant of $9,999,900.</div>
          <div class="wk-answer">Land asset recognised at $10m (fair value); deferred income credit/fair value through grant recognised at $9,999,900; the $100 paid may be recognised as an asset cost. The grant is recognised in profit or loss on the same systematic basis as if cash had been received.</div>
        </div>
      </div>
      <div class="card ci">
        <div class="ctitle ci">Tax concessions and similar benefits</div>
        <div class="principle">IAS 20 permits the exemption of tax concessions and similar benefits from the definition of government grants if the benefit arises from legislation that establishes the entity's tax obligations broadly — rather than as a targeted grant. The entity presents the benefit on a net basis where permitted, rather than grossing it up with related expenses.</div>
      </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Disclosure</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">What SIC-10 / IAS 20 requires</div>
        <div class="check-list">
          <span>Accounting policy adopted for government grants (and any other forms of government assistance)</span>
          <span>Nature and amounts of government grants recognised in the financial statements</span>
          <span>Unfulfilled conditions or contingencies attaching to any government grant still outstanding</span>
          <span>Significant unfulfilled conditions that existed at reporting date</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Judgments & Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether a particular government transfer is a grant within IAS 20 or rather an equity contribution under IAS 32</span>
              <span>Whether a tax concession is within IAS 20's scope or whether it arises from general tax legislation</span>
              <span>The periods over which the grant benefit is matched to the related costs</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Timing and amount of future compliance costs for which the grant is intended to compensate</span>
              <span>Whether the grant will ultimately be received (contingency assessment)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>SIC-10 vs IFRS</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison — SIC-10 within the broader IFRS framework</div>
        <div class="td-table">
          <div class="th cols-1-1-1"><span>Aspect</span><span>SIC-10 / IAS 20 (IFRS)</span><span>Comparable local GAAP</span></div>
          <div class="tr cols-1-1-1"><span>Grants related to operating activities</span><span>Recognised in profit or loss over the periods of the related costs</span><span>Often recognised immediately on receipt — P&L volatility</span></div>
          <div class="tr alt cols-1-1-1"><span>Grants NOT related to operating activities</span><span>SIC-10 confirms these are STILL grants under IAS 20 — recognised systematically</span><span>Often treated as equity contributions rather than income</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every SIC-10 event lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Grant related to specific operating activity — systematic recognition</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Deferred income amortised to profit or loss as related costs are incurred</span></div>
          <div class="tr alt cols-16-1-14"><span>Grant NOT related to specific operating activities — systematic recognition</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>SIC-10 confirms IAS 20 scope is broad; recognised on the same systematic basis</span></div>
          <div class="tr cols-16-1-14"><span>Grant as non-monetary asset</span><span><span class="badge bs">SOFP</span> <span class="badge bp">SOPL</span></span><span>Asset recognised at fair value; grant recognised as deferred income</span></div>
          <div class="tr alt cols-16-1-14"><span>Loan forgiveness</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>The forgiven amount recognised as a government grant when forgiveness occurs</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 20</span><span>The parent standard SIC-10 confirms applies to assistance not tied to specific operating activities, using the same systematic recognition approach</span></div>
          <div class="tr alt cols-08-2"><span>IAS 41</span><span>Government grants related to biological assets at fair value have distinct treatment outside SIC-10's general scope</span></div>
          <div class="tr cols-08-2"><span>IAS 32</span><span>Supplies the equity/liability distinction relevant to distinguishing genuine capital contributions from grants</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Government grant</div>
          <div class="glossary-def">A transfer of resources by government in return for past or future compliance with certain conditions regarding the operating activities of the entity.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Systematic basis</div>
          <div class="glossary-def">The method of recognising a government grant in profit or loss over the periods in which the entity recognises the related costs for which the grant is intended to compensate.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Government grant", definition: "A transfer of resources by government in return for past or future compliance with certain conditions regarding the operating activities of the entity — SIC-10 confirms its scope is not narrowed by the nature of the assistance." },
      { term: "Systematic recognition", definition: "The IAS 20 principle that grants are recognised in profit or loss over the periods in which the related costs are recognised, ensuring matching." },
      { term: "Below-market loan", definition: "A government loan at an interest rate below market rates — the benefit of the below-market rate is a government grant recognised over the life of the loan, not at inception." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC10} />
  </section>
</StandardPageLayout>
