---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc995.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "The Capital Construction Fund (CCF) — Merchant Marine Act Section 607" },
        { id: "s4", label: "Deferred Tax Exception for CCF Deposits" },
        { id: "s5", label: "Worked Example — CCF Deposit and Deferred Tax Treatment" },
        { id: "s6", label: "Disclosure Requirements" },
        { id: "s7", label: "Critical Judgments &amp; Estimates" },
        { id: "s8", label: "No Direct IFRS Equivalent — Discussion" },
        { id: "s9", label: "Statement Mapping" },
        { id: "s10", label: "Related Topics" },
        { id: "s11", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card ci span2"><div class="ctitle ci">A narrow accounting consequence of a specific US maritime tax policy</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">ASC 995 is one of the NARROWEST, most niche Topics in the entire Codification — it addresses the accounting consequence of a SPECIFIC US federal maritime policy tool: the "CAPITAL CONSTRUCTION FUND" (CCF), a tax-advantaged savings mechanism Congress created to encourage US-flag vessel operators to set aside funds for building, acquiring, or reconstructing vessels. ASC 995's substantive content is essentially a SINGLE, specific DEFERRED TAX exception tied to this program.</div>
    </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cw span2"><div class="ctitle cw">US-flag steamship and vessel operating entities</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">ASC 995 applies to US steamship (vessel operating) entities that participate in the Capital Construction Fund program under the Merchant Marine Act.</div>
    </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>The Capital Construction Fund (CCF) — Merchant Marine Act Section 607</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">A statutory savings program encouraging US vessel construction</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">Under SECTION 607 of the Merchant Marine Act, qualifying US-flag vessel operators may DEPOSIT eligible earnings into a "CAPITAL CONSTRUCTION FUND" (CCF) — a special reserve intended to accumulate resources for the future CONSTRUCTION, ACQUISITION, or RECONSTRUCTION of vessels — a statutory policy tool designed to encourage continued investment in the US-flag merchant marine fleet.</div>
    </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Deferred Tax Exception for CCF Deposits</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cs span2"><div class="ctitle cs">A specific exception to normal deferred tax recognition</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">Amounts DEPOSITED into a CCF, and used for QUALIFYING vessel construction/reconstruction purposes, receive favourable TAX deferral treatment under the Merchant Marine Act itself — and ASC 995 confirms that a DEFERRED TAX LIABILITY need NOT be recognised for this SPECIFIC, statutorily-sanctioned deferral, provided the CCF deposits and their USE continue to meet the qualifying statutory conditions — a narrow, SPECIFIC exception layered on top of ASC 740's GENERAL deferred tax recognition principles (see the companion ASC 740 poster), tailored to this ONE specific maritime tax policy mechanism.</div>
    </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Worked Example — CCF Deposit and Deferred Tax Treatment</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cw span2"><div class="ctitle cw">A narrow, specific deferred tax exception in action</div>
    <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A shipping company's CCF deposit</div><div class="wk-body">A US-flag shipping company deposits $10,000,000 of qualifying earnings into its Capital Construction Fund, intending to use the funds toward constructing a new vessel within the required statutory timeframe.</div><div class="wk-answer">Under NORMAL ASC 740 principles, a temporary difference of this kind might otherwise require deferred tax liability recognition. However, under ASC 995's SPECIFIC CCF exception, <strong>NO deferred tax liability is recognised</strong> for this $10,000,000 deposit, PROVIDED it continues to meet the Merchant Marine Act's qualifying conditions for use toward approved vessel construction purposes.</div></div>
    </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">What ASC 995 requires</div><div class="check-list"><span>Nature and amount of Capital Construction Fund deposits and their intended qualifying use</span><span>Basis for not recognising a deferred tax liability on qualifying CCF deposits</span></div>
    </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
    <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether CCF deposits and their intended use continue to meet the Merchant Marine Act's qualifying statutory conditions</span></div></div>
    <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Generally minimal — this is a narrow, statutorily-defined exception rather than an estimation-heavy area</span></div></div></div>
    </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>No Direct IFRS Equivalent — Discussion</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card ci span2"><div class="ctitle ci">A genuinely US-specific maritime policy construct</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">IFRS has NO equivalent standard or exception paralleling ASC 995 — the CAPITAL CONSTRUCTION FUND is a construct SPECIFIC to US federal maritime policy under the Merchant Marine Act, without a directly analogous mechanism in most other jurisdictions' tax or accounting frameworks. An IFRS reporter would simply apply GENERAL IAS 12 deferred tax principles, WITHOUT any comparable specific exception for a vessel construction savings program. This makes ASC 995 one of the NARROWEST, most genuinely US-specific Topics in the entire Codification, similar in character to ASC 808 (Collaborative Arrangements), ASC 852 (Reorganizations), and ASC 912 (Contractors—Federal Government).</div>
    </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cs span2"><div class="ctitle cs">Where every ASC 995 event lands</div>
    <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
    <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Qualifying CCF deposit</span><span><span class="badge bs">BS</span></span><span>No deferred tax liability recognised, per the specific statutory exception</span></div>
    </div>
    </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Related Topics</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
    <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
    <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 740</span><span>Supplies the general deferred tax recognition framework this Topic provides a narrow, specific exception from</span></div>
    </div>
    </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cn span2">
    <div class="glossary-item"><div class="glossary-term">Capital Construction Fund (CCF)</div><div class="glossary-def">A tax-advantaged reserve fund, established under Merchant Marine Act Section 607, allowing qualifying US-flag vessel operators to defer tax on earnings deposited toward future vessel construction, acquisition, or reconstruction.</div></div>
    </div>
    </div>

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.asc995 || []} />
  </section>
</StandardPageLayout>

