---
/*
Toolbar button

Accessible button for header/toolbar toolbars.

Props:
- id (optional)
- title (optional)

Wraps the default slot in a styled button element with optional identification attributes.
*/

interface Props {
    title?: string;
}

const { id, title } = Astro.props;
---

<button id={id} class="toolbar-btn" title={title} type="button">
    <slot />
</button>
