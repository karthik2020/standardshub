---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ias/ias40.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "s1",
          label: "Conceptual Framework",
        },
        {
          id: "s2",
          label: "Scope & Applicability",
        },
        {
          id: "s3",
          label: "Recognition Criteria",
        },
        {
          id: "s4",
          label: "Internally Generated Intangibles",
        },
        {
          id: "s5",
          label: "Subsequent Measurement",
        },
        {
          id: "s6",
          label: "Amortisation",
        },
        {
          id: "s7",
          label: "Impairment Link",
        },
        {
          id: "s8",
          label: "Derecognition",
        },
        {
          id: "s9",
          label: "Disclosure",
        },
        {
          id: "s10",
          label: "Judgements & Estimates",
        },
        {
          id: "s11",
          label: "IFRS vs US GAAP",
        },
        {
          id: "s12",
          label: "Statement Mapping",
        },
        {
          id: "s13",
          label: "Related Standards",
        },
        {
          id: "s14",
          label: "Glossary",
        },
        {
          id: "history",
          label: "History & Development",
        },
      ]}
    />
  </Fragment>

  <div class="wrap">
    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1">
      <span class="num">1</span><h2>Conceptual Framework Linkage</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">
          Why an intangible is an asset under the Framework
        </div>
        <div class="principle">
          An item qualifies as an asset under the Conceptual Framework if it is
          a present economic resource controlled by the entity as a result of
          past events, with the potential to produce economic benefits — the
          challenge with intangibles is proving control and separability without
          physical substance.
        </div>
        <div class="elabel">
          HOW INTANGIBLES MAP TO THE FRAMEWORK'S ELEMENTS
        </div>
        <div class="check-list">
          <span
            ><strong style="font-weight:600">Control</strong> — the entity has the
            power to obtain future economic benefits from the resource AND restrict
            others' access (usually via legal rights such as patents, copyrights,
            or contracts — without legal enforceability, control is very hard to demonstrate,
            e.g. for a skilled workforce)</span
          >
          <span
            ><strong style="font-weight:600">Past event</strong> — purchase, internal
            development, or acquisition in a business combination</span
          >
          <span
            ><strong style="font-weight:600">Future economic benefit</strong> — revenue
            from sale of products/services, cost savings, or other benefits from the
            asset's use</span
          >
        </div>
        <div class="note">
          IAS 38 operationalises the Framework's general asset definition for
          identifiable, non-monetary items without physical substance,
          deliberately setting a HIGHER recognition bar than for tangible assets
          because reliable measurement is harder.
        </div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Measurement principles applied by IAS 38</div>
        <div class="principle">
          The Conceptual Framework lists several possible measurement bases; IAS
          38 selects specific ones for initial and subsequent measurement.
        </div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;">
            <span>Framework basis</span><span>Used by IAS 38 for…</span>
          </div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;">
            <span>Historical cost</span><span>Initial recognition (always)</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;">
            <span>Current value (fair value)</span><span
              >Revaluation model (optional, only if an active market exists)</span
            >
          </div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;">
            <span>Value in use / FVLCD</span><span
              >Recoverable amount under IAS 36 (impairment)</span
            >
          </div>
        </div>
        <div class="callout info" style="margin-bottom:0;">
          ℹ️ <strong style="font-weight:600"
            >Qualitative characteristics in action:</strong
          > IAS 38 leans heavily toward <strong style="font-weight:600"
            >faithful representation</strong
          > — this is precisely why internally generated goodwill, brands, and most
          research costs are banned from recognition: their cost cannot be reliably
          distinguished from the cost of developing the business as a whole.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2">
      <span class="num">2</span><h2>Scope &amp; Applicability</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 38 covers</div>
        <div class="principle">
          IAS 38 applies to all intangible assets EXCEPT those specifically
          covered by another standard. An intangible asset is an identifiable,
          non-monetary asset without physical substance.
        </div>
        <div class="elabel">THE THREE-PART DEFINITION</div>
        <div
          style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:9px;"
        >
          (a) <strong style="font-weight:600">Identifiable</strong> — separable (can
          be sold, transferred, licensed, rented, or exchanged) OR arises from contractual/legal
          rights
        </div>
        <div
          style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:9px;"
        >
          (b) <strong style="font-weight:600">Controlled</strong> by the entity as
          a result of past events
        </div>
        <div style="font-size:13px;color:var(--color-text-secondary);">
          (c) Expected to generate <strong style="font-weight:600"
            >future economic benefits</strong
          >
        </div>
        <div class="elabel" style="margin-top:9px;">
          SCOPE EXCLUSIONS — GOVERNED BY OTHER STANDARDS
        </div>
        <div class="cross-list">
          <span
            >Intangible assets held for sale in the ordinary course of business
            → <strong style="font-weight:600">IAS 2</strong></span
          >
          <span
            >Deferred tax assets → <strong style="font-weight:600"
              >IAS 12</strong
            ></span
          >
          <span
            >Leases within the scope of IFRS 16 → <strong
              style="font-weight:600">IFRS 16</strong
            ></span
          >
          <span
            >Goodwill acquired in a business combination → <strong
              style="font-weight:600">IFRS 3</strong
            > (though subsequent impairment testing still follows IAS 36)</span
          >
          <span
            >Financial assets (as defined in IFRS 9) → <strong
              style="font-weight:600">IFRS 9</strong
            ></span
          >
          <span
            >Exploration and evaluation assets → <strong style="font-weight:600"
              >IFRS 6</strong
            ></span
          >
        </div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Identifiability</div>
          <div class="glossary-def">
            The critical feature separating an intangible asset from goodwill —
            separable from the entity, or arising from contractual/legal rights,
            regardless of whether those rights are transferable.
          </div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Research</div>
          <div class="glossary-def">
            Original and planned investigation undertaken to gain new scientific
            or technical knowledge and understanding — ALWAYS expensed.
          </div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Development</div>
          <div class="glossary-def">
            The application of research findings to a plan or design for the
            production of new/substantially improved materials, devices,
            products, or processes — capitalised ONLY if strict criteria
            (PIRATE, see Section 4) are met.
          </div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Active market</div>
          <div class="glossary-def">
            A market where items traded are homogeneous, willing buyers/sellers
            can normally be found, and prices are available to the public — rare
            for intangibles, which is why the revaluation model is seldom used
            in practice.
          </div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Amortisation</div>
          <div class="glossary-def">
            The systematic allocation of the depreciable amount of an intangible
            asset with a FINITE useful life over that life — the
            intangible-asset equivalent of depreciation.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — RECOGNITION CRITERIA ============ -->
    <div class="section-header" id="s3">
      <span class="num">3</span><h2>Recognition Criteria</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">
          The two-part recognition test — plus the definition hurdle
        </div>
        <div class="principle">
          Before the general recognition test can even be applied, the item must
          FIRST meet the definition of an intangible asset (identifiable,
          controlled, future benefits). Only then are the two recognition
          conditions assessed.
        </div>
        <div class="two-col">
          <div class="spec-box" style="margin-bottom:0;">
            <div class="spec-title" style="color:var(--color-text-success);">
              Condition 1 — Probable future economic benefit
            </div>
            <div
              style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;"
            >
              It is probable that the expected future economic benefits
              attributable to the asset will flow to the entity.
            </div>
          </div>
          <div class="spec-box" style="margin-bottom:0;">
            <div class="spec-title" style="color:var(--color-text-success);">
              Condition 2 — Reliable measurement
            </div>
            <div
              style="font-size:13px;color:var(--color-text-secondary);line-height:1.5;"
            >
              The cost of the asset can be measured reliably.
            </div>
          </div>
        </div>
        <div class="callout danger" style="margin-top:8px;margin-bottom:0;">
          ✕ <strong style="font-weight:600"
            >Never recognised as intangible assets, however much is spent:</strong
          > internally generated goodwill, brands, mastheads, publishing titles, customer
          lists, and similar items generated internally — because they cannot be distinguished
          from the cost of developing the business as a whole and lack reliably measurable
          cost.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 4 — INTERNALLY GENERATED INTANGIBLES (with worked example) ============ -->
    <div class="section-header" id="s4">
      <span class="num">4</span><h2>
        Internally Generated Intangibles — Research vs Development
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">The research/development split</div>
        <div class="formula-box">
          <div class="f-label">RESEARCH PHASE</div>
          <div class="f-eq">
            Always expensed to SOPL as incurred — no exceptions
          </div>
        </div>
        <div class="elabel">
          DEVELOPMENT PHASE — CAPITALISE ONLY IF ALL "PIRATE" CRITERIA MET
        </div>
        <div class="check-list" style="margin-bottom:9px;">
          <span
            ><strong style="font-weight:600">P</strong>robable future economic
            benefits can be demonstrated</span
          >
          <span
            ><strong style="font-weight:600">I</strong>ntention to complete and
            use/sell the asset</span
          >
          <span
            ><strong style="font-weight:600">R</strong>esources (technical,
            financial, other) adequate to complete the project</span
          >
          <span
            ><strong style="font-weight:600">A</strong>bility to use or sell the
            intangible asset</span
          >
          <span
            ><strong style="font-weight:600">T</strong>echnical feasibility of
            completing the asset</span
          >
          <span
            ><strong style="font-weight:600">E</strong>xpenditure can be
            measured reliably</span
          >
        </div>
        <div class="callout warn" style="margin-bottom:0;">
          ⚠️ If an entity cannot distinguish the research phase from the
          development phase of an internal project, ALL expenditure is treated
          as if incurred in the research phase — i.e. expensed.
        </div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">
          Worked example — capitalising development costs
        </div>
        <div class="worked">
          <div class="wk-title">Example 1: Software development project</div>
          <div class="wk-body">
            A company spends $200,000 over a year on a new software product.
            $80,000 was spent before technical feasibility was established
            (general feasibility studies) and $120,000 was spent afterward, once
            management had approved funding and a clear plan to complete and
            sell the product, with all six PIRATE criteria met from that point
            onward.
          </div>
          <div class="wk-answer">
            <strong>Expensed (research-type, pre-feasibility):</strong> $80,000 →
            SOPL<br />
            <strong>Capitalised (development, post-feasibility):</strong> $120,000
            → Intangible asset<br />
            Capitalisation begins only from the date all six criteria are FIRST met
            — never retrospectively for costs already expensed.
          </div>
        </div>
        <div class="elabel">JOURNAL ENTRY — DEVELOPMENT COSTS CAPITALISED</div>
        <div class="entry">
          <span class="dr">Dr</span><div class="etxt">
            Intangible asset — development costs $120,000<div class="badges">
              <span class="badge bs">SOFP — non-current asset</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="cr">Cr</span><div class="etxt">
            Cash / payables / wages payable $120,000<div class="badges">
              <span class="badge bs">SOFP</span>
            </div>
          </div>
        </div>
        <div class="note">
          Previously expensed research costs can NEVER be reinstated as an asset
          in a later period, even if the project later meets all PIRATE
          criteria.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — SUBSEQUENT MEASUREMENT ============ -->
    <div class="section-header" id="s5">
      <span class="num">5</span><h2>
        Subsequent Measurement — Cost vs Revaluation Model
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Cost model</div>
        <div class="formula-box">
          <div class="f-eq">
            Carrying amount = Cost − Accumulated amortisation − Accumulated
            impairment losses
          </div>
        </div>
        <div
          style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;"
        >
          The default and by far the most common model in practice, applied
          consistently to an entire CLASS of intangible assets.
        </div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Revaluation model</div>
        <div
          style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:8px;"
        >
          Permitted ONLY where fair value can be determined by reference to an
          ACTIVE MARKET — a condition rarely met for intangibles because most
          are unique (e.g. patents, brands). Exceptions do exist in practice:
          taxi licences, fishing quotas, production quotas.
        </div>
        <div class="elabel">
          JOURNAL ENTRIES — UPWARD REVALUATION (no prior deficit)
        </div>
        <div class="entry">
          <span class="dr">Dr</span><div class="etxt">
            Intangible asset — increase to FV<div class="badges">
              <span class="badge bs">SOFP</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="cr">Cr</span><div class="etxt">
            Revaluation surplus<div class="badges">
              <span class="badge bo">OCI</span><span class="badge be"
                >Equity</span
              >
            </div>
          </div>
        </div>
        <div class="div"></div>
        <div class="callout warn" style="margin-bottom:0;">
          ⚠️ An intangible asset can ONLY be revalued if it was initially
          recognised at cost (i.e. it must already qualify for recognition) AND
          an active market exists — an asset that has never been recognised
          cannot suddenly be revalued onto the SOFP.
        </div>
      </div>
    </div>

    <div class="grid" style="margin-top:10px;">
      <div class="card cw span2">
        <div class="ctitle cw">
          Worked example — indefinite-life asset with no active market
        </div>
        <div class="worked">
          <div class="wk-title">Example 2: Acquired trademark</div>
          <div class="wk-body">
            An entity acquires a well-known trademark for $2m in a separate
            purchase. Management assesses that there is no foreseeable limit to
            the period over which the trademark is expected to generate cash
            inflows, and no active market exists for similar trademarks.
          </div>
          <div class="wk-answer">
            <strong>Classification:</strong> Indefinite useful life → NOT amortised
            (see Section 6).<br />
            <strong>Measurement:</strong> Cost model only, since no active market
            exists for revaluation.<br />
            <strong>Subsequent treatment:</strong> Tested for impairment at least
            ANNUALLY, and whenever an indicator of impairment exists (IAS 36).
          </div>
        </div>
        <div class="callout danger" style="margin-bottom:0;">
          ✕ <strong style="font-weight:600"
            >"Indefinite" does not mean "infinite"</strong
          > — it means management can see no foreseeable limit to the period of benefit.
          The classification is reassessed every period; a change from indefinite
          to finite is a change in accounting estimate, applied prospectively.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 6 — AMORTISATION ============ -->
    <div class="section-header" id="s6">
      <span class="num">6</span><h2>Amortisation</h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Amortisation mechanics by useful life type</div>
        <div class="formula-box">
          <div class="f-label">FINITE LIFE — STRAIGHT-LINE (DEFAULT)</div>
          <div class="f-eq">
            Annual amortisation = (Cost − Residual value) ÷ Useful life
          </div>
        </div>
        <div class="elabel">FINITE USEFUL LIFE</div>
        <div class="dot-list" style="margin-bottom:9px;">
          <span
            >Amortised on a systematic basis over the useful life, reflecting
            the pattern of consumption of benefits (straight-line used if
            pattern cannot be determined reliably)</span
          >
          <span
            >Residual value assumed to be ZERO unless a third party commits to
            purchase it, or an active market exists to determine residual value
            at end of life</span
          >
          <span
            >Amortisation begins when the asset is available for use, and stops
            at the earlier of classification as held-for-sale (IFRS 5) or
            derecognition</span
          >
        </div>
        <div class="elabel">INDEFINITE USEFUL LIFE</div>
        <div class="check-list" style="margin-bottom:0;">
          <span
            >NOT amortised — instead tested for impairment annually and whenever
            indicators exist</span
          >
          <span
            >Useful life reassessed each period to confirm indefinite
            classification remains appropriate</span
          >
        </div>
      </div>

      <div class="card cn">
        <div class="ctitle cn">Worked example — patent amortisation</div>
        <div class="worked">
          <div class="wk-title">Example 3: Purchased patent</div>
          <div class="wk-body">
            An entity purchases a patent for $600,000 with a legal life of 15
            years, but management expects the technology to be commercially
            viable for only 6 years before it becomes obsolete. Residual value
            is nil.
          </div>
          <div class="wk-answer">
            <strong>Useful life used = 6 years</strong> (the SHORTER of legal life
            and expected economic/commercial life — never automatically the legal
            life).<br />
            <strong>Annual amortisation</strong> = $600,000 ÷ 6 = <strong
              style="color:var(--color-text-info);">$100,000 p.a.</strong
            >
          </div>
        </div>
        <div class="entry">
          <span class="dr">Dr</span><div class="etxt">
            Amortisation expense $100,000<div class="badges">
              <span class="badge bp">SOPL</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="cr">Cr</span><div class="etxt">
            Accumulated amortisation $100,000<div class="badges">
              <span class="badge bs">SOFP — asset ↓</span>
            </div>
          </div>
        </div>
        <div class="note">
          Amortisation is normally presented within operating expenses,
          classified by function or nature, consistent with the entity's policy
          for other similar expenses.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 — IMPAIRMENT LINK ============ -->
    <div class="section-header" id="s7">
      <span class="num">7</span><h2>Impairment Linkage (IAS 36)</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">How IAS 38 and IAS 36 interact</div>
        <div class="principle">
          IAS 38 itself does not contain impairment rules — IAS 36 governs
          whenever an indicator exists (finite-life assets) or, mandatorily, at
          least once a year regardless of indicators (indefinite-life assets,
          goodwill, and intangibles not yet available for use).
        </div>
        <div class="two-col">
          <div>
            <div class="elabel">
              MANDATORY ANNUAL IMPAIRMENT TEST — NO TRIGGER NEEDED
            </div>
            <div class="check-list">
              <span>Intangible assets with an indefinite useful life</span>
              <span
                >Intangible assets not yet available for use (e.g. development
                projects still in progress)</span
              >
              <span
                >Goodwill acquired in a business combination (tested at the
                cash-generating unit level)</span
              >
            </div>
          </div>
          <div>
            <div class="elabel">FINITE-LIFE INTANGIBLES</div>
            <div
              style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;"
            >
              Tested only when an indicator of impairment exists — same
              trigger-based approach as PPE under IAS 16.
            </div>
          </div>
        </div>
        <div class="note">
          See the dedicated IAS 36 poster for the full recoverable amount, CGU
          allocation, and reversal mechanics. Note: impairment losses on
          goodwill can NEVER be reversed.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — DERECOGNITION ============ -->
    <div class="section-header" id="s8">
      <span class="num">8</span><h2>Derecognition</h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">Derecognition rules &amp; journal entries</div>
        <div class="formula-box">
          <div class="f-eq">
            Gain/loss on disposal = Net disposal proceeds − Carrying amount
          </div>
        </div>
        <div class="entry">
          <span class="dr">Dr</span><div class="etxt">
            Accumulated amortisation<div class="badges">
              <span class="badge bs">SOFP</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="dr">Dr</span><div class="etxt">
            Cash / receivable (proceeds)<div class="badges">
              <span class="badge bs">SOFP</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="cr">Cr</span><div class="etxt">
            Intangible asset — at cost<div class="badges">
              <span class="badge bs">SOFP</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="cr">Cr</span><div class="etxt">
            Gain on disposal (or Dr if loss)<div class="badges">
              <span class="badge bp">SOPL — other income/expense</span>
            </div>
          </div>
        </div>
        <div class="note">
          An intangible asset is derecognised on disposal, or when no future
          economic benefits are expected from its use or disposal (e.g. a
          technology becomes obsolete with no resale value).
        </div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">
          Worked example — retirement with no proceeds
        </div>
        <div class="worked">
          <div class="wk-title">Example 4: Abandoned software licence</div>
          <div class="wk-body">
            A software licence with a carrying amount of $30,000 becomes
            obsolete mid-year following a system migration. It has no resale
            value and generates no further benefit.
          </div>
          <div class="wk-answer">
            <strong>Loss on derecognition</strong> = 0 − 30,000 = <strong
              style="color:var(--color-text-danger);">$(30,000)</strong
            > → SOPL, written off in full.
          </div>
        </div>
        <div class="entry">
          <span class="dr">Dr</span><div class="etxt">
            Loss on derecognition $30,000<div class="badges">
              <span class="badge bp">SOPL</span>
            </div>
          </div>
        </div>
        <div class="entry">
          <span class="cr">Cr</span><div class="etxt">
            Intangible asset (net carrying amount) $30,000<div class="badges">
              <span class="badge bs">SOFP</span>
            </div>
          </div>
        </div>
        <div class="note">
          Unlike PPE, there is rarely a revaluation surplus to transfer on
          derecognition, since most intangibles are held under the cost model.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9">
      <span class="num">9</span><h2>Disclosure Requirements</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">
          Required disclosures for each class of intangible asset
        </div>
        <div class="two-col">
          <div>
            <div class="elabel">MEASUREMENT &amp; RECONCILIATION</div>
            <div class="check-list">
              <span
                >Whether useful lives are finite or indefinite, and if finite,
                the lives/amortisation rates used</span
              >
              <span>Amortisation methods used for finite-life assets</span>
              <span
                >Gross carrying amount and accumulated amortisation (and
                impairment) at the beginning and end of the period</span
              >
              <span
                >Line item(s) of the statement of profit or loss in which
                amortisation is included</span
              >
              <span
                >A reconciliation of carrying amount at the beginning and end of
                the period (additions, disposals, amortisation, impairment,
                revaluation movements)</span
              >
            </div>
          </div>
          <div>
            <div class="elabel">ADDITIONAL DISCLOSURES</div>
            <div class="check-list">
              <span
                >Aggregate amount of research and development expenditure
                recognised as an expense during the period</span
              >
              <span
                >For indefinite-life assets: the carrying amount and the reasons
                supporting the indefinite-life assessment</span
              >
              <span
                >Existence and carrying amounts of intangible assets pledged as
                security or subject to restrictions on title</span
              >
              <span
                >Amount of contractual commitments for the acquisition of
                intangible assets</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10">
      <span class="num">10</span><h2>
        Critical Judgments &amp; Estimates
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">
              SIGNIFICANT ESTIMATES (IAS 8 — reviewed annually)
            </div>
            <div class="dot-list">
              <span>Useful life of each finite-life intangible</span>
              <span>Residual value (usually assumed nil)</span>
              <span
                >Amortisation method reflecting the pattern of benefit
                consumption</span
              >
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span
                >Identifying the point at which technical feasibility is
                achieved, triggering development cost capitalisation</span
              >
              <span
                >Whether an asset has a finite or indefinite useful life</span
              >
              <span
                >Whether expenditure meets the "identifiability" test (separable
                or arises from legal/contractual rights) or is simply an
                internally generated cost that must be expensed</span
              >
            </div>
          </div>
        </div>
        <div class="callout warn" style="margin-top:8px;margin-bottom:0;">
          ⚠️ Subsequent expenditure on an already-recognised intangible asset
          (e.g. ongoing brand advertising, staff training) is almost always
          expensed — it is very rare that further capitalisation is permitted,
          because such spend usually cannot be separately attributed to the
          asset rather than the business as a whole.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IFRS vs US GAAP ============ -->
    <div class="section-header" id="s11">
      <span class="num">11</span><h2>IFRS vs US GAAP — Key Differences</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">
          Comparison — IAS 38 vs US GAAP (ASC 350 / ASC 730)
        </div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;">
            <span>Feature</span><span style="color:var(--color-text-info);"
              >IFRS (IAS 38)</span
            ><span style="color:var(--color-text-warning);">US GAAP</span>
          </div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;">
            <span>Development costs</span><span
              >Capitalised once PIRATE criteria met</span
            ><span
              >Generally expensed as incurred (very limited exceptions, e.g.
              certain software)</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;">
            <span>Revaluation model</span><span
              >Permitted, only if active market exists</span
            ><span>NOT permitted — historical cost only</span>
          </div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;">
            <span>Research costs</span><span>Always expensed</span><span
              >Always expensed (same principle)</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;">
            <span>Impairment test trigger (finite-life)</span><span
              >Indicator-based (IAS 36)</span
            ><span
              >Indicator-based (similar), but different quantitative test
              mechanics</span
            >
          </div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;">
            <span>Impairment reversal</span><span
              >Permitted for finite-life assets (never for goodwill)</span
            ><span>Prohibited — never reversed</span>
          </div>
        </div>
        <div class="note">
          The development-cost treatment is the single most heavily examined
          IFRS vs US GAAP difference for IAS 38 — under US GAAP, most software
          and R&amp;D spend hits the income statement immediately, producing
          materially lower reported intangible assets and higher expenses in the
          development period.
        </div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING TABLE ============ -->
    <div class="section-header" id="s12">
      <span class="num">12</span><h2>
        Statement Mapping — Where Every Intangible Asset Event Lands
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">
          Comprehensive event-to-statement mapping table
        </div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Event / transaction</span><span>Statement(s) affected</span
            ><span>Notes</span>
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Purchase of an intangible asset (separate acquisition)</span
            ><span><span class="badge bs">SOFP</span></span><span
              >Recognised at cost</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Research expenditure</span><span
              ><span class="badge bp">SOPL</span></span
            ><span>Expensed as incurred — never capitalised</span>
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Development expenditure meeting PIRATE criteria</span><span
              ><span class="badge bs">SOFP</span></span
            ><span
              >Capitalised as an intangible asset; no SOPL charge at recognition</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Development expenditure NOT meeting criteria</span><span
              ><span class="badge bp">SOPL</span></span
            ><span>Expensed as incurred</span>
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Annual amortisation charge (finite life)</span><span
              ><span class="badge bp">SOPL</span>
              <span class="badge bs">SOFP</span></span
            ><span
              >Expense in SOPL; accumulated amortisation reduces SOFP carrying
              amount</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Indefinite-life asset — no amortisation</span><span>—</span
            ><span
              >No annual charge; carrying amount unchanged until impaired or
              reclassified</span
            >
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Upward revaluation (active market only)</span><span
              ><span class="badge bo">OCI</span>
              <span class="badge be">Equity</span>
              <span class="badge bs">SOFP</span></span
            ><span>No SOPL impact; rare in practice</span>
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Impairment loss (annual mandatory test or trigger-based)</span
            ><span
              ><span class="badge bp">SOPL</span>
              <span class="badge bs">SOFP</span></span
            ><span
              >Direct expense per IAS 36; goodwill impairment never reversed</span
            >
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Disposal — gain/loss</span><span
              ><span class="badge bp">SOPL</span>
              <span class="badge bs">SOFP</span></span
            ><span>Presented as other income/expense, not revenue</span>
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span
              >Cash paid for intangible asset purchases / capitalised
              development spend</span
            ><span><span class="badge bs">Cash Flow Statement</span></span><span
              >Investing activities outflow (IAS 7)</span
            >
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Proceeds from disposal</span><span
              ><span class="badge bs">Cash Flow Statement</span></span
            ><span>Investing activities inflow (IAS 7)</span>
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Amortisation add-back</span><span
              ><span class="badge bs">Cash Flow Statement</span></span
            ><span
              >Added back in operating activities under indirect method
              (non-cash item)</span
            >
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span
              >Class-level disclosures (useful life, R&amp;D expense,
              reconciliation)</span
            ><span><span class="badge bp">Notes</span></span><span
              >Required regardless of measurement model used</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13">
      <span class="num">13</span><h2>
        Related Standards — Cross-Reference Map
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">
          How IAS 38 connects across the IFRS body of literature
        </div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;">
            <span>Standard</span><span>Nature of the connection</span>
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>IFRS 3</span><span
              >Governs goodwill and identifiable intangibles acquired in a
              business combination — recognised at acquisition-date fair value
              even if they wouldn't otherwise meet IAS 38's recognition test
              standalone</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;">
            <span>IAS 36</span><span
              >Provides the impairment testing mechanics (recoverable amount,
              CGUs, mandatory annual tests, reversal rules) for intangibles and
              goodwill</span
            >
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>IAS 16</span><span
              >Shares the recognition/measurement architecture with IAS 38 (cost
              model, revaluation model, componentisation logic) — the
              tangible-asset counterpart</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;">
            <span>IFRS 16</span><span
              >Right-of-use assets are excluded from IAS 38's scope even when
              the underlying asset is intangible in nature (e.g. leased software
              rights)</span
            >
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>IAS 2</span><span
              >Intangible assets held for sale in the ordinary course of
              business (e.g. software developed for resale as inventory) fall
              under IAS 2, not IAS 38</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;">
            <span>IFRS 15</span><span
              >Costs to fulfil or obtain a contract with a customer may be
              capitalised under IFRS 15's own criteria, which interact with but
              are distinct from IAS 38's development criteria</span
            >
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>IAS 12</span><span
              >Revaluation surpluses on intangibles create taxable temporary
              differences, generating a deferred tax liability recognised
              through OCI</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;">
            <span>IFRS 9</span><span
              >Distinguishes intangible assets from financial assets —
              contractual rights to receive cash are financial assets under IFRS
              9, not intangibles under IAS 38</span
            >
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>IAS 8</span><span
              >Governs how changes in useful life, residual value, and
              amortisation method are treated (prospective, as changes in
              estimate)</span
            >
          </div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;">
            <span>IAS 1</span><span
              >Determines where intangible assets sit on the SOFP (non-current
              assets) and the general presentation framework the related
              disclosures sit within</span
            >
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>IFRS 5</span><span
              >Once classified as held for sale, an intangible asset exits IAS
              38's amortisation regime and switches to the
              lower-of-CA-and-FVLCTS rule</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14">
      <span class="num">14</span><h2>Quick-Reference Glossary</h2><span
        class="line"></span>
    </div>
 <Glossary entries={[
      { term: "Goodwill", definition: "The excess of consideration transferred over the net identifiable assets acquired in a business combination — never recognised internally, only on acquisition (IFRS 3)." },
      { term: "Useful life", definition: "The period over which an asset is expected to be available for use, or the number of production/similar units expected to be obtained from it — may be finite or indefinite for intangibles." },
      { term: "Separability", definition: "The capability of being separated from the entity and sold, transferred, licensed, rented, or exchanged, either individually or with a related contract/asset/liability." },
      { term: "PIRATE criteria", definition: "The six mandatory conditions (Probable benefits, Intention, Resources, Ability, Technical feasibility, Expenditure reliably measured) for capitalising development costs." },
      { term: "Recoverable amount", definition: "Higher of fair value less costs of disposal and value in use (IAS 36)." },
      { term: "Class of intangible assets", definition: "A grouping of assets of similar nature/use (e.g. patents, licences, software, brands) used for disclosure and policy application." }
    ]} />

<FinancialStatementKey />
