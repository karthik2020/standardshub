---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas38.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & Out-of-Scope Interests" },
        { id: "s2", label: "Definitions — Interest, Structured Entity & Binding Arrangement" },
        { id: "s3", label: "Significant Judgments, Assumptions & Investment Entity Status" },
        { id: "s4", label: "Interests in Controlled Entities — Composition & Non-Controlling Interests" },
        { id: "s5", label: "Significant Restrictions & Risks From Consolidated Structured Entities" },
        { id: "s6", label: "Consequences of Ownership Changes & Loss of Control" },
        { id: "s7", label: "Interests in Unconsolidated Controlled Entities — Investment Entities" },
        { id: "s8", label: "Interests in Joint Arrangements & Associates" },
        { id: "s9", label: "Interests in Structured Entities That Are Not Consolidated" },
        { id: "s10", label: "Non-Quantifiable Ownership Interests" },
        { id: "s11", label: "Controlling Interests Acquired with the Intention of Disposal" },
        { id: "s12", label: "Current Value Measurement Disclosures" },
        { id: "s13", label: "Effective Date & Amendment Timeline" },
        { id: "s14", label: "Relationship to IFRS 12" },
        { id: "s15", label: "Statement / Process Mapping" },
        { id: "s16", label: "Related Standards — Cross-Reference Map" },
        { id: "s17", label: "Quick-Reference Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 38 Disclosure of Interests in Other Entities is the current, active standard issued by the IPSASB for disclosing interests in controlled, unconsolidated controlled, joint-arrangement and associate entities, and in structured entities that are not consolidated. Effective for periods beginning on or after 1 January 2017 (earlier application encouraged). Paras. 1–57."
    historical="IPSAS 38 is the IPSASB's adaptation of IFRS 12 Disclosure of Interests in Other Entities for the public sector — mirroring the composition, risk and VIE-style disclosures, with public-sector commentary on service-concession and shared-service arrangements."
    link=""
    linkText=""
  />

  <div class="legend">
    <span class="legend-item legend-objective">Objective &amp; scope (paras. 1–4)</span>
    <span class="legend-item legend-recognition">Judgments & interests (paras. 7–34)</span>
    <span class="legend-item legend-disclosure">Disclosure (paras. 49–57)</span>
    <span class="legend-item legend-ias">IFRS / IAS equivalent (IFRS 12)</span>
  </div>

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; Out-of-Scope Interests (paras. 1–4)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Objective &amp; scope (para. 1)</div>
      <div class="principle">Requires an entity to disclose information that enables users to evaluate the NATURE OF, AND RISKS associated with, its interests in (a) controlled entities, (b) unconsolidated controlled entities, (c) joint arrangements and associates, and (d) structured entities that are not consolidated.</div>
      <div class="glossary-item"><div class="glossary-term">Interest</div><div class="glossary-def">A direct or indirect interest in an entity — control, joint arrangement, associate, structured entity.</div></div>
    </div>

    <div class="card cd span2">
      <div class="ctitle cd">Out of scope</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.5fr 1.5fr;"><span>Excluded</span><span>Instead, see…</span></div>
        <div class="tr" style="grid-template-columns:1.5fr 1.5fr;"><span>Separate FS own disclosures</span><span>IPSAS 34</span></div>
        <div class="tr alt" style="grid-template-columns:1.5fr 1.5fr;"><span>Consolidation mechanics</span><span>IPSAS 35</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Definitions — Interest, Structured Entity &amp; Binding Arrangement (para. 7)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Core definitions (para. 7)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.3fr 1.7fr;"><span>Term</span><span>Meaning</span></div>
        <div class="tr" style="grid-template-columns:1.3fr 1.7fr;"><span>Structured entity</span><span>Entity whose assets/liabilities are carried in a way dependent on assets not available to pay claims</span></div>
        <div class="tr alt" style="grid-template-columns:1.3fr 1.7fr;"><span>Binding arrangement</span><span>Contract giving rights to the holder and risks to the entity</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Significant Judgments, Assumptions &amp; Investment Entity Status (paras. 9–16)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Judgment calls (para. 9)</div>
      <div class="principle">Disclose the JUDGMENTS and ASSUMPTIONS used to determine (a) whether the entity has a controlling financial interest; (b) whether it is an investment entity (and the basis for that status); and (c) whether a VIE-like structured entity should be consolidated. Transparency over the how.</div>
      <div class="callout warn">Where the entity is an investment entity, disclose the nature of the status and any changes in it.</div>
    </div>
  </div>

  <!-- ============ SECTION 4 ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Interests in Controlled Entities — Composition &amp; Non-Controlling Interests (paras. 17–19)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">What's inside (para. 17)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.3fr 1.7fr;"><span>Disclosure</span><span>Content</span></div>
        <div class="tr" style="grid-template-columns:1.3fr 1.7fr;"><span>Composition of the group</span><arg_value>Segment, geography, line of business</span></div>
        <div class="tr alt" style="grid-template-columns:1.3fr 1.7fr;"><span>NCI</span><span>Amount, ownership %, valuation basis</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 5 ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Significant Restrictions &amp; Risks From Consolidated Structured Entities</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw">
      <div class="ctitle cw">VIE-style risks (para. 20)</div>
      <div class="principle">Disclose the nature of the involvement with each structured entity over which the group has a controlling interest, the significant restrictions to which it is subject, and the impact on the entity's financial position and performance if it were to lose the structured entity.</div>
      <div class="glossary-item"><div class="glossary-term">Structured entity</div><div class="glossary-def">Entity whose assets are exposed to residual risks of assets not available to pay liabilities.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 6 ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Consequences of Ownership Changes &amp; Loss of Control</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Change events (para. 25)</div>
      <div class="principle">Disclose the gain/loss recognised on acquisition or loss of a controlling interest, including the movement in NCI and any deferred/contingent consideration involved. Reconcile the opening and closing balances of NCI equity.</div>
      <div class="callout info callout--flush">A change in control is a separate transaction from the continuing acquiree.</div>
    </div>
  </div>

  <!-- ============ SECTION 7 ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Interests in Unconsolidated Controlled Entities — Investment Entities (paras. 27–34)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Unconsolidated (para. 27)</div>
      <div class="principle">Where an investment entity holds an interest in a controlled entity that is NOT consolidated, disclose the reason for non-consolidation, the nature of the interest, the carrying amount, and the unobservable inputs used in valuing structured-entity interests.</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.4fr;"><span>Item</span><span>Disclosed</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.4fr;"><span>Cause of non-consolidation</span><span>Investment entity status</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.4fr;"><span>Fair value hierarchy</span><span>Level 2 vs Level 3 split</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 8 ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Interests in Joint Arrangements &amp; Associates (paras. 35–39)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw">
      <div class="ctitle cw">Joint & associate interests (para. 35)</div>
      <div class="principle">Disclose the carrying amount of interests in joint arrangements (IPSAS 37) and associates (IPSAS 36), the share of profit/loss recognised, and the FV hierarchy where measured at FVOCI. Include a maturity analysis for commitments.</div>
      <div class="callout warn">Separate line for unobservable (Level 3) inputs — critical for structured-entity interests.</div>
    </div>
  </div>

  <!-- ============ SECTION 9 ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Interests in Structured Entities That Are Not Consolidated (paras. 40–48)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Unconsolidated structured (para. 40)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.4fr;"><span>Basis</span><span>Metric</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.4fr;"><span>Why not consolidated</span><span>No power over activities</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.4fr;"><span>Exposure metric</span><arg_span>Carrying amount + max loss potential</span></div>
      </div>
      <div class="callout warn">This is where the public sector 'guarantee' exposure most often surfaces — disclose it explicitly.</div>
    </div>
  </div>

  <!-- ============ SECTION 10 ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Non-Quantifiable Ownership Interests</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Unobservable bits (para. 49)</div>
      <div class="principle">Disclose the nature and carrying amount of ownership interests that are NOT measured at fair value (e.g. cost-method interests, interests with no quoted price), including the basis for that treatment and the unobservable inputs used in any valuation technique.</div>
      <div class="glossary-item"><div class="glossary-term">Level 3</div><div class="glossary-def">Inputs other than quoted prices for identical or similar assets/liabilities.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 11 ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Controlling Interests Acquired with the Intention of Disposal</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Held for sale (para. 51)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.3fr 1.7fr;"><span>Disclosure</span><span>Content</span></div>
        <div class="tr" style="grid-template-columns:1.3fr 1.7fr;"><span>Acquisition with disposal intent</span><span>Nature, carrying amount, FV less costs to sell</span></div>
        <div class="tr alt" style="grid-template-columns:1.3fr 1.7fr;"><span>Timing</span><span>Expected disposal horizon</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 12 ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Current Value Measurement Disclosures (paras. 57A–57D)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Valuation detail (para. 57A)</div>
      <div class="principle">Where interests in structured entities are measured at fair value, disclose the valuation techniques used, the inputs (Level 1/2/3 split), the reconciliation of beginning/end carrying amounts, and any transfers between levels of the hierarchy.</div>
      <div class="callout info callout--flush">Level 3 movements must be reconciled in detail — the IPSASB treats structured-entity valuations as high-transparency.</div>
    </div>
  </div>

  <!-- ============ SECTION 13 ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Effective Date &amp; Amendment Timeline (paras. 61–61D)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Timeline</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.2fr;"><span>Date</span><span>Event</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>Jan 2015</span><span>Issued</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.2fr;"><span>1 Jan 2017</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>2023</span><span>Amended (latest)</span></div>
      </div>
      <div class="callout warn">IPSAS 38 superseded IPSAS 9 (Interests in Offshore Entities) — that earlier Standard withdrew.</div>
    </div>
  </div>

  <!-- ============ SECTION 14 ============ -->
  <div class="section-header" id="s14"><span class="num">14</span><h2>Relationship to IFRS 12</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">Mapping (para. 61E)</div>
      <div class="principle">IPSAS 38 mirrors IFRS 12's disclosure framework — composition of the group, NCI, VIE-style structured entities, unobservable inputs, and changes in control — with public-sector commentary on government guarantees and shared-service entities.</div>
      <div class="cross-list"><span>IFRS 12 composition</span><span>IPSAS 38 same</span><span>IFRS 12 VIE disclosures</span><span>IPSAS 38 same</span><span>IFRS 12 unobservable inputs</span><span>IPSAS 38 same</span></div>
    </div>
  </div>

  <!-- ============ SECTION 15 ============ -->
  <div class="section-header" id="s15"><span class="num">15</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Where it flows</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.4fr 1.3fr;"><span>Process</span><span>Ledger</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Interest register</span><span>Entity Register → composition/NCI</span></div>
        <div class="tr alt" style="grid-template-columns:1.4fr 1.3fr;"><span>VIE assessment</span><span>Risk Function → Structured Entity Dashboard</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>FV hierarchy</span><span>Valuation → Disclosure Engine (Level 1/2/3)</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 16 ============ -->
  <div class="section-header" id="s16"><span class="num">16</span><h2>Related Standards — Cross-Reference Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">See also</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 2fr;"><span>Standard</span><span>Relation</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 35</span><span>Consolidation (composes the group)</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IPSAS 36</span><span>Associate interests</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 37</span><span>Joint-arrangement interests</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IFRS 12</span><span>Direct equivalent</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 17 ============ -->
  <div class="section-header" id="s17"><span class="num">17</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Structured entity</div><div class="glossary-def">Entity whose assets depend on assets not available to pay liabilities.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Investment entity</div><div class="glossary-def">Holds investments for capital appreciation; FV exception.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Non-controlling interest</div><div class="glossary-def">NCI share of subsidiary equity not attributable to parent.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Level 3</div><div class="glossary-def">Unobservable valuation inputs.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Control</div><div class="glossary-def">Power to govern policies so as to obtain benefits.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Loss of control</div><div class="glossary-def">Derecognition; gain/loss to P&amp;L.</div></div>
    </div>
  </div>
</StandardPageLayout>
