  <Fragment slot="toc">
    <PageToc items={[
        {id: "s1", label: "1. Conceptual Framework Linkage"},
        {id: "s2", label: "2. Scope"},
        {id: "s3", label: "3. Lower of Cost and Net Realisable Value"},
        {id: "s4", label: "4. Acceptable Cost Formulas — and the Elimination of LIFO"},
        {id: "s5", label: "5. Write-Down to Net Realisable Value — Presentation"},
        {id: "s6", label: "6. Reversal of Write-Downs"},
