---
import NavLink from "./NavLink.astro";

interface Props {
  items: any[];
  sectionId: string;
  categories?: readonly string[];
  label?: string;
}

const { items, sectionId, categories, label } = Astro.props;

function orderItems(list: any[]) {
  const primary = list.filter(
    (item: any) => !item.status || item.status === "Upcoming"
  );
  const retired = list.filter(
    (item: any) => item.status && item.status !== "Upcoming"
  );
  return [...primary, ...retired];
}

function badgeFor(item: any) {
  return item.status || undefined;
}

function badgeVariantFor(item: any) {
  if (!item.status) return undefined;
  return item.status === "Upcoming" ? "upcoming" : "retired";
}

const orderedItems = categories ? [] : orderItems(items);

const categoryGroups = categories
  ? categories
      .map((category: string) => {
        const inCategory = items.filter(
          (item: any) => item.category === category
        );
        return { category, items: orderItems(inCategory) };
      })
      .filter((group) => group.items.length > 0)
  : [];

---

<div class="section" data-section={sectionId}>
  {label && <div class="sidebar-subfolder-label">{label}</div>}

  {categories &&
    categoryGroups.map((group) => (
      <div class="sidebar-category-group">
        <div class="sidebar-category-label">{group.category}</div>
        <ul class="sidebar-items">
          {group.items.map((item: any) => (
            <li>
              <NavLink
                href={item.url}
                title={item.title}
                section={sectionId}
                code={item.code}
                standardTitle={item.title}
                badge={badgeFor(item)}
                badgeVariant={badgeVariantFor(item)}
              >
                {item.code}
              </NavLink>
            </li>
          ))}
        </ul>
      </div>
    ))}

  {!categories && (
    <ul class="sidebar-items">
      {orderedItems.map((item: any) => (
        <li>
          <NavLink
            href={item.url}
            title={item.title}
            section={sectionId}
            code={item.code}
            standardTitle={item.title}
            badge={badgeFor(item)}
            badgeVariant={badgeVariantFor(item)}
          >
            {item.code}
          </NavLink>
        </li>
      ))}
    </ul>
  )}
</div>
