---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas13.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Why This Standard Is Here" },
        { id: "s2", label: "Superseded by IPSAS 43" },
        { id: "s3", label: "Redirect Map" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IPSAS 13 Leases was withdrawn for annual financial statements covering periods beginning on or after 1 January 2025 and superseded by IPSAS 43 Leases."
    historical="IPSAS 13 used the finance-lease / operating-lease dichotomy for lessees (mirroring IAS 17). The IPSASB replaced this approach, mirroring the IASB's 2016 replacement of IAS 17 with IFRS 16."
    link="/ipsas/ipsas43"
    linkText="IPSAS 43 — Leases"
    currentLabel="Replaced by"
  />

    <!-- ============ SECTION 1 — WHY THIS STANDARD IS HERE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Why This Standard Is Here</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Removed from the Handbook — retained here only as a numbering placeholder</div>
        <div class="principle">IPSAS 13, <em>Leases</em>, was withdrawn following the IPSASB's move to a modern, single-model lease accounting Standard, mirroring the IASB's 2016 replacement of IAS 17 with IFRS 16. It was superseded for annual financial statements covering periods beginning on or after <strong>1 January 2025</strong>.</div>
        <div class="callout danger callout--flush">The 2025 IPSASB Handbook now contains only a one-paragraph removal notice for this number — there is no remaining technical content to build a reference poster from. This page exists so the poster library's numbering stays complete and correctly redirects to the live successor Standard.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SUPERSEDED BY ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Superseded by IPSAS 43</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">The finance/operating lessee split is gone</div>
        <div class="principle">IPSAS 13 used the older finance-lease/operating-lease dichotomy (mirroring IAS 17) — a lessee only recognized a lease liability and asset for leases classified as "finance leases," with operating leases kept entirely off the statement of financial position.</div>
        <div class="spec-box">
          <div class="spec-title">IPSAS 43 — Leases</div>
          <div class="text-supporting">Adopts a single lessee accounting model (mirroring IFRS 16): almost all leases are brought ON-BALANCE-SHEET as a right-of-use asset and a lease liability, eliminating the old finance/operating distinction for lessees. Lessor accounting broadly retains the finance/operating split.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — REDIRECT MAP ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Redirect Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Withdrawn number → live Standard</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1fr 1.4fr 1.6fr;"><span>Withdrawn</span><span>Superseded by</span><span>Effective date</span></div>
          <div class="tr" style="grid-template-columns:1fr 1.4fr 1.6fr;"><span>IPSAS 13</span><span><span class="badge bs">IPSAS 43</span></span><span>Periods beginning on/after 1 Jan 2025</span></div>
        </div>
        <div class="note">For current authoritative requirements, see the dedicated standard for IPSAS 43 (Leases) in this library.</div>
      </div>
    </div>


  </StandardPageLayout>
