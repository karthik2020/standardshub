---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/sic/sic18.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-18 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-18 was withdrawn in March 2003 when the IASB issued Improvements to IFRSs, which eliminated most benchmark and allowed-alternative treatment choices from individual standards, removing the need for SIC-18's consistency requirement."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ias/ias8"
    linkText="IAS 8 Accounting Policies, Changes in Accounting Estimates and Errors"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-18 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-18 addressed</div>
        <div class="principle">SIC-18 addressed how consistently an entity must apply a chosen accounting treatment when an IFRS permits a choice between a benchmark treatment and an allowed alternative treatment. It provided guidance on whether an entity could mix treatments across periods or items.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-18 concluded that an entity must apply its chosen treatment consistently. Once an entity selects either the benchmark or the allowed alternative treatment under a particular IFRS, it must apply that treatment consistently for all assets and liabilities within a class, and from period to period, unless a change in accounting policy is justified under IAS 8.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>Improvements to IFRSs (2003)</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2003 Improvements project eliminated most benchmark and allowed-alternative choices, absorbing consistency into IAS 8</span></div>
          <div class="tr"><span>Current status</span><span>Superseded</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Benchmark treatment", definition: "The preferred or norm-requirement accounting treatment specified in an IFRS when the standard originally permitted a choice between treatments." },
      { term: "Allowed alternative treatment", definition: "The optional accounting treatment permitted alongside the benchmark treatment under certain older IFRS standards." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC18} />
  </section>
</StandardPageLayout>




