        { id: "s7", label: "7. The Creditor's Perspective — Recognising a Restructuring Loss" },
        { id: "s8", label: "8. Debt-to-Equity Swaps" },
        { id: "s9", label: "9. Worked Example — a Debtor's Gain on Debt Forgiveness" },
        { id: "s10", label: "10. Worked Example — a Debt-to-Equity Swap" },
