---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas1.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Complete Set of Financial Statements" },
        { id: "s4", label: "Structure & Content — Balance Sheet" },
        { id: "s5", label: "Structure & Content — Statement of P&L" },
        { id: "s6", label: "Current vs Non-Current Classification" },
        { id: "s7", label: "Schedule III — The Mandatory Indian Format" },
        { id: "s8", label: "Going Concern & Materiality" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 1 vs IAS 1 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Same fair presentation objective as IAS 1, different mandatory layout</div>
        <div class="principle">Ind AS 1 shares IAS 1's core objective — ensuring financial statements FAIRLY present financial position, performance, and cash flows, and are COMPARABLE both across periods and across entities. Where Ind AS 1 genuinely diverges is that Indian company financial statements must ALSO comply with the PRESCRIBED format of Schedule III to the Companies Act, 2013, which IAS 1 does not impose on IFRS preparers globally.</div>
        <div class="elabel">HOW IND AS 1 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Comparability</strong> — Schedule III's prescribed format arguably ENHANCES comparability specifically WITHIN India, even though it narrows the flexibility IAS 1 otherwise allows</span>
          <span><strong>Faithful representation</strong> — the single combined statement of profit and loss (mandatory under Ind AS 1) is considered to present performance MORE COHESIVELY than a two-statement split</span>
        </div>
        <div class="note">This is one of the FEW Ind AS standards with a genuine, structurally significant format-level divergence from its IFRS counterpart, rather than a purely regulatory-overlay difference.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Complete set of financial statements — largely identical components to IAS 1</div>
        <div class="td-table">
          <div class="th cols-16-1"><span>Component</span><span>Ind AS 1 name</span></div>
          <div class="tr cols-16-1"><span>Statement of financial position</span><span>Balance Sheet</span></div>
          <div class="tr alt cols-16-1"><span>Statement of profit or loss + OCI</span><span>Statement of Profit and Loss (single, combined)</span></div>
          <div class="tr cols-16-1"><span>Statement of changes in equity</span><span>Statement of Changes in Equity</span></div>
          <div class="tr alt cols-16-1"><span>Statement of cash flows</span><span>Cash Flow Statement</span></div>
        </div>
        <div class="callout warn callout--chip callout--flush">⚠️ IAS 1 permits IFRS preparers to choose whichever titles they wish; Ind AS 1's titles align with Schedule III terminology, which Indian preparers must use.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 1 covers</div>
        <div class="principle">Ind AS 1 sets overall requirements for presentation of general purpose financial statements, structure, and minimum content — IDENTICAL underlying scope to IAS 1, layered with Schedule III's format mandate for Indian companies.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">General purpose financial statements</div>
          <div class="glossary-def">IDENTICAL definition to IAS 1.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Schedule III</div>
          <div class="glossary-def">A schedule to the Companies Act, 2013 prescribing the mandatory format for Indian company balance sheets and statements of profit and loss.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — COMPLETE SET ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Complete Set of Financial Statements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical components, Schedule III-aligned titles</div>
        <div class="text-supporting">Balance sheet, statement of profit and loss, statement of changes in equity, cash flow statement, and notes — the SAME components required by IAS 1, but presented under Schedule III's mandatory Indian titles and formats.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — BALANCE SHEET (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Structure &amp; Content — Balance Sheet</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Schedule III's prescribed vertical format</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Balance sheet format constraint</div>
          <div class="wk-body">An Indian manufacturing company wants to present its balance sheet in a horizontal (T-account) format, similar to a style permitted under IAS 1's flexible approach used by some global peers.</div>
          <div class="wk-answer">Schedule III MANDATES a VERTICAL format with specific line-item groupings (e.g. "Equity and Liabilities" then "Assets", each split between non-current and current) — the company CANNOT use a horizontal format, illustrating the genuine format constraint Ind AS 1 imposes beyond IAS 1's own more flexible presentation latitude.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — STATEMENT OF P&L ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Structure &amp; Content — Statement of Profit and Loss</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Mandatory single-statement approach — a genuine divergence from IAS 1</div>
        <div class="text-supporting">IAS 1 permits EITHER a single statement of profit or loss and OCI, OR two separate statements (a separate income statement followed by a separate statement of comprehensive income). Ind AS 1 does NOT offer this choice — it MANDATES the single combined Statement of Profit and Loss, incorporating both P&amp;L and OCI sections, aligned with Schedule III's prescribed format.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — CURRENT VS NON-CURRENT ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Current vs Non-Current Classification</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical classification principles to IAS 1</div>
        <div class="text-supporting">The operating cycle test, and the 12-month settlement/realisation criteria for current classification, are IDENTICAL to IAS 1 (including the IASB's 2020/2022 non-current liabilities with covenants amendments, converged into Ind AS 1).</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — SCHEDULE III (worked example) ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Schedule III — The Mandatory Indian Format</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">The single most consequential Indian divergence point</div>
        <div class="principle">Schedule III prescribes DETAILED line-item groupings, minimum disclosure line items, and rounding-off conventions (e.g. figures rounded to the nearest lakh/crore depending on turnover) for Indian company financial statements — a level of PRESCRIPTIVE detail that IAS 1 deliberately avoids globally, instead relying on principles-based minimum line item requirements.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: Rounding-off requirements</div>
          <div class="wk-body">A large Indian listed company with turnover exceeding ₹100 crore must round off figures in its financial statements to the nearest LAKH, crore, or decimals thereof, per Schedule III's rounding-off table (based on turnover bands).</div>
          <div class="wk-answer">This SPECIFIC rounding-off mandate has NO direct equivalent in IAS 1, which leaves rounding/presentation currency conventions to entity/jurisdictional discretion — a clear illustration of Schedule III's prescriptive layer beyond Ind AS 1/IAS 1's own principles-based content.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — GOING CONCERN & MATERIALITY ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Going Concern &amp; Materiality</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 1</div>
        <div class="text-supporting">Going concern assessment, materiality-based aggregation/disaggregation, and consistency of presentation — IDENTICAL principles to IAS 1.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical core disclosures plus Schedule III line items</div>
        <div class="check-list">
          <span>Compliance statement, accounting policies</span>
          <span>Judgements and sources of estimation uncertainty</span>
          <span>Capital management disclosures</span>
          <span>Schedule III-specific line items (e.g. share capital reconciliation, related party details in prescribed format)</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Current vs non-current classification at the reporting date</span>
              <span>Materiality thresholds for aggregation/disaggregation</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Going concern assessment period and assumptions</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">⚠️ Reconciling internal management reporting formats with Schedule III's mandatory presentation is a genuinely common practical challenge for Indian finance teams, distinct from any IAS 1-only jurisdiction's experience.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 1 vs IAS 1 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 1 vs IAS 1 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 1</span><span>Ind AS 1</span></div>
          <div class="tr cols-12-1-1"><span>Statement of profit or loss format</span><span>Choice of single statement OR two separate statements</span><span>MANDATORY single combined statement — no two-statement option</span></div>
          <div class="tr alt cols-12-1-1"><span>Balance sheet/P&amp;L format</span><span>Principles-based minimum line items, no prescribed layout</span><span>Schedule III PRESCRIBES a specific vertical format with detailed groupings</span></div>
          <div class="tr cols-12-1-1"><span>Rounding-off conventions</span><span>Left to entity/jurisdictional discretion</span><span>Schedule III mandates SPECIFIC rounding bands based on turnover</span></div>
          <div class="tr alt cols-12-1-1"><span>Current/non-current classification, going concern, materiality</span><span>Standard principles</span><span>IDENTICAL to IAS 1</span></div>
        </div>
        <div class="note">Ind AS 1 is one of the RARE standards with a genuine, structurally meaningful divergence from its IFRS counterpart — driven by Schedule III's prescriptive format mandate, not by any difference in Ind AS 1's own underlying principles.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Revenue, expenses</span><span><span class="badge bp">P&amp;L</span></span><span>Within the single combined statement</span></div>
          <div class="tr alt cols-16-1-14"><span>Remeasurement gains/losses (e.g. defined benefit plans)</span><span><span class="badge bo">OCI</span></span><span>Within the SAME combined statement, in its OCI section</span></div>
          <div class="tr cols-16-1-14"><span>Share capital movements</span><span><span class="badge be">Equity</span></span><span>Schedule III prescribes a specific reconciliation format</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 1</span><span>The global counterpart standard, converged in principle but diverging in mandatory format</span></div>
          <div class="tr alt cols-08-2"><span>Schedule III (Companies Act, 2013)</span><span>Prescribes the mandatory Indian presentation format</span></div>
          <div class="tr cols-08-2"><span>Ind AS 8</span><span>Governs accounting policy changes and error corrections referenced in Ind AS 1</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Operating cycle</div>
          <div class="glossary-def">The time between acquisition of assets for processing and their realisation in cash — identical concept to IAS 1.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Rounding-off table</div>
          <div class="glossary-def">Schedule III's turnover-based table prescribing whether figures are rounded to hundreds, lakhs, or crores.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "General purpose financial statements", definition: "Statements intended to meet the needs of users who cannot require an entity to prepare reports tailored to them — identical definition to IAS 1." },
      { term: "Schedule III", definition: "A schedule to the Companies Act, 2013 prescribing the mandatory format for Indian company balance sheets and statements of profit and loss." },
      { term: "Operating cycle", definition: "The time between acquisition of assets for processing and their realisation in cash or cash equivalents — identical concept to IAS 1." },
      { term: "Rounding-off table", definition: "Schedule III's turnover-based table prescribing whether figures are rounded to hundreds, lakhs, or crores." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
