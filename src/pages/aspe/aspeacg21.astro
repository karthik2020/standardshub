import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspeacg21.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Scope — the Policyholder's Perspective" },
        { id: "s3", label: "3. Why Private Enterprises Hold Corporate-Owned Life Insurance" },
        { id: "s4", label: "4. THE CORE PRINCIPLE — Recognizing Cash Surrender Value as an Asset" },
        { id: "s5", label: "5. Allocating Premiums — Insurance Cost vs Cash Surrender Value Increase" },
        { id: "s6", label: "6. Changes in Cash Surrender Value" },
        { id: "s7", label: "7. Worked Example — Allocating an Annual Premium Payment" },
        { id: "s8", label: "8. Worked Example — Recognizing a Cash Surrender Value Increase" },
        { id: "s9", label: "9. Disclosure Requirements" },
        { id: "s10", label: "10. Critical Judgments &amp; Estimates" },
        { id: "s11", label: "11. A Note on Scope — Policyholder, Not Insurer" },
        { id: "s12", label: "12. Statement Mapping" },
        { id: "s13", label: "13. Related Standards" },
        { id: "s14", label: "14. Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
</div>





<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Recognizing a genuine asset within a routine insurance premium</div><div class="principle">AcG-21 addresses HOW a POLICYHOLDER enterprise ACCOUNTS for a LIFE insurance POLICY it OWNS — TYPICALLY, corporate-OWNED life INSURANCE on a KEY employee OR shareholder — WHERE that POLICY carries a CASH surrender VALUE (CSV). THE core PRINCIPLE is RECOGNIZING the CSV as an ASSET, SEPARATE from the INSURANCE protection ELEMENT of the SAME premium PAYMENT (Section 4).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — the Policyholder's Perspective</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">The company owning the policy, not the insurance company issuing it</div><div class="principle">This Guideline applies TO an ENTERPRISE that OWNS a LIFE insurance POLICY with a CASH surrender VALUE — ADDRESSING the POLICYHOLDER'S own ACCOUNTING, ENTIRELY separate FROM how an INSURANCE company WOULD account FOR contracts it ISSUES.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Why Private Enterprises Hold Corporate-Owned Life Insurance</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Key-person protection and estate/tax planning</div><div class="text-supporting">CORPORATE-owned LIFE insurance is a GENUINELY common CANADIAN private-ENTERPRISE practice — PROTECTING against the LOSS of a KEY employee OR shareholder, and OFTEN serving AS part of a BROADER estate OR tax-PLANNING structure (SIMILAR in SPIRIT to the ESTATE-freeze and RoMRS arrangements COVERED under SECTION 3251 — see the COMPANION poster). THE policy'S cash SURRENDER value REPRESENTS a GENUINE, realizable ASSET the COMPANY could ACCESS by SURRENDERING or BORROWING against the POLICY.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>THE CORE PRINCIPLE — Recognizing Cash Surrender Value as an Asset</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">An asset distinct from the pure insurance protection element</div><div class="text-supporting">THE policyholder RECOGNIZES the CASH surrender VALUE of the POLICY as an ASSET on ITS own BALANCE Sheet — REFLECTING the GENUINE, realizable VALUE the POLICY carries BEYOND its PURE insurance-PROTECTION function, DISTINCT from the PORTION of EACH premium payment THAT simply PAYS for the COST of insurance COVERAGE itself.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Allocating Premiums — Insurance Cost vs Cash Surrender Value Increase</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Two components within a single premium payment</div>
<div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Component</span><span>Treatment</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Cost of insurance protection</span><span>EXPENSED as INCURRED — REFLECTING the GENUINE cost OF the underlying RISK coverage FOR the period</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Increase in cash surrender value</span><span>CAPITALIZED, INCREASING the CSV asset ON the BALANCE Sheet</span></div>
</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Changes in Cash Surrender Value</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Recognized in net income as they occur</div><div class="text-supporting">CHANGES in the POLICY'S cash SURRENDER value ARE recognized WITHIN net INCOME for the PERIOD — GIVEN ASPE'S absence OF any OCI mechanism (see the COMPANION Section 1520 poster), THERE is no ALTERNATIVE presentation AVAILABLE for THESE changes.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Worked Example — Allocating an Annual Premium Payment</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Splitting a single payment into two distinct components</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A key-person policy premium</div><div class="wk-body">A private company pays a $45,000 annual premium on a key-person life insurance policy covering its founder. Of this amount, the policy's cash surrender value is determined to have increased by $28,000 during the year, with the remainder representing the cost of insurance protection.</div><div class="wk-answer">The COMPANY expenses $45,000 − $28,000 = $17,000 as the COST of insurance PROTECTION, and CAPITALIZES the REMAINING <strong>$28,000</strong> as an INCREASE to the CASH surrender VALUE asset ON its BALANCE Sheet.</div></div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — Recognizing a Cash Surrender Value Increase</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Tracking the asset's growth over time</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: The policy's carrying value over successive years</div><div class="wk-body">Continuing the prior example, the policy's cash surrender value was $310,000 at the start of the year.</div><div class="wk-answer">FOLLOWING the $28,000 INCREASE, the POLICY'S cash SURRENDER value ASSET is <strong>$338,000</strong> at YEAR end — RECOGNIZED and CARRIED on the COMPANY'S Balance SHEET, REPRESENTING a GENUINE, realizable VALUE distinct FROM the pure INSURANCE protection ELEMENT of the ARRANGEMENT.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What AcG-21 requires</div><div class="check-list"><span>Carrying amount of cash surrender value recognized as an asset</span><span>Nature of significant corporate-owned life insurance arrangements</span><span>Amount of insurance expense and cash surrender value change recognized during the period</span></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Allocating a premium payment between the cost of insurance protection and the cash surrender value increase</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Generally minimal — cash surrender value is typically provided directly by the insurer</span></div></div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>A Note on Scope — Policyholder, Not Insurer</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">A fundamentally different question from insurance contract accounting</div>
<div class="text-supporting">THIS Guideline SHOULD not be CONFUSED with the BROADER question OF how an INSURANCE company ITSELF accounts FOR the insurance CONTRACTS it ISSUES (a SUBSTANTIALLY different, FAR more COMPLEX topic — SEE the COMPANION ASBE No. 25/26 POSTERS covering DIRECT insurance and REINSURANCE contracts EARLIER in this LIBRARY'S Chinese GAAP SERIES, for a SENSE of the SCALE of that SEPARATE topic). AcG-21 addresses ONLY the ORDINARY policyholder'S own, RELATIVELY narrow ACCOUNTING question.</div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every life insurance policy event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Cost of insurance protection</span><span><span class="badge is">IS</span></span><span>Expensed as incurred</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Cash surrender value increase</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Capitalized as an asset, changes recognized in net income</span></div>
</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 3251</span><span>Equity — shares a common Canadian tax-and-estate-planning context with this Guideline's typical use case</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Cash surrender value (CSV)</div><div class="glossary-def">The realizable value a life insurance policy carries beyond its pure insurance-protection function, recognized as an asset by the policyholder.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Corporate-owned life insurance</div><div class="glossary-def">A life insurance policy owned by a company, typically on a key employee or shareholder, often used for key-person protection or estate planning purposes.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.aspeacg21 || []} />
  </section>
</StandardPageLayout>
