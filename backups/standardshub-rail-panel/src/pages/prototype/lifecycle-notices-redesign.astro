---
import StandardLayout from "../../layouts/StandardLayout.astro";
import LifecycleNotice from "../../components/prototype/LifecycleNotice.astro";
import {
  ArrowRightLeft,
  Ban,
  BookMarked,
  CalendarClock,
  FileDiff,
  RefreshCw,
  CirclePause,
} from "@lucide/astro";
---

<StandardLayout code="PROTO" title="Lifecycle Notice — Redesign Preview" framework="Design">
  <p class="proto-intro">
    Prototype preview of the redesigned Standard Lifecycle Notice. Each panel shows a
    different lifecycle status with realistic accounting wording so the typography,
    spacing and colour hierarchy can be evaluated. No production pages are affected.
  </p>

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IAS 35</span>
    <span class="hero-status-pill hero-status-pill--superseded">
      <span class="hero-status-pill__circle"><ArrowRightLeft /></span>
      Superseded
    </span>
  </div>
  <p class="proto-context">Superseded — IAS 35 → IFRS 5</p>
  <LifecycleNotice
    type="superseded"
    explanation="IAS 35 Discontinuing Operations was superseded by IFRS 5 Non-current Assets Held for Sale and Discontinued Operations for annual periods beginning on or after 1 January 2005."
    historical="This page is retained for historical reference because the discontinuing-operations concept it introduced is the direct ancestor of IFRS 5's discontinued-operations and held-for-sale classification, and the standard may still be encountered in older study material and historical financial reporting discussions."
    link="/ifrs/ifrs5"
    linkText="IFRS 5 Non-current Assets Held for Sale and Discontinued Operations"
    transitionTo="ifrs5"
    targetStatus="Active"
  />

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IAS 15</span>
    <span class="hero-status-pill hero-status-pill--withdrawn">
      <span class="hero-status-pill__circle"><Ban /></span>
      Withdrawn
    </span>
  </div>
  <p class="proto-context">Withdrawn — IAS 15 (no longer in the literature)</p>
  <LifecycleNotice
    type="withdrawn"
    explanation="IAS 15 Information Reflecting the Effects of Changing Prices was withdrawn and is no longer part of the IFRS literature. Its subject matter is not addressed by a dedicated current standard."
    historical="This page is retained for historical reference because the disclosure practices it promoted still appear in narrative reporting, and the standard may be encountered in older academic texts and historical financial statements."
    link="/ias/ias16"
    linkText="IAS 16 Property, Plant and Equipment"
  />

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IAS 17</span>
    <span class="hero-status-pill hero-status-pill--historical-reference">
      <span class="hero-status-pill__circle"><BookMarked /></span>
      Historical Reference
    </span>
  </div>
  <p class="proto-context">Historical Reference — IAS 17 → IFRS 16</p>
  <LifecycleNotice
    type="historical-reference"
    explanation="IAS 17 Leases is provided here as a historical reference. Lease accounting for virtually all entities is now governed by IFRS 16 Leases for annual periods beginning on or after 1 January 2019."
    historical="This page is retained for historical reference because IAS 17's finance/operating lease classification logic still underpins lessor accounting under IFRS 16, and the standard remains common in older exam material and historical financial statements."
    link="/ifrs/ifrs16"
    linkText="IFRS 16 Leases"
  />

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IFRS 18</span>
    <span class="hero-status-pill hero-status-pill--effective-soon">
      <span class="hero-status-pill__circle"><CalendarClock /></span>
      Effective Soon
    </span>
  </div>
  <p class="proto-context">Effective Soon — IFRS 18 (future mandatory date)</p>
  <LifecycleNotice
    type="effective-soon"
    currentLabel="Becomes Effective"
    explanation="IFRS 18 Presentation and Disclosure of Financial Statements becomes mandatory for annual periods beginning on or after 1 January 2027, with earlier application permitted."
    historical="This page describes the upcoming requirements so readers can prepare ahead of adoption. Until the effective date, IFRS 18 does not yet apply to current reporting periods."
    link="/ifrs/ifrs18"
    linkText="IFRS 18 Presentation and Disclosure of Financial Statements"
    eventDate="2027-01-01"
  />

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IAS 1</span>
    <span class="hero-status-pill hero-status-pill--amended">
      <span class="hero-status-pill__circle"><FileDiff /></span>
      Amended
    </span>
  </div>
  <p class="proto-context">Amended — IAS 1 (narrow-scope improvements)</p>
  <LifecycleNotice
    type="amended"
    explanation="IAS 1 Presentation of Financial Statements was amended to clarify disclosure principles and to introduce the defined contribution plan classification, among other narrow-scope improvements."
    historical="This page reflects the amended requirements. Prior versions of IAS 1 remain relevant when reading financial statements prepared under earlier effective dates, and are retained here for historical reference."
    link="/ias/ias1"
    linkText="IAS 1 Presentation of Financial Statements"
    eventDate="2026-08-01"
  />

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IAS 39</span>
    <span class="hero-status-pill hero-status-pill--replaced">
      <span class="hero-status-pill__circle"><RefreshCw /></span>
      Replaced
    </span>
  </div>
  <p class="proto-context">Replaced — IAS 39 → IFRS 9</p>
  <LifecycleNotice
    type="replaced"
    explanation="IAS 39 Financial Instruments: Recognition and Measurement was replaced by IFRS 9 Financial Instruments for annual periods beginning on or after 1 January 2018."
    historical="This page is retained for historical reference because IAS 39's recognition, derecognition and hedge accounting concepts still underpin IFRS 9 in modified form, and the standard is frequently encountered in older study material."
    link="/ifrs/ifrs9"
    linkText="IFRS 9 Financial Instruments"
  />

  <div class="proto-lifecycle-hero">
    <span class="proto-lifecycle-hero__code">IFRS 18</span>
    <span class="hero-status-pill hero-status-pill--suspended">
      <span class="hero-status-pill__circle"><CirclePause /></span>
      Suspended
    </span>
  </div>
  <p class="proto-context">Suspended — deferred effective date</p>
  <LifecycleNotice
    type="suspended"
    explanation="The mandatory effective date of the new presentation and disclosure requirements has been suspended by the IASB pending the outcome of its post-implementation review, so the existing requirements continue to apply in the interim."
    historical="This page is retained because the suspended change may be reactivated, and readers should monitor IASB announcements for the revised effective date before applying the new requirements."
    link="/ias/ias1"
    linkText="IAS 1 Presentation of Financial Statements"
  />

  <style>
    .proto-intro {
      font-size: var(--text-small);
      color: var(--text-secondary);
      line-height: 1.6;
      padding: var(--space-lg);
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      margin-bottom: var(--space-2xl);
    }

    .proto-lifecycle-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      flex-wrap: wrap;
      margin-bottom: var(--space-sm);
      padding: var(--space-md);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
    }
    .proto-lifecycle-hero__code {
      font-size: 15px;
      font-weight: var(--weight-bold);
      color: var(--text);
      line-height: 1.3;
    }

    /* ===== Redesigned integrated status pill ===== */
    .hero-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 28px;
      padding: 0 12px 0 4px;
      border-radius: 999px;
      border: 1px solid var(--status-accent);
      background: var(--status-soft);
      color: var(--status-ink);
      font-size: 12px;
      font-weight: var(--weight-semibold);
      line-height: 1;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }
    .hero-status-pill__circle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--status-accent);
      color: #ffffff;
    }
    .hero-status-pill__circle :global(svg) {
      width: 12px;
      height: 12px;
    }
    .hero-status-pill--published {
      --status-accent: #059669;
      --status-soft: #ecfdf5;
      --status-ink: #065f46;
    }
    .hero-status-pill--draft {
      --status-accent: #475569;
      --status-soft: #f8fafc;
      --status-ink: #334155;
    }
    .hero-status-pill--archived {
      --status-accent: #64748b;
      --status-soft: #f1f5f9;
      --status-ink: #475569;
    }
    .hero-status-pill--superseded,
    .hero-status-pill--replaced {
      --status-accent: #b45309;
      --status-soft: #fffbeb;
      --status-ink: #92400e;
    }
    .hero-status-pill--withdrawn {
      --status-accent: #dc2626;
      --status-soft: #fff1f2;
      --status-ink: #b91c1c;
    }
    .hero-status-pill--historical-reference {
      --status-accent: #475569;
      --status-soft: #f1f5f9;
      --status-ink: #334155;
    }
    .hero-status-pill--effective-soon {
      --status-accent: #4f46e5;
      --status-soft: #eef2ff;
      --status-ink: #4338ca;
    }
    .hero-status-pill--amended {
      --status-accent: #7c3aed;
      --status-soft: #f5f3ff;
      --status-ink: #6d28d9;
    }
    .hero-status-pill--suspended {
      --status-accent: #c2410c;
      --status-soft: #fff7ed;
      --status-ink: #9a3412;
    }

    @media (max-width: 640px) {
      .proto-lifecycle-hero {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-sm);
      }
      .hero-status-pill {
        align-self: flex-start;
      }
    }

    .proto-context {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin: 0 0 var(--space-sm);
    }

    .proto-context:not(:first-of-type) {
      margin-top: var(--space-2xl);
    }
  </style>
</StandardLayout>
