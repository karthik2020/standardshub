---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas38.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Recognition Criteria — Identifiability, Control, Future Benefits" },
        { id: "s4", label: "Research Phase vs Development Phase" },
        { id: "s5", label: "Internally Generated Intangibles" },
        { id: "s6", label: "Useful Life — Finite vs Indefinite" },
        { id: "s7", label: "R&D Capitalisation for Indian IT/Pharma Sectors" },
        { id: "s8", label: "Website & Software Development Costs" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 38 vs IAS 38 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical recognition philosophy to IAS 38</div>
        <div class="principle">Ind AS 38 applies the IDENTICAL principle as IAS 38 — an intangible asset is recognised ONLY when it is IDENTIFIABLE, the entity has CONTROL, future economic benefits are PROBABLE, and cost can be measured RELIABLY, with research costs EXPENSED and development costs CAPITALISED only once specific criteria are met.</div>
        <div class="elabel">HOW IND AS 38 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Prudence in R&amp;D capitalisation</strong> — the strict research/development split PREVENTS speculative capitalisation of uncertain future benefits — identical to IAS 38</span>
          <span><strong>Indian IT/pharma relevance</strong> — India's LARGE software services/product and pharmaceutical (generic drug R&amp;D) sectors make Ind AS 38's development cost capitalisation criteria GENUINELY significant and frequently judgement-intensive in Indian practice</span>
        </div>
        <div class="note">Ind AS 38 introduced NO substantive change to the recognition framework relative to IAS 38 — its Indian relevance is most pronounced for the FREQUENCY of R&amp;D capitalisation judgements in technology/pharma sectors.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Research vs development — identical distinction to IAS 38</div>
        <div class="td-table"><div class="th cols-1-16"><span>Phase</span><span>Treatment</span></div>
          <div class="tr cols-1-16"><span>Research</span><span>EXPENSED as incurred (no reliable future benefit demonstration possible)</span></div>
          <div class="tr alt cols-1-16"><span>Development</span><span>CAPITALISED once six specific criteria are met</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 38 covers</div>
        <div class="principle">Ind AS 38 applies to intangible assets EXCLUDING those covered by other standards (e.g. Ind AS 115 contract costs, Ind AS 109 financial assets, goodwill under Ind AS 103) — IDENTICAL scope to IAS 38.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Identifiability</div>
          <div class="glossary-def">IDENTICAL definition to IAS 38 — separable from the entity, OR arising from contractual/legal rights.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Development phase</div>
          <div class="glossary-def">Application of research findings to a plan/design for production of new/improved materials, products, processes — identical to IAS 38.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — RECOGNITION CRITERIA ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Recognition Criteria — Identifiability, Control, Future Benefits</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 38</div>
        <div class="text-supporting">Identifiability, control (usually through legal rights), and probable future economic benefits — IDENTICAL three-part test to IAS 38, alongside the reliable cost measurement requirement.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — RESEARCH VS DEVELOPMENT (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Research Phase vs Development Phase</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical six development criteria to IAS 38</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Software development cost capitalisation</div>
          <div class="wk-body">An Indian software company incurs ₹2,00,00,000 exploring GENERAL feasibility of a new product concept (research), followed by ₹5,00,00,000 building a specific, technically feasible product with demonstrated market demand and adequate resources to complete it (development), meeting ALL six of Ind AS 38's development capitalisation criteria.</div>
          <div class="wk-answer">The ₹2,00,00,000 research cost is EXPENSED as incurred. The ₹5,00,00,000 development cost is CAPITALISED as an intangible asset, since ALL SIX criteria (technical feasibility, intention to complete, ability to use/sell, probable future benefits, adequate resources, reliable cost measurement) are met — an IDENTICAL application to how IAS 38 would treat the same software development project globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — INTERNALLY GENERATED ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Internally Generated Intangibles</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical prohibitions to IAS 38</div>
        <div class="text-supporting">Internally generated GOODWILL, brands, mastheads, publishing titles, and customer lists are NEVER recognised as intangible assets — IDENTICAL prohibition to IAS 38, since they cannot be reliably distinguished from the cost of developing the business as a whole.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — USEFUL LIFE ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Useful Life — Finite vs Indefinite</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 38</div>
        <div class="text-supporting">Finite-life intangibles are AMORTISED over their useful life; indefinite-life intangibles are NOT amortised but tested ANNUALLY for impairment under Ind AS 36 — IDENTICAL to IAS 38, relevant for Indian pharmaceutical patents (finite, tied to legal protection period) versus certain brand intangibles (potentially indefinite).</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — INDIAN IT/PHARMA R&D ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>R&amp;D Capitalisation for Indian IT/Pharma Sectors</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A practically prominent Indian application area</div>
        <div class="text-supporting">India's LARGE software product/services and generic pharmaceutical R&amp;D sectors make Ind AS 38's research/development split and SIX-CRITERIA development capitalisation test GENUINELY significant and frequently applied. Patent-related intangibles ALSO interact with India's Patents Act, 1970 framework — the LEGAL protection period under patent law often INFORMS (but does not by itself determine) the ACCOUNTING useful life estimate under Ind AS 38, which remains an economic/entity-specific judgement, IDENTICAL in principle to how IAS 38 treats patent-related useful life estimation globally.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — WEBSITE & SOFTWARE ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Website &amp; Software Development Costs</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 38 (via SIC-32 equivalent guidance)</div>
        <div class="text-supporting">Website development costs are assessed against the SAME research/development framework, with PLANNING stage costs expensed and APPLICATION/infrastructure development stage costs potentially capitalised if criteria are met — IDENTICAL to IAS 38's own SIC-32-derived guidance.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 38</div>
        <div class="check-list">
          <span>Useful lives/amortisation rates and methods</span>
          <span>Gross carrying amount and accumulated amortisation reconciliation</span>
          <span>Aggregate R&amp;D expenditure recognised as an expense</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Distinguishing the research phase from the development phase</span>
              <span>Whether all six development capitalisation criteria are genuinely met</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Useful life estimation, particularly for patents and technology intangibles</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">⚠️ Indian pharma/IT companies should maintain CONTEMPORANEOUS documentation supporting the research-to-development transition point, given the genuinely significant P&amp;L impact of this judgement.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 38 vs IAS 38 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 38 vs IAS 38 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 38</span><span>Ind AS 38</span></div>
          <div class="tr cols-12-1-1"><span>Research/development split, recognition criteria, useful life model</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Practical application context</span><span>Varies by jurisdiction/industry</span><span>Especially prominent in India's large IT/software and pharmaceutical R&amp;D sectors</span></div>
        </div>
        <div class="note">Ind AS 38 is essentially IDENTICAL to IAS 38 in substance — its distinctive Indian relevance lies in the FREQUENCY of R&amp;D capitalisation judgements, not any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Research cost incurred</span><span><span class="badge bp">P&amp;L</span></span><span>Expensed as incurred, identical to IAS 38</span></div>
          <div class="tr alt cols-16-1-14"><span>Development cost capitalised</span><span><span class="badge bs">Balance Sheet</span></span><span>Recognised as an intangible asset</span></div>
          <div class="tr cols-16-1-14"><span>Amortisation expense</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 38</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 38</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 36</span><span>Governs impairment testing of indefinite-life intangibles annually, and finite-life intangibles when indicators exist</span></div>
          <div class="tr cols-08-2"><span>Ind AS 103</span><span>Governs recognition of intangible assets acquired in a business combination</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Six development criteria</div>
          <div class="glossary-def">Technical feasibility, intention to complete, ability to use/sell, probable future benefits, adequate resources, reliable cost measurement — identical to IAS 38.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Patents Act, 1970</div>
          <div class="glossary-def">India's statutory patent protection framework, informing (but not determining) accounting useful life estimates for patent intangibles.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Six development criteria", definition: "Technical feasibility, intention to complete, ability to use/sell, probable future benefits, adequate resources, reliable cost measurement — identical to IAS 38." },
      { term: "Patents Act, 1970", definition: "India's statutory patent protection framework, informing (but not determining) accounting useful life estimates for patent intangibles." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
