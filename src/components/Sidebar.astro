---
/*
Sidebar

Primary navigation sidebar for the standards library.

Props:
- none (uses Astro.url.pathname for active state)

Renders collapsible sections for IAS, IFRS, and Ind AS with live search, count badges, and footer shortcuts. Active section expands automatically based on the current route.
*/

import standards from "../data/standards.json";
import NavLink from "./NavLink.astro";
import {
  Search,
  BookOpen,
  LibraryBig,
  Files,
  X,
  BookText,
  Clock,
  ChevronRight,
} from "@lucide/astro";
const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <div class="sidebar-search">
    <div class="search-box">
      <div class="search-input-wrapper">
        <Search size={15} class="search-icon" />

        <div class="search-placeholder" id="search-placeholder"></div>

        <input
          class="search-input"
          id="standard-search"
          type="text"
          placeholder=""
          aria-label="Filter standards"
          autocomplete="off"
        />

        <button class="search-action" id="search-action" type="button" aria-label="Clear filter" title="Clear filter">
          <X size={15} />
        </button>
      </div>
    </div>
  </div>

  <div class="sidebar-scroll">
    <nav aria-label="Standards Library">
    <div class="sidebar-heading">STANDARDS LIBRARY</div>

    <!-- IAS -->

    <details class="section section-ias" open={currentPath.startsWith("/ias")}>
      <summary class="section-header">
        <div class="section-title">
          <BookText size={17} strokeWidth={2} />
          <span>IAS</span>
        </div>

        <div class="section-actions">
          <span class="count-badge badge-ias">
            {standards.IAS.length}
          </span>

          <ChevronRight class="section-chevron" size={16} strokeWidth={2.4} />
        </div>
      </summary>

      <div class="section-items">
        <ul class="sidebar-items">
          {
            standards.IAS.map((item) => (
              <li>
                <NavLink
                  href={item.url}
                  title={item.title}
                  section="ias"
                  code={item.code}
                  standardTitle={item.title}
                >
                  {item.code}
                </NavLink>
              </li>
            ))
          }
        </ul>
      </div>
    </details>

    <!-- IFRS -->

    <details
      class="section section-ifrs"
      open={currentPath.startsWith("/ifrs")}
    >
      <summary class="section-header">
        <div class="section-title">
          <LibraryBig size={17} strokeWidth={2} />
          <span>IFRS</span>
        </div>

        <div class="section-actions">
          <span class="count-badge badge-ifrs">
            {standards.IFRS.length}
          </span>

          <ChevronRight class="section-chevron" size={16} strokeWidth={2.4} />
        </div>
      </summary>

      <div class="section-items">
        <ul class="sidebar-items">
          {
            standards.IFRS.map((item) => (
              <li>
                <NavLink
                  href={item.url}
                  title={item.title}
                  section="ifrs"
                  code={item.code}
                  standardTitle={item.title}
                >
                  {item.code}
                </NavLink>
              </li>
            ))
          }
        </ul>
      </div>
    </details>

    <!-- Ind AS -->

    <details
      class="section section-indas"
      open={currentPath.startsWith("/indas")}
    >
      <summary class="section-header">
        <div class="section-title">
          <Files size={17} strokeWidth={2} />
          <span>Ind AS</span>
        </div>

        <div class="section-actions">
          <span class="count-badge badge-indas">
            {standards.IndAS.length}
          </span>

          <ChevronRight class="section-chevron" size={16} strokeWidth={2.4} />
        </div>
      </summary>

      <div class="section-items">
        <ul class="sidebar-items">
          {
            standards.IndAS.map((item) => (
              <li>
                <NavLink
                  href={item.url}
                  title={item.title}
                  section="indas"
                  code={item.code}
                  standardTitle={item.title}
                >
                  {item.code}
                </NavLink>
              </li>
            ))
          }
        </ul>
      </div>
    </details>

    <div class="sidebar-empty" id="sidebar-empty" hidden>
      <div class="sidebar-empty-title">No matching standards</div>
      <div class="sidebar-empty-text">Try another standard number or keyword.</div>
      <div class="sidebar-empty-examples">
        <span>IAS 16</span>
        <span>Revenue</span>
        <span>Lease</span>
      </div>
    </div>
    </nav>
  </div>
  <footer class="sidebar-footer">
    <a href="#" class="footer-link">
      <Clock size={17} strokeWidth={2} />
      <span>Recent</span>
    </a>
  </footer>
</aside>
