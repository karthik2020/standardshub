        { id: "s7", label: "7. Acquisition-Related Costs — Expensed as Incurred" },
        { id: "s8", label: "8. Step Acquisitions" },
        { id: "s9", label: "9. Common Control Combinations — Recap and the Restatement Practice" },
        { id: "s10", label: "10. The Measurement Period" },
        { id: "s11", label: "11. Worked Example — Recognising Goodwill in an Arm's-Length Acquisition" },
        { id: "s12", label: "12. Worked Example — a Bargain Purchase Gain" },
        { id: "s13", label: "13. Disclosure Requirements" },
        { id: "s14", label: "14. Critical Judgments &amp; Estimates" },
        { id: "s15", label: "15. Relationship to IFRS 3" },
