>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope – Defining Environmental Credits and ECOs" },
        { id: "s3", label: "What Falls Outside the Scope" },
        { id: "s4", label: "Recognition of Environmental Credits – Driven by Intended Use" },
        { id: "s5", label: "Measurement of Environmental Credits" },
        { id: "s6", label: "Compliance Credits – Cost, With No Subsequent Remeasurement" },
        { id: "s7", label: "Non-Compliance Credits Recognized as Assets – Impairment Testing" },
        { id: "s8", label: "Recognition and Measurement of Environmental Credit Obligations (ECOs)" },
        { id: "s9", label: "The Funded and Unfunded Portions of an ECO" },
        { id: "s10", label: "Presentation – No Netting of Credits Against Obligations" },
        { id: "s11", label: "Worked Example – Recognizing a Compliance Credit Asset" },
        { id: "s12", label: "Worked Example – Measuring an Environmental Credit Obligation" },
        { id: "s13", label: "Disclosure Requirements" },
        { id: "s14", label: "Critical Judgments &amp; Estimates" },
