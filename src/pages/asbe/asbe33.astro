import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/asbe/asbe33.json";
---

<StandardPageLayout
  code='ASBE No. 33'
  standardType='ASBE'
  title={metadata.title}
  description={metadata.description}
  issued='2006-02'
  latestAmendment='2017-01'
  status='Active'
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope â€” the Group as a Single Reporting Entity" },
        { id: "s3", label: "The Control-Based Consolidation Model" },
        { id: "s4", label: "The Three Elements of Control" },
        { id: "s5", label: "Structured Entities and De Facto Control" },
        { id: "s6", label: "Uniform Accounting Policies Across the Group" },
        { id: "s7", label: "Non-Controlling Interests â€” Presented Within Equity" },
        { id: "s8", label: "Elimination of Intragroup Transactions and Balances" },
        { id: "s9", label: "Worked Example â€” Assessing Control Through De Facto Indicators" },
        { id: "s10", label: "Worked Example â€” Presenting Non-Controlling Interests" },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments &amp; Estimates" },
        { id: "s13", label: "Relationship to IFRS 10" },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Standards" },
        { id: "s16", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">
<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Presenting a group of entities as a single economic unit</div><div class="principle">ASBE No. 33 governs the PREPARATION of CONSOLIDATED financial STATEMENTS â€” PRESENTING a PARENT and ITS subsidiaries AS IF they WERE a SINGLE economic ENTITY. The Standard APPLIES a CONTROL-based consolidation MODEL closely CONVERGED with IFRS 10 internationally.</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope â€” the Group as a Single Reporting Entity</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Parents controlling one or more subsidiaries</div><div class="principle">This Standard applies to a PARENT company CONTROLLING one or MORE subsidiaries, REQUIRING the PREPARATION of CONSOLIDATED financial STATEMENTS COMBINING the PARENT'S and SUBSIDIARIES' individual FINANCIAL statements INTO a SINGLE set of GROUP-level statements.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>The Control-Based Consolidation Model</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Consolidation determined by control, not simply ownership percentage</div><div class="principle">AN investee is CONSOLIDATED WHERE the INVESTOR has CONTROL over it â€” CONTROL being the DETERMINING factor, RATHER than SIMPLY the PERCENTAGE of VOTING rights HELD â€” CONSISTENT with IFRS 10'S own control-BASED consolidation MODEL internationally.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>The Three Elements of Control</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Power, exposure to variable returns, and the ability to use power to affect returns</div><div class="check-list"><span>POWER over the INVESTEE (existing RIGHTS giving the CURRENT ability to DIRECT relevant ACTIVITIES)</span><span>EXPOSURE, or RIGHTS, to VARIABLE returns FROM involvement WITH the investee</span><span>The ABILITY to USE power OVER the investee to AFFECT the AMOUNT of the INVESTOR'S returns</span></div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Structured Entities and De Facto Control</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Control assessed even without majority voting rights</div><div class="principle">AN investor MAY control an INVESTEE EVEN WITHOUT holding a MAJORITY of VOTING rights â€” THROUGH "DE FACTO" control INDICATORS (e.g. a LARGE, dispersed SHAREHOLDER base LEAVING the LARGEST minority HOLDER with PRACTICAL control), OR through STRUCTURED entities DESIGNED so that VOTING rights are NOT the DOMINANT factor in DETERMINING control â€” CONSISTENT with IFRS 10'S own broadened CONTROL assessment internationally.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Uniform Accounting Policies Across the Group</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Adjusting subsidiary statements to match group policy</div><div class="principle">CONSOLIDATED financial STATEMENTS are PREPARED using UNIFORM accounting POLICIES for LIKE transactions and EVENTS across the ENTIRE group â€” WHERE a SUBSIDIARY applies DIFFERENT accounting POLICIES from the GROUP'S own, APPROPRIATE adjustments are MADE to that SUBSIDIARY'S financial STATEMENTS when PREPARING the CONSOLIDATED statements.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Non-Controlling Interests â€” Presented Within Equity</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Separately from the parent's own equity</div><div class="principle">NON-CONTROLLING interests (the EQUITY in a SUBSIDIARY NOT attributable, DIRECTLY or INDIRECTLY, to the PARENT) are PRESENTED WITHIN the CONSOLIDATED Balance SHEET'S owners' EQUITY section, SEPARATELY from the PARENT'S own EQUITY â€” CONSISTENT with IFRS 10'S own presentation REQUIREMENT internationally.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Elimination of Intragroup Transactions and Balances</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Removing transactions within the group entirely</div><div class="principle">INTRAGROUP balances, TRANSACTIONS, income, and EXPENSES (INCLUDING unrealised PROFITS and losses ARISING from intragroup TRANSACTIONS) are ELIMINATED IN FULL when PREPARING the CONSOLIDATED financial STATEMENTS â€” ENSURING the GROUP'S consolidated RESULTS reflect ONLY transactions with PARTIES OUTSIDE the group.</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example â€” Assessing Control Through De Facto Indicators</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Control without a majority voting stake</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: The largest shareholder in a widely dispersed company</div><div class="wk-body">A company holds 35% of the voting shares in an investee, with the remaining 65% dispersed among thousands of small shareholders who rarely attend or vote at shareholder meetings.</div><div class="wk-answer">GIVEN the DISPERSED nature of the REMAINING shareholding, the 35% holder MAY, in PRACTICE, have DE FACTO control OVER the investee'S relevant ACTIVITIES â€” REQUIRING consolidation EVEN WITHOUT a MAJORITY voting STAKE.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example â€” Presenting Non-Controlling Interests</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Separating the minority shareholders' share within equity</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: An 80%-owned subsidiary</div><div class="wk-body">A parent owns 80% of a subsidiary with net assets of RMB 100,000,000.</div><div class="wk-answer">The CONSOLIDATED Balance Sheet PRESENTS the SUBSIDIARY'S net ASSETS in FULL (RMB 100,000,000), with NON-CONTROLLING interests of RMB 100,000,000 Ã— 20% = <strong>RMB 20,000,000</strong> presented SEPARATELY WITHIN owners' EQUITY, distinguishing it from the PARENT'S OWN 80% share.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What ASBE No. 33 requires</div><div class="check-list"><span>Significant judgements made in determining control over an investee</span><span>Non-controlling interests, presented separately within equity</span><span>Nature and extent of significant restrictions on a subsidiary's ability to transfer funds to the parent</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Whether de facto control exists absent a majority voting interest</span><span>Whether a structured entity should be consolidated</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Fair value of consideration and non-controlling interests at acquisition (see the companion ASBE No. 20 poster)</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IFRS 10</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison â€” ASBE 33 vs IFRS 10</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASBE 33</span><span style="color:var(--color-text-info);">IFRS 10</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Control definition</span><span>Power, exposure, ability to use power</span><span>Power, exposure, ability to use power â€” converged</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Non-controlling interests presentation</span><span>Within equity, separately</span><span>Within equity, separately â€” converged</span></div>
</div>
<div class="note">A GENUINELY thoroughly CONVERGED standard â€” CHINA'S own DISTINCTIVE consolidation FEATURE remains the SEPARATE common-CONTROL business COMBINATION treatment (see the COMPANION ASBE No. 2 poster), RATHER than the CONSOLIDATION model ITSELF.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every consolidation event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Non-controlling interests</span><span><span class="badge bo">SCOE</span></span><span>Presented separately within owners' equity</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASBE No. 20</span><span>Business Combinations â€” supplies the initial measurement principles this Standard's ongoing consolidation builds upon</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASBE No. 2</span><span>Long-term Equity Investments â€” governs the separate-statement cost method that complements full consolidation</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">De facto control</div><div class="glossary-def">Practical control over an investee arising from circumstances such as a dispersed remaining shareholder base, even absent a majority voting interest.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Non-controlling interest</div><div class="glossary-def">The equity in a subsidiary not attributable, directly or indirectly, to the parent, presented within consolidated equity.</div></div>
</div>
</div>
    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.asbe33 || []} />
  </section>
</StandardPageLayout>






