---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ifrs/ifrs16.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Identifying a Lease" },
        { id: "s4", label: "Lessee — Initial Recognition" },
        { id: "s5", label: "Lessee — Subsequent Measurement" },
        { id: "s6", label: "Short-Term & Low-Value Exemptions" },
        { id: "s7", label: "Lease Modifications" },
        { id: "s8", label: "Lessor Accounting" },
        { id: "s9", label: "Sale and Leaseback" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IFRS vs US GAAP" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
        { id: "history", label: "History & Development" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why (almost) every lease is now on the balance sheet</div>
        <div class="principle">The Conceptual Framework defines an asset as a resource CONTROLLED as a result of past events, from which future economic benefits are expected. IFRS 16 applies this directly: a lease conveys the RIGHT TO USE an identified asset, which is itself a resource the lessee controls — meaning virtually EVERY lease creates a genuine asset (and corresponding liability) for the lessee, abolishing IAS 17's off-balance-sheet operating lease treatment entirely.</div>
        <div class="elabel">HOW IFRS 16 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Faithful representation</strong> — recognising a right-of-use asset and lease liability for ALL leases (with narrow exemptions) ensures the SOFP reflects genuine economic obligations previously kept off-balance-sheet</span>
          <span><strong>Comparability</strong> — a SINGLE lessee model eliminates the classification judgement (finance vs operating) that made comparing lessees under IAS 17 difficult</span>
          <span><strong>Substance over form</strong> — the right to use an asset is a genuine resource regardless of whether legal title ever transfers</span>
        </div>
        <div class="note">IFRS 16 was a DIRECT response to long-standing criticism that IAS 17's off-balance-sheet operating lease treatment understated corporate leverage — a criticism that persisted for decades before finally being addressed.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The single lessee model vs the retained lessor dual model</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Party</span><span>Model</span></div>
          <div class="tr cols-13-1"><span>Lessee</span><span>SINGLE model — right-of-use asset + lease liability for (almost) all leases</span></div>
          <div class="tr alt cols-13-1"><span>Lessor</span><span>DUAL model RETAINED — finance vs operating classification, largely unchanged from IAS 17</span></div>
        </div>
        <div class="callout info callout--chip callout--flush">The reform focused ENTIRELY on the lessee side — lessor accounting was judged to already faithfully represent economic substance and was left substantively intact.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRS 16 covers</div>
        <div class="principle">IFRS 16 applies to ALL leases, EXCEPT: leases to explore for minerals/oil/gas; leases of biological assets (IAS 41); service concession arrangements (IFRIC 12); licences of intellectual property granted by a lessor (IFRS 15); and rights held under licensing agreements for films, patents, copyrights (IAS 38).</div>
        <div class="note">A lessee MAY elect NOT to apply IFRS 16 to leases of INTANGIBLE assets (an optional scope exclusion).</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Lease</div><div class="glossary-def">A contract, or part of a contract, that conveys the right to CONTROL the use of an identified asset for a period of time in exchange for consideration.</div></div>
        <div class="glossary-item"><div class="glossary-term">Right-of-use asset</div><div class="glossary-def">An asset representing a lessee's right to use an underlying asset for the lease term.</div></div>
        <div class="glossary-item"><div class="glossary-term">Incremental borrowing rate</div><div class="glossary-def">The rate a lessee would have to pay to borrow, over a similar term and security, funds necessary to obtain an asset of similar value — used to discount lease payments if the rate implicit in the lease is not readily determinable.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Identifying a Lease</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">The two-part test — identified asset + control over use</div>
        <div class="principle">A contract IS (or contains) a lease if it conveys the right to CONTROL the use of an IDENTIFIED asset for a period of time. This requires: (1) an IDENTIFIED asset (explicitly or implicitly specified, without substantive substitution rights held by the supplier); and (2) the customer has the right to OBTAIN SUBSTANTIALLY ALL the economic benefits from use, AND the right to DIRECT the use of the asset throughout the period.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Testing for a lease — substantive substitution rights</div>
          <div class="wk-body">A customer contracts for the use of a specific truck for 3 years to transport goods, with the customer deciding routes, timing, and cargo. The supplier retains a theoretical CONTRACTUAL right to substitute the truck for another, but has NO PRACTICAL ability to do so economically (substitution would require significant cost/effort with no real benefit to the supplier), and has NEVER exercised this right historically.</div>
          <div class="wk-answer">Since the supplier's substitution right is NOT substantive (no practical ability/economic benefit), the truck IS an identified asset. The customer directs its use (routes, timing, cargo) and obtains substantially all economic benefits — this contract IS a LEASE under IFRS 16, requiring right-of-use asset and lease liability recognition by the customer (lessee).</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Lessee — Initial Recognition &amp; Measurement</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">The initial measurement formulas</div>
        <div class="formula-box">
          <div class="f-eq">Lease liability = Present value of lease payments not yet paid, discounted at the rate implicit in the lease (or the lessee's incremental borrowing rate)</div>
        </div>
        <div class="formula-box">
          <div class="f-eq">Right-of-use asset = Lease liability + initial direct costs + prepaid lease payments + estimated restoration costs − lease incentives received</div>
        </div>
      </div>
      <div class="card cw">
        <div class="ctitle cw">Worked example — initial recognition</div>
        <div class="worked">
          <div class="wk-title">Example 2: Initial recognition of a 5-year office lease</div>
          <div class="wk-body">A lessee enters a 5-year lease with annual payments of $50,000 in arrears, discounted at an incremental borrowing rate of 6%. Present value of the 5 payments = $210,618. Initial direct costs incurred by the lessee: $8,000.</div>
          <div class="wk-answer">
            <strong>Lease liability</strong> = <strong>$210,618</strong> (PV of payments)<br>
            <strong>Right-of-use asset</strong> = 210,618 + 8,000 = <strong>$218,618</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Lessee — Subsequent Measurement</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Depreciation and effective interest, running in parallel</div>
        <div class="principle">The right-of-use asset is DEPRECIATED (generally straight-line) over the SHORTER of the lease term and the asset's useful life (or over the useful life if ownership transfers/a purchase option is reasonably certain to be exercised). The lease liability is measured using the EFFECTIVE INTEREST METHOD, with interest expense recognised separately from the depreciation charge.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 3: Year 1 subsequent measurement</div>
          <div class="wk-body">Continuing Example 2: right-of-use asset $218,618, depreciated straight-line over 5 years. Lease liability $210,618 at 6%, with a $50,000 payment at the end of Year 1.</div>
          <div class="wk-answer">
            <strong>Depreciation</strong> = 218,618 / 5 = <strong>$43,724</strong><br>
            <strong>Interest expense</strong> = 210,618 × 6% = $12,637<br>
            <strong>Liability after payment</strong> = 210,618 + 12,637 − 50,000 = <strong>$173,255</strong><br>
            TWO separate P&amp;L charges result: depreciation ($43,724) and interest ($12,637) — TOTAL Year 1 expense of $56,361, FRONT-LOADED compared to a straight-line operating lease expense of $50,000/year under the old IAS 17 model.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Short-Term &amp; Low-Value Exemptions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">The narrow "off-balance-sheet" survivors</div>
        <div class="principle">A lessee MAY elect NOT to recognise a right-of-use asset and lease liability for: SHORT-TERM leases (lease term of 12 months or less, with no purchase option); and leases of LOW-VALUE underlying assets (assessed on an absolute basis when new, e.g. laptops, small office furniture — NOT dependent on the lessee's size). For these, lease payments are recognised as an EXPENSE on a straight-line (or other systematic) basis — essentially preserving IAS 17's old operating lease treatment for these two narrow categories only.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Lease Modifications</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Separate lease vs remeasurement of the existing lease</div>
        <div class="text-supporting">A modification INCREASING scope AND consideration by an amount COMMENSURATE with the stand-alone price for the increase is accounted for as a SEPARATE, new lease. Other modifications (decreasing scope, or increasing scope without commensurate pricing) require REMEASUREMENT of the existing lease liability using a revised discount rate, with a corresponding adjustment to the right-of-use asset.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Lessor Accounting</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Retained largely unchanged from IAS 17</div>
        <div class="text-supporting">A lessor classifies each lease as a FINANCE lease (substantially all risks/rewards transferred — derecognise the asset, recognise a net investment receivable) or an OPERATING lease (asset retained on the lessor's SOFP, lease income recognised straight-line) — using indicators essentially IDENTICAL to IAS 17's own classification test.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Sale and Leaseback Transactions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">A materially reformed area versus IAS 17</div>
        <div class="text-supporting">If a sale qualifies as a genuine "sale" under IFRS 15's control-transfer test, the seller-lessee recognises a right-of-use asset for the PROPORTION of the previous carrying amount relating to the right retained, and recognises ONLY the gain/loss relating to the RIGHTS TRANSFERRED to the buyer-lessor — a materially more complex, RESTRICTIVE approach than IAS 17's deferred-gain mechanism.</div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures</div>
        <div class="two-col">
          <div>
            <div class="elabel">LESSEE DISCLOSURES</div>
            <div class="check-list">
              <span>Depreciation charge for right-of-use assets by class, interest expense on lease liabilities</span>
              <span>Expense relating to short-term and low-value asset leases</span>
              <span>Maturity analysis of lease liabilities (similar to IFRS 7's own maturity analysis)</span>
            </div>
          </div>
          <div>
            <div class="elabel">LESSOR DISCLOSURES</div>
            <div class="check-list">
              <span>Similar to IAS 17's own disclosures — finance lease reconciliations, operating lease future minimum payments</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether a contract contains a lease (identified asset, control over use)</span>
              <span>Determining the lease term, including assessing whether extension/termination options are reasonably certain to be exercised</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Incremental borrowing rate, where the rate implicit in the lease cannot be readily determined</span>
              <span>Estimated restoration/dismantling costs included in the right-of-use asset</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">Determining the LEASE TERM (including renewal options reasonably certain to be exercised) is one of the MOST frequently tested and consequential judgements under IFRS 16, directly affecting both the asset and liability measurement.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>IFRS vs US GAAP</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison — IFRS 16 vs US GAAP (ASC 842)</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS (IFRS 16)</span><span>US GAAP</span></div>
          <div class="tr cols-12-1-1"><span>Lessee model</span><span>SINGLE model — all leases create a right-of-use asset and liability</span><span>DUAL model RETAINED — lessees STILL classify leases as "finance" or "operating," with DIFFERENT P&amp;L expense patterns for each</span></div>
          <div class="tr alt cols-12-1-1"><span>Operating lease P&amp;L pattern (lessee)</span><span>Front-loaded (depreciation + declining interest), same as finance leases</span><span>SINGLE straight-line total lease expense for operating leases — a KEY remaining divergence from IFRS</span></div>
          <div class="tr cols-12-1-1"><span>Low-value asset exemption</span><span>Available (absolute value-based)</span><span>NOT available under US GAAP — no direct equivalent exemption</span></div>
        </div>
        <div class="note">This is one of the MOST significant remaining IFRS/US GAAP divergences — IFRS 16 abolished the lessee dual model ENTIRELY, while ASC 842 retained it, meaning IFRS and US GAAP lessees can report MATERIALLY different P&amp;L expense patterns for economically similar leases.</div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Initial recognition (lessee)</span><span><span class="badge bs">SOFP</span></span><span>Right-of-use asset and lease liability recognised at commencement</span></div>
          <div class="tr alt cols-16-1-14"><span>Depreciation of right-of-use asset</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Straight-line, shorter of lease term/useful life</span></div>
          <div class="tr cols-16-1-14"><span>Interest on lease liability</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Effective interest method</span></div>
          <div class="tr alt cols-16-1-14"><span>Short-term/low-value lease payments</span><span><span class="badge bp">SOPL</span></span><span>Straight-line expense; NO SOFP recognition</span></div>
          <div class="tr cols-16-1-14"><span>Lease modification (remeasurement)</span><span><span class="badge bs">SOFP</span></span><span>Liability remeasured at revised discount rate; asset adjusted</span></div>
          <div class="tr alt cols-16-1-14"><span>Sale and leaseback — gain on rights transferred</span><span><span class="badge bp">SOPL</span></span><span>Only the proportion relating to transferred rights</span></div>
          <div class="tr cols-16-1-14"><span>Cash lease payments</span><span><span class="badge bs">Cash Flow Statement</span></span><span>Principal (financing) and interest (per policy) split</span></div>
          <div class="tr alt cols-16-1-14"><span>Lessor operating/finance lease accounting</span><span><span class="badge bs">SOFP</span> <span class="badge bp">SOPL</span></span><span>Largely unchanged from IAS 17</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards &amp; Glossary</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 17</span><span>The DIRECT predecessor standard — IFRS 16 abolished lessee dual classification but retained lessor accounting</span></div>
          <div class="tr alt cols-08-2"><span>IFRS 15</span><span>Supplies the control-transfer test used to assess sale and leaseback qualification</span></div>
          <div class="tr cols-08-2"><span>IAS 36</span><span>Governs impairment testing of right-of-use assets</span></div>
          <div class="tr alt cols-08-2"><span>IFRS 1</span><span>Provides transition relief allowing first-time adopters to measure lease liabilities using the incremental borrowing rate at transition</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Lease term</div><div class="glossary-def">The non-cancellable period of a lease, plus periods covered by extension options reasonably certain to be exercised, and periods covered by termination options reasonably certain NOT to be exercised.</div></div>
        <div class="glossary-item"><div class="glossary-term">Commencement date</div><div class="glossary-def">The date the lessor makes the underlying asset available for use by the lessee.</div></div>
      </div>
    </div>

<Glossary entries={[
      { term: "Lease", definition: "A contract, or part of a contract, that conveys the right to CONTROL the use of an identified asset for a period of time in exchange for consideration." },
      { term: "Right-of-use asset", definition: "An asset representing a lessee's right to use an underlying asset for the lease term." },
      { term: "Incremental borrowing rate", definition: "The rate a lessee would have to pay to borrow, over a similar term and security, funds necessary to obtain an asset of similar value — used to discount lease payments if the rate implicit in the lease is not readily determinable." },
      { term: "Lease term", definition: "The non-cancellable period of a lease, plus periods covered by extension options reasonably certain to be exercised, and periods covered by termination options reasonably certain NOT to be exercised." },
      { term: "Commencement date", definition: "The date the lessor makes the underlying asset available for use by the lessee." },
      { term: "Short-term lease", definition: "A lease with a lease term of 12 months or less, with no purchase option — eligible for the recognition exemption." }
    ]} />

<FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRS16} />
  </section>
</StandardPageLayout>
