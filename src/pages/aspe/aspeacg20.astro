import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspeacg20.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — the Customer's Perspective" },
        { id: "s3", label: "THE CENTRAL QUESTION — Does the Arrangement Include a Software License?" },
        { id: "s4", label: "Where a Software License Exists — Intangible Asset Accounting" },
        { id: "s5", label: "Where No Software License Exists — a Service Contract" },
        { id: "s6", label: "Implementation Costs" },
        { id: "s7", label: "Worked Example — a Licensed, On-Premise-Capable Arrangement" },
        { id: "s8", label: "Worked Example — a Pure Hosting/SaaS Arrangement" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments &amp; Estimates" },
        { id: "s11", label: "A Note on International Comparability" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
</div>





<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Distinguishing a purchased asset from a purchased service</div><div class="principle">AcG-20 addresses HOW a CUSTOMER (RATHER than the CLOUD service PROVIDER) accounts FOR fees PAID under a CLOUD computing ARRANGEMENT — MOST commonly, a SOFTWARE-as-a-Service (SaaS) ARRANGEMENT. THE CENTRAL question IS whether the ARRANGEMENT includes a SOFTWARE license THE customer itself CONTROLS (Section 3).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — the Customer's Perspective</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Fees paid by a business customer for cloud-based software access</div><div class="principle">This Guideline applies TO fees PAID by a CUSTOMER enterprise FOR access TO cloud-BASED software APPLICATIONS — ADDRESSING the CUSTOMER'S own ACCOUNTING, NOT the CLOUD provider'S revenue RECOGNITION (which WOULD instead be GOVERNED by Section 3400).</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>THE CENTRAL QUESTION — Does the Arrangement Include a Software License?</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Can the customer take possession of the software?</div><div class="text-supporting">A SOFTWARE license EXISTS where the CUSTOMER has the CONTRACTUAL right TO take POSSESSION of the SOFTWARE, WITHOUT significant PENALTY, and it IS feasible FOR the customer EITHER to RUN the software ON its OWN hardware OR to CONTRACT with ANOTHER party TO host it — WHERE these CONDITIONS are NOT met (the TYPICAL fact PATTERN for MOST modern SaaS ARRANGEMENTS, where the CUSTOMER only ACCESSES the vendor'S own hosted SOFTWARE over the CONTRACT term), NO software LICENSE exists.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Where a Software License Exists — Intangible Asset Accounting</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Accounted for under Section 3064</div><div class="text-supporting">WHERE a SOFTWARE license GENUINELY exists, the ARRANGEMENT is ACCOUNTED for AS the ACQUISITION of an INTANGIBLE asset UNDER Section 3064 (see the COMPANION poster) — WITH the LICENSE cost CAPITALIZED, and CERTAIN qualifying IMPLEMENTATION costs ALSO capitalized SIMILARLY to internally DEVELOPED software.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Where No Software License Exists — a Service Contract</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Fees expensed as the service is received</div><div class="text-supporting">WHERE the ARRANGEMENT does NOT include a SOFTWARE license (the TYPICAL, pure hosting-STYLE SaaS ARRANGEMENT), it is ACCOUNTED for AS a SERVICE contract — SUBSCRIPTION fees are EXPENSED as INCURRED (OR over the SERVICE period), RATHER than CAPITALIZED as an INTANGIBLE asset OR property, PLANT, and EQUIPMENT.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Implementation Costs</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Certain costs may still qualify for separate capitalization</div><div class="text-supporting">EVEN within a PURE service-CONTRACT-style arrangement, CERTAIN implementation ACTIVITIES (e.g. DATA conversion, CONFIGURATION, or CUSTOMIZATION work MEETING specific RECOGNITION criteria) MAY still QUALIFY for CAPITALIZATION as a SEPARATE asset, AMORTIZED over the TERM of the HOSTING arrangement — CONCEPTUALLY tracking a SIMILAR issue US GAAP ADDRESSED through ASU 2018-15. GIVEN the RELATIVELY technical, FACT-specific nature OF this DISTINCTION, it WARRANTS careful REVIEW against the CURRENT CPA Canada HANDBOOK text FOR any SPECIFIC arrangement.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Worked Example — a Licensed, On-Premise-Capable Arrangement</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Capitalized as an intangible asset</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A perpetual license with self-hosting rights</div><div class="wk-body">A company pays $300,000 for a perpetual software license, with the contractual right to take possession of the software and run it on its own servers at any time, without penalty.</div><div class="wk-answer">GIVEN the CUSTOMER genuinely CONTROLS a SOFTWARE license, the COMPANY capitalizes the $300,000 as an <strong>INTANGIBLE asset</strong> under Section 3064, AMORTIZED over ITS estimated USEFUL life.</div></div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — a Pure Hosting/SaaS Arrangement</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Expensed as a service, not capitalized</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A typical monthly SaaS subscription</div><div class="wk-body">The same company also pays $8,000 per month for a customer relationship management (CRM) SaaS subscription, accessed only through the vendor's own hosted servers, with no right to take possession of the underlying software.</div><div class="wk-answer">GIVEN NO software LICENSE exists, the COMPANY expenses the <strong>$8,000 per month</strong> as a SERVICE cost, AS incurred — WITH NO intangible ASSET or PP&amp;E RECOGNIZED for the SUBSCRIPTION fee ITSELF.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What AcG-20 requires</div><div class="check-list"><span>Accounting policy applied to significant cloud computing arrangements</span><span>Amount of any capitalized implementation costs, and the amortization period</span><span>Nature and amount of expense recognized for service-contract-style arrangements</span></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether the customer genuinely controls a software license, or merely has access rights</span><span>Whether specific implementation costs meet the criteria for separate capitalization</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Amortization period for capitalized implementation costs, tied to the hosting arrangement's term</span></div></div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>A Note on International Comparability</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">A genuinely topical issue addressed similarly across frameworks</div>
<div class="text-supporting">THE core LICENSE-versus-SERVICE distinction UNDERLYING AcG-20 CLOSELY tracks a SIMILAR question ADDRESSED under US GAAP THROUGH ASU 2018-15, and IS conceptually CONSISTENT with how IFRS PREPARERS analyze SIMILAR arrangements UNDER IAS 38 (INTANGIBLE assets) and IFRS 15/IAS 37. GIVEN the GENUINELY recent, TOPICAL nature OF this GUIDANCE across MULTIPLE frameworks SIMULTANEOUSLY, it REFLECTS a SHARED, contemporary RESPONSE to the WIDESPREAD shift TOWARD cloud-based SOFTWARE delivery, RATHER than a LONGSTANDING point OF divergence.</div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every cloud computing arrangement event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Software license arrangement</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Capitalized as an intangible asset, amortized</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Pure hosting/SaaS arrangement</span><span><span class="badge is">IS</span></span><span>Expensed as a service cost</span></div>
</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 3064</span><span>Goodwill and Intangible Assets — governs the accounting where a genuine software license is identified</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Software license (in a cloud arrangement)</div><div class="glossary-def">A contractual right for the customer to take possession of software without significant penalty, and to run it independently of the vendor's hosting.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Hosting arrangement / SaaS</div><div class="glossary-def">A cloud computing arrangement providing access to vendor-hosted software without a distinct license, accounted for as a service contract.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.aspeacg20 || []} />
  </section>
</StandardPageLayout>
