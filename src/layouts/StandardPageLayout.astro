---
import StandardLayout from "./StandardLayout.astro";
import InformationHeader from "../components/InformationHeader.astro";
import "../styles/posters/poster-classic.css";

interface Props {
  code: string;
  title: string;
  standardType?: string;
  issued?: string;
  latestAmendment?: string;
  status?: string;
}

const {
  code,
  title,
  standardType = "IAS",
  issued = "",
  latestAmendment = "",
  status = "",
} = Astro.props;
---

<StandardLayout code={code} title={title} framework={standardType}>
  <Fragment slot="toc">
    <slot name="toc" />
  </Fragment>
  <InformationHeader
    code={code}
    title={title}
    issued={issued}
    latestAmendment={latestAmendment}
    status={status}
  />
  <slot />
</StandardLayout>
