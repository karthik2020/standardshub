---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas111.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "Joint Control — The Threshold Test" },
        { id: "s4", label: "Classification — Joint Operation vs Joint Venture" },
        { id: "s5", label: "Accounting for Joint Operations" },
        { id: "s6", label: "Accounting for Joint Ventures — Equity Method" },
        { id: "s7", label: "Indian Infrastructure Consortium Context" },
        { id: "s8", label: "Transactions Between a Joint Operator and the Arrangement" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "Ind AS 111 vs IFRS 11 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical substance-over-legal-form philosophy to IFRS 11</div>
        <div class="principle">Ind AS 111 applies the IDENTICAL principle as IFRS 11 — classification depends on the parties' RIGHTS and OBLIGATIONS arising from the arrangement's STRUCTURE, legal form, and contractual terms, NOT merely the vehicle's legal form (e.g. incorporated vs unincorporated).</div>
        <div class="elabel">HOW IND AS 111 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Faithful representation</strong> — reflecting genuine rights to assets/obligations for liabilities (joint operation) vs rights to net assets (joint venture) — identical to IFRS 11</span>
          <span><strong style="font-weight:500">Relevance to Indian infrastructure consortia</strong> — India's extensive PPP (Public-Private Partnership) and EPC (Engineering, Procurement, Construction) consortium structures make this classification GENUINELY significant and frequently applied in Indian practice</span>
        </div>
        <div class="note">Ind AS 111, like IFRS 11, ABOLISHED proportionate consolidation for jointly controlled entities that qualify as joint ventures — a change ALSO carried through into the Indian context without modification.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The two classifications — identical to IFRS 11</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Classification</span><span>Accounting</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Joint operation</span><span>Recognise OWN SHARE of assets, liabilities, revenue, expenses directly</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Joint venture</span><span>EQUITY METHOD only — no proportionate consolidation option</span></div>
        </div>
        <div class="callout info callout--chip" style="margin-bottom:0;">ℹ️ IDENTICAL to IFRS 11 — no Indian-specific modification to this classification.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 111 covers</div>
        <div class="principle">Ind AS 111 applies to entities that are a PARTY to a joint arrangement — IDENTICAL scope to IFRS 11.</div>
        <div class="note">Genuinely significant for Indian construction, infrastructure, and oil/gas sector companies operating through consortium/JV structures.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Joint control</div><div class="glossary-def">IDENTICAL definition to IFRS 11 — contractually agreed sharing of control, requiring UNANIMOUS consent of controlling parties for relevant activity decisions.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">EPC consortium</div><div class="glossary-def">A common Indian infrastructure structure where multiple contractors jointly undertake a project, often structured to qualify as a joint operation.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — JOINT CONTROL ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Joint Control — The Threshold Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical unanimous consent requirement to IFRS 11</div>
        <div class="principle">Joint control exists ONLY when decisions about relevant activities require the UNANIMOUS consent of the parties sharing control — IDENTICAL threshold to IFRS 11, distinct from sole control (Ind AS 110) or mere significant influence (Ind AS 28).</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — CLASSIFICATION ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Classification — Joint Operation vs Joint Venture</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical structure/legal form/contractual terms test</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: An Indian EPC consortium classified as a joint operation</div>
          <div class="wk-body">Two Indian construction companies form an UNINCORPORATED consortium to jointly execute a highway construction contract awarded by NHAI (National Highways Authority of India), with the consortium agreement specifying each party's SEPARATE scope of work, direct rights to its own portion of contract assets, and direct obligations for its own portion of liabilities.</div>
          <div class="wk-answer">Given the UNINCORPORATED structure and each party's DIRECT rights/obligations to specific assets/liabilities, this is classified as a <strong style="color:var(--color-text-info);">JOINT OPERATION</strong> — each party recognises its OWN SHARE of assets, liabilities, revenue, and expenses directly, an IDENTICAL analysis to how IFRS 11 would classify an equivalent global consortium structure.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — ACCOUNTING FOR JOINT OPERATIONS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Accounting for Joint Operations</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical direct recognition approach to IFRS 11</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">A joint operator recognises its OWN assets (including its share of jointly held assets), liabilities, revenue, and expenses (including its share of jointly incurred expenses) — IDENTICAL to IFRS 11's own treatment, WITHOUT any separate consolidation or equity accounting mechanism.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — ACCOUNTING FOR JOINT VENTURES ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Accounting for Joint Ventures — Equity Method</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IFRS 11 (referencing Ind AS 28)</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Joint ventures are accounted for using the EQUITY METHOD per Ind AS 28 — IDENTICAL to IFRS 11's own cross-reference to IAS 28, with NO proportionate consolidation alternative available.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — INDIAN INFRASTRUCTURE CONSORTIUM ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Indian Infrastructure Consortium Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important practical application area</div>
        <div class="principle">India's LARGE infrastructure sector (roads, ports, power, urban transit) frequently structures projects through consortium/SPV joint arrangements, often in response to specific government tendering requirements (e.g. NHAI, state PWDs). Classification analysis under Ind AS 111 is GENUINELY consequential for how these entities report their infrastructure exposure.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 2: A power sector joint venture SPV</div>
          <div class="wk-body">Two Indian power companies jointly incorporate a Special Purpose Vehicle (SPV) to construct and operate a power plant, with the SPV holding all project assets/liabilities in its OWN name, and the joint venture agreement providing NO direct rights to specific underlying assets for either party.</div>
          <div class="wk-answer">Given the SEPARATE legal entity structure and absence of direct asset/liability rights, this is classified as a <strong style="color:var(--color-text-info);">JOINT VENTURE</strong>, accounted for using the EQUITY METHOD — an IDENTICAL classification outcome to how IFRS 11 would treat an equivalent global infrastructure SPV structure.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — TRANSACTIONS BETWEEN JOINT OPERATOR AND ARRANGEMENT ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Transactions Between a Joint Operator and the Arrangement</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IFRS 11</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Gains/losses on sales/contributions of assets to a joint operation are recognised only to the EXTENT of other parties' interests — IDENTICAL to IFRS 11.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IFRS 11</div>
        <div class="check-list">
          <span>Nature, extent, financial effects of joint operations/ventures</span>
          <span>Risks associated with interests in joint arrangements</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether joint control genuinely exists (unanimous consent requirement)</span>
              <span>Joint operation vs joint venture classification for Indian consortium/SPV structures</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Allocating shared costs/revenue between joint operators</span>
            </div>
          </div>
        </div>
        <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ Indian EPC/infrastructure consortium agreements often contain COMPLEX bespoke terms requiring careful legal and accounting analysis to determine classification correctly.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 111 VS IFRS 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 111 vs IFRS 11 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IFRS 11</span><span style="color:var(--color-text-success);">Ind AS 111</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Classification test</span><span>Structure, legal form, contractual terms</span><span>IDENTICAL</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Joint venture accounting</span><span>Equity method only</span><span>IDENTICAL</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Practical application context</span><span>Varies by jurisdiction/industry</span><span>Especially prominent in Indian infrastructure/EPC consortium and oil/gas exploration JV structures</span></div>
        </div>
        <div class="note">Ind AS 111 is essentially IDENTICAL to IFRS 11 in substance — its distinctive Indian relevance lies in the SCALE and FREQUENCY of infrastructure consortium applications, not in any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Joint operation — own share recognition</span><span><span class="badge bs">Balance Sheet</span> <span class="badge bp">P&amp;L</span></span><span>Direct line-by-line recognition</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Joint venture — equity method</span><span><span class="badge bs">Balance Sheet</span> <span class="badge bp">P&amp;L</span></span><span>Single-line investment, share of profit/loss</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 11</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 28</span><span>Supplies the equity method used for joint ventures</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 110</span><span>Distinguishes joint control from sole control</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">NHAI</div><div class="glossary-def">National Highways Authority of India — a common counterparty for Indian road infrastructure consortium arrangements.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">SPV</div><div class="glossary-def">Special Purpose Vehicle — a separate legal entity commonly used to structure Indian joint venture infrastructure projects.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Joint control", definition: "Contractually agreed sharing of control, requiring unanimous consent of controlling parties for relevant activity decisions — IDENTICAL definition to IFRS 11." },
      { term: "Joint operation", definition: "A joint arrangement whereby the parties have direct rights to assets and obligations for liabilities — each party recognises its own share directly." },
      { term: "Joint venture", definition: "A joint arrangement whereby the parties have rights to the net assets of the arrangement — accounted for using the equity method only." },
      { term: "EPC consortium", definition: "A common Indian infrastructure structure where multiple contractors jointly undertake a project, often structured to qualify as a joint operation." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
