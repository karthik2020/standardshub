---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import IAS38Poster from "../../components/posters/IAS38Poster.astro";
import PageToc from "../../components/PageToc.astro";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import "../../styles/posters/poster-classic.css";
---

<StandardPageLayout
  code="IAS 38"
  standardType="IAS"
  title="Intangible Assets"
  category="Assets"
  objective="Prescribe the accounting treatment for intangible assets not dealt with specifically in another IFRS."
  principle="Recognise an intangible asset only when future economic benefits are probable and cost can be measured reliably."
  scope={[
    "Identifiable non-monetary assets without physical substance",
    "Includes purchased and internally generated development assets",
    "Excludes goodwill, financial assets and certain specialised assets",
  ]}
  related={[
    {
      code: "IAS 16",
      title: "Property, Plant and Equipment",
      url: "/ias/ias16",
    },
    {
      code: "IAS 36",
      title: "Impairment of Assets",
      url: "/ias/ias36",
    },
    {
      code: "IAS 23",
      title: "Borrowing Costs",
      url: "/ias/ias23",
    },
    {
      code: "IFRS 3",
      title: "Business Combinations",
      url: "/ifrs/ifrs3",
    },
  ]}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "overview",
          label: "Overview",
        },
        {
          id: "poster",
          label: "Revision Poster",
        },
        {
          id: "history",
          label: "History & Development",
        },
        {
          id: "related",
          label: "Related Standards",
        },
      ]}
    />
  </Fragment>

  <section id="poster">
    <IAS38Poster />
  </section>

  <section id="history">
    <HistoryTimeline items={history.IAS38} />
  </section>
</StandardPageLayout>
