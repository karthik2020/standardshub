import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/hgb/hgb335a.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  summary={metadata.summary}
  subtitle={metadata.nativeTitle}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "§335a(1) – the Basic Right to Appeal, and Its Suspensive Effect" },
        { id: "s4", label: "Worked Example – the Practical Significance of Suspensive Effect" },
        { id: "s5", label: "§335a(2) – the Two-Week Deadline and LG Bonn's Exclusive Jurisdiction" },
        { id: "s6", label: "Court Composition – the Kammer für Handelssachen" },
        { id: "s7", label: "Worked Example – Filing a Timely Appeal" },
        { id: "s8", label: "The Cost-Shifting Mechanism" },
        { id: "s9", label: "§335a(3) – the Further Appeal (Rechtsbeschwerde), Genuinely Narrow" },
        { id: "s10", label: "Worked Example – Contrasting Beschwerde and Rechtsbeschwerde" },
        { id: "s11", label: "Critical Judgments &amp; Practical Difficulties" },
        { id: "s12", label: "Relationship to IFRS" },
        { id: "s13", label: "Statement Mapping" },
        { id: "s14", label: "Related Provisions – Cross-Reference Map" },
        { id: "s15", label: "Quick-Reference Glossary" }
      ]}
    />
  </Fragment>
  

  <div class="wrap">
<!-- ============ SECTION 1 ============ -->
  
  <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="callout suc">A PURELY PROCEDURAL PROVISION – HOW to challenge what §335 imposes: a two-week Beschwerde to a specific court (confirmed as the Landgericht Bonn, since that is where the Bundesamt für Justiz itself is seated), with a genuinely important suspensive effect, followed by a narrow, permission-only further appeal to the Oberlandesgericht.</div>

  
      <div class="ctitle ci">The right to be heard, completing §335's own enforcement power</div>
      <div class="principle">§335 gave the Bundesamt für Justiz genuine power to impose an escalating, repeating coercive fine for disclosure non-compliance. §335a is the essential counterweight: a structured, genuine right to CHALLENGE that decision, with real procedural protections – including, critically, an appeal that automatically PAUSES enforcement while it is being decided.</div>
      <div class="elabel">HOW §335A MAPS TO GERMAN ACCOUNTING PRINCIPLES</div>
      <div class="check-list">
        <span><strong>Rechtsstaatlichkeit (rule of law)</strong> – even an administrative body's enforcement power must be subject to genuine, court-based review</span>
        <span><strong>Proportionate procedural burden</strong> – a straightforward two-week Beschwerde for the ordinary case, reserving the more demanding, lawyer-mandatory Rechtsbeschwerde for genuinely significant legal questions the Landgericht itself judges worth escalating</span>
      </div>
    </div>

    <div class="card cs">
      <div class="ctitle cs">What §335a covers, at a glance</div>
      <div class="td-table">
        <div class="th cols-06-17"><span>§</span><span>Core content</span></div>
        <div class="tr cols-06-17"><span>335a(1)</span><span>The right to a Beschwerde, with suspensive effect for fine impositions</span></div>
        <div class="tr alt cols-06-17"><span>335a(2)</span><span>Two-week deadline; LG Bonn's exclusive jurisdiction; court composition; cost-shifting</span></div>
        <div class="tr cols-06-17"><span>335a(3)</span><span>A narrow further appeal (Rechtsbeschwerde), requiring the Landgericht's own permission</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">The fined party – and, for the further appeal, the Bundesamt itself too</div>
      <div class="principle">§335a's Beschwerde right belongs to the party against whom the Ordnungsgeld was imposed. For the SECOND-tier Rechtsbeschwerde specifically, the right ALSO extends to the Bundesamt für Justiz itself – meaning the enforcement authority can, in principle, appeal a Landgericht decision it disagrees with too, not merely the fined company.</div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>§335a(1) – the Basic Right to Appeal, and Its Suspensive Effect</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">A genuinely significant procedural protection</div>
      <div class="principle">§335a(1) grants a Beschwerde (appeal) against a decision imposing an Ordnungsgeld, rejecting an Einspruch (objection), or rejecting a Wiedereinsetzung (reinstatement) application – governed by the FamFG's own general procedural rules, except where §335a itself provides otherwise. CRITICALLY, §335a(1) sentence 2 gives the Beschwerde SUSPENSIVE EFFECT (aufschiebende Wirkung) specifically where it concerns the imposition of an Ordnungsgeld – meaning filing the appeal AUTOMATICALLY pauses enforcement of the fine while the appeal remains pending.</div>
    </div>
  </div>

  <!-- ============ SECTION 4 ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Worked Example – the Practical Significance of Suspensive Effect</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cs span2">
      <div class="ctitle cs">The fine cannot be collected while the appeal is genuinely pending</div>
      <div class="worked">
        <div class="wk-title">Example 1: A company appealing a €10,000 fine before it becomes payable</div>
        <div class="wk-body">The Bundesamt imposes a €10,000 Ordnungsgeld against a company under §335(4). The company believes the fine was wrongly calculated and files a timely Beschwerde.</div>
        <div class="wk-answer">Because the Beschwerde concerns the IMPOSITION of the Ordnungsgeld itself, it carries automatic suspensive effect under §335a(1) – the Bundesamt CANNOT proceed to collect the €10,000 while the appeal remains genuinely pending before the Landgericht, protecting the company from having to pay a potentially wrongly-imposed fine before its challenge has even been decided.</div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 5 ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>§335a(2) – the Two-Week Deadline and LG Bonn's Exclusive Jurisdiction</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">A genuinely tight window, decided by a single, specific court nationwide</div>
      <div class="principle">§335a(2) requires the Beschwerde to be filed within TWO WEEKS, and confirms jurisdiction lies with the Landgericht at the Bundesamt für Justiz's own registered SEAT – confirmed, via the Landgericht Bonn's own published description of its role, to be the Landgericht Bonn specifically, holding EXCLUSIVE nationwide jurisdiction over these Ordnungsgeld appeals, REGARDLESS of where the fined company itself is actually located anywhere in Germany. A regulatory-delegation mechanism ALSO permits the relevant state government to reassign this jurisdiction elsewhere by regulation, to manage caseload or backlog concerns, should that become necessary.</div>
    </div>
  </div>

  <!-- ============ SECTION 6 ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Court Composition – the Kammer für Handelssachen</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Commercial expertise, where available</div>
      <div class="text-supporting">Where the Landgericht Bonn has established a Kammer für Handelssachen (Chamber for Commercial Matters), that specialised chamber handles the Beschwerde INSTEAD of the ordinary Zivilkammer (civil chamber). Where the ordinary civil chamber decides, the standard single-judge/panel rules under ZPO §§348-348a apply; where the commercial chamber decides instead, the presiding judge alone decides – a genuinely specific procedural nuance reflecting the commercial, rather than purely civil, character of these disputes.</div>
    </div>
  </div>

  <!-- ============ SECTION 7 ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Worked Example – Filing a Timely Appeal</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">A tight window, but a nationally consolidated, specialised forum</div>
      <div class="worked">
        <div class="wk-title">Example 2: A Bavarian company appealing to a court in North Rhine-Westphalia</div>
        <div class="wk-body">A company headquartered in Munich receives an Ordnungsgeld decision and wishes to appeal, believing the fine was miscalculated.</div>
        <div class="wk-answer">DESPITE the company's own Bavarian location, it must file its Beschwerde within TWO WEEKS specifically with the Landgericht Bonn – the court is NOT determined by the company's own location, but by the Bundesamt für Justiz's OWN seat, ensuring these appeals are consolidated nationally within a single specialised commercial forum rather than scattered across every regional court in Germany.</div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 8 ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>The Cost-Shifting Mechanism</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Discretionary reimbursement, including where the Bundesamt itself concedes</div>
      <div class="text-supporting">The Landgericht may, based on equitable discretion (billiges Ermessen), order that a successful appellant's necessary extrajudicial costs be reimbursed, wholly or partly, from the state treasury – and the SAME reimbursement mechanism applies where the Bundesamt itself simply GRANTS the appeal (abhilft) without the matter needing full court adjudication, ensuring a company that was genuinely wrongly fined isn't left bearing its own defence costs even where the dispute resolves informally.</div>
    </div>
  </div>

  <!-- ============ SECTION 9 ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>§335a(3) – the Further Appeal (Rechtsbeschwerde), Genuinely Narrow</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">Permission-only, decided by the Oberlandesgericht, with mandatory legal representation</div>
      <div class="principle">§335a(3) permits a FURTHER appeal – the Rechtsbeschwerde – against the Landgericht's own Beschwerde decision, but ONLY where the Landgericht ITSELF has expressly ALLOWED it (zugelassen) – genuinely NOT an automatic right. The Rechtsbeschwerde is decided by the Oberlandesgericht (higher regional court) with jurisdiction over the Landgericht's own seat – NOT, as might be assumed, the Bundesgerichtshof – and is available to the Bundesamt itself as well as the fined party, including specifically against a Wiedereinsetzung the Landgericht may have granted. Before the Oberlandesgericht, parties MUST be represented by a lawyer – EXCEPT the Bundesamt, which requires no such representation.</div>
    </div>
  </div>

  <!-- ============ SECTION 10 ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example – Contrasting Beschwerde and Rechtsbeschwerde</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cs span2">
      <div class="ctitle cs">A genuinely two-tiered structure, with a real gate between the levels</div>
      <div class="worked">
        <div class="wk-title">Example 3: A company that loses its Beschwerde and wants to appeal further</div>
        <div class="wk-body">A company's Beschwerde is unsuccessful – the Landgericht Bonn upholds the original Ordnungsgeld. The company, believing the Landgericht made a genuine legal error on a point of general significance, wishes to appeal further.</div>
        <div class="wk-answer">The company can ONLY pursue a Rechtsbeschwerde if the Landgericht Bonn ITSELF expressly ALLOWS it – the company has NO automatic right to escalate further, unlike the initial Beschwerde itself. IF permitted, the further appeal goes to the Oberlandesgericht (with jurisdiction over Bonn's own seat – the OLG Köln), and the company MUST now be represented by a lawyer, a requirement that did not necessarily apply at the earlier Beschwerde stage.</div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 11 ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Practical Difficulties</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cn span2">
      <div class="ctitle cn">Where judgement matters most</div>
      <div class="two-col">
        <div>
          <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
          <div class="dot-list">
            <span>Whether a legal question genuinely warrants the Landgericht permitting a Rechtsbeschwerde, versus being confined to that single level of review</span>
          </div>
        </div>
        <div>
          <div class="elabel">PRACTICAL DIFFICULTIES</div>
          <div class="dot-list">
            <span>Meeting the genuinely tight two-week Beschwerde deadline, particularly for companies located far from Bonn who may need to quickly engage local counsel familiar with the specific LG Bonn procedure</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 12 ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IFRS</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Appeal procedure sits entirely outside any accounting standard</div>
      <div class="text-supporting">Precisely as with §335 itself, IFRS has no equivalent – the specific mechanics of challenging a disclosure-enforcement fine are governed entirely by each jurisdiction's own procedural law. §335a completes this poster series' documentation of the practical, procedural layer sitting beneath HGB's disclosure enforcement regime, ensuring the power §335 grants remains genuinely subject to judicial check.</div>
    </div>
  </div>

  <!-- ============ SECTION 13 ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cs span2">
      <div class="ctitle cs">Where every §335a event lands</div>
      <div class="td-table">
        <div class="th cols-16-1-14"><span>Event / obligation</span><span>Document affected</span><span>Notes</span></div>
        <div class="tr cols-16-1-14"><span>Beschwerde filed</span><span>–</span><span>Automatically pauses fine collection, per §335a(1)</span></div>
        <div class="tr alt cols-16-1-14"><span>Rechtsbeschwerde permitted</span><span>–</span><span>A genuinely rare, permission-gated further review</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 14 ============ -->
  <div class="section-header" id="s14"><span class="num">14</span><h2>Related Provisions – Cross-Reference Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">How §335a connects across HGB Book 3</div>
      <div class="td-table">
        <div class="th cols-08-2"><span>Provision</span><span>Nature of the connection</span></div>
        <div class="tr cols-08-2"><span>§335</span><span>The underlying Ordnungsgeld decision §335a exists to allow challenging</span></div>
        <div class="tr alt cols-08-2"><span>§335(4)</span><span>Specifically referenced for the Wiedereinsetzung mechanism the Rechtsbeschwerde can also target</span></div>
        <div class="tr cols-08-2"><span>§335b</span><span>The NEXT provision, extending this entire cluster's rules to certain partnerships – closing out this Subsection</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 15 ============ -->
  <div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Beschwerde</div><div class="glossary-def">The first-tier appeal against an Ordnungsgeld decision, with automatic suspensive effect for fine impositions.</div></div>
      <div class="glossary-item"><div class="glossary-term">Rechtsbeschwerde</div><div class="glossary-def">The second-tier, permission-only further appeal, decided by the Oberlandesgericht.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Aufschiebende Wirkung</div><div class="glossary-def">Suspensive effect – the automatic pause on fine collection while a timely Beschwerde is pending.</div></div>
      <div class="glossary-item"><div class="glossary-term">Kammer für Handelssachen</div><div class="glossary-def">Chamber for Commercial Matters – the specialised court division handling these appeals where established.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Zugelassen</div><div class="glossary-def">Permitted/allowed – the Landgericht's own gatekeeping decision required before a Rechtsbeschwerde can proceed at all.</div></div>
      <div class="glossary-item"><div class="glossary-term">Abhilfe</div><div class="glossary-def">The Bundesamt itself granting/conceding an appeal without requiring full court adjudication.</div></div>
    </div>
  </div>
  </div>
</StandardPageLayout>
