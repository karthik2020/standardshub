---
import "../styles/site.css";
import "../styles/print.css";
import FrameworkRail from "../components/FrameworkRail.astro";
import StandardsPanel from "../components/StandardsPanel.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { detectSeoType } from "../utils/seo";
import { getFramework } from "../data/frameworks";

interface Props {
  code: string;
  /** Display title used in the header/breadcrumbs. */
  title?: string;
  /** SEO document title prefix. Defaults to `title`. Omit for the home page. */
  seoTitle?: string;
  framework?: string;
  noindex?: boolean;
  hideFramework?: boolean;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: string;
  /** Standard page context used to auto-generate the description. */
  standard?: { code: string; title: string; dateModified?: string };
}

const {
  code,

  title,

  seoTitle = title,

  framework = "",
  noindex = false,
  hideFramework = false,
  description,
  canonical,
  robots = noindex ? "noindex" : undefined,
  ogType,
  ogImage,
  twitterCard,
  standard,
} = Astro.props;

const frameworkConfig = getFramework(framework) ?? getFramework("ias")!;
const seoType = detectSeoType({ code, framework, standard, hideFramework });
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("rail-theme") || "light";
          document.documentElement.setAttribute("data-sidebar-theme", theme);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900; 1, 14..32, 100..900&display=swap" />
    <Seo
      title={seoTitle}
      description={description}
      canonical={canonical}
      robots={robots}
      ogType={ogType}
      ogImage={ogImage}
      twitterCard={twitterCard}
      standard={standard}
      seoType={seoType}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app-shell">
      {hideFramework ? (
        <header class="site-header">
          <div class="header-left">
            <a href="/" class="site-logo">
              <span class="logo-mark"></span>
              <span class="logo-text"> StandardsHub </span>
            </a>
            <nav class="header-breadcrumbs" aria-label="Breadcrumb">
              <a href="/" class="crumb breadcrumb-home">
                <span>Home</span>
              </a>
              <span class="breadcrumb-separator" aria-hidden="true">❯</span>
              <span class="breadcrumb-current" aria-current="page">
                <span class="breadcrumb-title">{title}</span>
              </span>
            </nav>
          </div>
          <div class="header-right">
            <button class="toolbar-btn" id="printBtn" title="Print"> 🖨 </button>
          </div>
        </header>
      ) : (
        <Header code={code} title={title} framework={framework} />
      )}

      <div class="app-body" data-framework={frameworkConfig.id}>
        <div class="standards-sidebar sidebar">
          <FrameworkRail />
          <StandardsPanel />
        </div>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <main class="content" id="main" tabindex="-1">
          <div class="page-body" class:list={{"home-layout": code === "Home"}}>
            <div class="reading-column">
              <div class="page-content">
                <slot />
              </div>
            </div>

            <aside class="page-toc">
              <slot name="toc" />
            </aside>

            <Footer />
          </div>
        </main>
      </div>
    </div>

    <script is:inline src="/js/sidebar.js"></script>
    <script is:inline src="/js/rail-panel.js"></script>
    <script is:inline src="/js/toc.js"></script>
    <script is:inline src="/js/search.js"></script>

    <style>
      .skip-link {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, -120%);
        z-index: 1000;
        padding: 10px 18px;
        border-radius: var(--radius-pill);
        background: var(--text);
        color: var(--surface);
        font-size: var(--text-small);
        font-weight: var(--weight-semibold);
        text-decoration: none;
        box-shadow: var(--shadow-md);
        transition: transform var(--duration-fast) var(--ease);
      }

      .skip-link:focus-visible {
        transform: translate(-50%, 12px);
        outline: 2px solid var(--ias);
        outline-offset: 2px;
      }
    </style>
  </body>
</html>
