---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/sic/sic11.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-11 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-11 was withdrawn in March 2003 when the IASB issued a revised IAS 21 The Effects of Changes in Foreign Exchange Rates, which eliminated the capitalisation option for exchange losses from severe currency devaluations."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ias/ias21"
    linkText="IAS 21 The Effects of Changes in Foreign Exchange Rates"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-11 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-11 addressed</div>
        <div class="principle">SIC-11 addressed whether exchange losses arising from severe currency devaluations could be capitalised into the cost of related assets. It clarified whether such losses could be included in the carrying amount of an asset when they arose from a devaluation that was not expected to reverse in the near term.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-11 concluded that exchange losses from a severe currency devaluation that could not be predicted and were not expected to reverse in the near term could be capitalised into the cost of related assets, provided that the losses were directly attributable to the acquisition of those assets. This treated severe devaluations differently from ordinary exchange fluctuations.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IAS 21 The Effects of Changes in Foreign Exchange Rates</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2003 revision eliminated the capitalisation option entirely</span></div>
          <div class="tr"><span>Current status</span><span>Withdrawn</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Currency devaluation", definition: "A significant downward adjustment to a country's currency value relative to other currencies, distinct from normal exchange rate fluctuations." },
      { term: "Capitalisation", definition: "The accounting treatment of including a cost as part of the carrying amount of an asset rather than recognising it as an expense." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC11} />
  </section>
</StandardPageLayout>




