  5. Define TOC
*/

import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ias/ias19.json";

---

<StandardPageLayout {...metadata}>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "s1",
          label: "Conceptual Framework",
        },
        {
          id: "s2",
          label: "Scope & Definitions",
        },
        {
          id: "s3",
          label: "Short-Term Employee Benefits",
        },
        {
          id: "s4",
          label: "Post-Employment: Defined Contribution",
        },
        {
          id: "s5",
          label: "Post-Employment: Defined Benefit",
        },
        {
          id: "s6",
          label: "Remeasurements & OCI",
        },
        {
          id: "s7",
          label: "Plan Assets & Net Interest",
        },
        {
          id: "s8",
          label: "Other Long-Term & Termination Benefits",
        },
        {
          id: "s9",
          label: "Disclosure",
        },
        {
          id: "s10",
          label: "Judgments & Estimates",
        },
        {
          id: "s11",
          label: "IFRS vs US GAAP",
        },
        {
          id: "s12",
          label: "Statement Mapping",
        },
        {
          id: "s13",
          label: "Related Standards",
        },
        {
          id: "s14",
          label: "Glossary",
        },
        {
          id: "history",
          label: "History & Development",
        },
      ]}
    />
  </Fragment>

  <div class="wrap">
    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why employee benefit obligations are genuine Framework liabilities</div>
        <div class="principle">When an employee renders service to an entity, a present obligation arises to pay the resulting benefits – whether payable now, or years into the future. IAS 19 exists to ensure the COST of employee service is recognised in the period the service is RENDERED, not merely when cash is eventually paid out.</div>
        <div class="elabel">HOW EMPLOYEE BENEFITS MAP TO THE FRAMEWORK'S ELEMENTS</div>
        <div class="check-list">
          <span><strong style="font-weight:600">Present obligation</strong> – a legal obligation (contract, legislation) or CONSTRUCTIVE obligation (established practice creating a valid expectation of payment)</span>
          <span><strong style="font-weight:600">Past event</strong> – the employee's service rendered during the period</span>
          <span><strong style="font-weight:600">Expense recognition</strong> – the cost of benefits is recognised as the employee earns them, matched to the service period, not the payment date</span>
        </div>
        <div class="note">IAS 19's basic principle is deceptively simple to state – "recognise the cost of benefits when employees earn them, not when paid" – but applying it to long-term, uncertain, post-employment obligations (defined benefit pensions) makes this one of the most actuarially complex standards in IFRS.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Measurement principles applied by IAS 19</div>
        <div class="principle">Measurement complexity scales directly with the RISK profile of each benefit type – from simple undiscounted amounts to full actuarial present value calculations.</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Benefit type</span><span>Measurement basis</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Short-term benefits</span><span>Undiscounted amount expected to be paid</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Defined contribution plans</span><span>Contributions payable for the period (no further measurement needed)</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Defined benefit plans</span><span>Present value of the obligation, using the Projected Unit Credit method, LESS the fair value of plan assets</span></div>
        </div>
        <div class="callout info callout--chip" style="margin-bottom:0;"><strong style="font-weight:600">Qualitative characteristics in action:</strong> the defined benefit obligation's use of actuarial present value and discounting reflects <strong style="font-weight:600">relevance</strong> – a long-term pension promise decades from settlement would badly misstate the entity's true obligation if measured undiscounted.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope & Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 19 covers – the four categories</div>
        <div class="principle">IAS 19 prescribes accounting and disclosure for employee benefits – ALL forms of consideration given by an entity in exchange for service rendered by employees, or for termination of employment.</div>
        <div class="check-list">
          <span><strong style="font-weight:600">Short-term employee benefits</strong> – wages, salaries, paid annual/sick leave, profit-sharing, bonuses, and non-monetary benefits, all due to be settled WITHIN 12 months of the related service</span>
          <span><strong style="font-weight:600">Post-employment benefits</strong> – pensions, other retirement benefits, post-employment life insurance/medical care</span>
          <span><strong style="font-weight:600">Other long-term employee benefits</strong> – long-service/sabbatical leave, jubilee benefits, long-term disability benefits, profit-sharing/bonuses due 12+ months after period end</span>
          <span><strong style="font-weight:600">Termination benefits</strong> – provided in exchange for the termination of an employee's employment (redundancy)</span>
        </div>
        <div class="note">IAS 19 does NOT cover employee benefits within the scope of IFRS 2 (Share-based Payment) – a critical scope boundary tested frequently in exams.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Defined contribution plans</div>
          <div class="glossary-def">Post-employment benefit plans under which an entity pays fixed contributions into a separate fund and has NO legal or constructive obligation to pay further contributions if the fund has insufficient assets to pay employee benefits.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Defined benefit plans</div>
          <div class="glossary-def">Post-employment benefit plans OTHER than defined contribution plans – the entity effectively RETAINS actuarial and investment risk, since it bears the obligation to provide the agreed benefits regardless of fund performance.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Actuarial gains and losses</div>
          <div class="glossary-def">Changes in the present value of the defined benefit obligation resulting from experience adjustments (differences between previous actuarial assumptions and what actually occurred) and the effects of changes in actuarial assumptions.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Current service cost</div>
          <div class="glossary-def">The increase in the present value of the defined benefit obligation resulting from employee service in the CURRENT period.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Short-Term Employee Benefits</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Recognition & measurement – the simplest category</div>
        <div class="formula-box formula-box--chip">
          <div class="f-eq">Recognise the UNDISCOUNTED amount expected to be paid as an expense, unless another Standard requires/permits capitalisation into the cost of an asset (e.g. inventory, PPE)</div>
        </div>
        <div class="elabel">COMPENSATED ABSENCES – TWO TYPES</div>
        <div class="dot-list">
          <span><strong style="font-weight:600">Accumulating</strong> (e.g. carried-forward annual leave) – recognised as employees render service that increases their entitlement, even if unused</span>
          <span><strong style="font-weight:600">Non-accumulating</strong> (e.g. sick leave that lapses if unused) – recognised only when the absence actually occurs</span>
        </div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Worked example – accrued annual leave</div>
        <div class="worked">
          <div class="wk-title">Example 1: Accumulating paid leave provision</div>
          <div class="wk-body">
            At year end, 50 employees have a combined total of 320 unused, carried-forward annual leave days. Average daily pay rate: $250. Leave is accumulating and vests (paid out even on resignation).
          </div>
          <div class="wk-answer">
            <strong>Liability for accrued annual leave</strong> = 320 days × $250 = <strong style="color:var(--color-text-info);">$80,000</strong>, recognised undiscounted as a short-term employee benefit liability.
          </div>
        </div>
        <div class="entry"><span class="dr">Dr</span><div class="etxt">Staff cost / leave expense $80,000<div class="badges"><span class="badge bp">SOPL</span></div></div></div>
        <div class="entry"><span class="cr">Cr</span><div class="etxt">Accrued leave liability $80,000<div class="badges"><span class="badge bs">SOFP</span></div></div></div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Post-Employment Benefits – Defined Contribution Plans</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">The simple case – contribution equals expense</div>
        <div class="principle">Because the entity's obligation is limited to the amount it agrees to contribute (with NO further obligation once contributions are paid), accounting is straightforward: the contribution payable for a period is recognised as an EXPENSE, unless another standard requires capitalisation.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 2: Defined contribution scheme</div>
          <div class="wk-body">An entity contributes 8% of gross salaries to a defined contribution pension scheme. Total gross salaries for the period: $2,400,000. $150,000 of the required contribution remains unpaid at year end.</div>
          <div class="wk-answer">
            <strong>Total contribution expense</strong> = 2,400,000 × 8% = <strong style="color:var(--color-text-info);">$192,000</strong> (SOPL, in full, regardless of payment timing)<br>
            <strong>Liability at year end</strong> = <strong style="color:var(--color-text-danger);">$150,000</strong> (unpaid portion only)
          </div>
        </div>
        <div class="note">No actuarial assumptions, discounting, or complex remeasurement is EVER required for defined contribution plans – the entire complexity of Sections 5–7 applies ONLY to defined benefit plans.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Post-Employment Benefits – Defined Benefit Plans</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">The net defined benefit liability/asset formula</div>
        <div class="formula-box formula-box--chip">
          <div class="f-eq">Net defined benefit liability (asset) = Present value of the defined benefit obligation − Fair value of plan assets</div>
        </div>
        <div class="elabel">THE PROJECTED UNIT CREDIT METHOD</div>
        <div style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;">Each period of service gives rise to an ADDITIONAL unit of benefit entitlement, and each unit is measured SEPARATELY to build up the final obligation – requiring actuarial assumptions about mortality, staff turnover, salary growth, and discount rates. This calculation is normally performed by a qualified actuary.</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">The three components of defined benefit cost</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr;"><span>Component</span><span>Recognised in…</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr;"><span>Service cost (current + past service cost + gains/losses on settlement)</span><span><span class="badge bp">SOPL</span></span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr;"><span>Net interest on the net defined benefit liability/asset</span><span><span class="badge bp">SOPL</span></span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr;"><span>Remeasurements of the net defined benefit liability/asset</span><span><span class="badge bo">OCI</span></span></div>
        </div>
        <div class="note">This three-way split – the "IAS 19R" model since the 2011 amendment – is the single most important structural fact to memorise about defined benefit accounting.</div>
      </div>
    </div>

    <div class="grid" style="margin-top:10px;">
      <div class="card cn span2">
        <div class="ctitle cn">Worked example – full defined benefit reconciliation</div>
        <div class="worked">
          <div class="wk-title">Example 3: Movement in the net defined benefit liability</div>
          <div class="wk-body">
            Opening defined benefit obligation: $4,000,000. Opening plan assets: $3,600,000. Current service cost: $250,000. Discount rate at start of year: 5%. Benefits paid during the year: $180,000. Contributions paid into the plan: $220,000. Actuarial loss on the obligation (change in assumptions): $60,000. Return on plan assets (actual): $200,000.
          </div>
          <div class="wk-answer">
            <strong>Net interest on opening net liability</strong> = (4,000,000 − 3,600,000) × 5% = 400,000 × 5% = <strong style="color:var(--color-text-info);">$20,000</strong> (net interest expense, SOPL)<br><br>
            <strong>Obligation roll-forward:</strong> 4,000,000 + 250,000 (service cost) + 200,000 (interest on obligation: 4,000,000×5%) − 180,000 (benefits paid) + 60,000 (actuarial loss) = <strong>$4,330,000 closing obligation</strong><br>
            <strong>Plan assets roll-forward:</strong> 3,600,000 + 180,000 (interest on assets: 3,600,000×5%) − 180,000 (benefits paid) + 220,000 (contributions) + 20,000 (return above expected, remeasurement gain) = <strong>$3,840,000 closing assets</strong><br><br>
            <strong>Closing net defined benefit liability</strong> = 4,330,000 − 3,840,000 = <strong style="color:var(--color-text-danger);">$490,000</strong>
          </div>
        </div>
        <div class="note">Note "return on plan assets" is split: EXPECTED return (at the discount rate) flows through net interest in SOPL; any DIFFERENCE from actual return is a remeasurement in OCI – see Section 6/7.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Remeasurements – Why They Sit in OCI</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Components of remeasurement, and the no-recycling rule</div>
        <div class="check-list" style="margin-bottom:9px;">
          <span>Actuarial gains and losses on the defined benefit obligation (experience adjustments and the effects of changes in actuarial assumptions)</span>
          <span>The difference between actual return on plan assets and the amount included in net interest (i.e. return on plan assets, excluding amounts in net interest)</span>
          <span>Any change in the effect of the asset ceiling, excluding amounts included in net interest</span>
        </div>
        <div class="callout danger callout--chip" style="margin-bottom:0;"><strong style="font-weight:600">Remeasurements recognised in OCI are NEVER reclassified ("recycled") to profit or loss in a later period</strong> – they may, however, be transferred WITHIN equity (e.g. to retained earnings), similar to a revaluation surplus under IAS 16. This is a frequently tested distinguishing feature versus other OCI items like FX translation reserves (IAS 21), which DO recycle.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Plan Assets, Net Interest & the Asset Ceiling</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">Net interest mechanics</div>
        <div class="formula-box formula-box--chip">
          <div class="f-eq">Net interest = Net defined benefit liability (asset) at the START of the period × Discount rate determined at the START of the period</div>
        </div>
        <div style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;">The SAME discount rate used to measure the obligation is applied to BOTH the obligation and plan assets, ensuring net interest is calculated symmetrically on the NET position.</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">The asset ceiling</div>
        <div style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:9px;">Where plan assets EXCEED the defined benefit obligation (a net surplus/asset position), the recognised asset is capped at the "asset ceiling" – the present value of any economic benefits available in the form of refunds from the plan or reductions in future contributions.</div>
        <div class="callout warn callout--chip" style="margin-bottom:0;">An entity cannot simply recognise a large pension surplus as an asset if it has no realistic way to actually access that surplus (e.g. via refund or contribution holidays) – the asset ceiling prevents overstatement of recoverable pension surpluses.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Other Long-Term Benefits & Termination Benefits</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Other long-term employee benefits</div>
        <div style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:9px;">Uses a SIMPLIFIED version of defined benefit accounting: the net total of service cost, net interest, AND remeasurements is recognised entirely in PROFIT OR LOSS – unlike defined benefit pensions, there is NO separate OCI presentation for remeasurements here.</div>
        <div class="dot-list">
          <span>Long-service/sabbatical leave</span>
          <span>Jubilee or other long-service benefits</span>
          <span>Long-term disability benefits</span>
          <span>Profit-sharing and bonuses payable 12+ months after period end</span>
        </div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Termination benefits – recognition trigger</div>
        <div style="font-size:13px;color:var(--color-text-secondary);line-height:1.6;margin-bottom:9px;">Recognised at the EARLIER of: when the entity can no longer withdraw the offer of the benefits; and when the entity recognises costs for a restructuring (IAS 37) that involves paying termination benefits.</div>
        <div class="note">Termination benefits arise from the DECISION TO TERMINATE, not from employee service rendered – a fundamentally different obligating event from every other category in IAS 19, which is why they're accounted for separately.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures (primarily for defined benefit plans)</div>
        <div class="two-col">
          <div>
            <div class="elabel">CHARACTERISTICS & RISKS</div>
            <div class="check-list">
              <span>Characteristics of the defined benefit plans and risks associated with them (e.g. asset volatility, discount rate risk, longevity risk)</span>
              <span>A reconciliation of the opening and closing balances of the defined benefit obligation and plan assets, showing each component of change separately</span>
            </div>
          </div>
          <div>
            <div class="elabel">AMOUNTS & SENSITIVITY</div>
            <div class="check-list">
              <span>A disaggregation of plan assets by class/nature and risk characteristics</span>
              <span>Significant actuarial assumptions used (discount rate, salary growth, mortality)</span>
              <span>Sensitivity analysis for each significant actuarial assumption, showing the effect of reasonably possible changes on the obligation</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments & Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Discount rate – determined by reference to market yields on high-quality corporate bonds (or government bonds where no deep corporate bond market exists) of matching currency and term</span>
              <span>Future salary growth rates, mortality/longevity assumptions, staff turnover rates</span>
              <span>Expected inflation and medical cost trend rates for post-employment medical benefit plans</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Classifying a plan as defined contribution vs defined benefit – sometimes unclear for multi-employer or state plans</span>
              <span>Whether a constructive obligation exists (e.g. informal practice of enhancing statutory redundancy pay)</span>
              <span>Applying the asset ceiling test where a plan is in surplus</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip" style="margin-top:8px;margin-bottom:0;">A small change in the discount rate assumption can have a DISPROPORTIONATELY large effect on the defined benefit obligation for long-duration pension liabilities – this sensitivity is precisely why detailed sensitivity disclosure is mandatory.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRS vs US GAAP – Key Differences</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison – IAS 19 vs US GAAP (ASC 715)</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IFRS (IAS 19)</span><span style="color:var(--color-text-warning);">US GAAP</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Actuarial gains/losses (remeasurements)</span><span>Recognised IMMEDIATELY in OCI, never recycled to SOPL</span><span>May be recognised immediately in OCI, OR deferred and amortised using a "corridor" approach; if deferred, EVENTUALLY recycled through SOPL</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Past service cost</span><span>Recognised immediately in SOPL, whether vested or unvested</span><span>Amortised over the future service period of employees, if unvested</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Expected return on plan assets</span><span>No longer a separate concept – net interest uses the SAME discount rate on both obligation and assets</span><span>Expected return on assets is separately estimated (potentially different from the discount rate) and included in pension expense</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Presentation of pension cost components</span><span>Service cost + net interest in SOPL; remeasurements in OCI</span><span>Service cost presented within operating expenses; other components (interest, expected return, amortisation) presented separately, often below operating income</span></div>
        </div>
        <div class="note">The "corridor approach" permitting delayed, smoothed recognition of actuarial gains/losses under older US GAAP practice is the most significant historical divergence – IFRS's mandatory immediate OCI recognition (since the 2011 IAS 19 amendment) is considerably more conservative and volatility-transparent.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping – Where Every Employee Benefit Event Lands</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Short-term benefit expense (wages, accrued leave)</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Undiscounted; liability for any unpaid amount</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Defined contribution – contribution payable</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Simple expense recognition, no actuarial complexity</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Defined benefit – current/past service cost</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Increases the obligation and SOPL expense</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Defined benefit – net interest</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Applied to the net opening liability/asset at the opening discount rate</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Defined benefit – remeasurements (actuarial gains/losses, asset return above/below expected)</span><span><span class="badge bo">OCI</span> <span class="badge bs">SOFP</span></span><span>Never recycled to SOPL; may transfer within equity</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Contributions paid into the plan</span><span><span class="badge bs">SOFP</span></span><span>Increases plan assets, reducing the net liability</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Benefits paid out of the plan</span><span><span class="badge bs">SOFP</span></span><span>Reduces both the obligation and plan assets equally – no SOPL/OCI impact</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Other long-term benefits – total net movement</span><span><span class="badge bp">SOPL</span></span><span>All components (service cost, interest, remeasurement) through SOPL – no OCI split</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Termination benefits</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Recognised at the earlier of offer-withdrawal or related restructuring recognition</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Contributions paid (cash)</span><span><span class="badge bs">Cash Flow Statement</span></span><span>Operating activities outflow</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Actuarial assumptions, sensitivity, plan risk characteristics</span><span><span class="badge bp">Notes</span></span><span>Extensive mandatory disclosure for defined benefit plans</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards – Cross-Reference Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">How IAS 19 connects across the IFRS body of literature</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Nature of the connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 2</span><span>Share-based payment employee benefits are EXPLICITLY EXCLUDED from IAS 19's scope and follow IFRS 2's own fair value-based recognition rules instead</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 12</span><span>Remeasurements recognised in OCI generate temporary differences whose deferred tax effect ALSO flows through OCI, consistent with IAS 12's "tax follows the item" rule</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 37</span><span>A decision to restructure, involving termination benefits, triggers simultaneous recognition of both an IAS 37 restructuring provision and IAS 19 termination benefits</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 1</span><span>Determines where net defined benefit liabilities/assets are presented on the SOFP (always non-current in practice, given the long-term nature) and where remeasurements sit within OCI</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 13</span><span>Supplies the fair value measurement framework used to value plan assets held by the pension fund</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 24</span><span>Key management personnel compensation, including post-employment and other long-term benefits, must be disclosed as related party transactions</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 10 / IAS 27</span><span>Determines whether a pension fund itself should be consolidated by the sponsoring entity, based on the control assessment (usually NOT consolidated where the fund is a separate legal entity administered independently)</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<Glossary entries={[
      { term: "Past service cost", definition: "The change in the present value of the defined benefit obligation for employee service in PRIOR periods, resulting from a plan amendment or curtailment – recognised immediately in SOPL." },
      { term: "Curtailment", definition: "A significant reduction by the entity in the number of employees covered by a plan, or an amendment reducing future benefits for existing service." },
      { term: "Multi-employer plans", definition: "Plans that pool the assets contributed by various entities not under common control, used to provide benefits to employees of more than one entity – classified as DC or DB based on the terms, not simply the pooling structure." },
      { term: "Vested employee benefits", definition: "Benefits not conditional on future employment – the entitlement is secured regardless of whether the employee continues to work for the entity." },
      { term: "Plan assets", definition: "Assets held by a long-term employee benefit fund, and qualifying insurance policies, that are used solely to settle employee benefit obligations and are not available to the reporting entity's own creditors." },
      { term: "Constructive obligation", definition: "An obligation arising from an entity's own established pattern of past practice, published policies, or a sufficiently specific current statement, creating a valid expectation among employees that the entity will discharge those responsibilities." }
    ]} />

<FinancialStatementKey />
