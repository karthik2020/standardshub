import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc848.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — Contracts and Hedges Referencing a Rate Expected to Be Discontinued" },
        { id: "s3", label: "Why Optional Relief Was Needed" },
        { id: "s4", label: "The Contract Modification Expedient" },
        { id: "s5", label: "What the Modification Expedient Avoids Reassessing" },
        { id: "s6", label: "The Hedge Accounting Relief" },
        { id: "s7", label: "An Elective, Not Mandatory, Framework" },
        { id: "s8", label: "The Sunset Date — a Genuinely Temporary Standard" },
        { id: "s9", label: "Worked Example — Applying the Contract Modification Expedient" },
        { id: "s10", label: "Worked Example — Continuing a Hedge Relationship Through the Transition" },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments &amp; Estimates" },
        { id: "s13", label: "A Genuinely Unusual Standard Within US GAAP" },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Topics" },
        { id: "s16", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">

<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Relief from onerous re-evaluation triggered purely by a rate benchmark change</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">ASC 848 provides OPTIONAL expedients and EXCEPTIONS for APPLYING US GAAP to CONTRACT modifications and HEDGING relationships AFFECTED by REFERENCE rate reform — MOST notably, the GLOBAL phase-OUT of LIBOR (the LONDON Interbank OFFERED Rate) in FAVOR of ALTERNATIVE reference RATES such as SOFR (the SECURED Overnight FINANCING Rate). WITHOUT this RELIEF, the SHEER volume of CONTRACTS and HEDGING relationships REQUIRING technical REASSESSMENT purely BECAUSE of a BENCHMARK rate CHANGE would have IMPOSED a GENUINELY enormous, LARGELY unproductive ACCOUNTING burden.</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — Contracts and Hedges Referencing a Rate Expected to Be Discontinued</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Applies only where reference rate reform is the cause of the change</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">This Topic applies to CONTRACTS, HEDGING relationships, and OTHER transactions that REFERENCE LIBOR or ANOTHER reference RATE expected to be DISCONTINUED because OF reference RATE reform — RELIEF is AVAILABLE only WHERE the RELEVANT contract MODIFICATION is DIRECTLY related TO, and a DIRECT consequence OF, reference RATE reform.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Why Optional Relief Was Needed</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">The scale of LIBOR-referencing contracts made ordinary accounting impractical</div><div style="font-size: var(--text-small);color:var(--color-text-secondary);line-height:1.6;">LIBOR was REFERENCED in an ENORMOUS volume of GLOBAL financial CONTRACTS — LOANS, bonds, DERIVATIVES, leases, and MORE. WITHOUT relief, EVERY contract MODIFICATION simply CHANGING the REFERENCE rate (e.g. FROM LIBOR to SOFR) WOULD, under ORDINARY US GAAP principles, POTENTIALLY trigger a FULL reassessment of WHETHER the MODIFICATION represents a NEW contract, WHETHER embedded DERIVATIVES require RE-EVALUATION, and WHETHER hedge ACCOUNTING relationships remain VALID — an ENORMOUS operational BURDEN, given the SCALE of the TRANSITION, for CHANGES that were PURELY mechanical rather than ECONOMICALLY substantive.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>The Contract Modification Expedient</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Treating an eligible modification as a continuation of the existing contract</div><div style="font-size: var(--text-small);color:var(--color-text-secondary);line-height:1.6;">FOR ELIGIBLE contract MODIFICATIONS, an ENTITY may ACCOUNT for the MODIFICATION as a CONTINUATION of the EXISTING contract, RATHER than the CREATION of a NEW contract — AVOIDING the NEED to REASSESS prior CONCLUSIONS (SUCH as LEASE classification, OR whether a CONTRACT contains an EMBEDDED derivative REQUIRING separate ACCOUNTING) purely BECAUSE of the REFERENCE rate change.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>What the Modification Expedient Avoids Reassessing</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A meaningful list of technical reassessments avoided</div><div class="check-list"><span>Whether a lease modification should be accounted for as a new lease</span><span>Whether a contract modification requires reassessment of an embedded derivative</span><span>Whether the modification results in extinguishment versus modification accounting for debt</span></div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>The Hedge Accounting Relief</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Continuing hedge relationships without dedesignation</div><div style="font-size: var(--text-small);color:var(--color-text-secondary);line-height:1.6;">ASC 848 ALLOWS entities to CONTINUE applying HEDGE accounting to RELATIONSHIPS affected BY reference RATE reform WITHOUT dedesignating THEM — EVEN where CHANGES to the HEDGED risk, the HEDGING instrument, or OTHER hedge DOCUMENTATION would, UNDER ordinary hedge ACCOUNTING principles, OTHERWISE require de-DESIGNATION and RE-designation of the HEDGING relationship.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>An Elective, Not Mandatory, Framework</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Entities choose whether to apply the relief</div><div style="font-size: var(--text-small);color:var(--color-text-secondary);line-height:1.6;">APPLICATION of ASC 848'S expedients and EXCEPTIONS is ENTIRELY OPTIONAL — an ENTITY ELECTS to APPLY the RELIEF (in WHOLE or in PART, to SPECIFIC transactions OR transaction TYPES), RATHER than being REQUIRED to. AN entity that DOES NOT elect the RELIEF simply APPLIES ordinary US GAAP PRINCIPLES to REFERENCE-rate-related MODIFICATIONS, WITH the FULL reassessment BURDEN this Topic is DESIGNED to AVOID.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>The Sunset Date — a Genuinely Temporary Standard</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Built-in expiration, extended once to track the actual transition timeline</div><div style="font-size: var(--text-small);color:var(--color-text-secondary);line-height:1.6;">ASC 848 was ORIGINALLY set to SUNSET (EXPIRE) on DECEMBER 31, 2022, but ASU 2022-06 (issued DECEMBER 2022) EXTENDED the SUNSET date to DECEMBER 31, 2024, to ALIGN with the ACTUAL, extended TIMELINE over WHICH certain LIBOR settings CONTINUED to be PUBLISHED. THIS built-in EXPIRATION is a GENUINELY unusual FEATURE within US GAAP — MOST ASC topics are PERMANENT, ONGOING authoritative GUIDANCE, RATHER than DELIBERATELY time-LIMITED transition relief.</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Applying the Contract Modification Expedient</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">No reassessment triggered by the rate change alone</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A LIBOR-referencing term loan transitioning to SOFR</div><div class="wk-body">A company's $40,000,000 term loan referenced 3-month LIBOR. In 2023, the loan agreement was amended solely to replace the LIBOR reference with SOFR plus an agreed spread adjustment, with no other substantive changes to the loan's terms.</div><div class="wk-answer">APPLYING the ASC 848 CONTRACT modification EXPEDIENT, the company ACCOUNTS for the AMENDMENT as a CONTINUATION of the EXISTING loan AGREEMENT — WITHOUT reassessing WHETHER the MODIFICATION constitutes an EXTINGUISHMENT requiring GAIN/loss recognition, and WITHOUT recalculating a NEW effective INTEREST rate FROM scratch.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example — Continuing a Hedge Relationship Through the Transition</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Avoiding hedge dedesignation purely due to the rate change</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: An interest rate swap hedging LIBOR-based debt</div><div class="wk-body">A company has a cash flow hedge using an interest rate swap to hedge variability in interest payments on LIBOR-based debt. Both the debt and the swap transition to SOFR at the same time, as part of the broader market-wide reference rate transition.</div><div class="wk-answer">APPLYING the ASC 848 HEDGE accounting RELIEF, the company CONTINUES the EXISTING cash FLOW hedge RELATIONSHIP WITHOUT dedesignating and RE-designating it — AVOIDING a POTENTIAL interruption to HEDGE accounting, and AVOIDING reclassifying ANY amounts PREVIOUSLY deferred WITHIN other COMPREHENSIVE income, PURELY because of the REFERENCE rate change.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What ASC 848 requires</div><div class="check-list"><span>Nature of, and reason for, an entity's election to apply ASC 848 relief</span><span>Types of contracts and hedging relationships the relief has been applied to</span><span>Progress of the entity's transition away from reference rates expected to be discontinued</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether a specific contract modification is genuinely a direct consequence of reference rate reform, qualifying for the expedient</span><span>Whether to elect ASC 848 relief for a given transaction or population of transactions</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Generally minimal — the relief is designed to avoid triggering new estimation requirements</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>A Genuinely Unusual Standard Within US GAAP</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Temporary, transaction-specific relief rather than permanent principle-setting</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.8fr;"><span>Feature</span><span>ASC 848's distinctive character</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.8fr;"><span>Permanence</span><span>DELIBERATELY temporary, WITH a BUILT-in sunset DATE (now EXPIRED)</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.8fr;"><span>Purpose</span><span>OPERATIONAL relief FROM a market-WIDE, non-ECONOMIC transition EVENT, RATHER than a PERMANENT accounting PRINCIPLE</span></div>
</div>
<div class="note">MOST ASC topics ESTABLISH ongoing, PERMANENT accounting PRINCIPLES — ASC 848 is a GENUINE outlier, EXISTING purely to SMOOTH a ONE-TIME, market-WIDE structural TRANSITION.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every reference rate reform election lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Contract modification expedient elected</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Avoids extinguishment gain/loss and new effective rate recalculation</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Hedge accounting relief elected</span><span><span class="badge oci">OCI</span></span><span>Avoids dedesignation and reclassification of amounts in OCI</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Topics</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 815, Derivatives and Hedging</span><span>Supplies the ordinary hedge accounting and dedesignation rules ASC 848's relief provides an exception from</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASC 470, Debt</span><span>Supplies the ordinary modification-versus-extinguishment analysis ASC 848's contract modification expedient provides relief from</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Reference rate reform</div><div class="glossary-def">The global market-wide transition away from LIBOR and similar reference rates expected to be discontinued, toward alternative rates such as SOFR.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Sunset date</div><div class="glossary-def">The date after which ASC 848's optional relief provisions are no longer available for new elections, set at December 31, 2024.</div></div>
</div>
</div>

    <Glossary entries={[
      { term: "Reference rate reform", definition: "The global market-wide transition away from LIBOR and similar reference rates expected to be discontinued, toward alternative rates such as SOFR." },
      { term: "Sunset date", definition: "The date after which ASC 848's optional relief provisions are no longer available for new elections, set at December 31, 2024." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.asc848 || []} />
  </section>
</StandardPageLayout>
