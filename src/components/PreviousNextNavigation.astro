---
/*
Previous / next standard navigation.

Props:
- current
- framework

Renders linked previous and next standard cards based on the framework's ordered index. Only displays when at least one neighbour exists. Grid pins each card to its own column so positions stay stable when one side is missing.
*/

import { ArrowLeft, ArrowRight } from "@lucide/astro";
import standards from "../data/standards.json";
import type { Framework } from "../data/standards/metadata.types";
import { getFramework } from "../data/frameworks";

interface Props {
  current: string;
  framework: Framework;
}

const { current, framework } = Astro.props;

const frameworkConfig = getFramework(framework) ?? getFramework("ias")!;

const allIAS = [
  ...standards.IAS.filter((s) => !s.status),
  ...standards.IAS.filter((s) => s.status),
];

const standardsList =
  frameworkConfig.code === "IAS"
    ? allIAS
    : frameworkConfig.code === "Ind AS"
      ? [
          ...standards.IndAS.filter((s) => !s.status),
          ...standards.IndAS.filter((s) => s.status),
        ]
      : frameworkConfig.code === "IFRS Sustainability"
        ? [
            ...standards.IFRSSustainability.filter((s) => !s.status),
            ...standards.IFRSSustainability.filter((s) => s.status),
          ]
        : frameworkConfig.code === "IFRS Publications"
          ? [
              ...standards.IFRSPublications.filter((s) => !s.status),
              ...standards.IFRSPublications.filter((s) => s.status),
            ]
          : frameworkConfig.code === "IFRS for SMEs"
            ? [
                ...standards.IFRSForSMEs.filter((s) => !s.status),
                ...standards.IFRSForSMEs.filter((s) => s.status),
              ]
             : frameworkConfig.code === "IFRIC"
               ? [
                   ...standards.IFRIC.filter((s) => !s.status),
                   ...standards.IFRIC.filter((s) => s.status),
                 ]
               : frameworkConfig.code === "SIC"
                 ? [
                     ...standards.SIC.filter((s) => !s.status),
                     ...standards.SIC.filter((s) => s.status),
                   ]
                 : standards[frameworkConfig.code] ?? [];

const currentIndex = standardsList.findIndex((standard) => standard.code === current);
const previous =
  currentIndex > 0 ? standardsList[currentIndex - 1] : undefined;
const next =
  currentIndex >= 0 && currentIndex < standardsList.length - 1
    ? standardsList[currentIndex + 1]
    : undefined;

const frameworkClass = frameworkConfig.id;
---

{
  (previous || next) && (
    <nav class="pnn-nav" aria-label="Previous and next standards">
      {previous && (
        <a class={`pnn-card pnn-prev nav-${frameworkClass}`} href={previous.url}>
          <span class="pnn-label" aria-hidden="true">Previous</span>
          <span class="pnn-code">
            <ArrowLeft size={17} class="pnn-arrow" aria-hidden="true" />
            {previous.code}
          </span>
          <span class="pnn-title">{previous.title}</span>
        </a>
      )}

      {next && (
        <a class={`pnn-card pnn-next nav-${frameworkClass}`} href={next.url}>
          <span class="pnn-label" aria-hidden="true">Next</span>
          <span class="pnn-code">
            {next.code}
            <ArrowRight size={17} class="pnn-arrow" aria-hidden="true" />
          </span>
          <span class="pnn-title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}
