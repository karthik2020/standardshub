---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas27.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & Definitions" },
        { id: "s2", label: "Biological Assets, Produce & Bearer Plants" },
        { id: "s3", label: "Recognition & Measurement" },
        { id: "s4", label: "Gains & Losses" },
        { id: "s5", label: "Inability to Measure Fair Value Reliably" },
        { id: "s6", label: "Disclosure — General & Descriptive" },
        { id: "s7", label: "Reconciliation of Biological Asset Carrying Amounts" },
        { id: "s8", label: "Current Value Measurement Disclosures" },
        { id: "s9", label: "Effective Date & Amendment Timeline" },
        { id: "s10", label: "Relationship to IAS 41" },
        { id: "s11", label: "Statement / Process Mapping" },
        { id: "s12", label: "Related Standards" },
        { id: "s13", label: "Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 27 Agriculture is the current, active standard issued by the IPSASB for accounting for biological assets (except bearer plants) and agricultural produce. Effective for periods beginning on or after 1 April 2011 (earlier application permitted). The current Standard comprises paras. 1–57."
    historical="IPSAS 27 is the IPSASB's adaptation of IAS 41 Agriculture for the public sector. The core regime — biological assets and produce at the point of harvest measured at fair value less estimated point-of-sale costs with changes in profit or loss — is retained, with public-sector commentary on 'agricultural activity' and explicit treatment of government grants under IPSAS 23 rather than within the Standard itself."
    link=""
    linkText=""
  />

  <div class="legend">
    <span class="legend-item legend-objective">Objective &amp; scope (paras. 1–3)</span>
    <span class="legend-item legend-recognition">Recognition &amp; measurement (paras. 4–16)</span>
    <span class="legend-item legend-disclosure">Disclosure (paras. 17–32)</span>
    <span class="legend-item legend-related">Related Standard</span>
    <span class="legend-item legend-ias">IAS / IFRS equivalent</span>
  </div>

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; Definitions (paras. 1–9)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Objective &amp; scope</div>
      <div class="principle">Prescribes the accounting treatment and disclosures for biological assets (except bearer plants), agricultural produce, and bearer plants used in agricultural activity. Requires both to be measured at FAIR VALUE less estimated POINT-OF-SALE costs, with changes in fair value recognised in profit or loss.</div>
      <div class="glossary-item"><div class="glossary-term">Biological asset</div><div class="glossary-def">A living plant or animal — or a group — with bio-generative normality and a market, held for harvest as agricultural produce.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Agricultural produce</div><div class="glossary-def">The harvested product of the entity's biological assets, measured at the point of harvest.</div></div>
    </div>

    <div class="card cd span2">
      <div class="ctitle cd">Scope (para. 3)</div>
      <div class="principle">Applies to biological assets and agricultural produce — EXCEPT for trading livestock (carried at fair value through profit/loss under IPSAS 41) and agricultural activities conducted wholly underwater or in a greenhouse (see IPSAS 41 commentary).</div>
      <div class="callout info callout--flush">Bearer plants ARE covered — but measured under IPSAS 17 (cost model) rather than this fair-value regime.</div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Biological Assets, Produce &amp; Bearer Plants (paras. 10–16)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">The measurement rule (para. 10)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.6fr;"><span>Item</span><span>Measurement</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.6fr;"><span>Biological assets (living)</span><span>FV less estimated PO sale costs</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.6fr;"><span>Agricultural produce (harvested)</span><span>FV less estimated PO sale costs at harvest</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.6fr;"><span>Bearer plants</span><span>Cost model (IPSAS 17)</span></div>
      </div>
      <div class="callout warn">Costs of sale are deducted from FV — not recognised separately — because fair value is a market net-realisable value.</div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Recognition &amp; Measurement (paras. 17–26)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">When to book (para. 17)</div>
      <div class="principle">A biological asset is recognised when (a) it is probable that future economic benefits will flow and (b) it can be measured reliably — i.e., a market exists. Initial cost is not used; the asset is booked at its fair value on the day it is first recognised.</div>
      <div class="check-list"><span>Probable future economic benefits</span><span>Reliable fair-value measurement</span><span>Market-based, not cost-based</span></div>
    </div>
  </div>

  <!-- ============ SECTION 4 ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Gains &amp; Losses (paras. 27–34)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Goes to profit or loss (para. 27)</div>
      <div class="principle">Changes in the fair value of a biological asset (less costs of sale) are recognised in profit or loss as they arise — EXCEPT for the portion relating to agricultural produce already included in the cost of sales (inventory) recognised on harvest, which is also in profit or loss.</div>
      <div class="cross-list"><span>Fair value gain</span><span>Other income (P&amp;L)</span><span>Fair value loss</span><span>Losses (P&amp;L)</span></div>
    </div>
  </div>

  <!-- ============ SECTION 5 ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Inability to Measure Fair Value Reliably (paras. 35–38)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw">
      <div class="ctitle cw">Last-resort cost model (para. 35)</div>
      <div class="principle">If fair value cannot be measured reliably, the entity measures the biological asset (and produce) at cost — the same measurement used for similar assets in other Standards. Disclose the reason and the amount.</div>
      <div class="callout info callout--flush">This is an exception, not the rule: fair value is the default because agricultural markets are typically liquid.</div>
    </div>
  </div>

  <!-- ============ SECTION 6 ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Disclosure — General &amp; Descriptive (paras. 39–43)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Headline disclosures (para. 39)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.5fr 1.5fr;"><span>The matter</span><span>Disclosed</span></div>
        <div class="tr" style="grid-template-columns:1.5fr 1.5fr;"><span>Accounting policy</span><span>FV less costs of sale basis + exceptions</span></div>
        <div class="tr alt" style="grid-template-columns:1.5fr 1.5fr;"><span>Methods &amp; significant assumptions</span><span>How fair value is determined</span></div>
        <div class="tr" style="grid-template-columns:1.5fr 1.5fr;"><span>Risk exposure</span><span>Bearer-plant and market-price risks</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 7 ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Reconciliation of Biological Asset Carrying Amounts (paras. 44–45)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Movement table (para. 44)</div>
      <div class="principle">Reconcile opening to closing carrying amount: opening FV, purchases, sales, harvest, FV changes, and closing FV. Present in the same fair-value hierarchy as produce.</div>
      <div class="callout warn">Separate line for each major biological asset category where practicable.</div>
    </div>
  </div>

  <!-- ============ SECTION 8 ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Current Value Measurement Disclosures (paras. 46–47)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Maturity bands (para. 46)</div>
      <div class="principle">Disclose carrying amounts by expected timing of conversion to agricultural produce: <1 year, 1–2 years, 2–3 years, >3 years — so users see maturation and cash-flow timing.</div>
    </div>
  </div>

  <!-- ============ SECTION 9 ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Effective Date &amp; Amendment Timeline</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Timeline</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.2fr;"><span>Date</span><span>Event</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>Dec 2010</span><span>Issued</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.2fr;"><span>1 Apr 2011</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>2025</span><span>Amended (latest)</span></div>
      </div>
      <div class="callout info callout--flush">Aligned with IFRS 11 (service concession) commentary issued the same cycle.</div>
    </div>
  </div>

  <!-- ============ SECTION 10 ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Relationship to IAS 41</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Mapping (para. 48)</div>
      <div class="principle">IPSAS 27 mirrors IAS 41's fair-value-measurement approach but diverges on scope: bearer plants (IAS 41 para. 31) are measured at cost under IPSAS 17 in the IPSAS framework, and government grants on biological assets are excluded from IPSAS 27 and dealt with under IPSAS 23.</div>
      <div class="cross-list"><span>IAS 41 fair value</span><span>IPSAS 27 same</span><span>IAS 41 bearer plants</span><span>IPSAS 17 cost model</span><span>IAS 41 grants</span><span>IPSAS 23</span></div>
    </div>
  </div>

  <!-- ============ SECTION 11 ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Where it flows</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.4fr 1.3fr;"><span>Process</span><span>Ledger</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Fair-value estimation</span><span>Farm Manager → Asset Register (FV)</span></div>
        <div class="tr alt" style="grid-template-columns:1.4fr 1.3fr;"><span>Gain/loss booking</span><span>Valuation Reserve → P&amp;L</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Reconciliation</span><span>Harvested Produce → Inventory → Cost of Sales</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 12 ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Related Standards</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">See also</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 2fr;"><span>Standard</span><span>Relation</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 17</span><span>Bearer plants (cost model)</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IPSAS 23</span><span>Government grants on agriculture</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IAS 41</span><span>Direct equivalent</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 13 ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Biological asset</div><div class="glossary-def">Living plant/animal held for harvest as agricultural produce.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Agricultural produce</div><div class="glossary-def">Harvested product measured at the point of harvest.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Bearer plant</div><div class="glossary-def">Plant that, after regular harvesting, continues to bear produce.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Fair value less costs to sell</div><div class="glossary-def">Market price minus disposal costs.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Gains/losses</div><div class="glossary-def">FV movements booked in profit or loss.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Maturity band</div><div class="glossary-def">Carrying-amount split by expected harvest timing.</div></div>
    </div>
  </div>
</StandardPageLayout>
