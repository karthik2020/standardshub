---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas110.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "The Control Model — Three Elements" },
        { id: "s4", label: "Power Over the Investee" },
        { id: "s5", label: "Exposure to Variable Returns" },
        { id: "s6", label: "Linkage Between Power and Returns" },
        { id: "s7", label: "Investment Entities Exception — Indian AIF/Mutual Fund Context" },
        { id: "s8", label: "Loss of Control" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "Ind AS 110 vs IFRS 10 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical control philosophy to IFRS 10</div>
        <div class="principle">Ind AS 110 applies the IDENTICAL single control model as IFRS 10 — consolidation follows genuine POWER, exposure to VARIABLE RETURNS, and the ABILITY to use power to affect those returns, replacing any purely voting-percentage-based approach with a substance-based test.</div>
        <div class="elabel">HOW IND AS 110 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Substance over form</strong> — identical to IFRS 10</span>
          <span><strong>Faithful representation</strong> — consolidating only what is genuinely controlled — identical to IFRS 10</span>
          <span><strong>Interaction with India's fund management sector</strong> — Indian mutual funds/AIFs are ALSO separately regulated by SEBI, whose own regulations govern fund structuring; Ind AS 110's investment entities exception (Section 7) must be applied CONSISTENTLY with this parallel SEBI framework</span>
        </div>
        <div class="note">Ind AS 110 introduced NO substantive change to the control definition itself relative to IFRS 10 — its practical application in India is most distinctive for asset managers and NBFCs managing pooled investment vehicles.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The three-element control test — identical to IFRS 10</div>
        <div class="formula-box"><div class="f-eq">Control = Power + Exposure to variable returns + Ability to use power to affect returns</div></div>
        <div class="callout info callout--chip callout--flush">ALL three elements must be present simultaneously — IDENTICAL requirement to IFRS 10.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 110 covers</div>
        <div class="principle">Ind AS 110 establishes principles for presenting/preparing consolidated financial statements when an entity controls one or more other entities — IDENTICAL scope to IFRS 10.</div>
        <div class="note">Applies to Indian parent companies preparing consolidated financial statements under the Companies Act, 2013 and Ind AS.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Control of an investee</div><div class="glossary-def">IDENTICAL definition to IFRS 10.</div></div>
        <div class="glossary-item"><div class="glossary-term">AIF (Alternative Investment Fund)</div><div class="glossary-def">A SEBI-regulated Indian pooled investment vehicle (e.g. private equity, venture capital, hedge funds), relevant to the investment entities exception analysis.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — CONTROL MODEL ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Control Model — Three Elements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical continuous reassessment requirement to IFRS 10</div>
        <div class="principle">An investor reassesses control whenever facts/circumstances indicate changes to power, returns, or linkage — IDENTICAL to IFRS 10, with no Indian-specific modification.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — POWER OVER THE INVESTEE ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Power Over the Investee</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">Identical to IFRS 10</div>
        <div class="text-supporting">Power arises from rights — voting, appointment/removal of key management, contractual arrangements — with substantive potential voting rights considered, IDENTICAL to IFRS 10.</div>
      </div>
      <div class="card cw">
        <div class="worked">
          <div class="wk-title">Example 1: De facto control at an Indian listed company</div>
          <div class="wk-body">An Indian promoter holds 38% of a listed company's shares; the remaining 62% is dispersed among thousands of small retail shareholders, with historical AGM attendance rarely exceeding 25% of total voting rights.</div>
          <div class="wk-answer">The 38% stake likely confers de facto control given extreme dispersion and low turnout — IDENTICAL analysis to how IFRS 10 would assess the same facts globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — EXPOSURE TO VARIABLE RETURNS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Exposure to Variable Returns</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical broad concept to IFRS 10</div>
        <div class="text-supporting">Returns can be positive, negative, or both, including dividends, fees, residual interests — IDENTICAL to IFRS 10, with the same principal/agent nuance for fund managers (Section 6).</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — LINKAGE BETWEEN POWER AND RETURNS ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Linkage Between Power and Returns — Principal vs Agent</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical decision-maker analysis to IFRS 10</div>
        <div class="principle">The principal-vs-agent test (scope of decision-making authority, other parties' rights, remuneration, exposure to variability) is IDENTICAL to IFRS 10.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: An Indian AIF manager as agent</div>
          <div class="wk-body">An Indian AIF's investment manager earns a market-standard 2% management fee plus a 20% performance fee (carried interest), typical for Indian private equity/venture funds. Investors hold substantive rights to remove the manager via majority vote, per the fund's constitutional documents (aligned with SEBI AIF Regulations).</div>
          <div class="wk-answer">The manager is likely acting as an <strong>AGENT</strong> — market-based remuneration and substantive investor removal rights — and does NOT consolidate the fund, an IDENTICAL conclusion to how IFRS 10 would assess an equivalent global private equity fund structure.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 — INVESTMENT ENTITIES EXCEPTION ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Investment Entities Exception — Indian AIF/Mutual Fund Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important interaction point</div>
        <div class="text-supporting">Ind AS 110's investment entities exception (fair value through profit or loss, rather than consolidation) is available on the SAME criteria as IFRS 10 (funds obtained from investors, exit strategy commitment, fair-value-based performance evaluation) — but its PRACTICAL application must be considered ALONGSIDE SEBI's Mutual Fund Regulations and AIF Regulations, which impose their OWN structural and reporting requirements on Indian pooled investment vehicles. This is a REGULATORY LAYER interaction, similar in spirit to IRDAI's role for insurers and RBI's for banks, rather than a substantive accounting divergence from IFRS 10.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — LOSS OF CONTROL ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Loss of Control</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IFRS 10</div>
        <div class="text-supporting">Derecognition of assets/liabilities/NCI, recognition of consideration received, and fair value remeasurement of any retained interest — IDENTICAL to IFRS 10.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IFRS 10</div>
        <div class="check-list">
          <span>Significant judgements in determining control</span>
          <span>Group composition, NCI interests</span>
          <span>Restrictions on accessing group assets</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>De facto control in dispersed Indian listed company shareholdings</span>
              <span>Principal vs agent for Indian fund managers</span>
              <span>Investment entity qualification alongside SEBI AIF/Mutual Fund Regulations</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Fair value of a retained interest on loss of control</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">For Indian NBFCs sponsoring securitisation SPVs, the control assessment (particularly the "power" and "linkage" elements) requires careful analysis, similar to structured entity assessments globally under IFRS 10.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 110 VS IFRS 10 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 110 vs IFRS 10 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS 10</span><span>Ind AS 110</span></div>
          <div class="tr cols-12-1-1"><span>Control model</span><span>Power + returns + linkage</span><span>IDENTICAL</span></div>
          <div class="tr alt cols-12-1-1"><span>Investment entities exception</span><span>Available per specific criteria</span><span>IDENTICAL criteria, applied alongside SEBI's separate Mutual Fund/AIF Regulations for Indian pooled vehicles</span></div>
          <div class="tr cols-12-1-1"><span>NBFC consolidation</span><span>No specific global equivalent regulatory overlay</span><span>RBI's separate NBFC regulatory framework may impose additional group-structure reporting requirements alongside Ind AS 110</span></div>
        </div>
        <div class="note">Ind AS 110 is essentially IDENTICAL to IFRS 10 in substance — the meaningful Indian context is the interaction with SEBI/RBI's separate regulatory frameworks for funds and NBFCs, not any divergence in the control definition itself.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Line-by-line combination</span><span><span class="badge bs">Balance Sheet</span></span><span>Identical to IFRS 10</span></div>
          <div class="tr alt cols-16-1-14"><span>NCI share of profit</span><span><span class="badge bp">P&amp;L</span> <span class="badge be">Equity</span></span><span>Identical to IFRS 10</span></div>
          <div class="tr cols-16-1-14"><span>Loss of control remeasurement</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Identical to IFRS 10</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 10</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 103</span><span>Applied at the point control is obtained</span></div>
          <div class="tr cols-08-2"><span>SEBI AIF/Mutual Fund Regulations</span><span>Governs the legal structuring of Indian pooled investment vehicles relevant to the investment entities exception</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">AIF</div><div class="glossary-def">Alternative Investment Fund — a SEBI-regulated Indian pooled investment vehicle.</div></div>
        <div class="glossary-item"><div class="glossary-term">Carried interest</div><div class="glossary-def">A performance-based fee common in Indian private equity/VC fund structures, relevant to principal vs agent analysis.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Control of an investee", definition: "IDENTICAL definition to IFRS 10 — power over the investee, exposure to variable returns, and ability to use power to affect returns." },
      { term: "AIF (Alternative Investment Fund)", definition: "A SEBI-regulated Indian pooled investment vehicle (e.g. private equity, venture capital, hedge funds), relevant to the investment entities exception analysis." },
      { term: "De facto control", definition: "Control arising from substantive potential voting rights and dispersed shareholding patterns, rather than a majority voting stake." },
      { term: "Principal vs agent", definition: "The assessment of whether a decision-maker is acting as principal (consolidates) or agent (does not consolidate) based on scope of authority, remuneration, and exposure to variability." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
