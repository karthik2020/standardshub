---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas112.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "Significant Judgements in Determining Control/Influence" },
        { id: "s4", label: "Disclosures for Subsidiaries" },
        { id: "s5", label: "Disclosures for Joint Arrangements & Associates" },
        { id: "s6", label: "Unconsolidated Structured Entities" },
        { id: "s7", label: "Schedule III Group Disclosure Interaction" },
        { id: "s8", label: "Restrictions and Risks" },
        { id: "s9", label: "Disclosure Summary" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "Ind AS 112 vs IFRS 12 – Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical disclosure philosophy to IFRS 12</div>
        <div class="principle">Ind AS 112 applies the IDENTICAL objective as IFRS 12 – enabling users to EVALUATE the nature of, and risks associated with, an entity's interests in subsidiaries, joint arrangements, associates, and unconsolidated structured entities, and the EFFECTS of those interests on financial position/performance.</div>
        <div class="elabel">HOW IND AS 112 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Relevance</strong> – group structure risks/dependencies are not always apparent from consolidated totals alone – identical to IFRS 12</span>
          <span><strong>Interaction with Schedule III</strong> – the Companies Act, 2013's Schedule III ALSO requires specific group entity disclosures (e.g. a statement showing net assets/profit-loss share of each entity in a consolidation) – operating ALONGSIDE, not instead of, Ind AS 112's own requirements</span>
        </div>
        <div class="note">This dual disclosure requirement (Ind AS 112 + Schedule III) is a genuinely distinctive INDIAN practical feature, though NOT a substantive divergence in Ind AS 112's own accounting content.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The four disclosure categories – identical to IFRS 12</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Category</span><span>Focus</span></div>
          <div class="tr cols-13-1"><span>Significant judgements</span><span>How control/joint control/significant influence was determined</span></div>
          <div class="tr alt cols-13-1"><span>Subsidiaries</span><span>NCI, restrictions, consolidated structured entities</span></div>
          <div class="tr cols-13-1"><span>Joint arrangements/associates</span><span>Nature, extent, financial effects</span></div>
          <div class="tr alt cols-13-1"><span>Unconsolidated structured entities</span><span>Nature, extent, risk exposure</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 112 covers</div>
        <div class="principle">Ind AS 112 applies to entities with interests in subsidiaries, joint arrangements, associates, or unconsolidated structured entities – IDENTICAL scope to IFRS 12.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Structured entity</div><div class="glossary-def">IDENTICAL definition to IFRS 12 – an entity designed so voting rights are not the dominant factor in control.</div></div>
        <div class="glossary-item"><div class="glossary-term">Schedule III statement</div><div class="glossary-def">The Companies Act, 2013-mandated statement disclosing each group entity's share of net assets and profit/loss within a consolidation.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 – SIGNIFICANT JUDGEMENTS ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Significant Judgements in Determining Control/Influence</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IFRS 12</div>
        <div class="text-supporting">Disclosure of significant judgements/assumptions in determining control, joint control, or significant influence – IDENTICAL to IFRS 12, particularly relevant for de facto control scenarios common in Indian dispersed shareholding structures (see Ind AS 110, Section 4).</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – DISCLOSURES FOR SUBSIDIARIES ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Disclosures for Subsidiaries</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical to IFRS 12</div>
        <div class="text-supporting">Composition of the group, NCI's proportion of ownership/voting rights, summarised financial information for MATERIAL NCI, and nature/extent of significant restrictions on group asset access – IDENTICAL to IFRS 12.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 – DISCLOSURES FOR JOINT ARRANGEMENTS & ASSOCIATES ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Disclosures for Joint Arrangements &amp; Associates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IFRS 12</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Summarised financial information for a material Indian joint venture</div>
          <div class="wk-body">An Indian listed company holds a 40% interest in a material joint venture SPV constructing a toll road. The JV's total assets are ₹200 crore, total liabilities ₹120 crore, revenue ₹35 crore, profit ₹8 crore.</div>
          <div class="wk-answer">Ind AS 112 requires disclosure of the JV's summarised financial information (assets, liabilities, revenue, profit) IN FULL, reconciled to the carrying amount of the equity-accounted investment – an IDENTICAL disclosure requirement to IFRS 12 for an equivalent material joint venture globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 6 – UNCONSOLIDATED STRUCTURED ENTITIES ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Unconsolidated Structured Entities</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IFRS 12</div>
        <div class="text-supporting">Nature/purpose, size, financing, and MAXIMUM EXPOSURE TO LOSS disclosures for unconsolidated structured entities – IDENTICAL to IFRS 12, relevant for Indian NBFCs' securitisation SPVs where control is NOT established.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 – SCHEDULE III INTERACTION ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Schedule III Group Disclosure Interaction</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A parallel Companies Act requirement</div>
        <div class="text-supporting">Schedule III mandates a SPECIFIC additional statement in consolidated financial statements, showing each entity's (parent, subsidiaries, associates, joint ventures) SHARE of consolidated net assets and profit/loss – a REQUIREMENT distinct from, but complementary to, Ind AS 112's own detailed narrative and quantitative disclosures. This is a purely PRESENTATIONAL Companies Act requirement layered on top of Ind AS 112, not a substantive divergence from IFRS 12.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 – RESTRICTIONS AND RISKS ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Restrictions and Risks</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IFRS 12</div>
        <div class="text-supporting">Disclosure of significant restrictions (e.g. regulatory, contractual) on a subsidiary's ability to transfer funds to the parent – IDENTICAL to IFRS 12, relevant for Indian subsidiaries subject to RBI/FEMA (Foreign Exchange Management Act) restrictions on cross-border fund transfers.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – DISCLOSURE SUMMARY ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Summary</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures – identical to IFRS 12</div>
        <div class="check-list">
          <span>Significant judgements in determining control/joint control/significant influence</span>
          <span>Subsidiary composition, NCI information, restrictions</span>
          <span>Joint arrangement/associate summarised financial information</span>
          <span>Unconsolidated structured entity exposure</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Materiality threshold for detailed NCI/JV/associate disclosures</span>
              <span>Whether an entity is a "structured entity"</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Maximum exposure to loss from unconsolidated structured entities</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">FEMA cross-border fund transfer restrictions are a genuinely distinctive Indian consideration under the "restrictions" disclosure requirement, not commonly relevant in many other IFRS 12 jurisdictions.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 – IND AS 112 VS IFRS 12 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 112 vs IFRS 12 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS 12</span><span>Ind AS 112</span></div>
          <div class="tr cols-12-1-1"><span>Core disclosure objectives/requirements</span><span>Four-category structure</span><span>IDENTICAL</span></div>
          <div class="tr alt cols-12-1-1"><span>Group entity net asset/profit share statement</span><span>No direct global equivalent within IFRS 12 itself</span><span>Schedule III of the Companies Act, 2013 mandates a SPECIFIC additional statement, presented alongside Ind AS 112</span></div>
          <div class="tr cols-12-1-1"><span>Fund transfer restrictions context</span><span>Varies by jurisdiction</span><span>FEMA/RBI cross-border restrictions are a common, genuinely Indian-specific example</span></div>
        </div>
        <div class="note">Ind AS 112's disclosure SUBSTANCE mirrors IFRS 12 closely – the Schedule III statement is an ADDITIONAL Companies Act presentation requirement, not a modification of Ind AS 112 itself.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every Ind AS 112 disclosure lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Disclosure item</span><span>Location</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Significant judgements, subsidiary/JV/associate disclosures</span><span><span class="badge bp">Notes</span></span><span>Identical to IFRS 12</span></div>
          <div class="tr alt cols-16-1-14"><span>Schedule III net asset/profit share statement</span><span><span class="badge bp">Consolidated FS Annexure</span></span><span>Companies Act-specific presentation, alongside Ind AS 112 notes</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 12</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 110 / 111 / 28</span><span>Supply the underlying control/joint control/significant influence concepts Ind AS 112 discloses</span></div>
          <div class="tr cols-08-2"><span>Schedule III (Companies Act, 2013)</span><span>Mandates the additional group entity net asset/profit share statement</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">FEMA</div><div class="glossary-def">Foreign Exchange Management Act – governs cross-border fund transfer restrictions relevant to Ind AS 112's restrictions disclosure.</div></div>
        <div class="glossary-item"><div class="glossary-term">Maximum exposure to loss</div><div class="glossary-def">The disclosure metric for unconsolidated structured entities, identical to IFRS 12.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Structured entity", definition: "IDENTICAL definition to IFRS 12 – an entity designed so voting rights are not the dominant factor in control." },
      { term: "Schedule III statement", definition: "The Companies Act, 2013-mandated statement disclosing each group entity's share of net assets and profit/loss within a consolidation." },
      { term: "FEMA", definition: "Foreign Exchange Management Act – governs cross-border fund transfer restrictions relevant to Ind AS 112's restrictions disclosure." },
      { term: "Maximum exposure to loss", definition: "The disclosure metric for unconsolidated structured entities, identical to IFRS 12." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
