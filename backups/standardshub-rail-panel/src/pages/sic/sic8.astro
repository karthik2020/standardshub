---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/sic/sic8.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-8 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-8 was superseded in June 2003 when the IASB issued IFRS 1 First-time Adoption of International Financial Reporting Standards, which provided a comprehensive framework for first-time adopters and replaced the narrow guidance in SIC-8."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ifrs/ifrs1"
    linkText="IFRS 1 First-time Adoption of International Financial Reporting Standards"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-8 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-8 addressed</div>
        <div class="principle">SIC-8 addressed how an entity should apply International Accounting Standards (IASs) for the first time as the primary basis of accounting. It dealt with the transition from local GAAP to IASs and whether retrospective application was required or if transitional exemptions were available.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-8 concluded that an entity adopting IASs for the first time should generally apply them retrospectively, restating prior periods as if IASs had always been used. However, it recognised that full retrospective application might be impracticable in some cases, and permitted selected exemptions where the requirements of IASs were inconsistent with the requirements of the previous GAAP and the adjustments were material.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IFRS 1 First-time Adoption of International Financial Reporting Standards</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>IFRS 1 provided a comprehensive framework for first-time adoption</span></div>
          <div class="tr"><span>Current status</span><span>Superseded</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "First-time adoption", definition: "The date when an entity first prepares and presents a complete set of financial statements in accordance with International Financial Reporting Standards." },
      { term: "Retrospective application", definition: "The application of a new accounting policy to transactions, other events and conditions as if that policy had always been applied." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC8} />
  </section>
</StandardPageLayout>
