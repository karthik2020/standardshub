---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas107.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Significance of Financial Instruments" },
        { id: "s4", label: "Credit Risk Disclosures" },
        { id: "s5", label: "Liquidity Risk Disclosures" },
        { id: "s6", label: "Market Risk & Sensitivity Analysis" },
        { id: "s7", label: "RBI's Regulatory Role" },
        { id: "s8", label: "The Fair Value Hierarchy" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 107 vs IFRS 7" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical disclosure philosophy to IFRS 7</div>
        <div class="principle">Ind AS 107 applies the IDENTICAL Conceptual Framework logic as IFRS 7 – recognised amounts alone tell users little about risk exposure or measurement reliability; genuine understanding requires SEPARATE, DEDICATED risk disclosures (credit, liquidity, market) alongside the fair value hierarchy.</div>
        <div class="elabel">HOW IND AS 107 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Relevance</strong> – risk disclosures give users forward-looking insight beyond recognised balances – IDENTICAL rationale to IFRS 7</span>
          <span><strong>Faithful representation</strong> – the fair value hierarchy distinguishes observable from unobservable inputs – IDENTICAL to IFRS 7</span>
          <span><strong>Dual regulatory layer for financial sector entities</strong> – for Indian banks and NBFCs, Ind AS 107's disclosures operate ALONGSIDE the Reserve Bank of India's (RBI) own extensive prudential disclosure norms – a genuinely India-specific dual-track feature, similar in spirit to IRDAI's role for insurers under Ind AS 104</span>
        </div>
        <div class="note">Ind AS 107 was one of the LATER standards to become fully effective for Indian banks specifically (given phased regulatory transition), but its accounting SUBSTANCE mirrors IFRS 7 closely once applicable.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Two broad disclosure categories – identical to IFRS 7</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Category</span><span>Purpose</span></div>
          <div class="tr cols-13-1"><span>Significance of financial instruments</span><span>Understanding financial position/performance in relation to financial instruments</span></div>
          <div class="tr alt cols-13-1"><span>Nature and extent of risks</span><span>Understanding credit, liquidity, market risk exposure</span></div>
        </div>
        <div class="callout info callout--flush">This structure is IDENTICAL to IFRS 7's own two-category framework.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 107 covers</div>
        <div class="principle">Ind AS 107 applies to ALL entities, for ALL types of financial instruments – IDENTICAL scope to IFRS 7, with the SAME scope exclusions (subsidiary/associate/JV interests, employee benefit plans, insurance contracts except embedded derivatives).</div>
        <div class="note">In practice, DETAILED sensitivity analysis and fair value hierarchy disclosures are most extensively applied by Indian banks, NBFCs, and other financial-sector-heavy entities.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Credit risk / Liquidity risk / Market risk</div><div class="glossary-def">IDENTICAL definitions to IFRS 7.</div></div>
        <div class="glossary-item"><div class="glossary-term">RBI</div><div class="glossary-def">Reserve Bank of India – India's central bank and banking/NBFC regulator, prescribing its own extensive prudential disclosure requirements alongside Ind AS 107.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 – SIGNIFICANCE OF FINANCIAL INSTRUMENTS ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Significance of Financial Instruments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical disclosure requirements to IFRS 7</div>
        <div class="text-supporting">Carrying amounts by Ind AS 109 category, net gains/losses, interest income/expense (effective interest method), impairment (ECL) reconciliation, reclassifications, collateral – ALL identical to IFRS 7's own requirements.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – CREDIT RISK DISCLOSURES ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Credit Risk Disclosures</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical ECL-staging disclosures to IFRS 7</div>
        <div class="text-supporting">Credit risk management practices, quantitative/qualitative ECL information, three-stage movement analysis (12-month/lifetime not credit-impaired/lifetime credit-impaired), and concentration disclosure – IDENTICAL to IFRS 7's requirements, aligned with Ind AS 109's impairment model.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 – LIQUIDITY RISK DISCLOSURES (worked example) ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Liquidity Risk Disclosures (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical undiscounted maturity analysis to IFRS 7</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: An Indian company's undiscounted maturity analysis</div>
          <div class="wk-body">An Indian company has a term loan requiring ₹40,00,000 principal plus ₹3,20,000 interest in Year 1, and ₹40,00,000 principal plus ₹1,60,000 interest in Year 2.</div>
          <div class="wk-answer">
            Disclosed maturity analysis (UNDISCOUNTED): <strong>₹43,20,000</strong> due within 1 year, <strong>₹41,60,000</strong> due in 1-2 years – an IDENTICAL calculation methodology to IFRS 7.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 6 – MARKET RISK & SENSITIVITY ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Market Risk &amp; Sensitivity Analysis</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical mandatory sensitivity analysis to IFRS 7</div>
        <div class="text-supporting">For EACH type of market risk, Ind AS 107 requires sensitivity analysis showing the effect of reasonably possible changes in the relevant risk variable on profit/loss and equity – IDENTICAL requirement to IFRS 7, commonly applied by Indian companies to interest rate risk on floating-rate borrowings and foreign currency risk given India's significant import/export exposure.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 – RBI'S REGULATORY ROLE (worked example) ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>RBI's Regulatory Role for Banks and NBFCs (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A parallel prudential disclosure framework</div>
        <div class="principle">The Reserve Bank of India prescribes DETAILED prudential disclosure norms for banks and NBFCs – including capital adequacy (Basel III-aligned), asset classification and provisioning (NPA norms), and specific format requirements for financial statements under the Banking Regulation Act, 1949 and RBI Master Directions. These operate ALONGSIDE Ind AS 107's own disclosures, similar in spirit to IRDAI's role for insurers.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: RBI vs Ind AS 107 disclosure layers for a bank</div>
          <div class="wk-body">An Indian scheduled commercial bank prepares its annual report with Ind AS 107's credit/liquidity/market risk disclosures, PLUS RBI-mandated Basel III Pillar 3 disclosures and asset quality (NPA) disclosures under RBI's prudential norms.</div>
          <div class="wk-answer">BOTH disclosure sets are required SIMULTANEOUSLY – Ind AS 107 governs the ACCOUNTING STANDARD-based disclosures, while RBI's prudential framework governs SUPERVISORY, capital-adequacy-focused disclosures – a genuinely India-specific dual reporting burden for financial sector entities, with NO direct single-standard equivalent in a typical IFRS 7 jurisdiction (though comparable prudential regimes, e.g. Basel III itself, exist globally alongside IFRS 7 too).</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 – FAIR VALUE HIERARCHY ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>The Fair Value Hierarchy</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical three-level hierarchy to IFRS 7/IFRS 13</div>
        <div class="text-supporting">Level 1 (quoted prices), Level 2 (observable inputs), Level 3 (unobservable inputs) – IDENTICAL to IFRS 7/IFRS 13, with Ind AS 113 (the Ind AS equivalent of IFRS 13) supplying the underlying fair value measurement framework.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IFRS 7</div>
        <div class="check-list">
          <span>Carrying amounts by category, net gains/losses, interest income/expense</span>
          <span>Credit risk exposure, ECL staging, concentration</span>
          <span>Liquidity risk maturity analysis</span>
          <span>Market risk sensitivity analysis</span>
          <span>Fair value hierarchy classification and Level 3 reconciliation</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Fair value hierarchy classification – identical to IFRS 7</span>
              <span>Reasonably possible market risk variable changes for sensitivity analysis</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Level 3 unobservable inputs</span>
              <span>Undiscounted contractual cash flow projections</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">For Indian banks/NBFCs, reconciling Ind AS 107's ECL-based disclosures with RBI's separate NPA/provisioning norms requires careful navigation of TWO PARALLEL, not always perfectly aligned, credit risk frameworks.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 – IND AS 107 vs IFRS 7 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 107 vs IFRS 7 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS 7</span><span>Ind AS 107</span></div>
          <div class="tr cols-12-1-1"><span>Core disclosure requirements</span><span>Significance, credit/liquidity/market risk, fair value hierarchy</span><span>IDENTICAL – no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Regulatory overlay for banks/NBFCs</span><span>Varies by jurisdiction, typically Basel-aligned local prudential rules</span><span>RBI's extensive prudential disclosure framework (Basel III, NPA norms) operates ALONGSIDE Ind AS 107</span></div>
          <div class="tr cols-12-1-1"><span>Effective date for Indian banks</span><span>N/A (global)</span><span>Ind AS applicability to banks was PHASED and, for some categories, further deferred relative to corporates generally – a genuinely Indian sequencing feature</span></div>
        </div>
        <div class="note">Ind AS 107's accounting DISCLOSURE requirements are essentially IDENTICAL to IFRS 7 – the meaningful Indian context lies in the PARALLEL regulatory (RBI) disclosure regime for the financial sector, and the PHASED implementation timeline for banks specifically.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every Ind AS 107 disclosure lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Disclosure item</span><span>Location</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Carrying amounts by category, net gains/losses</span><span><span class="badge bp">Notes</span></span><span>Identical to IFRS 7</span></div>
          <div class="tr alt cols-16-1-14"><span>Credit/liquidity/market risk disclosures</span><span><span class="badge bp">Notes</span></span><span>Identical to IFRS 7</span></div>
          <div class="tr cols-16-1-14"><span>Fair value hierarchy</span><span><span class="badge bp">Notes</span></span><span>Identical to IFRS 7/13</span></div>
          <div class="tr alt cols-16-1-14"><span>RBI prudential disclosures (banks/NBFCs)</span><span><span class="badge bp">Basel III Pillar 3 Report</span></span><span>Parallel, separate regulatory disclosure, not part of Ind AS 107 itself</span></div>
        </div>
        <div class="note">Ind AS 107 is entirely a DISCLOSURE standard, identical in structure to IFRS 7.</div>
      </div>
    </div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 7</span><span>The GLOBAL counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 109</span><span>Supplies the recognition/measurement/impairment rules Ind AS 107 discloses</span></div>
          <div class="tr cols-08-2"><span>Ind AS 113</span><span>Supplies the fair value hierarchy framework</span></div>
          <div class="tr alt cols-08-2"><span>Banking Regulation Act, 1949 / RBI Master Directions</span><span>Supplies the PARALLEL prudential disclosure framework for banks and NBFCs</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">NPA (Non-Performing Asset)</div><div class="glossary-def">RBI's regulatory classification for a loan/advance in default, subject to specific provisioning norms operating alongside (and interacting with) Ind AS 109's ECL model.</div></div>
        <div class="glossary-item"><div class="glossary-term">Basel III Pillar 3</div><div class="glossary-def">The international banking regulatory framework's market discipline disclosure pillar, implemented by RBI for Indian banks alongside Ind AS 107.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Credit risk / Liquidity risk / Market risk", definition: "IDENTICAL definitions to IFRS 7." },
      { term: "RBI", definition: "Reserve Bank of India – India's central bank and banking/NBFC regulator, prescribing its own extensive prudential disclosure requirements alongside Ind AS 107." },
      { term: "NPA (Non-Performing Asset)", definition: "RBI's regulatory classification for a loan/advance in default, subject to specific provisioning norms operating alongside (and interacting with) Ind AS 109's ECL model." },
      { term: "Basel III Pillar 3", definition: "The international banking regulatory framework's market discipline disclosure pillar, implemented by RBI for Indian banks alongside Ind AS 107." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
