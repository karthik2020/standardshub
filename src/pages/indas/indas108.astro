---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas108.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Identifying Operating Segments" },
        { id: "s4", label: "Aggregation of Segments" },
        { id: "s5", label: "Quantitative Thresholds — 10% Tests" },
        { id: "s6", label: "75% Reporting Sufficiency Test" },
        { id: "s7", label: "Schedule III Interaction" },
        { id: "s8", label: "Entity-Wide Disclosures" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 108 vs IFRS 8 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical management approach philosophy to IFRS 8</div>
        <div class="principle">Ind AS 108 applies the IDENTICAL "management approach" as IFRS 8 — segments are defined by how the entity is ACTUALLY organised and managed internally (via reports reviewed by the Chief Operating Decision Maker), not an externally imposed classification, DIRECTLY carrying forward IFRS 8's own rationale into the Indian context.</div>
        <div class="elabel">HOW IND AS 108 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Relevance</strong> — reporting segments the way management actually monitors them — IDENTICAL to IFRS 8</span>
          <span><strong>Cost constraint</strong> — segment information derived from data management already produces internally — IDENTICAL to IFRS 8</span>
          <span><strong>CODM identification in Indian corporate structures</strong> — for many Indian companies (particularly those with a managing director or promoter-led executive structure), identifying the CODM function requires the SAME judgement-based analysis as under IFRS 8, though Indian corporate governance conventions (e.g. the Board's role under the Companies Act, 2013) sometimes inform this identification</span>
        </div>
        <div class="note">Ind AS 108 does NOT introduce any INDIA-SPECIFIC segment identification concept — the management approach, CODM concept, and quantitative thresholds are reproduced essentially verbatim from IFRS 8.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Measurement principles — identical to IFRS 8</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Framework concept</span><span>Ind AS 108's application</span></div>
          <div class="tr cols-13-1"><span>Measurement basis</span><span>WHATEVER basis management uses internally — may differ from Ind AS, IDENTICAL to IFRS 8</span></div>
          <div class="tr alt cols-13-1"><span>Reconciliation requirement</span><span>Mandatory, IDENTICAL to IFRS 8</span></div>
        </div>
        <div class="callout info callout--flush">No substantive divergence exists on measurement principles.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 108 covers</div>
        <div class="principle">Ind AS 108 applies to entities with publicly traded debt/equity, or filing to issue such instruments — IDENTICAL scope trigger to IFRS 8.</div>
        <div class="note">Many LARGE unlisted Indian companies (e.g. certain NBFCs, or companies required to apply Ind AS due to net worth thresholds) MAY still voluntarily or be otherwise required to disclose segment information depending on specific listing/debt circumstances.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Operating segment</div><div class="glossary-def">IDENTICAL definition to IFRS 8 — a component with revenue/expenses, regularly reviewed by the CODM, with discrete financial information available.</div></div>
        <div class="glossary-item"><div class="glossary-term">Schedule III (Companies Act, 2013)</div><div class="glossary-def">The statutory format prescribing the general structure of Indian companies' financial statements, operating alongside (and requiring consistency with) Ind AS 108's segment disclosures where applicable.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — IDENTIFYING OPERATING SEGMENTS ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Identifying Operating Segments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical three-part test to IFRS 8</div>
        <div class="principle">A component qualifies as an operating segment ONLY if it: engages in revenue-generating business activities; has results regularly reviewed by the CODM; and has discrete financial information available — IDENTICAL to IFRS 8's own definition, with no Indian-specific modification.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — AGGREGATION ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Aggregation of Segments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical five-factor test to IFRS 8</div>
        <div class="text-supporting">Segments may be aggregated if similar in nature of products/services, production processes, customer type, distribution methods, and regulatory environment — IDENTICAL five-factor test to IFRS 8.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 — QUANTITATIVE THRESHOLDS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>The Quantitative Thresholds — 10% Tests (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical three tests to IFRS 8</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: An Indian conglomerate's segment threshold test</div>
          <div class="wk-body">An Indian group has 4 segments. Segment revenues: Textiles ₹120 crore, Chemicals ₹300 crore, Logistics ₹40 crore, Real Estate ₹90 crore. Combined revenue = ₹550 crore.</div>
          <div class="wk-answer">10% threshold = ₹55 crore. Textiles (₹120 crore), Chemicals (₹300 crore), and Real Estate (₹90 crore) all EXCEED this and are REPORTABLE. Logistics (₹40 crore) does NOT meet the revenue test alone (though it may still qualify via the profit/loss or assets tests, or via the 75% sufficiency test) — an IDENTICAL analysis to how IFRS 8 would apply.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 6 — 75% TEST ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>The 75% Reporting Sufficiency Test</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical backstop to IFRS 8</div>
        <div class="text-supporting">If reportable segments' total external revenue is LESS THAN 75% of total consolidated external revenue, additional segments must be added until 75% is reached — IDENTICAL to IFRS 8.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — SCHEDULE III ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Schedule III Interaction</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Consistency with the overall financial statement format</div>
        <div class="text-supporting">Schedule III of the Companies Act, 2013 prescribes the GENERAL format for Indian companies' Balance Sheet and Statement of Profit and Loss (classification of assets/liabilities, line item requirements) — Ind AS 108's segment disclosures are presented CONSISTENTLY with, but as a SEPARATE note disclosure alongside, this prescribed general format. This is a purely PRESENTATIONAL interaction, not a substantive difference in HOW segments are identified or measured.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — ENTITY-WIDE DISCLOSURES ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Entity-Wide Disclosures</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical backstop disclosures to IFRS 8</div>
        <div class="text-supporting">Revenue by product/service, geographical revenue/non-current asset split (India domicile vs foreign), and major customer concentration (10%+ of revenue) — IDENTICAL requirements to IFRS 8, applying regardless of the entity's own internal segment structure.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IFRS 8</div>
        <div class="check-list">
          <span>Factors used to identify reportable segments; products/services by segment</span>
          <span>Segment revenue, profit/loss, assets, liabilities (as reported to the CODM)</span>
          <span>Reconciliation of segment totals to consolidated Ind AS totals</span>
          <span>Entity-wide product/geographical/major customer disclosures</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Identifying the CODM function correctly in complex Indian promoter-led/board structures</span>
              <span>Whether operating segments meet the aggregation criteria</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Allocating shared/corporate costs between segments</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">In Indian promoter-controlled group structures, identifying the CODM can require careful analysis of WHO genuinely reviews segment performance for resource allocation — sometimes the promoter/managing director individually, sometimes a formal management committee.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 108 vs IFRS 8 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 108 vs IFRS 8 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS 8</span><span>Ind AS 108</span></div>
          <div class="tr cols-12-1-1"><span>Management approach</span><span>CODM-based internal reporting</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>10% thresholds &amp; 75% test</span><span>Standard mechanics</span><span>IDENTICAL</span></div>
          <div class="tr cols-12-1-1"><span>General financial statement format interaction</span><span>Varies by local company law</span><span>Schedule III of the Companies Act, 2013 governs overall statement FORMAT, with segment notes presented consistently alongside it</span></div>
          <div class="tr alt cols-12-1-1"><span>Terminology</span><span>"Operating segments," IFRS</span><span>Same terminology; "Balance Sheet"/"Statement of Profit and Loss" per Companies Act conventions</span></div>
        </div>
        <div class="note">Ind AS 108 is one of the MOST closely converged Ind AS standards — essentially IDENTICAL accounting substance to IFRS 8, with the only meaningful Indian context being the interaction with Schedule III's general presentation format, not the segment identification methodology itself.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every Ind AS 108 disclosure lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Disclosure item</span><span>Location</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Segment revenue, profit/loss, assets, liabilities</span><span><span class="badge bp">Notes</span></span><span>May use non-Ind AS internal measures</span></div>
          <div class="tr alt cols-16-1-14"><span>Reconciliation to consolidated totals</span><span><span class="badge bp">Notes</span></span><span>Mandatory bridging disclosure</span></div>
          <div class="tr cols-16-1-14"><span>Entity-wide disclosures</span><span><span class="badge bp">Notes</span></span><span>Required regardless of segment structure</span></div>
        </div>
        <div class="note">Like IFRS 8, Ind AS 108 is entirely a DISCLOSURE standard.</div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 8</span><span>The GLOBAL counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Schedule III (Companies Act, 2013)</span><span>Governs the general financial statement format Ind AS 108's disclosures sit alongside</span></div>
          <div class="tr cols-08-2"><span>Ind AS 105</span><span>Segments must be identified for held-for-sale/discontinued operations</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Schedule III</div><div class="glossary-def">The statutory format under the Companies Act, 2013 prescribing the general structure of Indian companies' financial statements.</div></div>
        <div class="glossary-item"><div class="glossary-term">CODM</div><div class="glossary-def">Chief Operating Decision Maker — a function, not necessarily a specific title, identical concept to IFRS 8.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Operating segment", definition: "IDENTICAL definition to IFRS 8 — a component with revenue/expenses, regularly reviewed by the CODM, with discrete financial information available." },
      { term: "Schedule III (Companies Act, 2013)", definition: "The statutory format prescribing the general structure of Indian companies' financial statements, operating alongside (and requiring consistency with) Ind AS 108's segment disclosures where applicable." },
      { term: "Schedule III", definition: "The statutory format under the Companies Act, 2013 prescribing the general structure of Indian companies' financial statements." },
      { term: "CODM", definition: "Chief Operating Decision Maker — a function, not necessarily a specific title, identical concept to IFRS 8." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
