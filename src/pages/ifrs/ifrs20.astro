---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ifrs/ifrs20.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "Differences in Timing — The Core Concept" },
        { id: "s4", label: "Total Allowed Compensation" },
        { id: "s5", label: "Recognition of Regulatory Assets & Liabilities" },
        { id: "s6", label: "Measurement — The Cash-Flow-Based Technique" },
        {
          id: "s7",
          label: "The 'Overlay' Approach — How IFRS 20 Works with IFRS 15",
        },
        { id: "s8", label: "Sectors Most Affected" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "IFRS 20 vs IFRS 14 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">
    <div class="section-header" id="s1">
      <span class="num">1</span><h2>Conceptual Framework Linkage</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Closing a genuine, long-standing IFRS gap</div>
        <div class="principle">
          IFRS 20 fills a gap IFRS has lacked COMPREHENSIVE guidance on: when a
          company is subject to RATE REGULATION (a regulator determines how much
          and WHEN it can charge customers), a mismatch can arise between when
          goods/services are SUPPLIED and when the related COMPENSATION is
          actually charged to customers under the regulatory agreement — IFRS 15
          revenue alone may NOT fully reflect the company's performance for the
          period. IFRS 20 requires recognising the TOTAL ALLOWED COMPENSATION
          for regulatory goods/services in the SAME period they are supplied,
          using regulatory assets/liabilities to bridge any timing gap.
        </div>
        <div class="elabel">HOW IFRS 20 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span
            ><strong>Faithful representation</strong> — aligning recognised income
            with the ECONOMIC entitlement the regulatory agreement creates, rather
            than only the cash-timing-driven IFRS 15 revenue figure</span
          >
          <span
            ><strong>Comparability</strong> — a SINGLE comprehensive model REDUCES
            the diversity in practice that previously existed across rate-regulated
            companies globally</span
          >
        </div>
        <div class="note">
          IFRS 20 is NOT sector-specific and, unlike IFRS 14, is NOT optional —
          any company meeting its scope criteria MUST apply it, a significant
          difference from its narrow, elective predecessor.
        </div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">
          The core principle — identical across the standard
        </div>
        <div class="formula-box">
          <div class="f-eq">
            Recognise TOTAL ALLOWED COMPENSATION for regulatory goods/services
            in the SAME period they are supplied — bridging any timing gap via
            regulatory assets/liabilities
          </div>
        </div>
        <div class="callout info callout--flush">
          This is an "OVERLAY" onto existing standards — IFRS 15 revenue is
          recognised FIRST, then IFRS 20 regulatory income/expense adjusts the
          total to match allowed compensation.
        </div>
      </div>
    </div>

    <div class="section-header" id="s2">
      <span class="num">2</span><h2>Scope & Definitions</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRS 20 covers</div>
        <div class="principle">
          IFRS 20 applies where:
          <ol>
            <li>the company and a regulator are party
              to an agreement PRESCRIBING the regulated rate the company can charge
              customers, and</li>
            <li>part of the total allowed compensation for
              goods/services delivered in ONE period is charged to customers in a
              DIFFERENT period — creating timing differences.</li>
          </ol>
          Effective 1 January
          2029, MANDATORY (not optional) for entities meeting scope criteria,
          superseding IFRS 14.
        </div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Difference in timing</div><div
            class="glossary-def"
          >
            Part or all of the total allowed compensation for regulatory
            goods/services supplied in ONE period is included in regulated rates
            charged to customers in a DIFFERENT period.
          </div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Total allowed compensation</div><div
            class="glossary-def"
          >
            The total amount the company is ENTITLED to earn for regulatory
            goods/services supplied in a period, per the regulatory agreement —
            the standard's central benchmark concept.
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s3">
      <span class="num">3</span><h2>
        Differences in Timing — The Core Concept
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">
          The engine driving regulatory asset/liability recognition
        </div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">
            Example 1: An under-recovery creating a regulatory asset
          </div>
          <div class="wk-body">
            A power distribution utility incurs $50 million of ELIGIBLE costs
            during the year that its regulatory agreement allows it to recover,
            but the applicable tariff formula only permits it to charge
            customers $35 million in the CURRENT year, with the remaining $15
            million recoverable through HIGHER tariffs in future years.
          </div>
          <div class="wk-answer">
            The $15 million shortfall represents a DIFFERENCE IN TIMING — the
            company has an ENFORCEABLE present right to add this amount to
            future regulated rates, so it recognises a REGULATORY ASSET of $15
            million (discounted at the regulatory interest rate) and
            corresponding REGULATORY INCOME, ensuring TOTAL income recognised
            for the period ($35 million IFRS 15 revenue + $15 million regulatory
            income = $50 million) matches the TOTAL allowed compensation
            actually earned.
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4">
      <span class="num">4</span><h2>Total Allowed Compensation</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">The standard's central benchmark</div>
        <div class="text-supporting">
          IFRS 20 provides guidance on the MOST COMMON types of
          compensation/deductions specified in regulatory agreements (e.g.
          recovery of specific costs, a return on a regulatory capital base,
          performance incentives/penalties) to help entities correctly identify
          what the total allowed compensation for a period actually comprises.
        </div>
      </div>
    </div>

    <div class="section-header" id="s5">
      <span class="num">5</span><h2>
        Recognition of Regulatory Assets & Liabilities
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">
          Enforceable rights and obligations, all recognised
        </div>
        <div class="text-supporting">
          A REGULATORY ASSET is recognised when the entity has an ENFORCEABLE
          present right to ADD an amount to future regulated rates; a REGULATORY
          LIABILITY when it has an enforceable present OBLIGATION to DEDUCT an
          amount from future regulated rates. IFRS 20 requires recognition of
          ALL regulatory assets/liabilities existing at the reporting date,
          subject to a SPECIFIC recognition criterion for those arising from
          regulatory depreciation of a regulatory capital base.
        </div>
      </div>
    </div>

    <div class="section-header" id="s6">
      <span class="num">6</span><h2>
        Measurement — The Cash-Flow-Based Technique
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">
          A discounted cash flow approach, regulatory-rate-anchored
        </div>
        <div class="text-supporting">
          Regulatory assets/liabilities are MEASURED using a cash-flow-based
          technique — estimating the FUTURE cash flows arising from recovery of
          a regulatory asset (or fulfilment of a regulatory liability),
          DISCOUNTED using the REGULATORY INTEREST RATE specified in the
          regulatory agreement for that specific balance, rather than a general
          market discount rate.
        </div>
      </div>
    </div>

    <div class="section-header" id="s7">
      <span class="num">7</span><h2>
        The 'Overlay' Approach — How IFRS 20 Works with IFRS 15
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely distinctive structural feature</div>
        <div class="text-supporting">
          IFRS 20 does NOT replace IFRS 15 revenue recognition — it operates as
          an "OVERLAY." A company FIRST applies IFRS 15 (and other relevant
          standards) NORMALLY, then LAYERS ON TOP any regulatory income/expense
          arising from differences in timing, adjusting the total reported
          income/expense to match the total allowed compensation actually earned
          in the period. Recognition of a regulatory asset/liability has NO
          impact on cash flows — it is a purely accrual-based bridging
          mechanism.
        </div>
      </div>
    </div>

    <div class="section-header" id="s8">
      <span class="num">8</span><h2>Sectors Most Affected</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">
          Where IFRS 20 will have the greatest practical impact
        </div>
        <div class="text-supporting">
          IFRS 20 mainly affects entities in industries such as ELECTRICITY,
          GAS, WATER, and TRANSPORTATION that are subject to rate regulation —
          sectors where tariff true-up mechanisms and cost recovery timing
          differences from regulators are an established operational feature.
          The IASB's own Effects Analysis notes companies in these sectors
          should expect changes to key financial metrics such as EBITDA, working
          capital, and return on assets once IFRS 20 is adopted.
        </div>
      </div>
    </div>

    <div class="section-header" id="s9">
      <span class="num">9</span><h2>Disclosure</h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Key disclosure requirements</div>
        <div class="check-list">
          <span>Nature of the regulatory agreement(s) and associated risks</span
          >
          <span
            >Reconciliation of opening/closing regulatory asset and liability
            balances</span
          >
          <span
            >Regulatory income and regulatory expense recognised in the period</span
          >
          <span
            >Regulatory interest rates and other key assumptions used in
            measurement</span
          >
        </div>
      </div>
    </div>

    <div class="section-header" id="s10">
      <span class="num">10</span><h2>Critical Judgments & Estimates</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span
                >Whether an enforceable present right/obligation genuinely
                exists under the regulatory agreement</span
              >
              <span
                >Identifying what comprises "total allowed compensation" for
                complex tariff formulas</span
              >
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span
                >Future cash flows arising from regulatory asset
                recovery/liability fulfilment</span
              >
              <span
                >Appropriate regulatory interest rate where not explicitly
                specified</span
              >
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">
          The IASB's own Effects Analysis notes that around 40% of fieldwork
          participants expect IFRS 20 to IMPACT debt covenants — a genuinely
          significant transition consideration for rate-regulated companies
          globally.
        </div>
      </div>
    </div>

    <div class="section-header" id="s11">
      <span class="num">11</span><h2>
        IFRS 20 vs IFRS 14 — Full Comparison
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1">
            <span>Feature</span><span>IFRS 14 (superseded)</span><span
              >IFRS 20 (from 2029)</span>
          </div>
          <div class="tr cols-12-1-1">
            <span>Applicability</span><span
              >OPTIONAL, first-time-adopter-only, narrow scope</span
            ><span
              >MANDATORY for ALL entities meeting scope criteria — no election</span>
          </div>
          <div class="tr alt cols-12-1-1">
            <span>Recognition model</span><span
              >Continuation of previous GAAP policy (if any)</span
            ><span
              >COMPREHENSIVE new recognition/measurement model for ALL
              rate-regulated entities</span>
          </div>
          <div class="tr cols-12-1-1">
            <span>Effective date</span><span>Applied since IFRS adoption</span
            ><span>1 January 2029, replacing IFRS 14 entirely</span>
          </div>
        </div>
        <div class="note">
          IFRS 20 represents a comprehensive overhaul of rate-regulated activity
          accounting — moving from IFRS 14's narrow, rarely-elected transitional
          relief toward a mandatory model bringing tariff timing differences
          onto the balance sheet for every affected entity.
        </div>
      </div>
    </div>

    <div class="section-header" id="s12">
      <span class="num">12</span><h2>Statement Mapping</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every IFRS 20 item lands</div>
        <div class="td-table">
          <div class="th cols-16-1-14">
            <span>Item</span><span>Statement(s) affected</span><span
              >Notes</span>
          </div>
          <div class="tr cols-16-1-14">
            <span>Regulatory asset/liability</span><span
              ><span class="badge bs">SOFP</span></span
            ><span
              >Presented separately, discounted at the regulatory interest rate</span>
          </div>
          <div class="tr alt cols-16-1-14">
            <span>Regulatory income/expense</span><span
              ><span class="badge bp">SOPL</span></span
            ><span
              >Presented separately from IFRS 15 revenue, bridging to total
              allowed compensation</span>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s13">
      <span class="num">13</span><h2>Related Standards</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2">
            <span>Standard</span><span>Connection</span>
          </div>
          <div class="tr cols-08-2">
            <span>IFRS 14</span><span
              >The narrow, optional predecessor standard IFRS 20 supersedes</span>
          </div>
          <div class="tr alt cols-08-2">
            <span>IFRS 15</span><span
              >Applied FIRST, with IFRS 20 operating as an overlay adjusting to
              total allowed compensation</span>
          </div>
          <div class="tr cols-08-2">
            <span>IFRS 9</span><span
              >Governs measurement of any related financial instrument
              components arising from regulatory arrangements</span>
          </div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Regulatory interest rate</div><div
            class="glossary-def"
          >
            The discount rate SPECIFIED in the regulatory agreement itself, used
            to measure the related regulatory asset/liability.
          </div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Regulatory capital base (RCB)</div><div
            class="glossary-def"
          >
            The asset base on which a rate-regulated entity earns an allowed
            return, relevant to regulatory depreciation recognition criteria.
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s14">
      <span class="num">14</span><h2>Glossary</h2><span class="line"></span>
    </div>
    <Glossary
      entries={[
        {
          term: "Regulatory interest rate",
          definition:
            "The discount rate specified in the regulatory agreement itself, used to measure the related regulatory asset/liability.",
        },
        {
          term: "Regulatory capital base (RCB)",
          definition:
            "The asset base on which a rate-regulated entity earns an allowed return.",
        },
        {
          term: "Difference in timing",
          definition:
            "Part or all of the total allowed compensation for regulatory goods/services supplied in one period is included in regulated rates charged in a different period.",
        },
        {
          term: "Total allowed compensation",
          definition:
            "The total amount the company is entitled to earn for regulatory goods/services supplied in a period.",
        },
      ]}
    />

    <FinancialStatementKey />
  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRS20} />
  </section>
</StandardPageLayout>
