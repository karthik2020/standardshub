---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/asbe/asbe39.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — a Unified Framework Across All of ASBE" },
        { id: "s3", label: "Fair Value Defined — an Exit Price Notion" },
        { id: "s4", label: "The Three-Level Fair Value Hierarchy" },
        { id: "s5", label: "The Principal (or Most Advantageous) Market" },
        { id: "s6", label: "Highest and Best Use for Non-Financial Assets" },
        { id: "s7", label: "Unifying Previously Scattered Guidance" },
        { id: "s8", label: "Worked Example — Classifying a Level 1 Measurement" },
        { id: "s9", label: "Worked Example — Classifying a Level 3 Measurement" },
        { id: "s10", label: "Disclosure Requirements" },
        { id: "s11", label: "Critical Judgments &amp; Estimates" },
        { id: "s12", label: "Relationship to IFRS 13" },
        { id: "s13", label: "Statement Mapping" },
        { id: "s14", label: "Related Standards" },
        { id: "s15", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">A single, consistent fair value methodology across ASBE</div><div class="principle">ASBE No. 39 establishes a SINGLE, unified DEFINITION and MEASUREMENT hierarchy for "FAIR VALUE" APPLICABLE across EVERY other ASBE standard that REQUIRES a fair VALUE measurement — CLOSELY converged with IFRS 13 internationally, REPLACING what was PREVIOUSLY scattered fair VALUE guidance ACROSS individual ASBE standards.</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — a Unified Framework Across All of ASBE</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Applies wherever another ASBE standard requires fair value measurement</div><div class="principle">This Standard applies WHEREVER another ASBE standard REQUIRES (or PERMITS) a fair VALUE measurement — INCLUDING investment PROPERTY (ASBE No. 3), biological ASSETS (ASBE No. 5), non-MONETARY exchanges (ASBE No. 7), business COMBINATIONS (ASBE No. 20), and FINANCIAL instruments (ASBE No. 22).</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Fair Value Defined — an Exit Price Notion</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">The price to sell an asset or transfer a liability</div><div class="text-supporting">FAIR value is DEFINED as the PRICE that WOULD be RECEIVED to SELL an asset, or PAID to TRANSFER a liability, in an ORDERLY transaction BETWEEN market PARTICIPANTS at the MEASUREMENT date — a GENUINE "EXIT price" notion, DIRECTLY mirroring IFRS 13'S own DEFINITION internationally.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>The Three-Level Fair Value Hierarchy</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Prioritising observable market inputs over unobservable estimates</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.6fr 2.4fr;"><span>Level</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:0.6fr 2.4fr;"><span>Level 1</span><span>QUOTED prices in ACTIVE markets for IDENTICAL assets/liabilities</span></div>
<div class="tr alt" style="grid-template-columns:0.6fr 2.4fr;"><span>Level 2</span><span>OBSERVABLE inputs OTHER than quoted PRICES</span></div>
<div class="tr" style="grid-template-columns:0.6fr 2.4fr;"><span>Level 3</span><span>UNOBSERVABLE inputs, USED only when OBSERVABLE market data is NOT available</span></div>
</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>The Principal (or Most Advantageous) Market</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Measuring based on the market with the greatest volume and activity</div><div class="text-supporting">FAIR value is MEASURED based on the PRICE in the PRINCIPAL market for the ASSET or LIABILITY (the MARKET with the GREATEST volume and LEVEL of activity) — or, in the ABSENCE of a PRINCIPAL market, the MOST ADVANTAGEOUS market (MAXIMISING the AMOUNT received for an ASSET, or MINIMISING the amount PAID to transfer a LIABILITY).</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Highest and Best Use for Non-Financial Assets</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Valuing an asset based on its optimal use by market participants</div><div class="text-supporting">FOR non-FINANCIAL assets, FAIR value MEASUREMENT considers a MARKET participant's ABILITY to GENERATE economic BENEFITS through the ASSET'S "HIGHEST and BEST use" — WHICH may DIFFER from the ASSET'S current USE by the REPORTING entity ITSELF.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Unifying Previously Scattered Guidance</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A single reference point, replacing standard-by-standard fair value rules</div><div class="text-supporting">BEFORE this Standard, FAIR value measurement GUIDANCE was SCATTERED across the INDIVIDUAL ASBE standards that HAPPENED to require IT — WITHOUT a SINGLE, consistent DEFINITION or HIERARCHY applicable UNIFORMLY across ALL of them. ASBE No. 39 CONSOLIDATED this into ONE unified reference FRAMEWORK — CLOSELY paralleling how IFRS 13 ITSELF consolidated SCATTERED fair value GUIDANCE internationally.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — Classifying a Level 1 Measurement</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">The highest-quality fair value input</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Listed equity securities</div><div class="wk-body">A company holds shares in a company listed on the Shanghai Stock Exchange, with a readily available, actively traded quoted market price.</div><div class="wk-answer">This is classified as a <strong>LEVEL 1</strong> fair value MEASUREMENT — the QUOTED market PRICE for an IDENTICAL asset in an ACTIVE market PROVIDES the HIGHEST-quality, MOST directly observable FAIR value input AVAILABLE.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Classifying a Level 3 Measurement</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Relying on unobservable inputs</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: An unlisted equity investment</div><div class="wk-body">A company holds a small equity stake in an unlisted start-up, with no observable market price, relying on a discounted cash flow model based on internal projections.</div><div class="wk-answer">This is classified as a <strong>LEVEL 3</strong> fair value MEASUREMENT — RELYING on GENUINELY unobservable INPUTS, requiring the GREATEST degree of JUDGEMENT among the THREE hierarchy levels.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What ASBE No. 39 requires</div><div class="check-list"><span>Fair value hierarchy level for each class of asset/liability measured at fair value</span><span>Valuation techniques and significant unobservable inputs used for Level 3 measurements</span><span>Transfers between hierarchy levels during the period</span></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Correctly classifying a fair value measurement within the appropriate hierarchy level</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Unobservable inputs and valuation model assumptions used for Level 3 measurements</span></div></div></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IFRS 13</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASBE 39 vs IFRS 13</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASBE 39</span><span style="color:var(--color-text-info);">IFRS 13</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Fair value definition</span><span>Exit price notion</span><span>Exit price notion — converged</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Hierarchy structure</span><span>Three levels</span><span>Three levels — converged</span></div>
</div>
<div class="note">A GENUINELY thoroughly CONVERGED standard — ONE of the MOST closely ALIGNED, UNIFIED measurement FRAMEWORKS within the ENTIRE ASBE suite.</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every fair value measurement lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Any fair value measurement</span><span>Varies by underlying item</span><span>The methodology is uniform; the effect follows the item's own governing standard</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASBE No. 22</span><span>Recognition and Measurement of Financial Instruments — a primary consumer of this Standard's fair value framework</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASBE No. 20</span><span>Business Combinations — relies on this Standard's methodology for acquisition accounting</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Fair value hierarchy</div><div class="glossary-def">A three-level classification, from observable to unobservable inputs, indicating the reliability of a fair value measurement.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Principal market</div><div class="glossary-def">The market with the greatest volume and level of activity for a particular asset or liability, forming the basis for fair value measurement.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (Chinese GAAP / ASBE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet (资产负债表) </div><div class="litem"><span class="badge bp">IS</span> Income Statement (利润表) </div><div class="litem"><span class="badge be">SCOE</span> Statement of Changes in Owners' Equity (所有者权益变动表) </div><div class="litem"><span class="badge bc">CFS</span> Cash Flow Statement (现金流量表)</div></div></div>


</div>
  <section id="history">
    <HistoryTimeline items={history.asbe39 || []} />
  </section>
</StandardPageLayout>
