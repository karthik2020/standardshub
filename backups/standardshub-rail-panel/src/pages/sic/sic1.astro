---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/sic/sic1.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-1 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-1 was withdrawn in March 2003 when the IASB issued a revised IAS 2 Inventories, which incorporated the consistency requirement directly into the standard and eliminated the need for the interpretation."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ias/ias2"
    linkText="IAS 2 Inventories"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-1 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-1 addressed</div>
        <div class="principle">SIC-1 addressed whether an entity could use different cost formulas for inventories with similar nature and use, or whether consistency was required simply because inventories were held in different locations or subject to different tax rules. It sought to clarify the scope of the consistency requirement in IAS 2.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-1 concluded that different cost formulas may only be used when they are appropriate to the specific circumstances of the inventories. Inventories with similar nature and use must be accounted for on a consistent basis, regardless of their location or the tax rules that apply to them. A change in cost formula is only acceptable when there is a genuine change in the nature or use of the inventories.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IAS 2 Inventories</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2003 revision of IAS 2 incorporated the consistency requirement directly into the standard</span></div>
          <div class="tr"><span>Current status</span><span>Withdrawn</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Cost formulas", definition: "The systematic allocation of the cost of inventories to specific items, such as FIFO, weighted average cost, or specific identification." },
      { term: "Consistency", definition: "The requirement that an entity apply the same accounting policies to similar transactions and events from one period to the next." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC1} />
  </section>
</StandardPageLayout>
