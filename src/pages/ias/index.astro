---
import StandardLayout from "../../layouts/StandardLayout.astro";
import standards from "../../data/standards.json";

const groupedIAS = /** @type {Record<string, any[]>} */ ({});

for (const item of standards.IAS) {

  const category = item.category;

  if (!groupedIAS[category]) {
    groupedIAS[category] = [];
  }

  groupedIAS[category].push(item);
}
---

<StandardLayout code="IAS" title="International Accounting Standards (IAS)" framework="IAS">

  <h1>International Accounting Standards</h1>

  <p class="category-description">
    International Accounting Standards (IAS) are a set of accounting principles issued by the IASB,
    covering topics such as revenue recognition, inventory valuation, and financial statement presentation.
  </p>

  <div class="view-toggle">

    <button id="btn-number" class="active" aria-pressed="true" aria-controls="number-view">
      Standard Number
    </button>

    <button id="btn-category" aria-pressed="false" aria-controls="category-view">
      Category
    </button>

  </div>

  <div id="number-view">

    <div class="standards-group">
      <h2 class="standards-group-title">Active Standards</h2>
      <div class="standards-grid">

        {
          standards.IAS.filter((item) => !item.status).map((item) => (

            <a href={item.url} class="standard-card">

              <div class="standard-code">
                {item.code}
              </div>

              <div class="standard-title">
                {item.title}
              </div>

            </a>

          ))
        }

      </div>
    </div>

    <div class="standards-divider"></div>

    <div class="standards-group">
      <h2 class="standards-group-title">Historical Standards</h2>
      <div class="standards-grid">

        {
          standards.IAS.filter((item) => item.status).map((item) => (

            <a href={item.url} class="standard-card">

              <div class="standard-code">
                {item.code}
              </div>

              <div class="standard-title">
                {item.title}
              </div>

              {item.status && (
                <div class="standard-status">
                  {item.status}
                </div>
              )}

            </a>

          ))
        }

      </div>
    </div>

  </div>

  <div id="category-view" style="display:none;">

    {
      Object.entries(groupedIAS).map(
        ([category, items]) => {

          const activeItems = items.filter((item) => !item.status);
          const historicalItems = items.filter((item) => item.status);

          return (
            <div class="category-group">

              <h2>{category}</h2>

              {activeItems.length > 0 && (
                <div class="standards-group">
                  <div class="standards-grid">

                    {
                      activeItems.map((item) => (

                        <a
                          href={item.url}
                          class="standard-card"
                        >

                          <div class="standard-code">
                            {item.code}
                          </div>

                          <div class="standard-title">
                            {item.title}
                          </div>

                        </a>

                      ))
                    }

                  </div>
                </div>
              )}

              {historicalItems.length > 0 && (
                <>
                  <div class="standards-divider"></div>
                  <div class="standards-group">
                    <div class="standards-grid">

                      {
                        historicalItems.map((item) => (

                          <a
                            href={item.url}
                            class="standard-card"
                          >

                            <div class="standard-code">
                              {item.code}
                            </div>

                            <div class="standard-title">
                              {item.title}
                            </div>

                            {item.status && (
                              <div class="standard-status">
                                {item.status}
                              </div>
                            )}

                          </a>

                        ))
                      }

                    </div>
                  </div>
                </>
              )}

            </div>
          );

        }
      )
    }

  </div>

  <script>

    const btnNumber =
      document.getElementById("btn-number");

    const btnCategory =
      document.getElementById("btn-category");

    const numberView =
      document.getElementById("number-view");

    const categoryView =
      document.getElementById("category-view");

    btnNumber?.addEventListener("click", () => {

      numberView.style.display = "block";
      categoryView.style.display = "none";

      btnNumber.classList.add("active");
      btnNumber.setAttribute("aria-pressed", "true");
      btnCategory.classList.remove("active");
      btnCategory.setAttribute("aria-pressed", "false");

    });

    btnCategory?.addEventListener("click", () => {

      numberView.style.display = "none";
      categoryView.style.display = "block";

      btnCategory.classList.add("active");
      btnCategory.setAttribute("aria-pressed", "true");
      btnNumber.classList.remove("active");
      btnNumber.setAttribute("aria-pressed", "false");

    });

  </script>

</StandardLayout>

