---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ias/ias8.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "s1",
          label: "Conceptual Framework Linkage",
        },
        {
          id: "s2",
          label: "Scope & Applicability",
        },
        {
          id: "s3",
          label: "Selecting Accounting Policies",
        },
        {
          id: "s4",
          label: "Changes in Accounting Policies",
        },
        {
          id: "s5",
          label: "Changes in Accounting Estimates",
        },
        {
          id: "s6",
          label: "Prior Period Errors",
        },
        {
          id: "s7",
          label: "The Three Treatments Compared",
        },
        {
          id: "s8",
          label: "Impracticability Exemption",
        },
        {
          id: "s9",
          label: "Disclosure Requirements",
        },
        {
          id: "s10",
          label: "Critical Judgments & Estimates",
        },
        {
          id: "s11",
          label: "IFRS vs US GAAP",
        },
        {
          id: "s12",
          label: "Statement Mapping",
        },
        {
          id: "s13",
          label: "Related Standards",
        },
        {
          id: "s14",
          label: "Glossary",
        },
        {
          id: "history",
          label: "History & Development",
        },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why IAS 8 is the Framework's "quality control" standard</div>
        <div class="principle">The Conceptual Framework's qualitative characteristics — comparability, consistency, and faithful representation — are meaningless without rules governing WHEN and HOW an entity may change the policies used to prepare its numbers. IAS 8 is that rulebook.</div>
        <div class="elabel">HOW IAS 8 MAPS TO THE FRAMEWORK'S QUALITATIVE CHARACTERISTICS</div>
        <div class="check-list">
          <span><strong style="font-weight:600">Comparability</strong> — restricting voluntary policy changes to those producing more relevant/reliable information prevents opportunistic year-to-year manipulation of results</span>
          <span><strong style="font-weight:600">Consistency</strong> — the same policies are applied to similar transactions across periods and across items within a period, unless a Standard permits otherwise</span>
          <span><strong style="font-weight:600">Faithful representation</strong> — correcting prior period errors ensures financial statements do not perpetuate a materially misstated position</span>
        </div>
        <div class="note">IAS 8 does not itself set RECOGNITION or MEASUREMENT rules — it governs the META-question of how an entity should select, apply, and change the policies that other standards' recognition/measurement rules operate within.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">Why the three categories are measured differently</div>
        <div class="principle">IAS 8's central technical distinction — retrospective restatement vs prospective application — flows directly from WHETHER new information reflects a correction of something that was always wrong, or a genuine, forward-looking change in circumstances/judgement.</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Category</span><span>Treatment basis</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Change in accounting policy</span><span>Retrospective — as if the new policy had always been applied</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Change in accounting estimate</span><span>Prospective — from the period of change forward only</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Prior period error</span><span>Retrospective restatement — as if the error had never occurred</span></div>
        </div>
        <div class="callout info" style="margin-bottom:0;">ℹ️ <strong style="font-weight:600">Qualitative characteristics in action:</strong> prospective treatment for estimate changes reflects that new information about the FUTURE doesn't mean the past was wrong — restating history for a genuine change in judgement would itself be a faithful-representation failure.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 8 covers</div>
        <div class="principle">IAS 8 prescribes the criteria for selecting and changing accounting policies, together with the accounting treatment and disclosure of changes in accounting policies, changes in accounting estimates, and corrections of prior period errors — applicable to ALL entities preparing IFRS financial statements.</div>
        <div class="elabel">WHAT IS NOT A CHANGE IN ACCOUNTING POLICY</div>
        <div class="cross-list">
          <span>Applying an accounting policy for transactions/events that DIFFER in substance from those previously occurring</span>
          <span>Applying a new accounting policy for transactions/events that DID NOT OCCUR previously or were immaterial</span>
        </div>
        <div class="note">This distinction matters enormously: a genuinely NEW transaction type simply adopts a policy for the first time (no retrospective restatement needed); only a change in the treatment of the SAME type of transaction is a "change in accounting policy."</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Accounting policies</div>
          <div class="glossary-def">The specific principles, bases, conventions, rules, and practices applied by an entity in preparing and presenting financial statements.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Change in accounting estimate</div>
          <div class="glossary-def">An adjustment of the carrying amount of an asset/liability, or the periodic consumption of an asset, resulting from the assessment of the present status of, and expected future benefits and obligations associated with, assets and liabilities. Results from new information or new developments — NOT a correction of an error.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Prior period errors</div>
          <div class="glossary-def">Omissions from, and misstatements in, an entity's financial statements for one or more prior periods arising from a failure to use, or misuse of, reliable information that was available and could reasonably be expected to have been obtained and taken into account when those statements were authorised for issue.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Retrospective application / restatement</div>
          <div class="glossary-def">Applying a new policy, or correcting an error, as if it had always applied/never occurred — adjusting the opening balance of each affected component of equity for the earliest prior period presented, and other comparative amounts.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — SELECTING ACCOUNTING POLICIES ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Selecting &amp; Applying Accounting Policies</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">The selection hierarchy</div>
        <div class="principle">Where an IFRS Standard specifically applies to a transaction, the policy is determined by applying that Standard, considering any relevant Implementation Guidance. Where NO Standard specifically applies, management must use judgement to develop a policy that is relevant and reliable, applying the following hierarchy IN ORDER.</div>
        <div class="two-col">
          <div class="spec-box" style="margin-bottom:0;">
            <div class="spec-title" style="color:var(--color-text-success);">Step 1 — Mandatory sources</div>
            <div class="text-supporting text-supporting--tight">Requirements in other IFRS Standards dealing with similar/related issues, AND the Conceptual Framework's definitions, recognition criteria, and measurement concepts for assets, liabilities, income, and expenses.</div>
          </div>
          <div class="spec-box" style="margin-bottom:0;">
            <div class="spec-title" style="color:var(--color-text-success);">Step 2 — May also consider</div>
            <div class="text-supporting text-supporting--tight">Pronouncements of other standard-setting bodies using a similar conceptual framework, other accounting literature, and accepted industry practices — ONLY if not in conflict with Step 1.</div>
          </div>
        </div>
        <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ <strong style="font-weight:600">Step 1 is not optional or discretionary</strong> — the Conceptual Framework must be consulted, and requirements from OTHER, related IFRS Standards take priority over any outside literature. This ordering is one of the most frequently tested technical points in IAS 8.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — CHANGES IN ACCOUNTING POLICIES (with worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Changes in Accounting Policies</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">When a voluntary change is permitted</div>
        <div class="principle">A voluntary change in accounting policy is permitted ONLY if it is required by an IFRS Standard, OR results in the financial statements providing reliable and MORE RELEVANT information.</div>
        <div class="elabel">MANDATORY (NOT VOLUNTARY) CHANGES</div>
        <div class="text-supporting">Adoption of a new IFRS Standard is applied per that Standard's own specific transitional provisions; only in their absence does IAS 8's general retrospective rule apply by default.</div>
        <div class="formula-box" style="margin-top:9px;">
          <div class="f-label">RETROSPECTIVE APPLICATION MECHANICS</div>
          <div class="f-eq">Adjust the opening balance of each affected component of equity for the EARLIEST prior period presented, and restate other comparative amounts as if the new policy had always applied</div>
        </div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Worked example — change in inventory cost formula</div>
        <div class="worked">
          <div class="wk-title">Example 1: Changing from weighted average to FIFO</div>
          <div class="wk-body">
            An entity changes its inventory cost formula from weighted average to FIFO on 1 January 20X3, because FIFO is judged to provide more relevant information given recent volatility in purchase prices. Under the old policy, retained earnings at 1 January 20X2 (the earliest comparative period presented) were $800,000. Under FIFO, they would have been $830,000. Profit for 20X2 under the old policy was $150,000; under FIFO it would have been $158,000.
          </div>
          <div class="wk-answer">
            <strong>Restated opening retained earnings at 1 Jan 20X2</strong> = <strong style="color:var(--color-text-info);">$830,000</strong> (adjustment of +$30,000 to the earliest period presented)<br>
            <strong>20X2 comparative profit restated</strong> = $158,000 (not the original $150,000)<br>
            20X3 is then prepared going forward as if FIFO had always been the policy — no separate "catch-up" adjustment appears in 20X3 itself.
          </div>
        </div>
        <div class="note">If restating comparatives for 20X2 is impracticable, the cumulative adjustment is made to the opening balance of the EARLIEST period for which restatement IS practicable (Section 8) — potentially the current period itself.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 — CHANGES IN ACCOUNTING ESTIMATES ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Changes in Accounting Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Prospective application mechanics</div>
        <div class="formula-box">
          <div class="f-eq">A change in estimate is recognised prospectively by including it in profit or loss in: (a) the period of change, if it affects that period only; or (b) the period of change AND future periods, if it affects both</div>
        </div>
        <div class="elabel">COMMON EXAMPLES</div>
        <div class="dot-list">
          <span>Useful life or residual value of PPE/intangible assets</span>
          <span>Pattern of consumption of economic benefits (depreciation/amortisation method)</span>
          <span>Allowance for expected credit losses / doubtful receivables</span>
          <span>Provisions — warranty obligations, restructuring costs</span>
          <span>Fair value of financial assets/liabilities where no active market price exists</span>
        </div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Worked example — change in useful life</div>
        <div class="worked">
          <div class="wk-title">Example 2: Machine useful life revised</div>
          <div class="wk-body">
            A machine was purchased for $500,000, originally depreciated straight-line over 10 years (no residual value). After 4 years (carrying amount = 500,000 − 4×50,000 = $300,000), management revises the remaining useful life estimate to 3 more years (total 7 years, not 10) based on new information about wear patterns.
          </div>
          <div class="wk-answer">
            <strong>New annual depreciation</strong> = Remaining carrying amount ÷ Remaining useful life = 300,000 ÷ 3 = <strong style="color:var(--color-text-info);">$100,000 p.a.</strong>, starting in Year 5<br>
            NO adjustment is made to Years 1–4's depreciation already recognised — the change applies prospectively from the date of change only.
          </div>
        </div>
        <div class="callout danger" style="margin-bottom:0;">✕ <strong style="font-weight:600">Never restate prior periods for an estimate change</strong> — even if the effect is material. Retrospectively "correcting" a genuine change in estimate would misrepresent the information actually available to management at the time.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — PRIOR PERIOD ERRORS ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Prior Period Errors</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Correction mechanics &amp; worked example</div>
        <div class="principle">Material prior period errors are corrected RETROSPECTIVELY in the first set of financial statements authorised for issue after discovery, by restating the comparative amounts for the prior period(s) presented, or if the error occurred before the earliest prior period presented, restating the opening balances of assets, liabilities, and equity for that earliest period.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 3: Overstated revenue discovered in a later period</div>
          <div class="wk-body">
            During preparation of 20X3 financial statements, an entity discovers that revenue of $60,000 was incorrectly recognised in 20X2 for goods that had NOT yet been delivered to the customer at year end (a genuine error under IFRS 15, not a change in judgement). Retained earnings at 1 Jan 20X2 (before the error) were correctly $500,000. Income tax rate: 20%.
          </div>
          <div class="wk-answer">
            <strong>20X2 comparative figures restated:</strong> revenue reduced by $60,000; profit reduced by 60,000 × (1 − 0.20) = $48,000 net of tax<br>
            <strong>Restated retained earnings, 1 Jan 20X3</strong> (= restated closing 20X2) = original closing balance − $48,000<br>
            A THIRD statement of financial position (at 1 Jan 20X2) is required under IAS 1 only if the error relates to periods BEFORE the earliest comparative period presented — here it does not, so only the 20X2 comparative SOFP and SOPL are restated.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 — THE THREE TREATMENTS COMPARED ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>The Three Treatments — Side-by-Side Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Quick-reference comparison table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1fr 1fr 1fr 1fr;"><span>Feature</span><span>Policy change</span><span>Estimate change</span><span>Error correction</span></div>
          <div class="tr" style="grid-template-columns:1fr 1fr 1fr 1fr;"><span>Trigger</span><span>New info makes an existing policy less relevant, or new Standard requires it</span><span>New info/developments about future economic benefits</span><span>Reliable information available but not used/misused</span></div>
          <div class="tr alt" style="grid-template-columns:1fr 1fr 1fr 1fr;"><span>Treatment</span><span>Retrospective</span><span>Prospective</span><span>Retrospective restatement</span></div>
          <div class="tr" style="grid-template-columns:1fr 1fr 1fr 1fr;"><span>Comparatives restated?</span><span>Yes</span><span>No</span><span>Yes</span></div>
          <div class="tr alt" style="grid-template-columns:1fr 1fr 1fr 1fr;"><span>Third SOFP possible?</span><span>Yes, if material</span><span>No — never</span><span>Yes, if material and pre-dates earliest comparative</span></div>
          <div class="tr" style="grid-template-columns:1fr 1fr 1fr 1fr;"><span>Typical example</span><span>Inventory cost formula, presentation format</span><span>Useful life, ECL allowance, warranty provision</span><span>Arithmetical mistake, misapplication of a policy, fraud, oversight</span></div>
        </div>
        <div class="callout warn" style="margin-bottom:0;">⚠️ <strong style="font-weight:600">The classic exam trap:</strong> when it is difficult to distinguish a change in policy from a change in estimate, the change is treated AS a change in accounting estimate — the default always favours the less disruptive, prospective treatment.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — IMPRACTICABILITY EXEMPTION ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Impracticability Exemption</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">When retrospective treatment is not required</div>
        <div class="text-supporting" style="margin-bottom:9px;">Retrospective application/restatement is NOT required when it is impracticable to determine either the period-specific effects, or the cumulative effect, of the change/error.</div>
        <div class="elabel">A REQUIREMENT IS IMPRACTICABLE WHEN</div>
        <div class="check-list">
          <span>The effects of retrospective application/restatement are not determinable</span>
          <span>Retrospective application/restatement requires assumptions about what management's intent would have been in that prior period</span>
          <span>Retrospective application/restatement requires significant estimates, and it is impossible to distinguish objectively information about those estimates that would have been available at the time from information that became available LATER (hindsight)</span>
        </div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Fallback approach when impracticable</div>
        <div class="dot-list">
          <span>If restating comparatives for one or more prior periods is impracticable, apply the new policy/correct the error prospectively from the EARLIEST date practicable</span>
          <span>If determining the CUMULATIVE effect at the start of the current period is impracticable, adjust comparatives prospectively from the earliest date practicable — potentially the current period itself</span>
        </div>
        <div class="note">The "use of hindsight" prohibition is a critical safeguard — an entity cannot justify a retrospective adjustment using information that genuinely only became known/knowable after the prior period ended.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures by category</div>
        <div class="two-col">
          <div>
            <div class="elabel">CHANGE IN ACCOUNTING POLICY</div>
            <div class="check-list">
              <span>Nature of the change; reasons why the new policy provides more reliable/relevant information (voluntary changes)</span>
              <span>For each period presented, the amount of the adjustment for each financial statement line item affected, and EPS if applicable</span>
              <span>Amount of the adjustment relating to periods before those presented, to the extent practicable</span>
            </div>
          </div>
          <div>
            <div class="elabel">CHANGE IN ESTIMATE &amp; ERROR CORRECTION</div>
            <div class="check-list">
              <span>Nature and amount of a change in estimate that has an effect in the current period, or is expected to have an effect in future periods</span>
              <span>For prior period errors: nature of the error, and for each period presented, the amount of correction for each line item affected and EPS</span>
              <span>Amount of the correction at the beginning of the earliest prior period presented</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Distinguishing a change in accounting policy from a change in accounting estimate (defaults to estimate when genuinely unclear)</span>
              <span>Whether new information reflects a genuine error (should have been known/available) versus a legitimate change in estimate based on new developments</span>
              <span>Whether retrospective restatement is genuinely impracticable, and to what extent hindsight would need to be used</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>The cumulative financial effect of a restatement, when full period-by-period data is unavailable</span>
              <span>The materiality threshold applied in determining whether an error requires correction at all</span>
            </div>
          </div>
        </div>
        <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ Fraud, deliberate misstatement, and simple oversight are ALL treated identically as "prior period errors" under IAS 8 — the standard does not distinguish by cause or intent; only the RESULT (a misstatement using information that was or should have been available) matters for accounting purposes.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IFRS vs US GAAP ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRS vs US GAAP — Key Differences</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison — IAS 8 vs US GAAP (ASC 250)</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IFRS (IAS 8)</span><span style="color:var(--color-text-warning);">US GAAP</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Accounting policy selection hierarchy</span><span>Mandatory: other IFRS Standards, then the Conceptual Framework, before other literature</span><span>FASB Accounting Standards Codification is the single source of authoritative GAAP — no equivalent tiered hierarchy needed</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Voluntary policy changes</span><span>Permitted if the new policy provides more relevant and reliable information</span><span>Permitted only if the new policy is "preferable," with a similar underlying rationale</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Error correction</span><span>Retrospective restatement</span><span>Also retrospective restatement — largely converged</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Change in estimate</span><span>Prospective</span><span>Also prospective — largely converged</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Materiality error correction — prior "rollover" method</span><span>Not used — always retrospective if material</span><span>Historically some entities used non-GAAP "rollover"/"iron curtain" quantification approaches for immaterial items, now largely restricted by SEC guidance (SAB 108)</span></div>
        </div>
        <div class="note">IAS 8 and its US GAAP counterpart are among the more converged pairs of standards — the retrospective/prospective distinctions are conceptually aligned, with the main practical difference lying in the source-hierarchy for developing policies where no specific standard exists.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING TABLE ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping — Where Every IAS 8 Event Lands</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Change in accounting policy — cumulative adjustment</span><span><span class="badge be">Equity</span> <span class="badge bs">SOFP</span></span><span>Opening retained earnings of earliest period restated</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Change in accounting policy — comparative period impact</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Prior period comparatives restated as if always applied</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Change in accounting estimate — current/future impact</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Recognised prospectively; NO restatement of prior periods</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Prior period error — comparative restatement</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span> <span class="badge be">Equity</span></span><span>Prior period figures restated as if error never occurred</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Error pre-dating earliest comparative period</span><span><span class="badge bs">SOFP</span> <span class="badge be">Equity</span></span><span>Opening balances of earliest period restated; may trigger third SOFP (IAS 1)</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Impracticable restatement — prospective fallback applied</span><span><span class="badge bp">SOPL</span></span><span>Applied from the earliest date practicable instead</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Cumulative effect of non-cash accounting adjustments</span><span><span class="badge bs">Cash Flow Statement</span></span><span>No actual cash impact; comparatives in the cash flow statement also restated where relevant</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Nature, amount, and reasons for changes/errors</span><span><span class="badge bp">Notes</span></span><span>Mandatory disclosure for all three categories</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards — Cross-Reference Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">How IAS 8 connects across the IFRS body of literature</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Nature of the connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 1</span><span>Determines when a "third statement of financial position" is required as a consequence of retrospective application, restatement, or reclassification under IAS 8</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 12</span><span>Deferred tax consequences must be recalculated and restated alongside any retrospective policy change or error correction affecting temporary differences</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 33</span><span>Restated EPS figures for each period presented must accompany retrospective adjustments, since EPS is highly comparability-sensitive</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 10</span><span>Interacts in determining whether an item discovered after year end is an adjusting event (often converging with error correction) or requires separate non-adjusting disclosure</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 16 / IAS 38</span><span>Supply the classic examples of "changes in estimate" — useful life, residual value, depreciation/amortisation method revisions</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 37</span><span>Changes in provision estimates (e.g. revised probability or amount of an obligation) are treated as changes in accounting estimate under IAS 8's framework</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 9</span><span>Revisions to expected credit loss estimates are treated as changes in accounting estimate, applied prospectively</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>All other Standards</span><span>IAS 8's selection hierarchy (Step 1) requires consulting related Standards FIRST whenever a transaction has no directly applicable Standard of its own</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<Glossary entries={[
      { term: "Retrospective application", definition: "Applying a NEW accounting policy to transactions/events as if that policy had always been applied." },
      { term: "Retrospective restatement", definition: "CORRECTING the recognition, measurement, and disclosure of amounts in financial statements as if a prior period error had never occurred." },
      { term: "Prospective application", definition: "Applying a new accounting policy, or recognising the effect of a change in estimate, to transactions/events occurring AFTER the date the policy is changed / estimate is revised." },
      { term: "Impracticable", definition: "A requirement is impracticable when the entity cannot apply it after making every reasonable effort — the exemption threshold that allows a prospective fallback instead of full retrospective treatment." },
      { term: "Material", definition: "Errors, omissions, or misstatements are material if they could, individually or collectively, influence the economic decisions of users based on the financial statements." },
      { term: "IFRS Standards", definition: "Standards and Interpretations adopted by the IASB, comprising IFRS Standards, IAS Standards, and Interpretations developed by the IFRS Interpretations Committee / former SIC." }
    ]} />

