---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas15.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Why This Standard Is Here" },
        { id: "s2", label: "Superseded by IPSAS 28, 29 & 30" },
        { id: "s3", label: "Redirect Map" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IPSAS 15 Financial Instruments: Disclosure and Presentation was withdrawn for annual financial statements covering periods beginning on or after 1 January 2013 and superseded by IPSAS 28, IPSAS 29 and IPSAS 30 (most content now in IPSAS 41)."
    historical="IPSAS 15 combined presentation, recognition/measurement, and disclosure guidance for financial instruments in one Standard (mirroring IAS 32). The IPSASB split this into IPSAS 28, IPSAS 29 and IPSAS 30; IPSAS 29 and IPSAS 30 were subsequently substantially superseded by IPSAS 41."
    link="/ipsas/ipsas41"
    linkText="IPSAS 41 — Financial Instruments"
    currentLabel="Replaced by"
  />

    <!-- ============ SECTION 1 — WHY THIS STANDARD IS HERE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Why This Standard Is Here</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Removed from the Handbook — retained here only as a numbering placeholder</div>
        <div class="principle">IPSAS 15, <em>Financial Instruments: Disclosure and Presentation</em>, was withdrawn as the IPSASB split financial instruments guidance into three focused Standards, mirroring the IASB's earlier split of IAS 32 into presentation, recognition/measurement, and disclosure components. It was superseded for annual financial statements covering periods beginning on or after <strong>1 January 2013</strong>.</div>
        <div class="callout danger callout--flush">The 2025 IPSASB Handbook now contains only a one-paragraph removal notice for this number — there is no remaining technical content to build a reference poster from. This page exists so the poster library's numbering stays complete and correctly redirects to the live successor Standards.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SUPERSEDED BY ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Superseded by IPSAS 28, 29 &amp; 30 — Now Largely Absorbed into IPSAS 41</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">One Standard split into three, then two of those three folded into a fourth</div>
        <div class="principle">IPSAS 15 originally combined presentation, recognition/measurement, and disclosure guidance for financial instruments in one Standard (mirroring IAS 32). At withdrawal it was split into three Standards; two of those three have since been substantially superseded again.</div>
        <div class="two-col">
          <div class="spec-box">
            <div class="spec-title">IPSAS 28 — Presentation</div>
            <div class="text-supporting">Liability-vs-equity classification, puttable instruments, offsetting. Still LIVE — not superseded.</div>
          </div>
          <div class="spec-box">
            <div class="spec-title">IPSAS 29 → largely IPSAS 41</div>
            <div class="text-supporting">Recognition and measurement — substantially superseded by IPSAS 41, Financial Instruments (Aug 2018).</div>
          </div>
          <div class="spec-box">
            <div class="spec-title">IPSAS 30 → largely IPSAS 41</div>
            <div class="text-supporting">Disclosures — most content carried forward into IPSAS 41's disclosure requirements.</div>
          </div>
        </div>
        <div class="callout warn callout--flush">IPSAS 28 remains an ACTIVE, live Standard in the current Handbook (it appears at its own number later in the sequence) — only IPSAS 15 itself was withdrawn, not its three successors.</div>
      </div>
    </div>

    <!-- ============ SECTION 3 — REDIRECT MAP ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Redirect Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Withdrawn number → live Standard(s)</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1fr 2fr 1.4fr;"><span>Withdrawn</span><span>Superseded by</span><span>Effective date</span></div>
          <div class="tr" style="grid-template-columns:1fr 2fr 1.4fr;"><span>IPSAS 15</span><span><span class="badge bo">IPSAS 28</span> <span class="badge be">IPSAS 29</span> <span class="badge bp">IPSAS 30</span> → mostly <span class="badge bc">IPSAS 41</span></span><span>1 Jan 2013 (29/30 further absorbed into 41 from 2023)</span></div>
        </div>
        <div class="note">For current authoritative requirements, see the dedicated standards for IPSAS 28 (Financial Instruments: Presentation), IPSAS 30 (Disclosures), and IPSAS 41 (Recognition and Measurement) in this library.</div>
      </div>
    </div>


  </StandardPageLayout>
