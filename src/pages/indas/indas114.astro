---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas114.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "Eligibility – First-Time Adopters Only" },
        { id: "s4", label: "Recognition of Regulatory Deferral Account Balances" },
        { id: "s5", label: "Presentation" },
        { id: "s6", label: "Why This Standard Is Rarely Applied in India" },
        { id: "s7", label: "CERC/SERC Tariff Regulation Context" },
        { id: "s8", label: "Impairment" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "Ind AS 114 vs IFRS 14 – Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical interim-standard philosophy to IFRS 14</div>
        <div class="principle">Ind AS 114 applies the IDENTICAL rationale as IFRS 14 – as an INTERIM, transitional measure, it permits FIRST-TIME ADOPTERS to continue recognising "regulatory deferral account balances" under their PREVIOUS GAAP accounting policies, pending a comprehensive rate-regulated activities project.</div>
        <div class="elabel">HOW IND AS 114 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Comparability trade-off</strong> – this is an ACKNOWLEDGED, deliberate exception to full Ind AS/IFRS comparability, isolated via separate line items – identical rationale to IFRS 14</span>
          <span><strong>Genuinely limited Indian relevance</strong> – Indian GAAP (the pre-Ind AS framework) generally did NOT recognise "regulatory deferral account" balances as distinct assets/liabilities in the manner IFRS 14 contemplates (e.g. US rate-regulated utility accounting under US GAAP ASC 980) – meaning FEW Indian first-time adopters have had a PREVIOUS GAAP balance to carry forward under this optional standard</span>
        </div>
        <div class="note">This is one of the LEAST practically applied Ind AS standards in India – its inclusion in the Ind AS suite provides CONVERGENCE completeness with IFRS 14, rather than reflecting active, widespread Indian application.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Optional, first-time-adopter-only scope – identical to IFRS 14</div>
        <div class="formula-box"><div class="f-eq">Applicable ONLY IF: (a) first-time Ind AS adopter, AND (b) recognised regulatory deferral account balances under previous GAAP</div></div>
        <div class="callout warn callout--chip callout--flush">An entity NOT already recognising such balances under previous GAAP CANNOT create them upon Ind AS adoption – IDENTICAL restriction to IFRS 14.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 114 covers</div>
        <div class="principle">Ind AS 114 applies ONLY to first-time Ind AS adopters that recognised regulatory deferral account balances under previous GAAP – IDENTICAL scope restriction to IFRS 14.</div>
        <div class="note">Given prior Indian GAAP's general non-recognition of such balances, this standard has seen VERY LIMITED actual application among Indian first-time adopters.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Regulatory deferral account balance</div><div class="glossary-def">IDENTICAL definition to IFRS 14 – an amount of expense/income that would NOT be recognised as an asset/liability under other Ind AS, but qualifies for deferral because of rate regulation.</div></div>
        <div class="glossary-item"><div class="glossary-term">CERC / SERC</div><div class="glossary-def">Central/State Electricity Regulatory Commission – India's tariff-setting regulators for the power sector, operating SEPARATELY from Ind AS accounting requirements.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 – ELIGIBILITY ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Eligibility – First-Time Adopters Only</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical eligibility gate to IFRS 14</div>
        <div class="text-supporting">Only entities ALREADY recognising such balances under previous GAAP, transitioning to Ind AS for the first time, may elect to continue this policy – IDENTICAL to IFRS 14, with NO broader applicability to established Ind AS preparers.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – RECOGNITION ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Recognition of Regulatory Deferral Account Balances</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical continuation-of-policy approach to IFRS 14</div>
        <div class="text-supporting">An eligible entity continues its PREVIOUS GAAP accounting policies for recognition, measurement, impairment, and derecognition of regulatory deferral account balances – IDENTICAL to IFRS 14's own "grandfather" approach.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 – PRESENTATION ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Presentation</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical isolation requirement to IFRS 14</div>
        <div class="text-supporting">Regulatory deferral account balances are presented as SEPARATE line items in the balance sheet, and net movements as separate line items in profit or loss/OCI – IDENTICAL to IFRS 14, ensuring these amounts do NOT contaminate comparability of the "regular" Ind AS-compliant figures.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 – WHY RARELY APPLIED ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Why This Standard Is Rarely Applied in India</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">The key India-specific practical observation</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: An Indian electricity distribution company's transition to Ind AS</div>
          <div class="wk-body">An Indian state electricity distribution company transitions to Ind AS for the first time. Under its PREVIOUS Indian GAAP financial statements, it followed the Companies Act/ICAI accounting standards, which did NOT recognise a "regulatory asset" for under-recovered tariff costs as a distinct balance sheet item – tariff true-ups were instead reflected through CERC/SERC-approved tariff orders affecting FUTURE billing, without a corresponding Indian GAAP balance sheet recognition mechanism.</div>
          <div class="wk-answer">Because the company had NO previous GAAP regulatory deferral account balance to carry forward, Ind AS 114's optional election is simply <strong>NOT AVAILABLE</strong> to it – illustrating why this standard, despite being fully converged with IFRS 14 in its TEXT, has seen minimal actual USE among Indian first-time adopters.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 – CERC/SERC CONTEXT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>CERC/SERC Tariff Regulation Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">A separate regulatory framework, not an Ind AS 114 substitute</div>
        <div class="text-supporting">India's electricity sector tariff mechanism (multi-year tariff orders, true-up adjustments for cost under/over-recovery) operates as its OWN distinct regulatory process under CERC/SERC, largely INDEPENDENT of whether an entity applies Ind AS 114 – a genuinely important Indian-specific observation about why the two frameworks do not automatically align.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 – IMPAIRMENT ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Impairment</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IFRS 14</div>
        <div class="text-supporting">Regulatory deferral account debit balances are assessed for impairment using the entity's previous GAAP policy – IDENTICAL to IFRS 14.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IFRS 14</div>
        <div class="check-list">
          <span>Nature of rate regulation and associated risks</span>
          <span>Basis for recognising/measuring regulatory deferral account balances</span>
          <span>Effects on financial position, performance, cash flows</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether the entity qualifies as an eligible first-time adopter with a genuine previous GAAP balance</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Recoverability of regulatory deferral account debit balances via future tariffs</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">Given the standard's minimal Indian application, the MOST important judgement for Indian practitioners is often simply confirming that this election is NOT available, rather than applying its detailed mechanics.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 – IND AS 114 VS IFRS 14 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 114 vs IFRS 14 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS 14</span><span>Ind AS 114</span></div>
          <div class="tr cols-12-1-1"><span>Standard text/mechanics</span><span>Optional, first-time-adopter-only continuation of previous GAAP policy</span><span>IDENTICAL text – no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Practical applicability</span><span>Applied by some jurisdictions with prior rate-regulated accounting frameworks (e.g. US-influenced utility GAAP)</span><span>RARELY applicable – previous Indian GAAP generally did NOT recognise such balances; India's CERC/SERC tariff mechanism operates separately</span></div>
        </div>
        <div class="note">Ind AS 114's TEXT is essentially identical to IFRS 14 – its DISTINCTIVE Indian feature is the practical observation that very few (if any) Indian entities have actually been able to USE this optional standard, given the absence of a qualifying previous GAAP balance.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every Ind AS 114 disclosure lands (if applicable)</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Item</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Regulatory deferral account balance</span><span><span class="badge bs">Balance Sheet</span></span><span>Presented as a SEPARATE line item, isolated from other Ind AS balances</span></div>
          <div class="tr alt cols-16-1-14"><span>Net movement in the balance</span><span><span class="badge bp">P&amp;L</span> <span class="badge bo">OCI</span></span><span>Presented as a SEPARATE line item</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 14</span><span>The global counterpart standard, identically worded but rarely usable in India</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 101</span><span>Governs the first-time adoption context in which this election arises</span></div>
          <div class="tr cols-08-2"><span>Electricity Act, 2003 / CERC & SERC Regulations</span><span>Supplies India's SEPARATE tariff true-up mechanism, independent of Ind AS 114</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Rate regulation</div><div class="glossary-def">A framework where a regulator (e.g. CERC/SERC) establishes prices that customers are charged, potentially creating regulatory deferral account balances under previous GAAP frameworks that recognise them.</div></div>
        <div class="glossary-item"><div class="glossary-term">True-up</div><div class="glossary-def">India's electricity tariff mechanism for reconciling estimated vs actual costs, operating through the CERC/SERC process rather than through an Ind AS 114 balance.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Regulatory deferral account balance", definition: "An amount of expense/income that would not be recognised as an asset/liability under other Ind AS, but qualifies for deferral because of rate regulation – IDENTICAL definition to IFRS 14." },
      { term: "CERC / SERC", definition: "Central/State Electricity Regulatory Commission – India's tariff-setting regulators for the power sector, operating separately from Ind AS accounting requirements." },
      { term: "Rate regulation", definition: "A framework where a regulator establishes prices that customers are charged, potentially creating regulatory deferral account balances." },
      { term: "True-up", definition: "India's electricity tariff mechanism for reconciling estimated vs actual costs, operating through the CERC/SERC process rather than through an Ind AS 114 balance." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
