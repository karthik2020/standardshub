---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas16.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Recognition Criteria" },
        { id: "s4", label: "Initial Measurement — Cost" },
        { id: "s5", label: "Subsequent Measurement — Cost vs Revaluation Model" },
        { id: "s6", label: "Depreciation" },
        { id: "s7", label: "Schedule II Useful Lives — The Indian Companion Regulation" },
        { id: "s8", label: "Derecognition" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 16 vs IAS 16 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical recognition/measurement philosophy to IAS 16</div>
        <div class="principle">Ind AS 16 applies the IDENTICAL principle as IAS 16 — PPE is recognised when it is PROBABLE future economic benefits will flow to the entity and cost can be measured RELIABLY, initially at COST, with a choice of cost or revaluation model subsequently.</div>
        <div class="elabel">HOW IND AS 16 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Faithful representation</strong> — componentised depreciation reflecting different useful lives of significant parts — identical to IAS 16</span>
          <span><strong>Schedule II useful lives</strong> — the Companies Act, 2013's Schedule II PRESCRIBES indicative useful lives for common asset categories (buildings, plant, vehicles, etc.), which companies may REBUT with technical justification — a genuinely Indian companion regulation, distinct from IAS 16's own entirely principles-based, entity-specific useful life estimation</span>
        </div>
        <div class="note">Ind AS 16 introduced NO substantive change to the recognition/measurement model relative to IAS 16 — Schedule II operates as a REGULATORY BENCHMARK for useful lives under company law, not a modification of Ind AS 16's own accounting principles.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Cost vs revaluation model — identical choice to IAS 16</div>
        <div class="td-table"><div class="th cols-1-16"><span>Model</span><span>Measurement</span></div>
          <div class="tr cols-1-16"><span>Cost model</span><span>Cost less accumulated depreciation/impairment</span></div>
          <div class="tr alt cols-1-16"><span>Revaluation model</span><span>Fair value at revaluation date less subsequent depreciation/impairment</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 16 covers</div>
        <div class="principle">Ind AS 16 applies to tangible items held for use in production/supply, rental, or administration, expected to be used for more than one period — IDENTICAL scope to IAS 16.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Componentisation</div>
          <div class="glossary-def">IDENTICAL requirement to IAS 16 — significant parts with different useful lives are depreciated separately.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Schedule II</div>
          <div class="glossary-def">A schedule to the Companies Act, 2013 prescribing indicative useful lives for depreciation purposes across common asset classes.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — RECOGNITION CRITERIA ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Recognition Criteria</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical two-pronged test to IAS 16</div>
        <div class="text-supporting">Probable future economic benefits AND reliable cost measurement — IDENTICAL recognition criteria to IAS 16, applied item by item (or by significant component).</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — INITIAL MEASUREMENT ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Initial Measurement — Cost</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical to IAS 16</div>
        <div class="text-supporting">Purchase price, directly attributable costs to bring the asset to working condition, and initial estimate of decommissioning/restoration costs — IDENTICAL to IAS 16.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 — SUBSEQUENT MEASUREMENT ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Subsequent Measurement — Cost vs Revaluation Model</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 16</div>
        <div class="text-supporting">Both models are available under Ind AS 16, IDENTICAL to IAS 16, with revaluation surpluses recognised in OCI (revaluation reserve) and increases reversing prior revaluation decreases through P&amp;L — same rules as IAS 16.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — DEPRECIATION (worked example) ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Depreciation</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical systematic allocation principle to IAS 16</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Useful life estimate vs Schedule II benchmark</div>
          <div class="wk-body">An Indian manufacturing company's engineering team assesses that a specialised piece of plant machinery has a USEFUL LIFE of 20 years based on its specific operating conditions and maintenance regime, while Schedule II's INDICATIVE useful life for general plant and machinery is 15 years.</div>
          <div class="wk-answer">Under Ind AS 16's OWN principles (identical to IAS 16), the entity uses its OWN technically justified estimate of 20 years, provided this is appropriately DOCUMENTED and DISCLOSED as a departure from the Schedule II indicative life — illustrating that Schedule II is a REBUTTABLE benchmark, not a mandatory override of Ind AS 16's own entity-specific useful life principle.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 — SCHEDULE II USEFUL LIVES ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Schedule II Useful Lives — The Indian Companion Regulation</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important practical Indian consideration</div>
        <div class="text-supporting">Schedule II to the Companies Act, 2013 provides INDICATIVE useful lives for depreciation purposes (e.g. general plant and machinery: 15 years; office buildings: 60 years; motor vehicles: 8-10 years), serving as a REGULATORY BENCHMARK. While Ind AS 16 (like IAS 16) requires useful life to be an ENTITY-SPECIFIC technical/commercial estimate, in PRACTICE many Indian companies align closely with Schedule II's indicative lives absent strong grounds to depart, given the compliance comfort this provides under company law — a distinctly Indian INTERACTION between statutory guidance and Ind AS 16's own principles-based estimate.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — DERECOGNITION ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Derecognition</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 16</div>
        <div class="text-supporting">An asset is derecognised on disposal or when no future economic benefits are expected, with gain/loss (disposal proceeds less carrying amount) recognised in P&amp;L — IDENTICAL to IAS 16.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 16</div>
        <div class="check-list">
          <span>Measurement basis, depreciation methods and useful lives/rates</span>
          <span>Gross carrying amount and accumulated depreciation reconciliation</span>
          <span>Revaluation details where the revaluation model is used</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether to depart from Schedule II's indicative useful lives</span>
              <span>Component identification for componentised depreciation</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Residual values and useful lives</span>
              <span>Decommissioning/restoration cost estimates</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">Departing materially from Schedule II's indicative lives typically warrants a clear technical justification note in the financial statements, given auditor and regulatory scrutiny in the Indian context.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 16 vs IAS 16 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 16 vs IAS 16 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 16</span><span>Ind AS 16</span></div>
          <div class="tr cols-12-1-1"><span>Recognition, measurement, componentisation, revaluation model</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Useful life guidance</span><span>Purely entity-specific, principles-based</span><span>Schedule II provides an INDICATIVE, rebuttable benchmark under company law — a genuinely Indian companion regulation</span></div>
        </div>
        <div class="note">Ind AS 16's ACCOUNTING SUBSTANCE mirrors IAS 16 exactly — Schedule II is a company-law-driven benchmark operating ALONGSIDE Ind AS 16, not a modification of the standard's own principles.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Asset acquisition</span><span><span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 16</span></div>
          <div class="tr alt cols-16-1-14"><span>Depreciation expense</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 16</span></div>
          <div class="tr cols-16-1-14"><span>Revaluation surplus</span><span><span class="badge bo">OCI</span> <span class="badge be">Equity</span></span><span>Identical to IAS 16</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 16</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Schedule II (Companies Act, 2013)</span><span>Provides indicative useful lives for depreciation under company law</span></div>
          <div class="tr cols-08-2"><span>Ind AS 36</span><span>Governs impairment testing of PPE carrying amounts</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Componentisation</div>
          <div class="glossary-def">Depreciating significant parts of an asset separately based on their distinct useful lives — identical to IAS 16.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Indicative useful life</div>
          <div class="glossary-def">Schedule II's suggested (rebuttable) useful life for a given asset category under Indian company law.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Componentisation", definition: "Depreciating significant parts of an asset separately based on their distinct useful lives — identical to IAS 16." },
      { term: "Indicative useful life", definition: "Schedule II's suggested (rebuttable) useful life for a given asset category under Indian company law." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
