---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas12.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "The Balance Sheet Approach — Temporary Differences" },
        { id: "s4", label: "Deferred Tax Assets & Liabilities" },
        { id: "s5", label: "Recognition Exceptions" },
        { id: "s6", label: "Measurement — Tax Rates & Substantively Enacted Law" },
        { id: "s7", label: "MAT Credit Entitlement — The Genuine Indian Addition" },
        { id: "s8", label: "Uncertain Tax Treatments" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 12 vs IAS 12 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical balance sheet approach to IAS 12</div>
        <div class="principle">Ind AS 12 applies the IDENTICAL principle as IAS 12 — deferred tax is recognised for TEMPORARY DIFFERENCES between the carrying amount of assets/liabilities and their TAX BASE, using a balance-sheet-focused (not income-statement-focused) methodology.</div>
        <div class="elabel">HOW IND AS 12 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Faithful representation</strong> — recognising the future tax consequences of transactions already reflected in the financial statements — identical to IAS 12</span>
          <span><strong>MAT credit — a genuinely Indian addition</strong> — Appendix A to Ind AS 12 recognises MAT credit as a DEFERRED TAX ASSET when it is probable the entity will pay normal income tax (rather than MAT) during the specified carry-forward period and utilise the credit — a concept ARISING FROM India's specific tax law structure, with NO direct IAS 12 counterpart</span>
        </div>
        <div class="note">This MAT credit treatment is one of the FEW Ind AS standards with a genuinely SUBSTANTIVE addition beyond its IFRS counterpart, driven by a uniquely Indian tax mechanism rather than a general accounting divergence.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The core temporary difference formula — identical to IAS 12</div>
        <div class="formula-box"><div class="f-eq">Temporary difference = Carrying amount − Tax base</div></div>
        <div class="callout info callout--flush">IDENTICAL formula to IAS 12 — taxable temporary differences generate deferred tax LIABILITIES; deductible temporary differences generate deferred tax ASSETS (subject to recoverability).</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & APPLICABILITY ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 12 covers</div>
        <div class="principle">Ind AS 12 applies to the accounting for income taxes, including current tax and deferred tax — IDENTICAL scope to IAS 12, with Appendix A's MAT credit guidance layered on top for Indian applicability.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Tax base</div>
          <div class="glossary-def">IDENTICAL definition to IAS 12 — the amount attributed to an asset/liability for tax purposes.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">MAT (Minimum Alternate Tax)</div>
          <div class="glossary-def">A minimum tax levied under Section 115JB of the Income Tax Act, 1961 on companies with low taxable income relative to book profit, generating a creditable excess under Section 115JAA.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — BALANCE SHEET APPROACH ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Balance Sheet Approach — Temporary Differences</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 12</div>
        <div class="text-supporting">Taxable temporary differences (e.g. accelerated tax depreciation) and deductible temporary differences (e.g. provisions not yet tax-deductible) are IDENTIFIED and MEASURED identically to IAS 12.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — DEFERRED TAX ASSETS & LIABILITIES ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Deferred Tax Assets &amp; Liabilities (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical recognition criteria to IAS 12</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Deferred tax on a provision</div>
          <div class="wk-body">An Indian company recognises a ₹20,00,000 warranty provision for accounting purposes, which is NOT tax-deductible until actually paid, with a corporate tax rate of 25%.</div>
          <div class="wk-answer">A DEFERRED TAX ASSET of ₹5,00,000 (₹20,00,000 × 25%) is recognised, since the provision creates a DEDUCTIBLE temporary difference expected to reverse when the warranty is paid and becomes tax-deductible — an IDENTICAL calculation to how IAS 12 would treat the same fact pattern globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — RECOGNITION EXCEPTIONS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Recognition Exceptions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical exceptions to IAS 12</div>
        <div class="text-supporting">Initial recognition exemption (for goodwill, and for transactions that are not business combinations and affect neither accounting nor taxable profit) — IDENTICAL to IAS 12.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — MEASUREMENT ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Measurement — Tax Rates &amp; Substantively Enacted Law</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 12</div>
        <div class="text-supporting">Deferred tax is measured at tax rates EXPECTED to apply when the asset is realised/liability settled, based on rates (and tax laws) ENACTED or SUBSTANTIVELY ENACTED by the reporting date — IDENTICAL to IAS 12, relevant when the Indian Finance Act introduces rate changes.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — MAT CREDIT ENTITLEMENT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>MAT Credit Entitlement — The Genuine Indian Addition (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">The single most important Ind AS 12-specific addition</div>
        <div class="principle">Under India's tax law, companies pay the HIGHER of normal income tax or MAT (calculated on book profit). The EXCESS paid as MAT over normal tax generates a CREDIT that can be carried forward and set off against normal tax in FUTURE years (subject to a statutory time limit). Appendix A to Ind AS 12 requires this MAT credit to be recognised as a DEFERRED TAX ASSET when it is PROBABLE that the future economic benefit (i.e., future normal tax liability against which the credit can be utilised) will be realised — a recognition test analogous in SPIRIT to IAS 12's own deferred tax asset recoverability test, but applied to a tax mechanism that simply does NOT EXIST under IFRS in most jurisdictions.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: Recognising a MAT credit asset</div>
          <div class="wk-body">An Indian company pays MAT of ₹30,00,000 in a year where its normal tax liability would have been only ₹18,00,000, generating a MAT credit of ₹12,00,000. Management projects sufficient future normal tax liabilities within the statutory carry-forward period to utilise this credit.</div>
          <div class="wk-answer">The ₹12,00,000 MAT credit is recognised as a DEFERRED TAX ASSET (specifically, "MAT credit entitlement") under Appendix A to Ind AS 12 — a recognition mechanism with NO direct IAS 12 counterpart, since MAT itself is a specifically Indian tax construct.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — UNCERTAIN TAX TREATMENTS ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Uncertain Tax Treatments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 12 (via Appendix C, aligned with IFRIC 23)</div>
        <div class="text-supporting">Uncertainty over income tax treatments is assessed using probability-weighted or most-likely-amount approaches, considering whether the tax authority is likely to accept the treatment — IDENTICAL to IAS 12's own Appendix C (converged with IFRIC 23).</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical core disclosures, plus MAT credit specifics</div>
        <div class="check-list">
          <span>Major components of tax expense</span>
          <span>Reconciliation of tax expense to accounting profit</span>
          <span>Unrecognised deductible temporary differences/tax losses</span>
          <span>MAT credit entitlement recognised, and the basis for recognition</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — CRITICAL JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Probability of future taxable profit to recognise deferred tax assets</span>
              <span>Probability of realising MAT credit within the statutory carry-forward window</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Future taxable profit projections supporting deferred tax asset/MAT credit recognition</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">MAT credit recognition requires careful, well-documented profit projections, given the statutory time limit on utilisation under Section 115JAA — a genuinely Indian-specific judgement area.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 12 vs IAS 12 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 12 vs IAS 12 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 12</span><span>Ind AS 12</span></div>
          <div class="tr cols-12-1-1"><span>Balance sheet approach, temporary differences, uncertain tax treatments</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>MAT credit entitlement</span><span>NO equivalent concept — MAT does not exist under IFRS-only jurisdictions</span><span>Appendix A prescribes recognition of MAT credit as a deferred tax asset — a GENUINE substantive addition arising from Indian tax law</span></div>
        </div>
        <div class="note">Ind AS 12's CORE deferred tax model is essentially IDENTICAL to IAS 12 — the MAT credit provision is a genuinely SUBSTANTIVE Indian-specific addition, one of the few in the entire Ind AS suite driven by a domestic tax law construct rather than a general accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Current tax expense</span><span><span class="badge bp">P&amp;L</span></span><span>Identical to IAS 12</span></div>
          <div class="tr alt cols-16-1-14"><span>Deferred tax on temporary differences</span><span><span class="badge bp">P&amp;L</span> <span class="badge bo">OCI</span> <span class="badge bs">Balance Sheet</span></span><span>Location follows the item the deferred tax relates to</span></div>
          <div class="tr cols-16-1-14"><span>MAT credit entitlement recognised</span><span><span class="badge bs">Balance Sheet</span> <span class="badge bp">P&amp;L</span></span><span>Recognised as deferred tax asset; utilisation reduces future tax expense</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 12</span><span>The global counterpart standard, converged in core model with a genuine MAT credit addition</span></div>
          <div class="tr alt cols-08-2"><span>Section 115JB / 115JAA, Income Tax Act, 1961</span><span>The statutory source of MAT and MAT credit entitlement</span></div>
          <div class="tr cols-08-2"><span>Ind AS 37</span><span>Distinguishes provisions from deferred tax liabilities</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">MAT credit entitlement</div>
          <div class="glossary-def">The deferred tax asset recognised for excess MAT paid over normal tax, per Appendix A to Ind AS 12.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Substantively enacted</div>
          <div class="glossary-def">A tax rate/law considered effectively certain to be enacted, even before final legislative approval — identical concept to IAS 12.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Tax base", definition: "IDENTICAL definition to IAS 12 — the amount attributed to an asset/liability for tax purposes." },
      { term: "MAT (Minimum Alternate Tax)", definition: "A minimum tax levied under Section 115JB of the Income Tax Act, 1961 on companies with low taxable income relative to book profit, generating a creditable excess under Section 115JAA." },
      { term: "MAT credit entitlement", definition: "The deferred tax asset recognised for excess MAT paid over normal tax, per Appendix A to Ind AS 12." },
      { term: "Substantively enacted", definition: "A tax rate/law considered effectively certain to be enacted, even before final legislative approval — identical concept to IAS 12." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
