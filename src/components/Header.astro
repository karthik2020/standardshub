---
/*
Site header

Top navigation bar for standard pages.

Props:
- code (optional, defaults to "")
- framework (optional, defaults to IAS)
- title (optional)

Renders the StandardsHub logo, framework breadcrumbs, current standard identity, and an optional print button. Slot available for toolbar actions.
*/

import { House, PanelLeft } from "@lucide/astro";
import { getFramework } from "../data/frameworks";

const defaultFramework = getFramework("ias")!;

const {
    code = "",
    framework = defaultFramework.code,
    title,
} = Astro.props;

const frameworkConfig = getFramework(framework) ?? defaultFramework;
const isHome = code.toLowerCase() === "home";
---

<header class="site-header">
    <div class="header-left">
        <a href="/" class="site-logo">
            <span class="logo-mark"></span>

            <span class="logo-text"> StandardsHub </span>
        </a>

        <nav class="header-breadcrumbs" aria-label="Breadcrumb">
            <a href="/" class="crumb breadcrumb-home">
                <House size={14} strokeWidth={2} />

                <span>Home</span>
            </a>

            {!isHome && code.toLowerCase() !== frameworkConfig.code.toLowerCase() && (
                <>
                    <span class="breadcrumb-separator" aria-hidden="true">❯</span>

                    <a
                        href={frameworkConfig.route}
                        class={`breadcrumb-framework ${frameworkConfig.id}`}
                    >
                        {frameworkConfig.displayName}
                    </a>
                </>
            )}

            {!isHome && (
                <>
                    <span class="breadcrumb-separator" aria-hidden="true">❯</span>

                    <span class="breadcrumb-current" aria-current="page">
                        <span class={`breadcrumb-code ${frameworkConfig.id}`}>
                            {code}
                        </span>

                        {!isHome && code.toLowerCase() !== frameworkConfig.code.toLowerCase() && (
                            <>
                                <span class="breadcrumb-dot"> • </span>

                                <span class="breadcrumb-title">
                                    {title}
                                </span>
                            </>
                        )}
                    </span>
                </>
            )}
        </nav>
    </div>

    <div class="header-right">
        <button class="toolbar-btn mobile-menu-btn" id="mobileMenuBtn" title="Menu" aria-label="Open menu" aria-expanded="false">
            <PanelLeft size={20} strokeWidth={2} />
        </button>

        <slot />

        <button class="toolbar-btn" id="printBtn" title="Print" aria-label="Print this page"> 🖨 </button>
    </div>
</header>

<script>
    document.getElementById("printBtn")?.addEventListener("click", () => {
        window.print();
    });
</script>
