---
/*
Site header

Top navigation bar for standard pages.

Props:
- code (optional, defaults to "")
- framework (optional, defaults to "IAS")
- title (optional)

Renders the StandardsHub logo, framework breadcrumbs, current standard identity, and an optional print button. Slot available for toolbar actions.
*/

import { House } from "@lucide/astro";

const {
    code = "",
    framework = "IAS",
    title,
} = Astro.props;
---

<header class="site-header">
    <div class="header-left">
        <a href="/" class="site-logo">
            <span class="logo-mark"></span>

            <span class="logo-text"> StandardsHub </span>
        </a>

        <nav class="header-breadcrumbs">
            <a href="/" class="crumb breadcrumb-home">
                <House size={14} strokeWidth={2} />

                <span>Home</span>
            </a>

            {code.toLowerCase() !== framework.toLowerCase() && (
                <>
                    <span class="breadcrumb-separator">❯</span>

                    <a
                        href={`/${framework.toLowerCase()}`}
                        class={`breadcrumb-framework ${framework.toLowerCase()}`}
                    >
                        {framework}
                    </a>
                </>
            )}

            {code.toLowerCase() !== "home" && (
                <>
                    <span class="breadcrumb-separator">❯</span>

                    <span class="breadcrumb-current">
                        <span class={`breadcrumb-code ${framework.toLowerCase()}`}>
                            {code}
                        </span>

                        {code.toLowerCase() !== framework.toLowerCase() && (
                            <>
                                <span class="breadcrumb-dot"> • </span>

                                <span class="breadcrumb-title">
                                    {title}
                                </span>
                            </>
                        )}
                    </span>
                </>
            )}
        </nav>
    </div>

    <div class="header-right">
        <slot />

        <button class="toolbar-btn" id="printBtn" title="Print"> 🖨 </button>
    </div>
</header>

<script>
    document.getElementById("printBtn")?.addEventListener("click", () => {
        window.print();
    });
</script>
