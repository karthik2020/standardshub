---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas37.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "The Three Recognition Criteria for Provisions" },
        { id: "s4", label: "Present Obligation – Legal vs Constructive" },
        { id: "s5", label: "Measurement – Best Estimate" },
        { id: "s6", label: "Contingent Liabilities & Contingent Assets" },
        { id: "s7", label: "Indian Litigation & Tax Dispute Context" },
        { id: "s8", label: "Onerous Contracts & Restructuring" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 37 vs IAS 37 – Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical recognition threshold philosophy to IAS 37</div>
        <div class="principle">Ind AS 37 applies the IDENTICAL principle as IAS 37 – a provision is recognised ONLY when a PRESENT obligation exists (legal or constructive), an outflow of resources is PROBABLE, and a RELIABLE estimate can be made, preventing entities from recognising liabilities for merely POSSIBLE future events.</div>
        <div class="elabel">HOW IND AS 37 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Prudence without overstatement</strong> – genuine obligations are recognised, but merely possible outflows remain disclosed (not recognised) as contingent liabilities – identical to IAS 37</span>
          <span><strong>Indian litigation volume</strong> – India's LARGE, often protracted litigation and tax dispute landscape makes the "probable" threshold assessment GENUINELY significant and frequently applied in Indian practice</span>
        </div>
        <div class="note">Ind AS 37 introduced NO substantive change to the recognition framework relative to IAS 37 – its Indian relevance is most pronounced for the SCALE and DURATION of litigation/tax dispute provisioning judgements.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The three-part recognition test – identical to IAS 37</div>
        <div class="formula-box formula-box--chip"><div class="f-eq">Provision recognised IF: Present obligation + Probable outflow + Reliable estimate</div></div>
        <div class="callout info callout--chip callout--flush">ALL three conditions must be met simultaneously – IDENTICAL to IAS 37.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 37 covers</div>
        <div class="principle">Ind AS 37 applies to provisions, contingent liabilities, and contingent assets, EXCLUDING those covered by other specific standards (e.g. Ind AS 115 contract-related, Ind AS 12 income tax, Ind AS 19 employee benefits) – IDENTICAL scope to IAS 37.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Provision</div>
          <div class="glossary-def">IDENTICAL definition to IAS 37 – a liability of UNCERTAIN timing or amount.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Constructive obligation</div>
          <div class="glossary-def">An obligation arising from an entity's own established pattern of practice/published policies creating a valid expectation – identical to IAS 37.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 – THREE CRITERIA ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Three Recognition Criteria for Provisions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 37</div>
        <div class="text-supporting">Present obligation, probable outflow (more likely than not), and reliable estimate – ALL identical thresholds to IAS 37, with the SAME "more likely than not" interpretation of "probable."</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – PRESENT OBLIGATION (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Present Obligation – Legal vs Constructive</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical to IAS 37</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Provision for a pending tax dispute</div>
          <div class="wk-body">An Indian company has received a tax demand notice from the Income Tax Department for ₹5,00,00,000, which its tax counsel assesses as having a 65% likelihood of being upheld (at least partially) on appeal, with a reasonably reliable estimate of the likely settlement amount at ₹3,50,00,000.</div>
          <div class="wk-answer">Since the outflow is assessed as PROBABLE (more likely than not) and a RELIABLE estimate exists, a provision of ₹3,50,00,000 is recognised – an IDENTICAL recognition threshold and measurement approach to how IAS 37 would treat a comparable tax dispute globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 – MEASUREMENT ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Measurement – Best Estimate</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 37</div>
        <div class="text-supporting">Provisions are measured at the BEST ESTIMATE of the expenditure required to settle the obligation, using expected value (for a range of outcomes) or the most likely outcome (for a single most likely outcome), DISCOUNTED where the time value of money is material – IDENTICAL to IAS 37.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 – CONTINGENT LIAB/ASSETS ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Contingent Liabilities &amp; Contingent Assets</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 37</div>
        <div class="text-supporting">Contingent liabilities (possible obligations, or present obligations not meeting recognition criteria) are DISCLOSED, not recognised; contingent assets are DISCLOSED only when inflow is PROBABLE, and NEVER recognised until virtually certain – IDENTICAL asymmetric treatment to IAS 37.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 – INDIAN LITIGATION CONTEXT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Indian Litigation &amp; Tax Dispute Context</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A practically prominent Indian application area</div>
        <div class="text-supporting">India's LEGAL and tax administration system is known for PROTRACTED litigation timelines (cases often spanning years through multiple appellate levels – Commissioner Appeals, ITAT, High Court, Supreme Court for tax matters), making Ind AS 37's "probable" threshold assessment and BEST ESTIMATE measurement GENUINELY significant and complex in Indian practice, particularly for indirect tax (GST), direct tax, and regulatory litigation exposures common across Indian corporates.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 – ONEROUS CONTRACTS ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Onerous Contracts &amp; Restructuring</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 37</div>
        <div class="text-supporting">A provision for an ONEROUS contract is recognised when unavoidable costs of meeting obligations EXCEED expected economic benefits; restructuring provisions require a DETAILED formal plan and valid expectation created in those affected – IDENTICAL criteria to IAS 37.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 37</div>
        <div class="check-list">
          <span>Reconciliation of provision carrying amounts (opening, additions, utilised, reversed, closing)</span>
          <span>Nature of the obligation and expected timing of outflows</span>
          <span>Contingent liabilities by class, with financial effect estimates where practicable</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether an outflow is "probable" versus merely "possible" for litigation/tax exposures</span>
              <span>Legal vs constructive obligation identification</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Best estimate of settlement amounts for litigation/tax provisions</span>
              <span>Discount rate for long-duration provisions</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">Given India's LONG litigation timelines, legal opinion updates at EACH reporting date are genuinely important to ensure provision/contingent liability classification remains current as cases progress through appellate stages.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 – IND AS 37 vs IAS 37 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 37 vs IAS 37 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 37</span><span>Ind AS 37</span></div>
          <div class="tr cols-12-1-1"><span>Recognition criteria, measurement, contingent asset/liability treatment</span><span>Standard model</span><span>IDENTICAL – no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Practical application context</span><span>Varies by jurisdiction</span><span>Especially significant given India's protracted litigation/tax dispute timelines</span></div>
        </div>
        <div class="note">Ind AS 37 is essentially IDENTICAL to IAS 37 in substance – its distinctive Indian relevance lies in the SCALE and DURATION of litigation/tax provisioning judgements, not any accounting divergence.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Provision recognised</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 37</span></div>
          <div class="tr alt cols-16-1-14"><span>Unwinding of discount on long-term provision</span><span><span class="badge bp">P&amp;L</span> <span class="badge bs">Balance Sheet</span></span><span>Recognised as a finance cost, identical to IAS 37</span></div>
          <div class="tr cols-16-1-14"><span>Contingent liability/asset</span><span><span class="badge bp">Notes</span></span><span>Disclosed only, not recognised</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 37</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 12</span><span>Distinguishes provisions from deferred tax liabilities</span></div>
          <div class="tr cols-08-2"><span>Ind AS 19</span><span>Governs restructuring-related termination benefit provisions</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">ITAT</div>
          <div class="glossary-def">Income Tax Appellate Tribunal – a common stage in the protracted Indian tax dispute appellate process relevant to provisioning judgement.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Onerous contract</div>
          <div class="glossary-def">A contract where unavoidable costs of meeting obligations exceed expected economic benefits – identical to IAS 37.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "ITAT", definition: "Income Tax Appellate Tribunal – a common stage in the protracted Indian tax dispute appellate process relevant to provisioning judgement." },
      { term: "Onerous contract", definition: "A contract where unavoidable costs of meeting obligations exceed expected economic benefits – identical to IAS 37." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
