---
/*
FrameworkRail

Narrow left column of the two-part standards sidebar. Shows Home plus the
4 core frameworks (IAS, IFRS, Ind AS, US GAAP); IFRS's sub-frameworks
(Sustainability, Publications, for SMEs, IFRIC, SIC) render as subfolders
inside the IFRS panel rather than as their own rail item.

The active item is resolved server-side from the URL for first paint /
no-JS correctness; rail-panel.js takes over for client-side switching
without a full page reload.
*/

import { FRAMEWORK_CONFIG } from "../data/frameworks";
import { Home, BookText, LibraryBig, Files, Leaf, BookOpen, Building2, ScrollText } from "@lucide/astro";

const RAIL_FRAMEWORKS = ["ias", "ifrs", "indas", "usgaap"] as const;

const lucideIconMap: Record<string, any> = { BookText, LibraryBig, Files, Leaf, BookOpen, Building2, ScrollText };

function resolveActiveFramework(pathname: string) {
  if (pathname.startsWith("/ifrs") || pathname.startsWith("/ifric") || pathname.startsWith("/sic")) return "ifrs";
  if (pathname.startsWith("/ias")) return "ias";
  if (pathname.startsWith("/indas")) return "indas";
  if (pathname.startsWith("/usgaap")) return "usgaap";
  return "home";
}

const active = resolveActiveFramework(Astro.url.pathname);
---

<nav class="framework-rail" data-rail aria-label="Frameworks">
  <a
    href="/"
    class="rail-item"
    data-rail-item="home"
    aria-current={active === "home" ? "page" : undefined}
  >
    <Home size={18} strokeWidth={2} />
    <span>Home</span>
  </a>

  <div class="rail-divider" role="separator"></div>

  {
    RAIL_FRAMEWORKS.map((id) => {
      const fw = FRAMEWORK_CONFIG[id];
      const Icon = lucideIconMap[fw.lucideIcon] ?? BookText;
      return (
        <button
          type="button"
          class:list={["rail-item", active === id && "active"]}
          data-rail-item={id}
          aria-current={active === id ? "page" : undefined}
        >
          <Icon size={18} strokeWidth={2} />
          <span>{fw.displayName}</span>
        </button>
      );
    })
  }
</nav>
