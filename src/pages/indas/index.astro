---
import StandardLayout from "../../layouts/StandardLayout.astro";
import standards from "../../data/standards.json";
---

<StandardLayout code="Ind AS" title="Indian Accounting Standards (Ind AS)" framework="Ind AS">

  <h1>Indian Accounting Standards</h1>

  <p class="category-description">
    Indian Accounting Standards (Ind AS) are converged with IFRS and issued by the Ministry of Corporate Affairs,
    aligning Indian financial reporting with international standards.
  </p>

  <div class="standards-group">
    <h2 class="standards-group-title">Active Standards</h2>
    <div class="standards-grid">

      {
        standards.IndAS.map((item) => (

          <a href={item.url} class="standard-card">

            <div class="standard-code">
              {item.code}
            </div>

            <div class="standard-title">
              {item.title}
            </div>

          </a>

        ))
      }

    </div>
  </div>

</StandardLayout>