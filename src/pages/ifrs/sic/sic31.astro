---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/sic/sic31.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-31 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-31 was superseded in May 2014 when the IASB issued IFRS 15 Revenue from Contracts with Customers, which replaced IAS 18 and absorbed barter advertising guidance into its general non-cash consideration measurement framework."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ifrs/ifrs15"
    linkText="IFRS 15 Revenue from Contracts with Customers"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-31 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-31 addressed</div>
        <div class="principle">SIC-31 addressed how to measure revenue from barter transactions involving advertising services. It considered whether an entity could measure the revenue from receiving advertising services by referencing the fair value of the advertising services it provides in exchange, rather than the fair value of the services it receives.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-31 concluded that an entity may measure the revenue from receiving advertising services by reference to the fair value of the advertising services it provides in exchange, provided that the fair value of the services received is not reliably measurable. This measurement method is permitted because in a barter transaction involving advertising services, the fair value of the advertising services provided is often the most reliable measure of the transaction.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IFRS 15 Revenue from Contracts with Customers</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2014 standard replaced IAS 18 and absorbed barter advertising guidance into its general non-cash consideration measurement framework</span></div>
          <div class="tr"><span>Current status</span><span>Superseded</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Barter transaction", definition: "An exchange of goods or services between two entities in a non-monetary transaction, such as an advertising exchange where each party provides advertising space or time to the other." },
      { term: "Non-cash consideration", definition: "Consideration received by an entity that is not in the form of cash or cash equivalents, addressed in IFRS 15 by reference to the fair value of the non-cash consideration." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC31} />
  </section>
</StandardPageLayout>




