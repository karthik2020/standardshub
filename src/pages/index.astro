---
import StandardLayout from "../layouts/StandardLayout.astro";
import standards from "../data/standards.json";
---

<StandardLayout code="Home" framework="home">

  <section class="hero">

    <h1>StandardsHub</h1>

    <p>
      Accounting Standards Reference Library
    </p>

    <p class="hero-subtitle">
      Browse IAS, IFRS and Ind AS standards, accounting guidance,
      financial reporting requirements and reference materials.
    </p>

  </section>

  <div class="home-grid">

    <a href="/ias" class="home-card card-ias">
      <h2>IAS</h2>
      <p>{standards.IAS.length} Standards</p>
    </a>

    <a href="/ifrs" class="home-card card-ifrs">
      <h2>IFRS</h2>
      <p>{standards.IFRS.length} Standards</p>
    </a>

    <a href="/indas" class="home-card card-indas">
      <h2>Ind AS</h2>
      <p>{standards.IndAS.length} Standards</p>
    </a>

    <a href="/usgaap" class="home-card card-usgaap">
      <h2>US GAAP</h2>
      <p>{standards.USGAAP.length} Standards</p>
    </a>

    <a href="/ukgaap" class="home-card card-ukgaap">
      <h2>UK GAAP</h2>
      <p>{standards.UKGAAP.length} Standards</p>
    </a>

    <a href="/asbe" class="home-card card-asbe">
      <h2>ASBE</h2>
      <p>{standards.ASBE.length} Standards</p>
    </a>

    <a href="/aspe" class="home-card card-aspe">
      <h2>ASPE</h2>
      <p>{standards.ASPE.length} Standards</p>
    </a>

  </div>

  <section class="home-section">
    <h2 class="home-section-title">Popular Standards</h2>
    <div class="popular-grid">
      <a href="/ias/ias1" class="popular-card">IAS 1</a>
      <a href="/ias/ias2" class="popular-card">IAS 2</a>
      <a href="/ias/ias7" class="popular-card">IAS 7</a>
      <a href="/ias/ias16" class="popular-card">IAS 16</a>
      <a href="/ias/ias36" class="popular-card">IAS 36</a>
      <a href="/ifrs/ifrs15" class="popular-card">IFRS 15</a>
      <a href="/ifrs/ifrs16" class="popular-card">IFRS 16</a>
      <a href="/indas/indas1" class="popular-card">Ind AS 1</a>
      <a href="/indas/indas16" class="popular-card">Ind AS 16</a>
      <a href="/usgaap/asc105" class="popular-card">ASC 105</a>
      <a href="/usgaap/asc842" class="popular-card">ASC 842</a>
      <a href="/ukgaap/frs102" class="popular-card">FRS 102</a>
      <a href="/asbe/asbe01" class="popular-card">ASBE 1</a>
    </div>
  </section>

  <section class="home-section">
    <h2 class="home-section-title">About StandardsHub</h2>
    <div class="about-card">
      <p>
        StandardsHub is an educational reference library for accounting standards.
        It covers IAS, IFRS, Ind AS, US GAAP, UK GAAP and ASBE with simplified explanations, worked examples
        and cross-standard links to support learning and quick reference.
      </p>
    </div>
  </section>

</StandardLayout>


