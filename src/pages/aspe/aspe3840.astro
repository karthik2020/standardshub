import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe3840.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Scope — Defining a Related Party" },
        { id: "s3", label: "3. Common Related Party Relationships" },
        { id: "s4", label: "4. THE MEASUREMENT PRINCIPLE — Carrying Amount as the Default" },
        { id: "s5", label: "5. When the Exchange Amount Is Used Instead" },
        { id: "s6", label: "6. Why ASPE Prescribes Measurement at All" },
        { id: "s7", label: "7. Transactions in the Normal Course of Operations" },
        { id: "s8", label: "8. Worked Example — a Related Party Sale Measured at Carrying Amount" },
        { id: "s9", label: "9. Worked Example — an Exchange Amount Transaction With a Substantive Change in Ownership" },
        { id: "s10", label: "10. Disclosure Requirements" },
        { id: "s11", label: "11. Critical Judgments &amp; Estimates" },
        { id: "s12", label: "12. Relationship to IAS 24" },
        { id: "s13", label: "13. Statement Mapping" },
        { id: "s14", label: "14. Related Standards" },
        { id: "s15", label: "15. Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
</div>

<div class="callout danger" style="max-width:900px;margin:0 auto 20px;text-align:center;">A GENUINELY IMPORTANT DIVERGENCE: IAS 24 internationally is a purely disclosure-oriented standard — it does NOT prescribe how related party transactions should be measured, relying entirely on other applicable standards for that purpose. ASPE Section 3840, by contrast, actively PRESCRIBES a specific measurement basis (carrying amount, or exchange amount in narrower circumstances) — a fundamentally different, more substantive standard than its IFRS counterpart's name alone would suggest.</div>



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Prescribing both disclosure AND measurement for related party dealings</div><div class="principle">ASPE Section 3840 governs the IDENTIFICATION, MEASUREMENT, and DISCLOSURE of RELATED party TRANSACTIONS — TRANSFERS of RESOURCES, obligations, OR services BETWEEN an ENTERPRISE and PARTIES it IS related TO. GENUINELY distinctively, THIS Section ACTIVELY prescribes a SPECIFIC measurement BASIS (Section 4), RATHER than being a PURELY disclosure-ORIENTED standard THE way IAS 24 IS internationally.</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — Defining a Related Party</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A principles-based test, not a bright-line ownership threshold</div><div class="principle">A RELATED party is a PARTY subject to COMMON control, MANAGEMENT, or OTHER influence to the EXTENT that ONE party MIGHT be PREVENTED from fully PURSUING its OWN separate INTERESTS — a BROADER, more PRINCIPLES-based definition THAN a SIMPLE bright-line OWNERSHIP percentage TEST alone.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Common Related Party Relationships</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Control, common control, and significant influence relationships</div><div class="dot-list"><span>Parent and subsidiary relationships</span><span>Entities under common control (e.g. sister companies owned by the same individual or family)</span><span>Key management personnel, and their close family members</span><span>Entities where significant influence exists, even absent control</span></div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>THE MEASUREMENT PRINCIPLE — Carrying Amount as the Default</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">No gain or loss recognized, absent specific conditions</div><div class="text-supporting">RELATED party TRANSACTIONS in the NORMAL course OF operations are MEASURED at the CARRYING amount (the TRANSFEROR'S existing BOOK value) — NOT fair VALUE — UNLESS specific CONDITIONS are MET (Section 5). THIS default REFLECTS a GENUINE skepticism THAT related-PARTY dealings, GIVEN the INHERENT lack OF arm's-LENGTH bargaining, RELIABLY establish a GENUINE fair-VALUE exchange AMOUNT.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>When the Exchange Amount Is Used Instead</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Clear evidence of substantive economic effect</div><div class="text-supporting">THE EXCHANGE amount (the AMOUNT actually AGREED to BY the RELATED parties) is USED instead OF carrying AMOUNT where THERE is CLEAR evidence THAT the TRANSACTION has SUBSTANTIVE economic SUBSTANCE — FOR example, WHERE the TRANSACTION reflects a GENUINE change IN economic ownership INTEREST between UNRELATED third PARTIES, OR is SUPPORTED by INDEPENDENT evidence OF fair VALUE (SUCH as a THIRD-party appraisal OR a GENUINELY competitive BIDDING process).</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Why ASPE Prescribes Measurement at All</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Guarding against artificially inflating reported results through related-party dealings</div><div class="text-supporting">GIVEN private ENTERPRISES frequently ENGAGE in TRANSACTIONS with FAMILY members, AFFILIATED entities, OR key MANAGEMENT personnel — RELATIONSHIPS where GENUINE arm's-LENGTH bargaining CANNOT be ASSUMED — ASPE'S standard-SETTERS concluded that MERELY requiring DISCLOSURE (the IAS 24 APPROACH) would be INSUFFICIENT to PREVENT related-PARTY transactions FROM artificially INFLATING reported EARNINGS or ASSET values. PRESCRIBING carrying-AMOUNT measurement AS the DEFAULT provides a MEANINGFUL substantive SAFEGUARD, RATHER than RELYING solely ON transparency THROUGH disclosure.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Transactions in the Normal Course of Operations</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A qualifying scope for the measurement principle</div><div class="text-supporting">THE carrying-AMOUNT default APPLIES to RELATED party TRANSACTIONS occurring IN the NORMAL course OF the enterprise'S OPERATIONS — ROUTINE, RECURRING transactions BETWEEN related PARTIES, RATHER than ONE-OFF, non-RECURRING events (WHICH may WARRANT separate CONSIDERATION on THEIR own SPECIFIC facts).</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — a Related Party Sale Measured at Carrying Amount</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">No gain recognized, despite an apparent fair value premium</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A sale between commonly controlled sister companies</div><div class="wk-body">Company A sells equipment (carrying amount $300,000) to Company B, a sister company under common family ownership, for $380,000 — a price the family patriarch set without any independent appraisal or competitive process.</div><div class="wk-answer">GIVEN this IS a ROUTINE related-PARTY transaction WITHOUT clear EVIDENCE of SUBSTANTIVE economic EFFECT, Company A records the SALE at the $300,000 CARRYING amount — <strong>NO gain</strong> is RECOGNIZED, DESPITE the $380,000 cash RECEIVED, WITH the DIFFERENCE effectively TREATED as an EQUITY-like transfer RATHER than genuine SALES income.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — an Exchange Amount Transaction With a Substantive Change in Ownership</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Independent evidence supporting the agreed price</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A related party sale supported by an independent appraisal</div><div class="wk-body">A company sells a property (carrying amount $1,200,000) to a related party for $1,650,000 — a price supported by an independent third-party appraisal obtained specifically for the transaction, as part of a genuine, substantive restructuring of family ownership interests.</div><div class="wk-answer">GIVEN the CLEAR, independent EVIDENCE of the PRICE'S fair-VALUE basis and THE substantive CHANGE in OWNERSHIP involved, the COMPANY measures the SALE at the $1,650,000 EXCHANGE amount, RECOGNIZING a $1,650,000 − $1,200,000 = <strong>$450,000</strong> gain.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 3840 requires</div><div class="check-list"><span>Description of the relationship between the parties, and the nature of the transaction</span><span>Amount of the transaction, and the measurement basis used (carrying amount or exchange amount)</span><span>Amounts due to or from related parties, and the terms of settlement</span></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether a party is genuinely "related" under the principles-based definition</span><span>Whether clear evidence of substantive economic effect exists, justifying exchange-amount measurement</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Generally minimal — the measurement basis itself (carrying amount) typically avoids the need for fair value estimation</span></div></div></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IAS 24</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASPE Section 3840 vs IAS 24</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 3840</span><span style="color:var(--color-text-info);">IAS 24</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Prescribes measurement</span><span>YES — carrying amount default</span><span>NO — purely a disclosure standard</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Disclosure of relationships and transactions</span><span>Required</span><span>Required — converged</span></div>
</div>
<div class="note">A GENUINELY fundamental DIVERGENCE in STANDARD design — DESPITE the SIMILAR name and OVERLAPPING subject MATTER, ASPE'S Section 3840 is a SUBSTANTIVELY different, MORE prescriptive STANDARD than ITS IFRS namesake.</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every related party event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Transaction at carrying amount</span><span><span class="badge bs">BS</span></span><span>No gain or loss recognized</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Transaction at exchange amount</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Gain or loss recognized, given substantive economic effect</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 1591</span><span>Subsidiaries — supplies the control-relationship concepts underlying this Section's definition of a related party</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Exchange amount</div><div class="glossary-def">The amount actually agreed to by related parties in a transaction, used as the measurement basis where clear evidence of substantive economic effect exists.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Carrying amount</div><div class="glossary-def">The transferor's existing book value, used as the default measurement basis for related party transactions in the normal course of operations.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.aspe3840 || []} />
  </section>
</StandardPageLayout>
