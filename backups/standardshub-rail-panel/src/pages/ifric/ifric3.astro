---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ifric/ifric3.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework (Historical)" },
        { id: "s2", label: "Scope & Definitions (Historical)" },
        { id: "s3", label: "The Required Accounting Model (Historical)" },
        { id: "s4", label: "Emission Allowances as Intangible Assets (Historical)" },
        { id: "s5", label: "The Liability for Emissions Made (Historical)" },
        { id: "s6", label: "Government-Granted Allowances (Historical)" },
        { id: "s7", label: "Why It Was Withdrawn" },
        { id: "s8", label: "Current Practice Diversity" },
        { id: "s9", label: "Disclosure (Historical)" },
        { id: "s10", label: "Judgments & Estimates (Historical)" },
        { id: "s11", label: "IFRIC 3 — Then vs Now" },
        { id: "s12", label: "Statement Mapping (Historical)" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IFRIC 3 was withdrawn by the IASB only months after issuance in 2005, following widespread criticism that its required mixed-measurement approach created artificial profit or loss volatility for participants in cap-and-trade emission schemes. Unlike most withdrawn interpretations, no direct successor was issued — emission rights accounting remains an area of diversity in practice under IFRS today."
    historical="This poster is retained for historical and comparative reference. Entities generating or trading emission rights must develop and consistently apply an accounting policy by reference to the Conceptual Framework and analogous standards, disclosing the basis for their approach given the absence of a dedicated standard."
    link="/ifrs/ifrs9"
    linkText="IFRS 9 Financial Instruments"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">A mixed-measurement approach that proved unworkable</div>
        <div class="principle">IFRIC 3 required emission allowances to be recognised as INTANGIBLE ASSETS (under IAS 38, at cost or fair value depending on how acquired), while the OBLIGATION to deliver allowances for emissions made was recognised as a PROVISION (under IAS 37, at the market price of allowances needed to settle it) — mixing TWO different measurement bases for what was economically a single, connected scheme.</div>
        <div class="elabel">WHY THIS CREATED A CONCEPTUAL PROBLEM</div>
        <div class="check-list">
          <span><strong>Measurement mismatch</strong> — allowances received for FREE from government were recognised at fair value with an OFFSETTING deferred income grant, while the emissions LIABILITY was measured at CURRENT market price</span>
          <span><strong>No genuine faithful representation</strong> — the mismatch did not reflect any real economic gain or loss</span>
        </div>
        <div class="note">This mismatch was the CENTRAL reason for withdrawal — a rare case of an interpretation being pulled specifically because its OWN internal logic produced counter-intuitive, criticised results.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The three-part accounting model IFRIC 3 required</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Item</span><span>Historical treatment</span></div>
          <div class="tr cols-13-1"><span>Emission allowances held</span><span>Intangible asset (IAS 38)</span></div>
          <div class="tr alt cols-13-1"><span>Government-granted allowances</span><span>Fair value + deferred income grant (IAS 20)</span></div>
          <div class="tr cols-13-1"><span>Obligation for emissions made</span><span>Provision at market price (IAS 37)</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope & Definitions (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRIC 3 covered</div>
        <div class="principle">IFRIC 3 addressed accounting for CAP-AND-TRADE emission rights schemes, where a government grants (or auctions) tradable allowances entitling the holder to emit up to a specified quantity, with participants required to deliver allowances matching actual emissions.</div>
        <div class="note">Relevant to entities in jurisdictions with mandatory emissions trading schemes (e.g. the EU Emissions Trading Scheme).</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Cap-and-trade scheme</div>
          <div class="glossary-def">A regulatory mechanism capping total emissions, allocating or auctioning tradable allowances to participants.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Emission allowance</div>
          <div class="glossary-def">A tradable right to emit a specified quantity of a pollutant, historically treated as an intangible asset under IFRIC 3.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>The Required Accounting Model (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">A theoretically consistent but practically criticised approach</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Each element (asset, grant, liability) was measured under the "correct" existing IFRS standard applicable to ITS nature — theoretically sound in isolation, but producing an ARTIFICIAL mismatch when combined, since the standards involved (IAS 38, IAS 20, IAS 37) were never designed to interact as a single coherent scheme.</div>
      </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Emission Allowances as Intangible Assets (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Historical measurement illustration</div>
        <div class="worked">
          <div class="wk-title">Example 1: The volatility problem illustrated</div>
          <div class="wk-body">A company received 1,000 emission allowances FREE from its government at the start of the year, when the market price was €20/allowance. By year-end, the company had emitted exactly 1,000 units, but the market price of allowances had risen to €35.</div>
          <div class="wk-answer">Under IFRIC 3: the intangible asset was recognised at €20,000 (fair value at grant), with a MATCHING €20,000 deferred income liability. The EMISSIONS PROVISION, however, was measured at the year-end market price: 1,000 × €35 = €35,000. This created a €15,000 LOSS in P&L — despite the company being PERFECTLY matched — the exact counter-intuitive result that led to IFRIC 3's withdrawal.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>The Liability for Emissions Made (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Provision measured at current market price</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The obligation to deliver allowances for ACTUAL emissions made during the period was measured as a PROVISION under IAS 37, at the market price of allowances needed for settlement — the source of the mismatch illustrated in Example 1.</div>
      </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Government-Granted Allowances (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Fair value recognition with a deferred income offset</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Allowances granted BELOW fair value (including for nil consideration) were recognised at FAIR VALUE, with the difference between consideration paid and fair value treated as a government grant under IAS 20, released to income over the compliance period.</div>
      </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Why It Was Withdrawn</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuine standard-setting failure, honestly acknowledged</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Constituents strongly criticised IFRIC 3 for producing ECONOMICALLY MEANINGLESS P&L volatility. The IASB WITHDREW IFRIC 3 in June 2005 — just months after its March 2005 issuance — acknowledging the measurement mismatch problem, but did NOT issue a replacement interpretation, leaving emission rights accounting an area the IASB has periodically revisited without a comprehensive standard ever being finalised.</div>
      </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Current Practice Diversity</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">An enduring gap, addressed differently across jurisdictions</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">In the ABSENCE of specific IFRS guidance, entities today apply general principles (IAS 38, IAS 20, IAS 37, or in some cases IAS 2) by ANALOGY, resulting in DIVERSITY in practice globally. Entities generating or trading emission/carbon credits must therefore develop and consistently apply an accounting policy, disclosing the basis for their approach.</div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Historical disclosure expectations</div>
        <div class="check-list">
          <span>Nature of the emission rights scheme participated in</span>
          <span>Measurement basis for allowances, grants, and the emissions provision</span>
          <span>Amount of any government grant income recognised</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Judgments & Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where judgement historically mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Fair value determination for allowances without an active market</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Estimating actual emissions for provision measurement ahead of final compliance reconciliation</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRIC 3 — Then vs Now</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive historical-to-current comparison</div>
        <div class="td-table">
          <div class="th cols-12-1"><span>Feature</span><span>Status</span></div>
          <div class="tr cols-12-1"><span>Formal binding guidance (2005)</span><span>Mandatory mixed-measurement model</span></div>
          <div class="tr alt cols-12-1"><span>Formal binding guidance (current)</span><span>NONE — entities apply general principles by analogy, resulting in diversity</span></div>
        </div>
        <div class="note">IFRIC 3 remains a notable example of an interpretation withdrawn due to its OWN internal measurement mismatch — the underlying accounting question it addressed remains UNRESOLVED at the formal IFRS level today.</div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where IFRIC 3 items historically appeared</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Item</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Emission allowance intangible asset</span><span><span class="badge bs">Balance Sheet</span></span><span>Under IAS 38</span></div>
          <div class="tr alt cols-16-1-14"><span>Emissions provision</span><span><span class="badge bs">Balance Sheet</span> <span class="badge bp">P&L</span></span><span>Under IAS 37, the source of the volatility mismatch</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 38</span><span>Historically governed emission allowance intangible asset recognition</span></div>
          <div class="tr alt cols-08-2"><span>IAS 37</span><span>Historically governed the emissions obligation provision</span></div>
          <div class="tr cols-08-2"><span>IAS 20</span><span>Historically governed the government grant offset for free allowances</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Carbon credit</div>
          <div class="glossary-def">A generic term for a tradable emission-reduction unit, the broader category of instrument IFRIC 3 addressed for cap-and-trade allowances specifically.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">EU ETS</div>
          <div class="glossary-def">European Union Emissions Trading Scheme — the primary real-world scheme IFRIC 3 was developed to address.</div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Cap-and-trade scheme", definition: "A regulatory mechanism capping total emissions, allocating or auctioning tradable allowances to participants." },
      { term: "Emission allowance", definition: "A tradable right to emit a specified quantity of a pollutant." },
      { term: "Mixed-measurement approach", definition: "IFRIC 3's approach of measuring allowances at fair value (IAS 38) and provisions at market price (IAS 37), creating artificial volatility." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRIC3} />
  </section>
</StandardPageLayout>
