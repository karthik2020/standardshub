---
import StandardLifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import PageToc from "../../../components/PageToc.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import metadata from "../../../data/standards/hgb/drs07.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  subtitle={metadata.nativeTitle}
  framework="hgb"
  status={metadata.status}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Part of the DRS consolidation wave" },
        { id: "s2", label: "Why withdrawn" },
        { id: "s3", label: "Status summary" },
      ]}
    />
  </Fragment>

  <StandardLifecycleNotice
    type="withdrawn"
    explanation="This standard has been withdrawn."
    targetStatus="Replaced by DRS 22"
    link="/germany/drs/drs22"
    linkText="View DRS 22"
  />

  <div class="section-header" id="s1"><span class="num">1</span><h2>Part of the DRS consolidation wave</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card warn">
<div class="ctitle">Part of the DRS consolidation wave</div>
<div class="principle">DRS 7, issued 3 April 2001, elaborated the presentation of consolidated group equity and the group's own comprehensive-income concept — supplementing the Eigenkapitalspiegel (statement of changes in equity) required under §297(1) HGB, established in the earlier HGB poster series. It was last amended in 2010 (DRÄS 5) before its eventual withdrawal.</div>
</div>
  </div>

  <div class="section-header" id="s2"><span class="num">2</span><h2>Why withdrawn — folded into the 2016 equity-specific rewrite</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card info">
<div class="ctitle">Why withdrawn — folded into the 2016 equity-specific rewrite</div>
<div class="principle">DRS 7 was formally withdrawn effective for fiscal years beginning after 31 December 2016, replaced by DRS 22 "Konzerneigenkapital" — announced in the SAME 23 February 2016 Bundesanzeiger notice that also introduced DRS 23 and DRS 24, part of a coordinated three-standard release addressing group equity, capital consolidation, and intangible assets together as a single modernisation package.</div>
</div>
  </div>

  <div class="section-header" id="s3"><span class="num">3</span><h2>Status summary</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card">
<div class="ctitle">Status summary</div>
<div class="td-table">
<div class="th"><span>Field</span><span>Detail</span></div>
<div class="tr"><span>Original topic</span><span>Group equity presentation and the Eigenkapitalspiegel</span></div>
<div class="tr"><span>First issued</span><span>3 April 2001</span></div>
<div class="tr"><span>Withdrawn</span><span>Effective for fiscal years beginning after 31.12.2016</span></div>
<div class="tr"><span>Successor</span><span><strong>DRS 22 — Konzerneigenkapital</strong></span></div>
</div>
</div>
  </div>

</StandardPageLayout>
