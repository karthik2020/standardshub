---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import IAS38Poster from "../../components/posters/IAS38Poster.astro";
import PageToc from "../../components/PageToc.astro";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import "../../styles/posters/poster-classic.css";
---

<StandardPageLayout
  code="IAS 38"
  standardType="IAS"
  title="Intangible Assets"
>
  <Fragment slot="toc">
    <PageToc
      items={[
        {
          id: "overview",
          label: "Overview",
        },
        {
          id: "poster",
          label: "Revision Poster",
        },
        {
          id: "history",
          label: "History & Development",
        },
        {
          id: "related",
          label: "Related Standards",
        },
      ]}
    />
  </Fragment>

  <section id="poster">
    <IAS38Poster />
  </section>

  <section id="history">
    <HistoryTimeline items={history.IAS38} />
  </section>
</StandardPageLayout>
