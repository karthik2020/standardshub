---
// InformationHeader component for StandardsHub
// Displays standard information with metadata

interface Props {
  // Required
  code: string;
  title: string;
  
  // Metadata - optional for flexibility
  issued?: string;
  latestAmendment?: string;
  status?: string;
}

const {
  code,
  title,
  issued = "",
  latestAmendment = "",
  status = "",
} = Astro.props;
---

<section class="information-header">
  <div class="information-header-content">
    <div class="information-header-main">
      <h1 class="information-header-code">{code}</h1>
      <p class="information-header-title">{title}</p>
    </div>
    
    {(issued || latestAmendment || status) && (
      <dl class="information-header-metadata">
        {issued && (
          <div class="metadata-item">
            <dt class="metadata-label">Issued</dt>
            <dd class="metadata-value">{issued}</dd>
          </div>
        )}
        
        {latestAmendment && (
          <div class="metadata-item">
            <dt class="metadata-label">Latest amendment</dt>
            <dd class="metadata-value">{latestAmendment}</dd>
          </div>
        )}
        
        {status && (
          <div class="metadata-item">
            <dt class="metadata-label">Status</dt>
            <dd class="metadata-value">{status}</dd>
          </div>
        )}
      </dl>
    )}
  </div>
</section>

<style>
  .information-header {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  
  .information-header-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  
  .information-header-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  
  .information-header-code {
    font-size: var(--text-hero);
    font-weight: var(--weight-bold);
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
  }
  
  .information-header-title {
    font-size: var(--text-subtitle);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }
  
  .information-header-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }
  
  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 120px;
  }
  
  .metadata-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .metadata-value {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--text);
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .information-header {
      padding: var(--space-lg);
    }
    
    .information-header-code {
      font-size: 32px;
    }
    
    .information-header-title {
      font-size: var(--text-h2);
    }
    
    .information-header-metadata {
      gap: var(--space-lg);
    }
    
    .metadata-item {
      min-width: 100px;
    }
  }
  
  @media (max-width: 480px) {
    .information-header-metadata {
      flex-direction: column;
      gap: var(--space-md);
    }
    
    .metadata-item {
      min-width: auto;
    }
  }
</style>