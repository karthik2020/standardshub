        { id: "s4", label: "The Equity Method – Associates and Joint Ventures" },
        { id: "s5", label: "Determining Significant Influence and Joint Control" },
        { id: "s6", label: "THE KEY DIVERGENCE – Business Combinations Under Common Control" },
        { id: "s7", label: "Why Common-Control Combinations Are So Common in China" },
