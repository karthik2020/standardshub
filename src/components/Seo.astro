---
import { SITE } from "../config/site";
import { resolveSeo } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  /** When true, also emits the viewport meta tag (for pages that own <head>). */
  viewport?: boolean;
}

const { title, description, canonical, robots, viewport = false } = Astro.props;

const seo = resolveSeo({ title, description, canonical, robots }, Astro.url.pathname);
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
<meta name="robots" content={seo.robots} />
<meta name="author" content={SITE.author} />
<meta name="application-name" content={SITE.applicationName} />
{viewport && <meta name="viewport" content="width=device-width, initial-scale=1.0" />}
<meta name="theme-color" content={SITE.themeColor} />
