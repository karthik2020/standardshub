---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas7.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Why This Standard Is Here" },
        { id: "s2", label: "Superseded by IPSAS 36" },
        { id: "s3", label: "Redirect Map" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IPSAS 7, Investments in Associates, was withdrawn as part of the IPSASB's 2015 Consolidation Suite, mirroring the IASB's 2011 revision of IAS 28 (Investments in Associates and Joint Ventures). It was superseded for annual financial statements covering periods beginning on or after 1 January 2017."
    historical="Retained as a numbering placeholder. The 2025 IPSASB Handbook contains only a one-paragraph removal notice for this number; there is no remaining technical content to build a reference poster from. Use IPSAS 36 for current requirements."
    link="/ipsas/ipsas36"
    linkText="IPSAS 36 – Investments in Associates and Joint Ventures"
    currentLabel="Replaced by"
  />

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Why This Standard Is Here</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Removed from the Handbook – retained here only as a numbering placeholder</div>
      <div class="principle">IPSAS 7, <em>Investments in Associates</em>, was withdrawn as part of the IPSASB's 2015 "Consolidation Suite" project, mirroring the IASB's own 2011 revision of IAS 28 (<em>Investments in Associates and Joint Ventures</em>). It was superseded for annual financial statements covering periods beginning on or after <strong>1 January 2017</strong>.</div>
      <div class="callout danger callout--flush">The 2025 IPSASB Handbook now contains only a one-paragraph removal notice for this number – there is no remaining technical content to build a reference poster from. This page exists so the poster library's numbering stays complete and correctly redirects to the live successor Standard.</div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Superseded by IPSAS 36</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cn span2">
      <div class="ctitle cn">Associates and joint ventures unified into one Standard</div>
      <div class="principle">IPSAS 7 prescribed the equity-method accounting for investments in associates. Its requirements – together with what had been IPSAS 8's joint venture equity-accounting content – were consolidated into a single Standard covering both relationship types.</div>
      <div class="spec-box" style="margin-bottom:0;">
        <div class="spec-title">IPSAS 36 – Investments in Associates and Joint Ventures</div>
        <div class="text-supporting">Defines significant influence, requires the equity method for both associates and joint ventures, and sets out impairment and discontinuation-of-equity-method requirements.</div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Redirect Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cs span2">
      <div class="ctitle cs">Withdrawn number → live Standard</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.4fr 1.6fr;"><span>Withdrawn</span><span>Superseded by</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.4fr 1.6fr;"><span>IPSAS 7</span><span><span class="badge bo">IPSAS 36</span></span><span>Periods beginning on/after 1 Jan 2017</span></div>
      </div>
      <div class="note">For current authoritative requirements, see the dedicated standard for IPSAS 36 (Investments in Associates and Joint Ventures) in this library.</div>
    </div>
  </div>
</StandardPageLayout>
