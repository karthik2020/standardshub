---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/sic/sic22.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-22 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-22 was withdrawn in March 2004 when the IASB issued IFRS 3 Business Combinations, which superseded SIC-22 by incorporating a formal measurement period concept directly into IFRS 3, providing clearer guidance on adjusting fair values and goodwill after the acquisition date."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ifrs/ifrs3"
    linkText="IFRS 3 Business Combinations"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-22 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-22 addressed</div>
        <div class="principle">SIC-22 addressed how to account for adjustments to fair values and goodwill after the initial accounting period of a business combination had been completed. It considered whether entities should adjust the amounts recognised for identifiable assets acquired, liabilities assumed and goodwill when new information emerged during the initial accounting period.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-22 concluded that adjustments to fair values and goodwill identified after the acquisition date should be accounted for retrospectively as if they had been known at the acquisition date. The entity should adjust the carrying amounts of the identifiable assets acquired and liabilities assumed, and adjust goodwill accordingly, until the earlier of the end of the measurement period and the date on which all information relevant to the acquisition is obtained.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IFRS 3 Business Combinations</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2004 standard incorporated a formal measurement period concept directly into IFRS 3</span></div>
          <div class="tr"><span>Current status</span><span>Superseded</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Acquisition date", definition: "The date on which the acquirer obtains control of the acquiree, which triggers the initial accounting for a business combination." },
      { term: "Measurement period", definition: "The period after the acquisition date during which the acquirer may adjust the provisional amounts recognised for a business combination, established formally in IFRS 3." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC22} />
  </section>
</StandardPageLayout>




