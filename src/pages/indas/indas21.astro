---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas21.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Functional Currency Determination" },
        { id: "s4", label: "Foreign Currency Transactions" },
        { id: "s5", label: "Exchange Differences — General Rule" },
        { id: "s6", label: "Translation of Foreign Operations" },
        { id: "s7", label: "Historical Capitalisation Option" },
        { id: "s8", label: "Presentation Currency" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 21 vs IAS 21 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical functional currency philosophy to IAS 21</div>
        <div class="principle">Ind AS 21 applies the IDENTICAL principle as IAS 21 — an entity measures its results/financial position in its FUNCTIONAL CURRENCY (the currency of the PRIMARY economic environment it operates in), translating foreign currency transactions and foreign operations using defined mechanical rules.</div>
        <div class="elabel">HOW IND AS 21 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Faithful representation</strong> — reflecting the economic environment the entity actually operates in — identical to IAS 21</span>
          <span><strong>The historical capitalisation option</strong> — India's MCA permitted entities that were ALREADY following the previous Indian GAAP practice of capitalising exchange differences on LONG-TERM foreign currency monetary items (relating to depreciable assets) to CONTINUE this policy for a TRANSITIONAL period, rather than immediately switching to IAS 21's mandatory P&amp;L recognition — a genuinely significant historical divergence, now LARGELY TIME-EXPIRED</span>
        </div>
        <div class="note">This capitalisation option was a TRANSITIONAL relief tied to specific historical dates, not an ongoing feature of Ind AS 21 — for MOST Indian entities today, Ind AS 21's exchange difference treatment is now IDENTICAL to IAS 21's own mandatory P&amp;L recognition rule.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The general exchange difference rule — identical to IAS 21</div>
        <div class="formula-box"><div class="f-eq">Exchange differences on monetary items = Recognised in P&amp;L in the period they arise</div></div>
        <div class="callout info callout--flush">IDENTICAL to IAS 21 for the VAST MAJORITY of transactions and entities today — the historical capitalisation option was a narrow, time-bound exception.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 21 covers</div>
        <div class="principle">Ind AS 21 applies to accounting for transactions/balances in foreign currencies, and translating foreign operations' results/financial position — IDENTICAL scope to IAS 21.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item">
          <div class="glossary-term">Functional currency</div>
          <div class="glossary-def">IDENTICAL definition to IAS 21 — the currency of the primary economic environment in which the entity operates.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Long-term foreign currency monetary item</div>
          <div class="glossary-def">A monetary item with a settlement term of 12 months or more, historically eligible for the Indian capitalisation option.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — FUNCTIONAL CURRENCY DETERMINATION ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Functional Currency Determination</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical primary/secondary indicators to IAS 21</div>
        <div class="text-supporting">Primary indicators (currency mainly influencing sales prices, costs) and secondary indicators (financing, retained receipts) are IDENTICAL to IAS 21 — the RUPEE is the functional currency for most standalone Indian entities operating domestically.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — FOREIGN CURRENCY TRANSACTIONS ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Foreign Currency Transactions — Initial &amp; Subsequent Measurement (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical measurement rules to IAS 21</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Foreign currency purchase and year-end retranslation</div>
          <div class="wk-body">An Indian importer purchases goods for USD 1,00,000 when the spot rate is ₹83/USD, with the payable still outstanding at year-end when the rate has moved to ₹85/USD.</div>
          <div class="wk-answer">Initial recognition: ₹83,00,000. At year-end, the MONETARY payable is RETRANSLATED at the closing rate to ₹85,00,000, with the ₹2,00,000 exchange LOSS recognised in P&amp;L — an IDENTICAL mechanism to how IAS 21 would treat the same transaction globally (in the absence of any historical capitalisation election).</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — EXCHANGE DIFFERENCES ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Exchange Differences — General Rule</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 21</div>
        <div class="text-supporting">Monetary items are retranslated at CLOSING rates; non-monetary items measured at historical cost remain at the TRANSACTION date rate — IDENTICAL to IAS 21, with exchange differences on monetary items recognised in P&amp;L (subject to the narrow historical exception in Section 7).</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — TRANSLATION OF FOREIGN OPERATIONS ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Translation of Foreign Operations</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 21</div>
        <div class="text-supporting">Assets/liabilities translated at closing rate; income/expenses at transaction date (or average) rate; resulting exchange differences recognised in OCI (foreign currency translation reserve) — IDENTICAL to IAS 21.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — HISTORICAL CAPITALISATION OPTION ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>The Historical Long-Term Monetary Item Capitalisation Option (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely significant, though now largely time-expired, Indian divergence</div>
        <div class="principle">India's MCA permitted entities to CONTINUE an option (originating from previous Indian GAAP practice under the old AS 11) to CAPITALISE exchange differences on LONG-TERM foreign currency monetary items relating to the acquisition of DEPRECIABLE capital assets, adding them to the asset's cost and depreciating them over its remaining useful life — rather than IAS 21's own mandatory IMMEDIATE P&amp;L recognition. This option was available only to entities ALREADY following this accounting policy before transitioning to Ind AS, and applied only for a DEFINED transitional window that has now LARGELY EXPIRED for most companies.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: Historical capitalisation illustration</div>
          <div class="wk-body">An Indian company that had historically capitalised exchange losses under old Indian GAAP had an outstanding foreign currency term loan (used to finance imported machinery) generating a ₹50,00,000 exchange LOSS in a year, during the period the transitional option remained available.</div>
          <div class="wk-answer">Under the HISTORICAL Ind AS 21 transitional option, this ₹50,00,000 could be ADDED to the machinery's carrying amount and depreciated over its remaining life, rather than expensed immediately — a treatment with NO IAS 21 equivalent. For entities and periods where this option has now EXPIRED, the exchange difference is expensed immediately in P&amp;L, IDENTICAL to IAS 21.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — PRESENTATION CURRENCY ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Presentation Currency</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IAS 21</div>
        <div class="text-supporting">An entity may present financial statements in ANY currency, translating from functional to presentation currency using the SAME mechanics as translating a foreign operation — IDENTICAL to IAS 21.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical disclosure requirements to IAS 21</div>
        <div class="check-list">
          <span>Net exchange differences recognised in P&amp;L</span>
          <span>Net exchange differences in a separate OCI/equity component</span>
          <span>Reasons for any change in functional currency</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Functional currency determination for entities with mixed economic indicators</span>
              <span>Confirming whether any historical capitalisation election remains available/relevant to the entity</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>None typically significant beyond exchange rate application itself</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--warn-flush">Most Indian entities today should confirm the historical capitalisation option has EXPIRED for their specific facts — applying it beyond its intended transitional window would be a departure from current Ind AS 21 requirements.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 21 vs IAS 21 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 21 vs IAS 21 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IAS 21</span><span>Ind AS 21</span></div>
          <div class="tr cols-12-1-1"><span>Functional currency, general exchange difference rule, foreign operation translation</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt cols-12-1-1"><span>Long-term monetary item exchange difference treatment</span><span>Mandatory immediate P&amp;L recognition, no capitalisation option</span><span>Historically permitted an OPTIONAL capitalisation exemption for qualifying entities — now LARGELY TIME-EXPIRED</span></div>
        </div>
        <div class="note">Ind AS 21's ONGOING requirements are essentially IDENTICAL to IAS 21 — the capitalisation option was a genuinely significant but NARROW, TIME-BOUND historical transitional divergence, not a permanent feature of the standard.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Monetary item exchange difference</span><span><span class="badge bp">P&amp;L</span></span><span>Identical to IAS 21 (for current, non-historical-option entities)</span></div>
          <div class="tr alt cols-16-1-14"><span>Foreign operation translation difference</span><span><span class="badge bo">OCI</span> <span class="badge be">Equity</span></span><span>Identical to IAS 21</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 21</span><span>The global counterpart standard, converged with a historical transitional divergence</span></div>
          <div class="tr alt cols-08-2"><span>Ind AS 16</span><span>Historically interacted with the long-term monetary item capitalisation option for depreciable assets</span></div>
          <div class="tr cols-08-2"><span>Ind AS 109</span><span>Governs financial instrument-level foreign currency exposures</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Monetary items</div>
          <div class="glossary-def">Units of currency held and assets/liabilities to be received/paid in a fixed/determinable number of currency units — identical to IAS 21.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Foreign currency translation reserve</div>
          <div class="glossary-def">The OCI/equity component accumulating translation differences on foreign operations — identical to IAS 21.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Functional currency", definition: "The currency of the primary economic environment in which the entity operates — identical to IAS 21." },
      { term: "Long-term foreign currency monetary item", definition: "A monetary item with a settlement term of 12 months or more, historically eligible for the Indian capitalisation option." },
      { term: "Monetary items", definition: "Units of currency held and assets/liabilities to be received/paid in a fixed/determinable number of currency units — identical to IAS 21." },
      { term: "Foreign currency translation reserve", definition: "The OCI/equity component accumulating translation differences on foreign operations — identical to IAS 21." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
