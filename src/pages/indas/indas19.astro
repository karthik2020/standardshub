---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas19.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Short-Term vs Long-Term Employee Benefits" },
        { id: "s4", label: "Defined Contribution Plans" },
        { id: "s5", label: "Defined Benefit Plans – Projected Unit Credit Method" },
        { id: "s6", label: "Remeasurements – OCI Treatment" },
        { id: "s7", label: "Gratuity Act & EPFO Interest Guarantee – Indian Plan Classification" },
        { id: "s8", label: "Termination Benefits" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 19 vs IAS 19 – Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 – CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical actuarial measurement philosophy to IAS 19</div>
        <div class="principle">Ind AS 19 applies the IDENTICAL principle as IAS 19 – employee benefit obligations are recognised as the SERVICE is rendered, using the PROJECTED UNIT CREDIT METHOD for defined benefit plans, with remeasurements recognised in OCI (not recycled to P&amp;L).</div>
        <div class="elabel">HOW IND AS 19 MAPS TO THE FRAMEWORK</div>
        <div class="check-list"><span><strong>Faithful representation</strong> – recognising the true cost of employee service as earned – identical to IAS 19</span><span><strong>EPFO interest guarantee classification</strong> – where an Indian Provident Fund arrangement (e.g. company-managed PF trusts under EPFO oversight) carries a STATUTORY GUARANTEE of a minimum interest rate, and the fund's actual returns are insufficient to meet that guarantee, the EMPLOYER bears the shortfall risk – meaning the arrangement may need to be classified as a DEFINED BENEFIT plan (not defined contribution) under Ind AS 19's own definitional test, IDENTICAL in principle to how IAS 19 would classify a comparable guaranteed-return arrangement anywhere globally</span></div>
        <div class="note">This is NOT a divergence in Ind AS 19's own classification PRINCIPLES from IAS 19 – it is a genuinely Indian APPLICATION consideration, since EPFO's guaranteed-return PF structure is a specifically Indian institutional feature.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Four employee benefit categories – identical to IAS 19</div>
        <div class="td-table"><div class="th cols-13-1"><span>Category</span><span>Example</span></div>
          <div class="tr cols-13-1"><span>Short-term</span><span>Wages, paid annual leave</span></div>
          <div class="tr alt cols-13-1"><span>Post-employment</span><span>Gratuity, pension, PF</span></div>
          <div class="tr cols-13-1"><span>Other long-term</span><span>Long-service awards, sabbatical leave</span></div>
          <div class="tr alt cols-13-1"><span>Termination</span><span>Severance, redundancy payments</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 – SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw"><div class="ctitle cw">What Ind AS 19 covers</div><div class="principle">Ind AS 19 applies to all employee benefits except those within Ind AS 102's scope (share-based payment) – IDENTICAL scope to IAS 19.</div><div class="note">Genuinely significant for Indian employers given the Gratuity Act's mandatory nature and PF's widespread applicability.</div></div>
      <div class="card cd"><div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Gratuity</div><div class="glossary-def">A statutory defined benefit under the Payment of Gratuity Act, 1972, mandatory for most Indian employers with 10+ employees.</div></div>
        <div class="glossary-item"><div class="glossary-term">EPFO</div><div class="glossary-def">Employees' Provident Fund Organisation – India's statutory body administering employee provident fund schemes, some carrying an interest rate guarantee.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 – SHORT-TERM VS LONG-TERM ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Short-Term vs Long-Term Employee Benefits</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Identical to IAS 19</div><div class="text-supporting">Short-term benefits (settled within 12 months) are recognised undiscounted; other long-term benefits use actuarial measurement WITHOUT the OCI remeasurement mechanism (all remeasurements go through P&amp;L) – IDENTICAL to IAS 19.</div></div></div>

    <!-- ============ SECTION 4 – DEFINED CONTRIBUTION PLANS ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Defined Contribution Plans</h2><span class="line"></span></div>
    <div class="grid"><div class="card cs span2"><div class="ctitle cs">Identical to IAS 19</div><div class="text-supporting">Contributions are expensed as payable, with NO further obligation once paid – IDENTICAL to IAS 19, applicable to standard (non-guaranteed) Indian PF/pension contribution arrangements.</div></div></div>

    <!-- ============ SECTION 5 – DEFINED BENEFIT PLANS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Defined Benefit Plans – Projected Unit Credit Method (with worked example)</h2><span class="line"></span></div>
    <div class="grid"><div class="card cd span2"><div class="ctitle cd">Identical actuarial methodology to IAS 19</div>
      <div class="worked worked--flush"><div class="wk-title">Example 1: Gratuity obligation measurement</div><div class="wk-body">An Indian company has a gratuity obligation under the Payment of Gratuity Act, requiring an independent actuary to determine the present value of the defined benefit obligation using the projected unit credit method, discounted at the yield on Indian government bonds of matching duration.</div><div class="wk-answer">The projected unit credit method attributes benefit to periods of service, discounted using a HIGH-QUALITY CORPORATE BOND yield (or, in the ABSENCE of a deep corporate bond market as in India, GOVERNMENT bond yields) – an IDENTICAL discount rate selection principle to IAS 19's own fallback rule for markets without a deep corporate bond market.</div></div>
    </div></div>

    <!-- ============ SECTION 6 – REMEASUREMENTS – OCI ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Remeasurements – OCI Treatment</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Identical to IAS 19</div><div class="text-supporting">Actuarial gains/losses and return on plan assets (excluding amounts in net interest) are recognised in OCI, NEVER recycled to P&amp;L – IDENTICAL to IAS 19's revised (post-2011 amendment) treatment.</div></div></div>

    <!-- ============ SECTION 7 – GRATUITY ACT & EPFO GUARANTEE ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Gratuity Act &amp; EPFO Interest Guarantee – Indian Plan Classification (with worked example)</h2><span class="line"></span></div>
    <div class="grid"><div class="card cw span2"><div class="ctitle cw">The single most important Indian application nuance</div>
      <div class="principle">Many Indian employers maintain their OWN Provident Fund trusts (rather than depositing directly with the government EPFO scheme), which are required to provide a return AT LEAST equal to the EPFO-notified interest rate. If the trust's own investment returns fall SHORT of this guaranteed rate, the EMPLOYER is obligated to make up the shortfall – meaning the arrangement carries INVESTMENT and ACTUARIAL RISK for the employer, the defining characteristic of a DEFINED BENEFIT plan under Ind AS 19's own classification test (IDENTICAL to IAS 19's own test).</div>
      <div class="worked worked--flush"><div class="wk-title">Example 2: Company-managed PF trust with a shortfall guarantee</div><div class="wk-body">An Indian company operates its OWN PF trust, guaranteeing the EPFO-notified rate of 8.25% to employees. In a particular year, the trust's actual investment returns are only 7.10%, requiring the company to fund the 1.15% shortfall from its own resources.</div><div class="wk-answer">Because the EMPLOYER bears this INVESTMENT RISK, the arrangement is classified as a DEFINED BENEFIT plan requiring actuarial valuation under Ind AS 19's projected unit credit method – NOT simple defined contribution expensing – an application of Ind AS 19's classification test IDENTICAL to IAS 19, but arising specifically from India's EPFO guarantee structure.</div></div>
    </div></div>

    <!-- ============ SECTION 8 – TERMINATION BENEFITS ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Termination Benefits</h2><span class="line"></span></div>
    <div class="grid"><div class="card cn span2"><div class="ctitle cn">Identical to IAS 19</div><div class="text-supporting">Recognised at the earlier of when the offer cannot be withdrawn, or when related restructuring costs are recognised under Ind AS 37 – IDENTICAL to IAS 19.</div></div></div>

    <!-- ============ SECTION 9 – DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid"><div class="card cd span2"><div class="ctitle cd">Identical disclosure requirements to IAS 19</div><div class="check-list"><span>Characteristics of defined benefit plans and associated risks</span><span>Reconciliation of defined benefit obligation and plan assets</span><span>Actuarial assumptions and sensitivity analysis</span></div></div></div>

    <!-- ============ SECTION 10 – JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid"><div class="card cn span2"><div class="ctitle cn">Where management judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Defined benefit vs defined contribution classification for guaranteed-return PF arrangements</span><span>Discount rate benchmark selection in markets without a deep corporate bond market</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Discount rate, salary growth rate, attrition/mortality assumptions</span></div></div></div>
      <div class="callout warn callout--warn-flush">Many Indian companies use GOVERNMENT security (G-Sec) yields as the discount rate benchmark for gratuity/PF valuations, given the absence of a deep, high-quality corporate bond market – consistent with IAS 19's own fallback provision.</div>
    </div></div>

    <!-- ============ SECTION 11 – IND AS 19 vs IAS 19 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 19 vs IAS 19 – Full Comparison</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Comprehensive comparison table</div>
      <div class="td-table"><div class="th cols-12-1-1"><span>Feature</span><span>IAS 19</span><span>Ind AS 19</span></div>
        <div class="tr cols-12-1-1"><span>Projected unit credit method, OCI remeasurements</span><span>Standard model</span><span>IDENTICAL – no substantive divergence</span></div>
        <div class="tr alt cols-12-1-1"><span>Guaranteed-return PF plan classification</span><span>Same classification test applies to any comparable guaranteed-return arrangement globally</span><span>EPFO's interest rate guarantee is a specifically Indian institutional feature commonly triggering defined benefit classification</span></div>
      </div>
      <div class="note">Ind AS 19's classification PRINCIPLES are essentially IDENTICAL to IAS 19 – the EPFO guarantee scenario is a genuinely Indian APPLICATION context, not a divergence in the standard's own rules.</div>
    </div></div>

    <!-- ============ SECTION 12 – STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid"><div class="card cs span2"><div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
      <div class="td-table"><div class="th cols-16-1-14"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
        <div class="tr cols-16-1-14"><span>Current/past service cost, net interest</span><span><span class="badge bp">P&amp;L</span></span><span>Identical to IAS 19</span></div>
        <div class="tr alt cols-16-1-14"><span>Actuarial remeasurements</span><span><span class="badge bo">OCI</span></span><span>Never recycled to P&amp;L, identical to IAS 19</span></div>
        <div class="tr cols-16-1-14"><span>Net defined benefit liability/asset</span><span><span class="badge bs">Balance Sheet</span></span><span>Identical to IAS 19</span></div>
      </div>
    </div></div>

    <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
        <div class="td-table"><div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IAS 19</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt cols-08-2"><span>Payment of Gratuity Act, 1972</span><span>The statutory source of India's mandatory gratuity defined benefit obligation</span></div>
          <div class="tr cols-08-2"><span>Ind AS 37</span><span>Governs restructuring provisions interacting with termination benefit recognition</span></div>
        </div>
      </div>
      <div class="card cn"><div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Projected unit credit method</div><div class="glossary-def">The actuarial valuation technique attributing benefit to periods of service – identical to IAS 19.</div></div>
        <div class="glossary-item"><div class="glossary-term">EPFO-notified rate</div><div class="glossary-def">The annually announced interest rate EPFO-administered/guaranteed PF trusts must credit to employee accounts.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 – GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Gratuity", definition: "A statutory defined benefit under the Payment of Gratuity Act, 1972, mandatory for most Indian employers with 10+ employees." },
      { term: "EPFO", definition: "Employees' Provident Fund Organisation – India's statutory body administering employee provident fund schemes, some carrying an interest rate guarantee." },
      { term: "Projected unit credit method", definition: "The actuarial valuation technique attributing benefit to periods of service – identical to IAS 19." },
      { term: "EPFO-notified rate", definition: "The annually announced interest rate EPFO-administered/guaranteed PF trusts must credit to employee accounts." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
