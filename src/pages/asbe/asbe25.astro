  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Scope — Direct Insurance, Not Reinsurance" },
        { id: "s3", label: "3. The General Measurement Model — the Building Block Approach" },
        { id: "s4", label: "4. Fulfilment Cash Flows" },
        { id: "s5", label: "5. The Contractual Service Margin (CSM)" },
        { id: "s6", label: "6. The Premium Allocation Approach — a Simplified Alternative" },
        { id: "s7", label: "7. A Structural Divergence — Two Separate Standards, Not One" },
        { id: "s8", label: "8. Worked Example — Recognising the Contractual Service Margin" },
        { id: "s9", label: "9. Worked Example — Applying the Premium Allocation Approach" },
        { id: "s10", label: "10. Disclosure Requirements" },
        { id: "s11", label: "11. Critical Judgments &amp; Estimates" },
        { id: "s12", label: "12. Relationship to IFRS 17" },
