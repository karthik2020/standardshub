---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas24.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Identifying Related Parties" },
        { id: "s4", label: "Key Management Personnel" },
        { id: "s5", label: "Related Party Transactions" },
        { id: "s6", label: "Government-Related Entities Exemption" },
        { id: "s7", label: "Companies Act KMP Alignment" },
        { id: "s8", label: "Pricing of Related Party Transactions" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "Ind AS 24 vs IAS 24 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINK ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical transparency philosophy to IAS 24</div>
        <div class="principle">Ind AS 24 applies the IDENTICAL principle as IAS 24 — financial statements must disclose the POSSIBILITY that an entity's financial position/performance may have been affected by the EXISTENCE of related parties and by transactions with them, even in the ABSENCE of actual transactions.</div>
        <div class="elabel">HOW IND AS 24 MAPS TO THE FRAMEWORK</div>
        <div class="check-list"><span><strong style="font-weight:500">Transparency</strong> — related party relationships can affect an entity's profit/loss and financial position even without any actual transactions — identical to IAS 24</span><span><strong style="font-weight:500">KMP alignment with Companies Act</strong> — Indian practice interprets "key management personnel" CONSISTENTLY with the Companies Act, 2013's Section 2(51) statutory definition, which SPECIFICALLY enumerates roles (Managing Director, Whole-time Director, CFO, Company Secretary, CEO) — a more PRESCRIPTIVE identification than IAS 24's own broader "authority and responsibility for planning, directing, controlling" test</span></div>
        <div class="note">This is NOT a divergence in Ind AS 24's own underlying PRINCIPLE from IAS 24 — it is a genuinely Indian INTERPRETIVE alignment, anchoring the broader IAS 24 concept to specific statutory roles under company law.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Related party categories — identical to IAS 24</div>
        <div class="td-table"><div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Category</span><span>Example</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Entities with control/joint control/significant influence</span><span>Parent, subsidiary, associate, JV</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Key management personnel</span><span>Directors, CFO, CEO, Company Secretary</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Close family members of KMP</span><span>Spouse, children, dependants</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw"><div class="ctitle cw">What Ind AS 24 covers</div><div class="principle">Ind AS 24 applies to identifying related party relationships/transactions, outstanding balances, and circumstances requiring disclosure — IDENTICAL scope to IAS 24.</div></div>
      <div class="card cd"><div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Related party</div><div class="glossary-def">IDENTICAL definition to IAS 24 — a person/entity related to the reporting entity via control, joint control, significant influence, or KMP status.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">KMP (Companies Act sense)</div><div class="glossary-def">Specific statutory roles enumerated under Section 2(51) of the Companies Act, 2013.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — IDENTIFYING RELATED PARTIES ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Identifying Related Parties</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Identical to IAS 24</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Substance-based identification, considering control, joint control, and significant influence relationships (cross-referencing Ind AS 110, 111, 28) — IDENTICAL to IAS 24.</div></div></div>

    <!-- ============ SECTION 4 — KEY MANAGEMENT PERSONNEL (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Key Management Personnel (with worked example)</h2><span class="line"></span></div>
    <div class="grid"><div class="card cs span2"><div class="ctitle cs">Broader IAS 24 principle, applied via Companies Act specifics in India</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example 1: Identifying KMP for an Indian listed company</div><div class="wk-body">An Indian listed company has a Managing Director, a CFO, a Company Secretary, and a Non-Executive Independent Director who does not participate in day-to-day management decisions.</div><div class="wk-answer">The Managing Director, CFO, and Company Secretary are KMP under BOTH the Companies Act, 2013's statutory definition AND IAS 24's broader "authority/responsibility" test. The Non-Executive Independent Director is ALSO typically included as KMP under the Companies Act's definition (which specifically includes directors), even though their day-to-day operational involvement might be more limited than IAS 24's own principles-based test alone might suggest — illustrating the Indian statutory alignment's slightly BROADER practical net for board members.</div></div>
    </div></div>

    <!-- ============ SECTION 5 — RELATED PARTY TRANSACTIONS ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Related Party Transactions</h2><span class="line"></span></div>
    <div class="grid"><div class="card cd span2"><div class="ctitle cd">Identical to IAS 24</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">A transfer of resources, services, or obligations between a reporting entity and a related party, REGARDLESS of whether a price is charged — IDENTICAL definition to IAS 24.</div></div></div>

    <!-- ============ SECTION 6 — GOVERNMENT-RELATED ENTITIES EXEMPTION ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Government-Related Entities Exemption</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Identical to IAS 24</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Reduced disclosure requirements for transactions with OTHER government-related entities (where the reporting entity is itself government-related) — IDENTICAL exemption to IAS 24, RELEVANT for India's extensive public sector undertaking (PSU) landscape.</div></div></div>

    <!-- ============ SECTION 7 — COMPANIES ACT KMP ALIGNMENT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Companies Act KMP Alignment — The Indian Divergence Point</h2><span class="line"></span></div>
    <div class="grid"><div class="card cw span2"><div class="ctitle cw">A genuinely important interpretive alignment</div>
      <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Section 2(51) of the Companies Act, 2013 provides a SPECIFIC, enumerated list of roles constituting KMP (CEO, Managing Director, Whole-time Director, CFO, Company Secretary, and any officer notified by the Central Government) — a more PRESCRIPTIVE, statute-anchored identification than IAS 24's own broader "authority and responsibility for planning, directing, controlling" functional test. In PRACTICE, Indian preparers typically ensure their Ind AS 24 KMP population is CONSISTENT with (and generally at least as broad as) this Companies Act list, given the overlapping compliance context (e.g. Schedule V managerial remuneration disclosures, Section 188 related party transaction approval requirements).</div>
    </div></div>

    <!-- ============ SECTION 8 — PRICING ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Pricing of Related Party Transactions</h2><span class="line"></span></div>
    <div class="grid"><div class="card cn span2"><div class="ctitle cn">Identical to IAS 24</div><div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Ind AS 24 does NOT require related party transactions to be at arm's length, nor does it prescribe pricing methodologies — IDENTICAL to IAS 24, though Indian companies separately navigate transfer pricing requirements under the Income Tax Act for TAX purposes, a distinct regulatory layer from Ind AS 24 itself.</div></div></div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid"><div class="card cd span2"><div class="ctitle cd">Identical disclosure requirements to IAS 24</div><div class="check-list"><span>Parent-subsidiary relationships disclosed regardless of transactions</span><span>KMP compensation by category (short-term, post-employment, share-based)</span><span>Nature of relationship and transaction details for material related party transactions</span></div></div></div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid"><div class="card cn span2"><div class="ctitle cn">Where management judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Identifying the complete KMP population consistent with both Ind AS 24 and Companies Act requirements</span><span>Assessing significant influence for less obvious related party relationships</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>None typically significant — Ind AS 24 is primarily a disclosure standard</span></div></div></div>
      <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ Indian companies must also separately track Section 188 Companies Act approval requirements for MATERIAL related party transactions — a compliance obligation layered ALONGSIDE, not replacing, Ind AS 24's own disclosure requirements.</div>
    </div></div>

    <!-- ============ SECTION 11 — IND AS 24 vs IAS 24 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 24 vs IAS 24 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid"><div class="card ci span2"><div class="ctitle ci">Comprehensive comparison table</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IAS 24</span><span style="color:var(--color-text-success);">Ind AS 24</span></div>
        <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Related party identification, transaction disclosure, government-related exemption</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
        <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>KMP definition anchor</span><span>Broad, principles-based functional test</span><span>Practically aligned with Companies Act, 2013 Section 2(51)'s specific enumerated roles</span></div>
      </div>
      <div class="note">Ind AS 24's UNDERLYING principles are essentially IDENTICAL to IAS 24 — the KMP alignment is a genuinely Indian INTERPRETIVE practice anchoring the standard's own broader test to specific statutory company law roles.</div>
    </div></div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid"><div class="card cs span2"><div class="ctitle cs">Where every Ind AS 24 disclosure lands</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Disclosure item</span><span>Location</span><span>Notes</span></div>
        <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Related party relationships and transactions</span><span><span class="badge bp">Notes</span></span><span>Identical to IAS 24</span></div>
        <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>KMP compensation</span><span><span class="badge bp">Notes</span></span><span>Categorised by type, identical to IAS 24</span></div>
      </div>
    </div></div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
        <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 24</span><span>The global counterpart standard, converged with an interpretive KMP alignment</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 2(51), 188, Schedule V (Companies Act, 2013)</span><span>Supplies the statutory KMP definition and related party transaction approval/remuneration requirements</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 110 / 111 / 28</span><span>Supply the control/joint control/significant influence tests underlying related party identification</span></div>
        </div>
      </div>
      <div class="card cn"><div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Close family members</div><div class="glossary-def">Family members expected to influence/be influenced by a person in dealings with the entity — identical to IAS 24.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Section 188</div><div class="glossary-def">The Companies Act, 2013 provision requiring board/shareholder approval for material related party transactions.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Related party", definition: "IDENTICAL definition to IAS 24 — a person/entity related to the reporting entity via control, joint control, significant influence, or KMP status." },
      { term: "KMP (Companies Act sense)", definition: "Specific statutory roles enumerated under Section 2(51) of the Companies Act, 2013." },
      { term: "Close family members", definition: "Family members expected to influence/be influenced by a person in dealings with the entity — identical to IAS 24." },
      { term: "Section 188", definition: "The Companies Act, 2013 provision requiring board/shareholder approval for material related party transactions." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
