---
/*
  StandardStatus

  Represents the review/publication status of the StandardsHub page.

  Props:
  - status: "published" | "under-review" | "draft" | "archived"
  - reviewed?: string – e.g. "12 July 2026"
  - description?: string – overrides the default description for the status

  Example:
    <StandardStatus status="published" reviewed="12 July 2026" />
*/

import {
  CheckCircle,
  Clock,
  FileEdit,
  Archive,
} from "@lucide/astro";

interface Props {
  status: "published" | "under-review" | "draft" | "archived";
  reviewed?: string;
  description?: string;
}

const { status, reviewed, description } = Astro.props;

const statusConfig = {
  published: {
    label: "Published",
    icon: CheckCircle,
    iconColor: "var(--color-text-success)",
    defaultDescription: "This page reflects the latest reviewed version of this educational summary.",
  },
  "under-review": {
    label: "Under Review",
    icon: Clock,
    iconColor: "var(--color-text-warning)",
    defaultDescription: "This content is currently being reviewed and may be updated.",
  },
  draft: {
    label: "Draft",
    icon: FileEdit,
    iconColor: "var(--text-muted)",
    defaultDescription: "This content is a draft and has not yet been reviewed.",
  },
  archived: {
    label: "Archived",
    icon: Archive,
    iconColor: "var(--text-muted)",
    defaultDescription: "This content has been archived and is no longer maintained.",
  },
};

const config = statusConfig[status];
const Icon = config.icon;
const resolvedDescription = description ?? config.defaultDescription;
---

<div class="standard-status">
  <span class="standard-status__icon" style="color: {config.iconColor}">
    <Icon size={16} strokeWidth={1.5} />
  </span>
  <div class="standard-status__body">
    <div class="standard-status__header">
      <span class="standard-status__label">{config.label}</span>
      {reviewed && (
        <span class="standard-status__reviewed">Reviewed on {reviewed}</span>
      )}
    </div>
    <p class="standard-status__description">{resolvedDescription}</p>
  </div>
</div>

<style>
  .standard-status {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    margin-bottom: var(--space-lg);
  }

  .standard-status__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .standard-status__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .standard-status__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .standard-status__label {
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    color: var(--text);
    line-height: 1.3;
  }

  .standard-status__reviewed {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.4;
  }

  .standard-status__description {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
