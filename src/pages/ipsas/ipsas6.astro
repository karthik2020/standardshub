---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas6.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Why This Standard Is Here" },
        { id: "s2", label: "Superseded by IPSAS 34 & IPSAS 35" },
        { id: "s3", label: "Redirect Map" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IPSAS 6, Consolidated and Separate Financial Statements, was withdrawn as part of the IPSASB's 2015 Consolidation Suite, mirroring the IASB's 2011 replacement of IAS 27 with IFRS 10 and IAS 27 (2011). It was superseded for annual financial statements covering periods beginning on or after 1 January 2017."
    historical="Retained as a numbering placeholder. The 2025 IPSASB Handbook contains only a one-paragraph removal notice for this number; there is no remaining technical content to build a reference poster from. Use IPSAS 34 and IPSAS 35 for current requirements."
    link="/ipsas/ipsas35"
    linkText="IPSAS 35 – Consolidated Financial Statements"
    currentLabel="Replaced by"
  />

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Why This Standard Is Here</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Removed from the Handbook – retained here only as a numbering placeholder</div>
      <div class="principle">IPSAS 6, <em>Consolidated and Separate Financial Statements</em>, was withdrawn as part of the IPSASB's 2015 "Consolidation Suite" project, mirroring the IASB's own 2011 replacement of IAS 27 with IFRS 10 and IAS 27 (2011). It was superseded for annual financial statements covering periods beginning on or after <strong>1 January 2017</strong>.</div>
      <div class="callout danger callout--flush">The 2025 IPSASB Handbook now contains only a one-paragraph removal notice for this number – there is no remaining technical content to build a reference poster from. This page exists so the poster library's numbering stays complete and correctly redirects to the live successor Standards.</div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Superseded by IPSAS 34 &amp; IPSAS 35</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cn span2">
      <div class="ctitle cn">One Standard split into two focused Standards</div>
      <div class="principle">IPSAS 6 originally set out when a controlling entity presents consolidated financial statements, how to account for changes in the level of ownership interest, and the requirements for preparing separate financial statements. Its content was split:</div>
      <div class="two-col">
        <div class="spec-box" style="margin-bottom:0;">
          <div class="spec-title">IPSAS 34 – Separate Financial Statements</div>
          <div class="text-supporting">Accounting for investments in controlled entities, joint ventures, and associates when an entity prepares separate (non-consolidated) financial statements.</div>
        </div>
        <div class="spec-box" style="margin-bottom:0;">
          <div class="spec-title">IPSAS 35 – Consolidated Financial Statements</div>
          <div class="text-supporting">The control model, consolidation procedures, and non-controlling interest presentation for a controlling entity's consolidated statements.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Redirect Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cs span2">
      <div class="ctitle cs">Withdrawn number → live Standard</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.4fr 1.6fr;"><span>Withdrawn</span><span>Superseded by</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.4fr 1.6fr;"><span>IPSAS 6</span><span><span class="badge bs">IPSAS 34</span> <span class="badge bs">IPSAS 35</span></span><span>Periods beginning on/after 1 Jan 2017</span></div>
      </div>
      <div class="note">For current authoritative requirements, see the dedicated standards for IPSAS 34 (Separate Financial Statements) and IPSAS 35 (Consolidated Financial Statements) in this library.</div>
    </div>
  </div>
</StandardPageLayout>
