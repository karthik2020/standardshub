---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas115.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "The Five-Step Model" },
        { id: "s4", label: "Identifying Performance Obligations" },
        { id: "s5", label: "Determining & Allocating Transaction Price" },
        { id: "s6", label: "Recognising Revenue — Point in Time vs Over Time" },
        { id: "s7", label: "Disclosure Relaxations for Unlisted Indian Companies" },
        { id: "s8", label: "Contract Costs" },
        { id: "s9", label: "Disclosure" },
        { id: "s10", label: "Judgments & Estimates" },
        { id: "s11", label: "Ind AS 115 vs IFRS 15 — Full Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK LINKAGE ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical control-based recognition philosophy to IFRS 15</div>
        <div class="principle">Ind AS 115 applies the IDENTICAL core principle as IFRS 15 — revenue is recognised to depict the transfer of promised goods/services to customers in an amount reflecting the CONSIDERATION the entity expects to be entitled to, replacing the old risks-and-rewards-based approach with a CONTROL-based five-step model.</div>
        <div class="elabel">HOW IND AS 115 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Faithful representation</strong> — depicting the genuine pattern of value transfer to customers — identical to IFRS 15</span>
          <span><strong style="font-weight:500">Comparability</strong> — a single revenue model replacing the numerous prior industry-specific standards (construction contracts, real estate guidance) — identical to IFRS 15</span>
          <span><strong style="font-weight:500">Cost constraint for smaller Indian entities</strong> — India provides certain DISCLOSURE-LEVEL relaxations for companies whose debt/equity instruments are NOT listed, reducing the burden of some of Ind AS 115's more extensive disaggregated revenue disclosures for this population — a genuinely distinctive Indian cost-benefit calibration</span>
        </div>
        <div class="note">Ind AS 115's RECOGNITION AND MEASUREMENT principles carry over from IFRS 15 without substantive modification — the meaningful Indian difference sits entirely in the DISCLOSURE layer for certain unlisted entities (Section 7).</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The five-step model — identical to IFRS 15</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.3fr 1.8fr;"><span>Step</span><span>Action</span></div>
          <div class="tr" style="grid-template-columns:0.3fr 1.8fr;"><span>1</span><span>Identify the contract with a customer</span></div>
          <div class="tr alt" style="grid-template-columns:0.3fr 1.8fr;"><span>2</span><span>Identify the performance obligations</span></div>
          <div class="tr" style="grid-template-columns:0.3fr 1.8fr;"><span>3</span><span>Determine the transaction price</span></div>
          <div class="tr alt" style="grid-template-columns:0.3fr 1.8fr;"><span>4</span><span>Allocate the transaction price</span></div>
          <div class="tr" style="grid-template-columns:0.3fr 1.8fr;"><span>5</span><span>Recognise revenue as/when obligations are satisfied</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 115 covers</div>
        <div class="principle">Ind AS 115 applies to ALL contracts with customers except leases, insurance contracts, financial instruments, and certain non-monetary exchanges — IDENTICAL scope to IFRS 15.</div>
        <div class="note">Ind AS 115 REPLACED the earlier Ind AS 11 (Construction Contracts) and Ind AS 18 (Revenue), identical in effect to how IFRS 15 replaced IAS 11 and IAS 18 globally.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Performance obligation</div><div class="glossary-def">IDENTICAL definition to IFRS 15 — a promise to transfer a distinct good or service.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Unlisted company (Ind AS context)</div><div class="glossary-def">A company whose debt/equity securities are NOT listed on a recognised stock exchange, eligible for certain Ind AS 115 disclosure relaxations.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 — FIVE-STEP MODEL ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Five-Step Model</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IFRS 15</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The five-step model applies IDENTICALLY to Indian entities — from contract identification through the final revenue recognition trigger — with no Indian-specific step modification.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — IDENTIFYING PERFORMANCE OBLIGATIONS ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Identifying Performance Obligations</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical distinctness criteria to IFRS 15</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: An Indian software company's bundled contract</div>
          <div class="wk-body">An Indian SaaS company sells a bundled contract for software licence access (₹6,00,000) plus one year of implementation support (₹1,50,000) and ongoing maintenance (₹2,50,000), each capable of being sold separately and used independently by the customer.</div>
          <div class="wk-answer">EACH component is DISTINCT and represents a SEPARATE performance obligation, requiring the ₹10,00,000 total transaction price to be ALLOCATED across all three based on standalone selling prices — an IDENTICAL analysis to how IFRS 15 would treat the same bundled software contract globally.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — TRANSACTION PRICE ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Determining &amp; Allocating Transaction Price</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IFRS 15</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Variable consideration, significant financing components, non-cash consideration, and consideration payable to customers — all IDENTICAL to IFRS 15, allocated based on RELATIVE standalone selling prices.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — RECOGNISING REVENUE ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Recognising Revenue — Point in Time vs Over Time</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical three-criteria over-time test to IFRS 15</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The over-time recognition criteria (customer simultaneously receives/consumes benefits; entity's performance creates/enhances a customer-controlled asset; or the asset has no alternative use PLUS an enforceable right to payment) are IDENTICAL to IFRS 15 — relevant for Indian real estate and EPC/construction sector revenue recognition, replacing the old Ind AS 11 percentage-of-completion method with this new control-based framework.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — DISCLOSURE RELAXATIONS ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Disclosure Relaxations for Unlisted Indian Companies</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">The genuinely important Indian divergence point</div>
        <div class="principle">Ind AS 115 provides RELIEF from certain extensive disclosure requirements (e.g. some disaggregated revenue disclosures, remaining performance obligation disclosures) for companies whose debt/equity instruments are NOT listed on a stock exchange — a COST-BENEFIT calibration NOT present in IFRS 15 for a comparably-sized global entity population, which generally applies its disclosure requirements more uniformly regardless of listing status.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 2: Disclosure burden for a listed vs unlisted Indian company</div>
          <div class="wk-body">An Indian LISTED manufacturing company and an otherwise-comparable UNLISTED Indian manufacturing company both apply Ind AS 115's five-step recognition model identically to their sales contracts.</div>
          <div class="wk-answer">The LISTED company must provide the FULL suite of Ind AS 115 disclosures (disaggregated revenue, contract balances, remaining performance obligations). The UNLISTED company may be ELIGIBLE for certain disclosure relaxations under the applicable Ind AS rules — while its underlying REVENUE RECOGNITION accounting remains IDENTICAL to the listed company's and to IFRS 15's own model.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 8 — CONTRACT COSTS ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Contract Costs</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Identical to IFRS 15</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Incremental costs of obtaining a contract, and costs to fulfil a contract, are capitalised and amortised on a systematic basis consistent with the transfer of goods/services — IDENTICAL to IFRS 15.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical core requirements to IFRS 15 (subject to Section 7 relaxations)</div>
        <div class="check-list">
          <span>Disaggregation of revenue</span>
          <span>Contract balances (receivables, contract assets/liabilities)</span>
          <span>Remaining performance obligations</span>
          <span>Significant judgements</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Identifying distinct performance obligations in bundled Indian contracts</span>
              <span>Over-time vs point-in-time recognition for construction/real estate contracts</span>
              <span>Whether the entity qualifies for unlisted-company disclosure relaxations</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Variable consideration estimates (rebates, volume discounts common in Indian FMCG/retail contracts)</span>
              <span>Standalone selling price allocation</span>
            </div>
          </div>
        </div>
        <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ Indian real estate companies faced a SIGNIFICANT transition impact moving from the old percentage-of-completion Ind AS 11/18 approach to Ind AS 115's stricter control-based over-time criteria, often shifting recognition patterns materially.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 115 VS IFRS 15 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 115 vs IFRS 15 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IFRS 15</span><span style="color:var(--color-text-success);">Ind AS 115</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Five-step recognition model</span><span>Standard model</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Disclosure requirements</span><span>Broadly uniform regardless of listing status</span><span>RELAXED for companies whose debt/equity are not listed — a genuinely Indian cost-benefit calibration</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Predecessor standards replaced</span><span>IAS 11, IAS 18</span><span>Ind AS 11, Ind AS 18 — IDENTICAL transition effect</span></div>
        </div>
        <div class="note">Ind AS 115's RECOGNITION AND MEASUREMENT model is essentially IDENTICAL to IFRS 15 — the meaningful Indian divergence is confined to DISCLOSURE relief for unlisted entities, not the underlying accounting.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Revenue recognised as performance obligations satisfied</span><span><span class="badge bp">P&amp;L</span></span><span>Identical to IFRS 15</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Contract asset/liability recognition</span><span><span class="badge bs">Balance Sheet</span></span><span>Identical to IFRS 15</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Capitalised contract costs</span><span><span class="badge bs">Balance Sheet</span></span><span>Amortised to P&amp;L over the contract period</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 15</span><span>The global counterpart standard, near-identically converged</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 11 / 18 (withdrawn)</span><span>Predecessor standards replaced by Ind AS 115</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 116</span><span>Leases are scoped OUT of Ind AS 115</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Contract asset</div><div class="glossary-def">An entity's right to consideration for goods/services already transferred, conditional on something other than the passage of time — identical to IFRS 15.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Standalone selling price</div><div class="glossary-def">The price at which an entity would sell a good/service separately to a customer — identical concept to IFRS 15.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Performance obligation", definition: "A promise to transfer a distinct good or service to a customer — IDENTICAL definition to IFRS 15." },
      { term: "Contract asset", definition: "An entity's right to consideration for goods/services already transferred, conditional on something other than the passage of time — identical to IFRS 15." },
      { term: "Contract liability", definition: "An entity's obligation to transfer goods/services to a customer for which the customer has already paid — identical to IFRS 15." },
      { term: "Standalone selling price", definition: "The price at which an entity would sell a good/service separately to a customer — identical concept to IFRS 15." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
