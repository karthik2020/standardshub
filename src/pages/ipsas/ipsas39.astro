  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & the Four Categories" },
        { id: "s2", label: "Definitions" },
        { id: "s3", label: "Short-Term Employee Benefits — Recognition" },
        { id: "s4", label: "Short-Term Paid Absences & Profit-Sharing/Bonus Plans" },
        { id: "s5", label: "Post-Employment Benefits — Defined Contribution vs Defined Benefit" },
        { id: "s6", label: "Defined Benefit Plans — the Four-Step Accounting Process" },
        { id: "s7", label: "Actuarial Valuation — the Projected Unit Credit Method" },
        { id: "s8", label: "Actuarial Assumptions & the Discount Rate" },
        { id: "s9", label: "Past Service Cost, Curtailments & Settlements" },
        { id: "s10", label: "Plan Assets, Net Interest & the Asset Ceiling" },
        { id: "s11", label: "Presentation — Offsetting & Component Placement" },
        { id: "s12", label: "Disclosure Requirements — Defined Benefit Plans" },
        { id: "s13", label: "Other Long-Term Employee Benefits" },
        { id: "s14", label: "Termination Benefits" },
        { id: "s15", label: "Effective Date & Amendment Timeline" },
        { id: "s16", label: "Relationship to IAS 19" },
