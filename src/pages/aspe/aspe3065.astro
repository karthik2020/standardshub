        { id: "s8", label: "8. Why ASPE Retained the Older Model" },
        { id: "s9", label: "9. Worked Example — Classifying and Accounting for a Capital Lease" },
        { id: "s10", label: "10. Worked Example — an Operating Lease, Off Balance Sheet" },
        { id: "s11", label: "11. Disclosure Requirements" },
        { id: "s12", label: "12. Critical Judgments &amp; Estimates" },
