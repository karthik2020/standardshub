---
interface Props {
  frameworkId: "ias" | "ifrs";
}

const frameworkId = Astro.props.frameworkId;

const lightColors: Record<string, { primary: string; secondary: string }> = {
  ias: { primary: "var(--ias)", secondary: "var(--ias-soft)" },
  ifrs: { primary: "var(--ifrs)", secondary: "var(--ifrs-soft)" },
};

const colors = lightColors[frameworkId];
