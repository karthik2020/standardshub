        { id: "s8", label: "8. Worked Example — a Cash Flow Hedge of Forecast Purchases" },
        { id: "s9", label: "9. Worked Example — a Fair Value Hedge of a Fixed-Rate Loan" },
        { id: "s10", label: "10. Disclosure Requirements" },
