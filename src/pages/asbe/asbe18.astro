---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. A Landmark 2006 Reform — Introducing the Balance Sheet Liability Method" },
        { id: "s3", label: "3. Scope" },
        { id: "s4", label: "4. Temporary Differences — Comparing Carrying Amount to Tax Base" },
        { id: "s5", label: "5. Deferred Tax Asset Recognition — the \"Probable\" Threshold" },
        { id: "s6", label: "6. Recognition Exceptions" },
        { id: "s7", label: "7. Measurement — Enacted or Substantively Enacted Tax Rates" },
        { id: "s8", label: "8. No Discounting" },
        { id: "s9", label: "9. China's Standard Tax Rate and Preferential Regimes" },
        { id: "s10", label: "10. Worked Example — Recognising a Deferred Tax Liability" },
        { id: "s11", label: "11. Worked Example — Recognising a Deferred Tax Asset" },
        { id: "s12", label: "12. Disclosure Requirements" },
        { id: "s13", label: "13. Critical Judgments &amp; Estimates" },
        { id: "s14", label: "14. Relationship to IAS 12" },
        { id: "s15", label: "15. Statement Mapping" },
