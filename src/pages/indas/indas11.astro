---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/indas/indas11.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework (Historical)" },
        { id: "s2", label: "Scope & Definitions" },
        { id: "s3", label: "The Percentage-of-Completion Method" },
        { id: "s4", label: "Contract Revenue & Costs" },
        { id: "s5", label: "Recognition of Expected Losses" },
        { id: "s6", label: "Combining & Segmenting Contracts" },
        { id: "s7", label: "Transition Impact — Indian EPC/Real Estate" },
        { id: "s8", label: "Why It Was Withdrawn" },
        { id: "s9", label: "Disclosure (Historical)" },
        { id: "s10", label: "Judgments & Estimates (Historical)" },
        { id: "s11", label: "Ind AS 11 vs IAS 11 — Full Comparison" },
        { id: "s12", label: "Statement Mapping (Historical)" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 — CONCEPTUAL FRAMEWORK (HISTORICAL) ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Identical percentage-of-completion philosophy to IAS 11</div>
        <div class="principle">Ind AS 11 applied the IDENTICAL principle as IAS 11 — construction contract revenue/costs were recognised by reference to the STAGE OF COMPLETION of contract activity at the reporting date, when outcome could be estimated reliably.</div>
        <div class="elabel">HOW IND AS 11 MAPPED TO THE FRAMEWORK (HISTORICAL)</div>
        <div class="check-list">
          <span><strong style="font-weight:600">Relevance</strong> — recognising revenue as construction activity progresses, rather than only at final completion — identical rationale to IAS 11</span>
          <span><strong style="font-weight:600">Matching</strong> — costs matched against revenue recognised in the same period — identical to IAS 11</span>
        </div>
        <div class="note">Both Ind AS 11 and IAS 11 were REPLACED by their respective single revenue standards (Ind AS 115 / IFRS 15), which introduced a more rigorous CONTROL-based over-time recognition test in place of this dedicated construction contracts standard.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">Now superseded by Ind AS 115's over-time recognition test</div>
        <div class="callout danger callout--chip" style="margin-bottom:0;">🚫 Ind AS 11 is NO LONGER APPLICABLE. Construction/EPC contract revenue is now recognised under Ind AS 115's five-step model, using its over-time vs point-in-time criteria (see the Ind AS 115 poster, Section 6).</div>
      </div>
    </div>

    <!-- ============ SECTION 2 — SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What Ind AS 11 covered</div>
        <div class="principle">Ind AS 11 applied to contracts specifically negotiated for the construction of an asset or combination of assets — IDENTICAL historical scope to IAS 11.</div>
        <div class="note">Genuinely significant historically for Indian EPC, infrastructure, and real estate companies.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Percentage-of-completion method</div>
          <div class="glossary-def">IDENTICAL definition to IAS 11 — recognising revenue/costs by reference to stage of completion.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Fixed price contract</div>
          <div class="glossary-def">A contract type historically covered by Ind AS 11, now assessed under Ind AS 115.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 — PERCENTAGE OF COMPLETION ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Percentage-of-Completion Method (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 11</div>
        <div class="text-supporting">Stage of completion was determined by methods such as the proportion of costs incurred to date over estimated total costs, surveys of work performed, or physical completion of contract work — IDENTICAL to IAS 11.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 — CONTRACT REVENUE & COSTS (worked example) ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Contract Revenue &amp; Costs (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Identical measurement to IAS 11</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: Historical percentage-of-completion calculation</div>
          <div class="wk-body">An Indian EPC contractor's highway project had a total contract value of ₹100 crore, with ₹40 crore of costs incurred against total estimated costs of ₹80 crore.</div>
          <div class="wk-answer">Under the OLD Ind AS 11 methodology, stage of completion was 50% (₹40cr ÷ ₹80cr), so ₹50 crore of revenue (50% × ₹100cr) would have been recognised — an IDENTICAL calculation methodology to how IAS 11 was historically applied globally. This methodology is NO LONGER USED — Ind AS 115's over-time criteria now govern this determination.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 — EXPECTED LOSSES ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Recognition of Expected Losses (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Identical to IAS 11</div>
        <div class="text-supporting">The ENTIRE expected loss on a contract was recognised IMMEDIATELY once foreseeable, regardless of stage of completion — IDENTICAL to IAS 11's own prudent, immediate loss recognition principle.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 — COMBINING & SEGMENTING ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Combining &amp; Segmenting Contracts (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Identical to IAS 11</div>
        <div class="text-supporting">Criteria for combining a group of contracts as one, or segmenting a single contract into separately identifiable assets, were IDENTICAL to IAS 11 — a concept that has evolved into Ind AS 115's own performance obligation identification.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 — TRANSITION IMPACT ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Transition Impact for Indian EPC/Real Estate Companies</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A genuinely important historical Indian transition event</div>
        <div class="text-supporting">India's LARGE EPC/infrastructure and real estate development sectors experienced a SIGNIFICANT transition impact moving from Ind AS 11's percentage-of-completion approach to Ind AS 115's stricter control-based over-time criteria — particularly for real estate developers, where the shift from an assumed "continuous transfer" model to Ind AS 115's more rigorous three-criteria test (see Ind AS 115 poster, Section 6) sometimes shifted revenue recognition from OVER TIME to POINT IN TIME (at possession/registration), materially altering reported revenue timing for many Indian developers.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 — WHY WITHDRAWN ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Why It Was Withdrawn</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Convergence with the single global revenue standard</div>
        <div class="text-supporting">Ind AS 11 (like IAS 11) was withdrawn as part of the broader move to a SINGLE, principles-based revenue recognition standard (Ind AS 115/IFRS 15) applicable across ALL industries, replacing the prior patchwork of industry/contract-type-specific standards.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 — DISCLOSURE (HISTORICAL) ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Historical disclosure requirements, identical to IAS 11</div>
        <div class="check-list">
          <span>Contract revenue recognised in the period</span>
          <span>Methods used to determine stage of completion</span>
          <span>Amounts due from/to customers for contract work</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 — JUDGMENTS & ESTIMATES (HISTORICAL) ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement historically mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether contract outcome could be estimated reliably</span>
              <span>Contract combining/segmenting determinations</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Total estimated contract costs, driving the stage-of-completion calculation</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 11 — IND AS 11 vs IAS 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Ind AS 11 vs IAS 11 — Full Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comprehensive comparison table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IAS 11</span><span style="color:var(--color-text-success);">Ind AS 11</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Core methodology (historical)</span><span>Percentage-of-completion</span><span>IDENTICAL — no substantive divergence</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Withdrawal/replacement</span><span>Replaced by IFRS 15</span><span>Replaced by Ind AS 115, on an aligned transition timeline</span></div>
        </div>
        <div class="note">Ind AS 11 was essentially IDENTICAL to IAS 11 throughout its life — both standards were withdrawn in favour of their respective single revenue standards.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 — STATEMENT MAPPING (HISTORICAL) ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where Ind AS 11 items historically appeared</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Item</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Contract revenue recognised</span><span><span class="badge bp">P&amp;L</span></span><span>Now governed by Ind AS 115</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Amounts due from/to customers</span><span><span class="badge bs">Balance Sheet</span></span><span>Now presented as contract assets/liabilities under Ind AS 115</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 — RELATED STANDARDS ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 11</span><span>The global counterpart standard, also withdrawn on an aligned timeline</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 115</span><span>The CURRENT standard governing all revenue, including former Ind AS 11 construction contracts</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Ind AS 18 (withdrawn)</span><span>The other predecessor revenue standard, also replaced by Ind AS 115</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item">
          <div class="glossary-term">Stage of completion</div>
          <div class="glossary-def">The historical Ind AS 11 metric for revenue recognition, now superseded by Ind AS 115's control-based over-time assessment.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">EPC contract</div>
          <div class="glossary-def">Engineering, Procurement, Construction — a common Indian contract type historically governed by Ind AS 11.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 — GLOSSARY ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Percentage-of-completion method", definition: "The historical method of recognising construction contract revenue/costs by reference to the stage of completion — identical to IAS 11." },
      { term: "Stage of completion", definition: "The historical Ind AS 11 metric for revenue recognition, now superseded by Ind AS 115's control-based over-time assessment." },
      { term: "EPC contract", definition: "Engineering, Procurement, Construction — a common Indian contract type historically governed by Ind AS 11." },
      { term: "Fixed price contract", definition: "A contract type historically covered by Ind AS 11, now assessed under Ind AS 115." },
    ]} />

    <FinancialStatementKey />

  </div>
</StandardPageLayout>
