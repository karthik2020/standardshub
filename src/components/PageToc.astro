---
import { X } from "@lucide/astro";

interface Item {
    id: string;
    label: string;
}

interface Props {
    items: Item[];
}

const { items = [] } = Astro.props as Props;

const slugify = (text: string) =>
    text.replace(/[^a-zA-Z0-9]+/g, "_").replace(/^_+|_+$/g, "");
---

<nav class="toc" aria-label="Table of contents" aria-labelledby="toc-title">
    <div class="toc-sheet-header">
      <span class="toc-sheet-header-title">Contents</span>
      <button
        class="toc-sheet-close"
        id="tocSheetClose"
        aria-label="Close table of contents"
        aria-expanded="false"
        aria-controls="mobileTocSheet"
      >
        <X size="20" stroke-width="2" absoluteStrokeWidth />
      </button>
    </div>
    <h2 id="toc-title" class="toc-title">Contents</h2>
    <ul>
        {items.map((item) => {
            const href = `#${item.id}_${slugify(item.label)}`;
            const numMatch = item.id.match(/^s(\d+)$/);
            const number = numMatch ? parseInt(numMatch[1], 10) : null;
            return (
                <li>
                    <a href={href} data-section={item.id}>
                        <span class="toc-number">{number !== null ? number : ""}</span>
                        <span class="toc-label">{item.label}</span>
                    </a>
                </li>
            );
        })}
    </ul>
</nav>
