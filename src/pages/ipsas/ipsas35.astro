---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas35.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & the Public Sector Combinations Carve-Out" },
        { id: "s2", label: "Presentation of Consolidated Financial Statements – the Consolidation Exemption" },
        { id: "s3", label: "Definitions" },
        { id: "s4", label: "Control – the Three-Element Test" },
        { id: "s5", label: "Power – Rights & Public Sector Nuances" },
        { id: "s6", label: "Benefits – Financial & Non-Financial" },
        { id: "s7", label: "Link Between Power and Benefits – Principal vs Agent" },
        { id: "s8", label: "Accounting Requirements & Consolidation Procedures" },
        { id: "s9", label: "Measurement Timing, Reporting Dates & Potential Voting Rights" },
        { id: "s10", label: "Non-Controlling Interests" },
        { id: "s11", label: "Changes in the Proportion Held by Non-Controlling Interests" },
        { id: "s12", label: "Loss of Control – Derecognition & Gain/Loss Mechanics" },
        { id: "s13", label: "Investment Entities – the Fair Value Exception & Status Changes" },
        { id: "s14", label: "Worked Scenarios – Power & Control Assessment Judgment" },
        { id: "s15", label: "Disclosure – Deferred Entirely to IPSAS 38" },
        { id: "s16", label: "Transitional Provisions, Effective Date & Amendment Timeline" },
        { id: "s17", label: "Relationship to IFRS 10" },
        { id: "s18", label: "Statement / Process Mapping" },
        { id: "s19", label: "Related Standards – Cross-Reference Map" },
        { id: "s20", label: "Quick-Reference Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 35 Consolidated Financial Statements is the current, active standard issued by the IPSASB for presenting and preparing consolidated financial statements when a public-sector entity controls one or more other entities. Effective for periods beginning on or after 1 January 2017 (earlier application encouraged). Paras. 1–78."
    historical="IPSAS 35 is the IPSASB's adaptation of IFRS 10 Consolidated Financial Statements for the public sector – keeping the IFRS 10 control model but adding public-sector nuances (the 'service potential' benefit concept, the public-sector combinations carve-out, and explicit 'control' commentary for grantor entities)."
    link=""
    linkText=""
  />

  <!-- ============ SECTION 1 ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; the Public Sector Combinations Carve-Out (paras. 1–6)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Objective &amp; scope (para. 1)</div>
      <div class="principle">Establishes principles for presenting and preparing consolidated financial statements when a public-sector entity controls one or more other entities. Scope covers all entities the reporting entity controls – the combination carve-out (IPSAS 40) is excluded and applied separately.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Key definitions</div>
      <div class="glossary-item"><div class="glossary-term">Control</div><div class="glossary-def">The power to govern the financial and operating policies of an entity so as to obtain benefits.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Reporting entity</div><div class="glossary-def">A public-sector entity and the entities it controls, as a single economic entity for reporting.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 2 ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Presentation of Consolidated Financial Statements – the Consolidation Exemption (paras. 5, 7, 9–10)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">When to exempt (para. 5)</div>
      <div class="principle">A wholly-owned subsidiary (or a primarily-financing, non-trading or intermediate entity) may be excluded from consolidation if the parent demonstrates it has nothing more to consolidate than an investment in the entity and presents that investment at fair value. The exemption applies only if all of the criteria are met.</div>
      <div class="callout info callout--flush">The exemption is the same economic principle as IFRS 10 but with IPSAS public-sector framing of 'service potential'.</div>
    </div>
  </div>

  <!-- ============ SECTION 3 ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Definitions (para. 14)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">Core terms (para. 14)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.3fr 1.7fr;"><span>Term</span><span>Meaning</span></div>
        <div class="tr" style="grid-template-columns:1.3fr 1.7fr;"><span>Controlled entity</span><span>Entity over which the parent has control</span></div>
        <div class="tr alt" style="grid-template-columns:1.3fr 1.7fr;"><span>Non-controlling interest</span><span>Part of equity in a subsidiary not attributable to the parent</span></div>
      </div>
      <div class="check-list"><span>Control</span><span>Power</span><span>Returns</span><span>Non-controlling interest</span></div>
    </div>
  </div>

  <!-- ============ SECTION 4 ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Control – the Three-Element Test (paras. 18–22)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card ci">
      <div class="ctitle ci">The IFRS 10 test (para. 18)</div>
      <div class="principle">Control exists when the entity has: (1) POWER over the investee (exercised relevantly); (2) EXPOSURE to VARIABLE RETURNS from involvement; and (3) the ABILITY to use power to affect those returns. All three must hold.</div>
      <div class="cross-list"><span>Power</span><span>Potential voting rights</span><span>Returns (variable)</span><span>Use power to affect returns</span></div>
    </div>
  </div>

  <!-- ============ SECTION 5 ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Power – Rights &amp; Public Sector Nuances (paras. 23–29)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Public-sector power (para. 23)</div>
      <div class="principle">Power comes from rights (voting or substantive), from the ability to direct key decisions, or from the terms of the arrangement. IPSAS adds commentary on public-sector grantor arrangements and where 'power' is exercised through statutory delegation rather than shareholding.</div>
      <div class="callout warn">For government grantors, evaluate whether substantive removal rights are held even absent a majority stake.</div>
    </div>
  </div>

  <!-- ============ SECTION 6 ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Benefits – Financial &amp; Non-Financial (paras. 30–34)</h2><span class="line"></span></div>
  <div class="cols-1 grid-spaced">
    <div class="card cw">
      <div class="ctitle cw">What returns? (para. 30)</div>
      <div class="principle">Returns may be financial (dividends, interest) OR non-financial – for the public sector, the 'benefit' is often the delivery of public services, the maintenance of an asset, or the achievement of policy outcomes. The public sector combinations carve-out (IPSAS 40) interacts here.</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.3fr 1.6fr;"><span>Return type</span><span>Public-sector example</span></div>
        <div class="tr" style="grid-template-columns:1.3fr 1.6fr;"><span>Financial</span><span>Dividends, interest on loan</span></div>
        <div class="tr alt" style="grid-template-columns:1.3fr 1.6fr;"><span>Non-financial</span><span>Public service delivery, asset upkeep</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 7 ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Link Between Power and Benefits – Principal vs Agent (paras. 35–37)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Principal vs agent (para. 35)</div>
 <div class="principle">An entity that controls the investor-side risk (principal) recognises the acquisition-related transaction in its own books; an agent-like participant (no control) recognises only the income element. The principal/agent determination drives recognition of pre-acquisition revenue.</div>
      <div class="callout info callout--flush">IPSAS 35 keeps IFRS 10's substance-over-form approach but adds public-sector examples.</div>
    </div>
  </div>

  <!-- ============ SECTION 8 ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Accounting Requirements &amp; Consolidation Procedures (paras. 38–41)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Consolidate (para. 38)</div>
      <div class="principle">The reporting entity must consolidate all entities it controls: (1) at acquisition date, recognise acquired assets/liabilities at FV; (2) eliminate intra-group items; (3) translate foreign operations; (4) assess goodwill for impairment.</div>
      <div class="check-list"><span>Control assessment</span><span>FV at acquisition</span><span>Eliminate intra-group</span><span>Goodwill impairment test</span></div>
    </div>
  </div>

  <!-- ============ SECTION 9 ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Measurement Timing, Reporting Dates &amp; Potential Voting Rights (paras. 42–46)</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card cw">
      <div class="ctitle cw">Timing rules (para. 42)</div>
      <div class="principle">Potential voting rights are assessed at each reporting date, not just acquisition. Consolidation is measured at the reporting date – including changes in control mid-period, which trigger a new acquisition-date measurement.</div>
      <div class="callout warn">A change in control is accounted for separately from the continuing acquiree – gains/losses recognised in profit or loss.</div>
    </div>
  </div>

  <!-- ============ SECTION 10 ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Non-Controlling Interests (paras. 47–50)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">NCI choices (para. 47)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.7fr;"><span>Option</span><span>Treatment</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.7fr;"><span>GVPTM (equity)</span><span>Cost of NCI – part of equity</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.7fr;"><span>FVOCI/GVOP (P&amp;L)</span><span>NCI measured at FV – in profit or loss</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 11 ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Changes in the Proportion Held by Non-Controlling Interests</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd">
      <div class="ctitle cd">Second purchase (para. 51)</div>
      <div class="principle">When the parent (already controlling) transacts with non-controlling owners for additional interests, the transaction is treated as an equity transaction – the consideration is added to/netted against equity, with NO gain or loss recognised.</div>
      <div class="glossary-item"><div class="glossary-term">Proportional PI</div><div class="glossary-def">Additional acquisition of non-controlling interest – equity, not P&amp;L.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 12 ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Loss of Control – Derecognition &amp; Gain/Loss Mechanics</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Partial disposal (para. 52)</div>
      <div class="principle">A loss of control is accounted for as a DERECOGNITION of the entity – any gain/loss is the difference between proceeds, carrying amount of the residual interest, and any deferred/contingent consideration. NCI is re-measured to FV.</div>
      <div class="callout info callout--flush">Full gain/loss on sale of control goes to profit or loss; the carve-out rules of IPSAS 40 may overlay for public-sector combinations.</div>
    </div>
  </div>

  <!-- ============ SECTION 13 ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Investment Entities – the Fair Value Exception &amp; Status Changes</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">FV through equity (para. 56)</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.4fr;"><span>Situation</span><span>Treatment</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.4fr;"><span>Investment-entity subsidiary</span><span>Measured at FVOCI</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.4fr;"><span>Loses investment-entity status</span><span>Re-measure to cost model</span></div>
      </div>
      <div class="callout warn">IPSAS 34 holds the corresponding separate-statements counterpart; IPSAS 36 covers the equity-method associates.</div>
    </div>
  </div>

  <!-- ============ SECTION 14 ============ -->
  <div class="section-header" id="s14"><span class="num">14</span><h2>Worked Scenarios – Power &amp; Control Assessment Judgment</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cd span2">
      <div class="ctitle cd">Judgment guide (IE2–IE6)</div>
      <div class="principle">IPSAS 35 includes illustrative examples judging when control exists: (1) variable returns + power; (2) power alone (voting + board); (3) exposure without power (agent); (4) joint control edge-case; (5) structured entity with no power. Each tests the three elements.</div>
      <div class="cross-list"><span>Power + returns + use of power</span><span>Solo control</span><span>Power absent → agent</span><span>Joint control → IPSAS 37</span></div>
    </div>
  </div>

  <!-- ============ SECTION 15 ============ -->
  <div class="section-header" id="s15"><span class="num">15</span><h2>Disclosure – Deferred Entirely to IPSAS 38</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cw span2">
      <div class="ctitle cw">Deferral (para. 65)</div>
      <div class="principle">IPSAS 35 itself requires NO disclosure – ALL disclosure relating to interests in controlled entities, non-controlling interests, structured entities and the composition of the group is DEFERRED to IPSAS 38 (which also covers associates and joint arrangements).</div>
      <div class="callout info callout--flush">This is a public-sector streamlining: consolidation is consolidated with the 38 disclosure set.</div>
    </div>
  </div>

  <!-- ============ SECTION 16 ============ -->
  <div class="section-header" id="s16"><span class="num">16</span><h2>Transitional Provisions, Effective Date &amp; Amendment Timeline (paras. 65–81)</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card ci span2">
      <div class="ctitle ci">Timeline</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 1.2fr;"><span>Date</span><span>Event</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>Jan 2015</span><span>Issued</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 1.2fr;"><span>1 Jan 2017</span><span>Effective date</span></div>
        <div class="tr" style="grid-template-columns:1fr 1.2fr;"><span>2026</span><span>Amended (latest)</span></div>
      </div>
      <div class="callout warn">Transition: apply retrospectively as a modified retrosspective (no separate opening SOFP required where IFRS 10 transition applies).</div>
    </div>
  </div>

  <!-- ============ SECTION 17 ============ -->
  <div class="section-header" id="s17"><span class="num">17</span><h2>Relationship to IFRS 10</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Mapping (para. 78)</div>
      <div class="principle">IPSAS 35 tracks IFRS 10's control model (three elements, VIEs/subos, principal/agent) but adds public-sector commentary, the combinations carve-out interaction and the wholesale deferral of disclosure to IPSAS 38.</div>
      <div class="cross-list"><span>IFRS 10 control test</span><span>IPSAS 35 same + carve-out</span><span>IFRS 10 NCI</span><span>IPSAS 35 same (GVPTM/GVOP)</span><span>IFRS 10 disclosure</span><span>IPSAS 38 takes it</span></div>
    </div>
  </div>

  <!-- ============ SECTION 18 ============ -->
  <div class="section-header" id="s18"><span class="num">18</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
  <div class="grid grid-spaced">
    <div class="card cw span2">
      <div class="ctitle cw">Where it flows</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.4fr 1.3fr;"><span>Process</span><span>Ledger</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>Control assessment</span><span>Governance → Control Matrix</span></div>
        <div class="tr alt" style="grid-template-columns:1.4fr 1.3fr;"><span>Consolidation run</span><span>Consol Engine → elim intercompany</span></div>
        <div class="tr" style="grid-template-columns:1.4fr 1.3fr;"><span>NCI movement</span><span>Equity Roll / NCI Module</span></div>
        <div class="tr alt" style="grid-template-columns:1.4fr 1.3fr;"><span>Disclosure</span><span>Defer to IPSAS 38 engine</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 19 ============ -->
  <div class="section-header" id="s19"><span class="num">19</span><h2>Related Standards – Cross-Reference Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">See also</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 2fr;"><span>Standard</span><span>Relation</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 34</span><span>Separate statements</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IPSAS 36</span><span>Equity-method associates/JVs</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 37</span><span>Joint arrangements</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IPSAS 38</span><span>Disclosure of interests in entities</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>IPSAS 40</span><span>Public sector combinations</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>IFRS 10</span><span>Direct equivalent</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 20 ============ -->
  <div class="section-header" id="s20"><span class="num">20</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Control</div><div class="glossary-def">Power + variable returns + ability to use power.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Non-controlling interest</div><div class="glossary-def">Portion of subsidiary equity not attributable to parent.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Principal vs agent</div><div class="glossary-def">Principal bears investor-side risk; agent does not.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Investment entity</div><div class="glossary-def">Holds investments for capital appreciation; FV exception.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Loss of control</div><div class="glossary-def">Derecognition event; gain/loss to P&amp;L.</div></div>
      <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Combinations carve-out</div><div class="glossary-def">IPSAS 40 interaction with public-sector combinations.</div></div>
    </div>
  </div>
</StandardPageLayout>

