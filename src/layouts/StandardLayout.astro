---
import "../styles/site.css";
import "../styles/print.css";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { detectSeoType } from "../utils/seo";

interface Props {
  code: string;
  /** Display title used in the header/breadcrumbs. */
  title?: string;
  /** SEO document title prefix. Defaults to `title`. Omit for the home page. */
  seoTitle?: string;
  framework?: string;
  noindex?: boolean;
  hideFramework?: boolean;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: string;
  /** Standard page context used to auto-generate the description. */
  standard?: { code: string; title: string; dateModified?: string };
}

const {
  code,

  title,

  seoTitle = title,

  framework = "",
  noindex = false,
  hideFramework = false,
  description,
  canonical,
  robots = noindex ? "noindex" : undefined,
  ogType,
  ogImage,
  twitterCard,
  standard,
} = Astro.props;

const seoType = detectSeoType({ code, framework, standard, hideFramework });
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={seoTitle}
      description={description}
      canonical={canonical}
      robots={robots}
      ogType={ogType}
      ogImage={ogImage}
      twitterCard={twitterCard}
      standard={standard}
      seoType={seoType}
    />
  </head>

  <body>
    <div class="app-shell">
      {hideFramework ? (
        <header class="site-header">
          <div class="header-left">
            <a href="/" class="site-logo">
              <span class="logo-mark"></span>
              <span class="logo-text"> StandardsHub </span>
            </a>
            <nav class="header-breadcrumbs">
              <a href="/" class="crumb breadcrumb-home">
                <span>Home</span>
              </a>
              <span class="breadcrumb-separator">❯</span>
              <span class="breadcrumb-current">
                <span class="breadcrumb-title">{title}</span>
              </span>
            </nav>
          </div>
          <div class="header-right">
            <button class="toolbar-btn" id="printBtn" title="Print"> 🖨 </button>
          </div>
        </header>
      ) : (
        <Header code={code} title={title} framework={framework} />
      )}

      <div class="app-body" data-framework={framework.toLowerCase().replace(/\s+/g, "")}>
        <Sidebar />

        <main class="content">
          <div class="page-body">
            <div class="reading-column">
              <div class="page-content">
                <slot />
              </div>
            </div>

            <aside class="page-toc">
              <slot name="toc" />
            </aside>

            <Footer />
          </div>
        </main>
      </div>
    </div>

    <script is:inline src="/js/sidebar.js"></script>
    <script is:inline src="/js/toc.js"></script>
    <script is:inline src="/js/search.js"></script>
  </body>
</html>
