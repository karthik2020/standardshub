import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas20.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & Definitions" },
        { id: "s2", label: "Close Family Members & Key Management Personnel" },
        { id: "s3", label: "Identifying Related Parties" },
        { id: "s4", label: "Why Related Party Disclosure Matters" },
        { id: "s5", label: "Disclosure of Control" },
        { id: "s6", label: "Disclosure of Related Party Transactions" },
        { id: "s7", label: "Disclosure – Key Management Personnel" },
        { id: "s8", label: "Effective Date & Amendment Timeline" },
        { id: "s9", label: "Relationship to IAS 24" },
        { id: "s10", label: "Statement / Process Mapping" },
        { id: "s11", label: "Related Standards" },
        { id: "s12", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 20 Related Party Disclosures is the current, active standard issued by the IPSASB for disclosing related-party relationships and transactions. It is effective for annual financial statements covering periods beginning on or after 1 January 2004 (earlier application encouraged)."
    historical="IPSAS 20 is based on IAS 24 Related Party Disclosures, adapted for the public sector with expanded coverage of close family members and key management personnel, and public-sector-specific related-party identification rules."
    link=""
    linkText=""
  />

    <!-- ============ SECTION 1 – OBJECTIVE, SCOPE & DEFINITIONS ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; Definitions (paras. 1–4)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Objective &amp; scope</div>
        <div class="principle">Requires disclosure of (a) related party relationships where CONTROL exists, and (b) certain transactions between the entity and its related parties – for accountability and to help users better understand financial position and performance. Two principal issues: identifying who controls or significantly influences the entity, and determining what to disclose about transactions with them.</div>
        <div class="check-list">
          <span>Applies to an entity preparing accrual-basis financial statements, disclosing related party relationships and certain transactions</span>
        </div>
        <div class="note">Paras. 2–3 [Deleted].</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Related party – the core definition (para. 4)</div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Related party</div>
          <div class="glossary-def">Parties are related if one has the ability to (a) CONTROL the other, or (b) exercise SIGNIFICANT INFLUENCE over the other's financial/operating decisions, OR if both are subject to COMMON CONTROL.</div>
        </div>
        <div class="dot-list">
          <span>Entities that directly/indirectly control, or are controlled by, the reporting entity</span>
          <span>Associates (IPSAS 36)</span>
          <span>Individuals with a significant-influence ownership interest, and their close family members</span>
          <span>Key management personnel, and their close family members</span>
          <span>Entities substantially owned by, or over which significant influence is held by, any of the above individuals</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 2 – CLOSE FAMILY MEMBERS & KEY MANAGEMENT PERSONNEL ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Close Members of the Family &amp; Key Management Personnel (paras. 4–9)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Close family members – presumed unless rebutted (para. 5)</div>
        <div class="dot-list">
          <span>Spouse, domestic partner, dependent child, or relative living in a common household</span>
          <span>Grandparent, parent, non-dependent child, grandchild, brother, or sister</span>
          <span>Spouse/domestic partner of a child; parent-in-law; brother-in-law; sister-in-law</span>
        </div>
        <div class="note">The presumption can be rebutted with evidence to the contrary (e.g. an estranged spouse).</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key management personnel (para. 4, with paras. 6–9)</div>
        <div class="dot-list">
          <span>ALL directors or members of the governing body</span>
          <span>Whole-of-government: the elected/appointed representative with oversight authority, any key advisors of that person, and the senior management group including the chief executive/permanent head</span>
        </div>
        <div class="callout warn callout--flush">Whether a "key advisor" qualifies is a matter of JUDGMENT – some possess special working relationships and access to privileged information amounting to significant influence, even without formal authority (para. 7). In some jurisdictions, only elected Cabinet-level members qualify as KMP for the whole-of-government entity, since civil servants may lack sufficient authority (para. 8).</div>
      </div>
    </div>

    <!-- ============ SECTION 3 – IDENTIFYING RELATED PARTIES ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Identifying Related Parties – Substance Over Form (paras. 10–17)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs">
        <div class="ctitle cs">Deemed NOT related parties (para. 12)</div>
        <div class="cross-list">
          <span>Providers of finance in the ordinary course of their business</span>
          <span>Trade unions</span>
          <span>Parties in the course of normal dealings, by virtue only of those dealings (even if they can circumscribe the entity's freedom of action)</span>
          <span>An entity whose relationship is SOLELY that of an agency</span>
        </div>
        <div class="note">A shared key management person between two entities doesn't AUTOMATICALLY create a related party relationship – it must be ASSESSED for the likelihood of influence over BOTH entities' mutual dealings (para. 11).</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Economic dependency – usually not enough on its own (para. 14)</div>
        <div class="text-supporting">A single customer, supplier, franchisor, distributor, or general agent transacting significant volume with a public sector entity is NOT a related party merely from that economic dependency. BUT dependency combined with OTHER factors may create significant influence – and therefore a related party relationship. Where an entity is economically dependent on another, disclosure of that dependency is ENCOURAGED (not required).</div>
      </div>
    </div>

    <!-- ============ SECTION 4 – WHY RELATED PARTY DISCLOSURE MATTERS ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Why Related Party Disclosure Matters in the Public Sector (paras. 18–19)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Related party relationships pervade government (para. 18)</div>
        <div class="dot-list">
          <span>Administrative units operate under the overall direction of executive government and, ultimately, Parliament/legislature</span>
          <span>Departments/agencies often conduct activities through separate controlled entities, or entities over which they have significant influence</span>
          <span>Ministers/elected officials can exert significant influence over department/agency operations</span>
        </div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Three reasons disclosure is needed (para. 19)</div>
        <div class="dot-list">
          <span>Related party relationships can influence how an entity operates with others, individually and collectively</span>
          <span>They might expose the entity to RISKS, or provide OPPORTUNITIES, that wouldn't exist without the relationship</span>
          <span>Related parties may transact on terms UNRELATED parties would not agree to – a real risk given the highest integrity standards expected of public monies</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 – DISCLOSURE OF CONTROL ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Disclosure of Control (paras. 25–26)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Disclosed regardless of transactions</div>
        <div class="formula-box">
          <div class="f-eq">Related party relationships where CONTROL exists → disclosed, irrespective of whether any transactions have occurred</div>
        </div>
        <div class="text-supporting">This means disclosing: the names of any controlled entities, the name of the IMMEDIATE controlling entity, and the name of the ULTIMATE controlling entity (if any) – so readers can form a view of the effects of these relationships regardless of transaction activity.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 – DISCLOSURE OF RELATED PARTY TRANSACTIONS ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Disclosure of Related Party Transactions (paras. 27–33)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">The arm's-length carve-out (para. 27)</div>
        <div class="principle">Disclosure is required for related party transactions EXCEPT those occurring within a normal supplier/client relationship, on terms no more or less favorable than an arm's-length transaction in the same circumstances.</div>
        <div class="elabel">WHERE DISCLOSURE IS REQUIRED, DISCLOSE</div>
        <div class="check-list">
          <span>Nature of the related party relationships</span>
          <span>Types of transactions that occurred</span>
          <span>Elements necessary to clarify significance to operations, sufficient for relevant, faithfully representative decision-making information</span>
        </div>
        <div class="note">Example triggers (para. 28): rendering/receiving services; purchases/transfers of goods, property, other assets; agency arrangements; leasing; R&amp;D transfer; license agreements; finance (loans, capital contributions, grants, cost-sharing); guarantees and collateral.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">The intra-government carve-out (para. 29)</div>
        <div class="principle">Departments are related parties (common control) – but disclosure is NOT required for transactions between them that are (a) consistent with NORMAL operating relationships, and (b) on terms/conditions NORMAL for such transactions in that jurisdiction – even if free of charge or below cost.</div>
        <div class="dot-list">
          <span>Nature of relationship (controlling, controlled, common control, or KMP)</span>
          <span>Description of transactions per broad class, and the VOLUME (monetary amount or proportion)</span>
          <span>Summary of broad terms/conditions, including how they differ from unrelated-party norms</span>
          <span>Amounts or proportions of outstanding items</span>
        </div>
        <div class="note">Items of a SIMILAR nature may be aggregated, unless separate disclosure is necessary for decision-making/accountability (para. 32). Disclosure between economic-entity members is UNNECESSARY in consolidated statements – those transactions are eliminated on consolidation (except investment-entity FVSD holdings); associate transactions under the equity method are NOT eliminated and DO require disclosure (para. 33).</div>
      </div>
    </div>

    <!-- ============ SECTION 7 – DISCLOSURE: KEY MANAGEMENT PERSONNEL ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Disclosure – Key Management Personnel (para. 34)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Required KMP disclosures – regardless of arm's-length status</div>
        <div class="check-list">
          <span>AGGREGATE remuneration of key management personnel, and the number of individuals (full-time equivalent basis), by major class</span>
          <span>Total amount of ALL OTHER remuneration/compensation to KMP and their close family members – split between the two groups</span>
          <span>For loans NOT widely available (or not widely known to be available): amount advanced, amount repaid, closing balance, and terms/conditions, per individual</span>
        </div>
        <div class="callout warn callout--flush">Unlike para. 27's general transaction disclosure, KMP disclosures apply WHETHER OR NOT the transactions occurred on an arm's-length basis (para. 35).</div>
      </div>

      <div class="card cw">
        <div class="ctitle cw">Measurement &amp; classification notes</div>
        <div class="dot-list">
          <span>Number receiving remuneration is estimated on a FULL-TIME EQUIVALENT basis (para. 36)</span>
          <span>An individual in BOTH the governing body and senior management group is counted in only ONE class</span>
          <span>Where benefit cost isn't determinable, a BEST ESTIMATE is used (para. 37)</span>
          <span>Non-monetary remuneration, if reliably measured and included, requires a note on the measurement basis (para. 38, cross-ref IPSAS 39)</span>
        </div>
        <div class="note">Remuneration EXCLUDES reimbursement of expenditure incurred for the entity's benefit (e.g. work-travel accommodation costs) (para. 16). It also excludes benefits derived in a capacity OTHER than as employee/governing-body member, though para. 34 requires disclosure of certain OTHER such benefits separately.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 – EFFECTIVE DATE & AMENDMENT TIMELINE ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Effective Date &amp; Amendment Timeline (paras. 42–43)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Amendment history at a glance</div>
        <div class="principle">Base Standard: periods beginning on/after <strong>1 January 2004</strong>.</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1fr 2.2fr;"><span>Effective</span><span>Change</span></div>
          <div class="tr" style="grid-template-columns:1fr 2.2fr;"><span>1 Jan 2017</span><span>Para. 43 (IPSAS 33); paras. 27, 32 (Improvements to IPSAS 2015)</span></div>
          <div class="tr alt" style="grid-template-columns:1fr 2.2fr;"><span>–</span><span>Paras. 4, 15, 24, 33 amended – IPSAS 35, IPSAS 37 &amp; IPSAS 38, all issued January 2015, applied together</span></div>
          <div class="tr" style="grid-template-columns:1fr 2.2fr;"><span>1 Jan 2018</span><span>Paras. 2, 3 deleted – The Applicability of IPSAS (Apr 2016)</span></div>
          <div class="tr alt" style="grid-template-columns:1fr 2.2fr;"><span>1 Jan 2018</span><span>Para. 38 – IPSAS 39, Employee Benefits (Jul 2016)</span></div>
        </div>
        <div class="note">Para. 43: when an entity adopts accrual-basis IPSAS after the effective date (per IPSAS 33), this Standard applies from the date of adoption.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 – RELATIONSHIP TO IAS 24 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Relationship to IAS/IFRS – Comparison with IAS 24</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison – IPSAS 20 vs IAS 24</div>
        <div class="principle">IPSAS 20 is drawn primarily from IAS 24 (Reformatted 1994), <em>Related Party Disclosures</em> – an older version than the current IFRS Standard.</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1.9fr;"><span>Topic</span><span>Difference</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1.9fr;"><span>Structure</span><span>IPSAS 20's structure differs substantially from IAS 24</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1.9fr;"><span>Wholly-owned subsidiary exclusion</span><span>IAS 24's exclusion for wholly-owned subsidiaries in the same domicile as the parent (with local consolidated statements) is NOT adopted in IPSAS 20</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1.9fr;"><span>Key management personnel definition</span><span>IPSAS 20 has a formal definition; IAS 24's commentary includes close family, while IPSAS 20's KMP definition itself does NOT include close family (they're addressed separately)</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1.9fr;"><span>Related party definition</span><span>IPSAS 20 formally includes relationships that IAS 24 addresses only in commentary</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1.9fr;"><span>Remuneration of KMP definition</span><span>IPSAS 20 defines it; IAS 24 does not</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1.9fr;"><span>KMP disclosure breadth</span><span>IPSAS 20 adds disclosures for KMP remuneration/close-family remuneration and certain other KMP transactions</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1.9fr;"><span>Normal-terms exclusion scope</span><span>IPSAS 20 excludes MORE related party transactions from disclosure (normal-terms transactions) than IAS 24's narrower exclusions</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1.9fr;"><span>Terminology</span><span>"Members of the governing body" (IPSAS 20) vs "directors" (IAS 24)</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 – STATEMENT / PROCESS MAPPING ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Disclosure decision map</div>
        <ol class="ordered-list">
        <li>Is the counterparty a related party – control, significant influence, common control, or KMP/close family? If no &rarr; outside this Standard entirely</li>
        <li>Does CONTROL exist? &rarr; disclose the relationship regardless of any transactions (names of controlled/controlling entities) (§5)</li>
        <li>Have transactions occurred? Were they on ARM'S-LENGTH terms, in the ordinary course? If yes &rarr; generally NO disclosure required (§6)</li>
        <li>Is it an intra-government transaction consistent with NORMAL operating relationships and NORMAL terms for that jurisdiction? &rarr; excluded from disclosure even if free/below cost (§6)</li>
        <li>Does the transaction involve KEY MANAGEMENT PERSONNEL or their close family? &rarr; disclose remuneration, other compensation, and specified loan details REGARDLESS of arm's-length status (§7)</li>
      </ol>
      </div>
    </div>

    <div class="grid grid-spaced">
      <div class="card cs span2">
        <div class="ctitle cs">Concept-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>IPSAS 20 concept</span><span>Statement(s)</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Names of controlled/controlling entities</span><span><span class="badge bp">Notes</span></span><span>Required regardless of transaction activity</span></div>
          <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Non-arm's-length related party transactions</span><span><span class="badge bp">Notes</span></span><span>Nature, type, and significance disclosed</span></div>
          <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>KMP aggregate remuneration</span><span><span class="badge bp">Notes</span></span><span>By class, on a full-time-equivalent headcount basis</span></div>
          <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>KMP / close-family loans (not widely available)</span><span><span class="badge bp">Notes</span></span><span>Per-individual advance, repayment, closing balance, terms</span></div>
          <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Intra-economic-entity transactions</span><span>–</span><span>Eliminated on consolidation – no separate disclosure needed</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 11 – RELATED STANDARDS ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>Related Standards – Cross-Reference Map</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">How IPSAS 20 connects across the IPSAS body of literature</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.7fr 2.2fr;"><span>Standard</span><span>Nature of the connection</span></div>
          <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 1</span><span>Requires disclosure of amounts payable to/receivable from controlling entities, fellow controlled entities, associates, and other related parties (§1)</span></div>
          <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 14</span><span>Planned intra-economic-entity transfers may require IPSAS 14 AND IPSAS 20 disclosure even without a binding provision (cross-ref from IPSAS 19)</span></div>
          <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 35</span><span>Consolidation eliminates intra-economic-entity related party transactions (except investment-entity FVSD holdings) (§6)</span></div>
          <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 36</span><span>Associates fall within the related party definition; equity-method transactions are NOT eliminated and require disclosure (§1, §6)</span></div>
          <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 37</span><span>Joint arrangement counterparties considered when identifying related parties (§8 amendment history)</span></div>
          <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 38</span><span>Disclosure of Interests in Other Entities – complements IPSAS 20's related party lens with a structural/ownership lens (§8 amendment history)</span></div>
          <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 39</span><span>Governs the measurement of employee benefits included within KMP remuneration disclosures (§7)</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 12 – GLOSSARY ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <div class="three-col">
      <div class="card cn">
        <div class="glossary-item"><div class="glossary-term">Related party</div><div class="glossary-def">A party with the ability to control or significantly influence another, or subject to common control with it.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Related party transaction</div><div class="glossary-def">A transfer of resources or obligations between related parties, regardless of whether a price is charged.</div></div>
      </div>
      <div class="card cn">
        <div class="glossary-item"><div class="glossary-term">Key management personnel</div><div class="glossary-def">Governing body members plus other persons with authority and responsibility for planning, directing, and controlling the entity's activities.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Close members of the family</div><div class="glossary-def">Close relatives or immediate family members expected to influence, or be influenced by, an individual in dealings with the entity.</div></div>
      </div>
      <div class="card cn">
        <div class="glossary-item"><div class="glossary-term">Significant influence</div><div class="glossary-def">Power to participate in financial/operating policy decisions, without control over those policies.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Remuneration of key management personnel</div><div class="glossary-def">Consideration or benefit derived from the reporting entity for services provided as a governing body member or employee.</div></div>
      </div>
    </div>

    <div class="legend">
      <div class="ltitle">Financial statement key</div>
      <div class="lrow">
        <span class="badge bp">Notes</span> Notes to the financial statements
      </div>
    </div>


  </StandardPageLayout>
