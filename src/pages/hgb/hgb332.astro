        { id: "s9", label: "§332(2) Sentence 2 — a SEPARATE PIE-Specific Aggravation" },
        { id: "s10", label: "Worked Example — a False Opinion on a PIE, No Bribery Required" },
        { id: "s11", label: "§332(3) — the Leichtfertigkeit Tier for PIE Cases" },
        { id: "s12", label: "Worked Example — Contrasting Intent and Leichtfertigkeit for the Same PIE Failure" },
