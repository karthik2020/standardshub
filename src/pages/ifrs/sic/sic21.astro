---
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../../components/FinancialStatementKey.astro";
import Glossary from "../../../components/Glossary.astro";
import PageToc from "../../../components/PageToc.astro";
import LifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import HistoryTimeline from "../../../components/HistoryTimeline.astro";
import history from "../../../data/history.json";
import metadata from "../../../data/standards/sic/sic21.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType="IFRS"
  title={metadata.title}
  description={metadata.summary}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "What SIC-21 Addressed (Historical)" },
        { id: "s2", label: "The Conclusion It Reached (Historical)" },
        { id: "s3", label: "Where This Guidance Lives Today" },
        { id: "s4", label: "Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="historical-reference"
    explanation="SIC-21 was withdrawn in December 2010 when the IASB issued amendments to IAS 12 Income Taxes, which superseded SIC-21 by generalising the recovery through sale presumption into a rebuttable presumption for investment property and other non-depreciable revalued assets."
    historical="This page is retained for historical and comparative reference. Entities should refer to the current standard that superseded this interpretation for authoritative guidance."
    link="/ias/ias12"
    linkText="IAS 12 Income Taxes"
  />

  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>What SIC-21 Addressed (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">What SIC-21 addressed</div>
        <div class="principle">SIC-21 addressed how to measure deferred tax on revalued non-depreciable assets, such as land. It considered whether the carrying amount of such an asset would be recovered through use or through sale, and how that determination affected the measurement basis for deferred tax liabilities.</div>
      </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>The Conclusion It Reached (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">The conclusion it reached</div>
        <div class="principle">SIC-21 concluded that the carrying amount of a revalued non-depreciable asset would be recovered through use if the asset was used in the business, but would be recovered through sale if the asset was held to earn rentals or for capital appreciation, or if the asset was unused. Accordingly, deferred tax should be measured based on the manner in which the carrying amount would be recovered.</div>
      </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Where This Guidance Lives Today</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card">
        <div class="ctitle">Where this guidance lives today</div>
        <div class="td-table">
          <div class="tr"><span>Superseded by</span><span>IAS 12 Income Taxes</span></div>
          <div class="tr alt"><span>Why withdrawn</span><span>The 2010 amendments superseded SIC-21 by generalising the recovery through sale presumption</span></div>
          <div class="tr"><span>Current status</span><span>Superseded</span></div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s4"><h2>Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Deferred tax liability", definition: "An amount of tax payable in future periods in respect of taxable temporary differences arising from the revaluation of non-depreciable assets." },
      { term: "Non-depreciable asset", definition: "An asset such as land that has an indefinite useful life and is not depreciated, but may be revalued under IAS 16." }
    ]} />

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.SIC21} />
  </section>
</StandardPageLayout>




