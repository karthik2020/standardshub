---
import StandardLayout from "./StandardLayout.astro";
import InformationHeader from "../components/InformationHeader.astro";
import ReferenceGuide from "../components/ReferenceGuide.astro";
import PreviousNextNavigation from "../components/PreviousNextNavigation.astro";
import "../styles/posters/poster-classic.css";

interface Props {
  code: string;
  title: string;
  standardType?: string;
  issued?: string;
  latestAmendment?: string;
  status?: string;
  summary?: string;
}

const {
  code,
  title,
  standardType = "IAS",
  issued = "",
  latestAmendment = "",
  status = "",
  summary = "",
} = Astro.props;
---
---

<StandardLayout code={code} title={title} framework={standardType}>
  <Fragment slot="toc">
    <slot name="toc" />
  </Fragment>
  <InformationHeader
    code={code}
    title={title}
    summary={summary}
    issued={issued}
    latestAmendment={latestAmendment}
    status={status}
    framework={standardType}
  />
  <ReferenceGuide>
    <slot />
  </ReferenceGuide>
  <PreviousNextNavigation current={code} framework={standardType as "IAS" | "IFRS" | "Ind AS"} />
</StandardLayout>