---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ias/ias25.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Classification – Current vs Long-Term Investments" },
        { id: "s4", label: "Measurement Choices for Current Investments" },
        { id: "s5", label: "Measurement Choices for Long-Term Investments" },
        { id: "s6", label: "Investment Property (Historical Treatment)" },
        { id: "s7", label: "Disposal of Investments" },
        { id: "s8", label: "Why IAS 25 Was Split" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IAS 25 vs Modern IFRS 9/IAS 40" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IAS 25 (issued 1986) governed accounting for investments in equity and debt securities, and investment property, offering entities a genuine choice of measurement bases. It was superseded in 2001, split between IAS 39 Financial Instruments: Recognition and Measurement (itself later replaced by IFRS 9) and IAS 40 Investment Property."
    historical="It is retained here for historical reference. For current investment accounting, apply IFRS 9 (financial instruments) or IAS 40 (investment property)."
    link="/ias/ias39"
    linkText="IAS 39 Financial Instruments"
  />

  <div class="wrap">
    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">A permissive, choice-heavy predecessor</div>
        <div class="principle">IAS 25 reflected an earlier era of IFRS standard-setting, where genuine measurement choice (rather than principle-driven, criteria-based classification) was common. The Conceptual Framework's comparability objective is best served when similar investments are measured consistently across entities – a goal IAS 25's broad menu of options genuinely undermined, motivating its eventual replacement by the far more prescriptive IAS 39 (and later IFRS 9) and IAS 40.</div>
        <div class="elabel">HOW IAS 25 MAPPED TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Comparability weakness</strong> – the genuine choice between cost and fair value/market value for both current and long-term investments meant economically similar holdings could be measured very differently across entities</span>
          <span><strong style="font-weight:500">An early recognition of fair value's relevance</strong> – IAS 25 nonetheless represented an important early acknowledgement that fair value (or "market value") could be more relevant than historical cost for certain investment categories – a principle later developed far more rigorously by IAS 39/IFRS 9 and IFRS 13</span>
          <span><strong style="font-weight:500">Investment property bundled in</strong> – IAS 25 treated investment property as just another category of "investment," rather than recognising its distinct economic characteristics (a real estate asset held for rental/capital appreciation) – a gap IAS 40 later addressed with dedicated guidance</span>
        </div>
        <div class="note">IAS 25's broad measurement choice reflects the IASC's earlier, more permissive approach to standard-setting – a philosophy the organisation progressively moved away from as it matured, converging toward more criteria-based, less choice-driven standards.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">The measurement menu, at a glance</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Investment category</span><span>Permitted measurement bases</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Current investments (marketable securities)</span><span>Lower of cost and market value, OR market value directly</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Long-term investments</span><span>Cost, revalued amount, OR (for marketable securities) lower of cost and market value</span></div>
        </div>
        <div class="callout info callout--chip" style="margin-bottom:0;">This genuine choice across multiple bases is precisely what later standards (IAS 39, then IFRS 9) progressively narrowed, replacing broad preparer discretion with criteria-based classification.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 25 covered</div>
        <div class="principle">IAS 25 applied to accounting for investments in marketable securities (equity and debt) and investment property, excluding investments in subsidiaries/associates/joint ventures (governed separately by IAS 27/28/31).</div>
        <div class="note">This exclusion of subsidiaries/associates/joint ventures reflects the same scope boundary maintained by IFRS 9 today – investments conferring control, joint control, or significant influence have always been treated separately from "portfolio" style investments.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Current investment (original)</div>
          <div class="glossary-def">An investment readily realisable, intended to be held for not more than one year.</div>
        </div>
        <div class="glossary-item">
          <div class="glossary-term">Long-term investment (original)</div>
          <div class="glossary-def">An investment other than a current investment – intended to be held for more than one year, or without a specific intention to dispose of it in the near term.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Investment property (original)</div>
          <div class="glossary-def">Property held for rental income or capital appreciation, rather than for use in production or administrative purposes.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Classification – Current vs Long-Term Investments (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">An intention-based distinction, predating today's more objective tests</div>
        <div class="principle">Classification depended largely on management's intention regarding the holding period – a relatively subjective test compared to IFRS 9's later, more objective business-model and contractual cash flow characteristics tests.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: Classifying a marketable security under IAS 25</div>
          <div class="wk-body">An entity purchases listed equity shares, with management intending to sell within the next 6 months to fund an upcoming capital project.</div>
          <div class="wk-answer">Given the specific intention to sell within 12 months, this qualifies as a current investment under IAS 25 – measured at the lower of cost and market value, or at market value directly, per the entity's elected accounting policy (Section 4).
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Measurement Choices for Current Investments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">A genuine, freely elected policy choice</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Current investments could be carried at either: the lower of cost and market value (aggregated on a portfolio or individual basis) – a conservative, prudence-driven approach; or at market value directly, with changes recognised either in income or as a revaluation reserve – a genuinely more fair-value-oriented approach, decades before IFRS 9's FVTPL/FVOCI categories formalised similar concepts.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Measurement Choices for Long-Term Investments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Cost, revaluation, or lower-of-cost-and-market</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">Long-term investments could be carried at cost (subject to write-down for other than temporary impairment); at a revalued amount, with a full revaluation policy applied consistently to the whole category; or, for marketable securities, at the lower of cost and market value on a portfolio basis – offering considerably more flexibility than the criteria-driven classification IAS 39/IFRS 9 later introduced.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Investment Property (Historical Treatment)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Bundled within the general "investment" measurement choices</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IAS 25 treated investment property as simply another type of long-term investment, subject to the same broad cost/revaluation measurement choice as equity and debt securities – without the dedicated fair value model, specific transfer rules, or detailed disclosure requirements IAS 40 later developed specifically for this asset category once it was recognised as warranting its own standard.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Disposal of Investments</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Gain/loss recognition, and revaluation reserve treatment</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">On disposal, the difference between net disposal proceeds and carrying amount was recognised as income/expense – for investments carried at a revalued amount, any related revaluation surplus was typically transferred directly to retained earnings on disposal, rather than being recycled through profit or loss, an approach broadly consistent with how IAS 16's revaluation surplus is treated today.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Why IAS 25 Was Split</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Growing complexity demanded dedicated standards</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">As financial instruments and investment property each grew significantly in complexity and economic importance during the 1990s, the IASC recognised that IAS 25's broad, choice-heavy, "one standard fits all investments" approach was no longer adequate. IAS 39 (1998, effective 2001) was developed specifically for financial instruments, introducing the far more detailed classification/measurement/impairment/hedge accounting framework. IAS 40 (2000) was developed specifically for investment property, introducing the dedicated fair value model. IAS 25 was withdrawn once both replacement standards became effective.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures under IAS 25</div>
        <div class="check-list">
          <span>Accounting policies for determining carrying amount of investments (cost, revaluation, or lower-of-cost-and-market)</span>
          <span>Market value of marketable securities, where carried at cost</span>
          <span>Significant restrictions on the realisability of investments, or the remittance of related income/disposal proceeds</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Classifying an investment as current vs long-term, based on management's intention</span>
              <span>Which of the available measurement bases to elect for each investment category</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Market value of investments where an active market existed</span>
              <span>Whether a decline in value was "other than temporary," triggering a write-down</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip" style="margin-top:8px;margin-bottom:0;">The heavy reliance on management intention for classification, and the genuine measurement choice available, made IAS 25 considerably less comparable across entities than the later, more criteria-driven IAS 39/IFRS 9 and IAS 40.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IAS 25 vs Modern IFRS 9/IAS 40</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison – IAS 25 (1986) vs current IFRS 9 &amp; IAS 40</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IAS 25 (withdrawn)</span><span style="color:var(--color-text-warning);">Current (IFRS 9 / IAS 40)</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Financial instrument classification</span><span>Intention-based (current vs long-term), broad measurement choice</span><span>Objective business model + SPPI cash flow tests (IFRS 9)</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Investment property treatment</span><span>Bundled within general "investment" rules</span><span>Dedicated standard (IAS 40) with a specific fair value model and transfer rules</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Impairment approach</span><span>"Other than temporary" decline write-down, judgement-based</span><span>Structured expected credit loss model (IFRS 9), or fair value model with no separate impairment concept (IAS 40)</span></div>
        </div>
        <div class="note">The overall trajectory from IAS 25 to today's standards mirrors a broader pattern across IFRS history – replacing broad, intention/choice-driven guidance with narrower, criteria-based, more comparable frameworks.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical, Under IAS 25)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Current investment measured at market value</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Or via a revaluation reserve, per elected policy</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Long-term investment revaluation</span><span><span class="badge bo">OCI</span> <span class="badge bs">SOFP</span></span><span>Revaluation surplus, similar to IAS 16 mechanics</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Write-down for other-than-temporary impairment</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Judgement-based recognition trigger</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Disposal – gain/loss recognition</span><span><span class="badge bp">SOPL</span></span><span>Revaluation surplus transferred directly to retained earnings, not recycled</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 9</span><span>The ultimate successor for financial instrument investments, via IAS 39</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 40</span><span>The direct successor for investment property specifically</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 27 / IAS 28 / IFRS 11</span><span>Always governed control/joint-control/significant-influence investments separately from IAS 25's scope</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Other than temporary decline", definition: "A decline in an investment's value judged to be more than a short-term fluctuation, triggering a write-down under IAS 25's cost-based measurement option." },
      { term: "Marketable security", definition: "A security traded in a market where prices are readily available, eligible for the lower-of-cost-and-market or market value measurement options." },
      { term: "Current investment", definition: "An investment readily realisable, intended to be held for not more than one year – measured at lower of cost and market value, or at market value directly." },
      { term: "Long-term investment", definition: "An investment other than a current investment – intended to be held for more than one year, or without a specific intention to dispose of it in the near term." },
      { term: "Investment property", definition: "Property held for rental income or capital appreciation, rather than for use in production or administrative purposes – later governed by IAS 40." }
    ]} />

    <FinancialStatementKey />
  </div>
</StandardPageLayout>
