---
import standards from "../data/standards.json";
import NavLink from "./NavLink.astro";
import {
  Search,
  BookOpen,
  LibraryBig,
  Files,
  ArrowRight,
  Bookmark,
  Clock,
  BookText,
  ChevronRight,
} from "@lucide/astro";
const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <div class="sidebar-search">
    <div class="search-box">
      <div class="search-input-wrapper">
        <Search size={15} class="search-icon" />

        <div class="search-placeholder" id="search-placeholder"></div>

        <input
          class="search-input"
          id="standard-search"
          type="text"
          placeholder=""
          autocomplete="off"
        />

        <button class="search-action" id="search-action" type="button">
          <ArrowRight size={16} />
        </button>
      </div>
    </div>
  </div>

  <div class="sidebar-scroll">
    <div class="sidebar-heading">STANDARDS LIBRARY</div>

    <!-- IAS -->

    <details class="section section-ias" open={currentPath.startsWith("/ias")}>
      <summary class="section-header">
        <div class="section-title">
          <BookText size={17} strokeWidth={2} />
          <span>IAS</span>
        </div>

        <div class="section-actions">
          <span class="count-badge badge-ias">
            {standards.IAS.length}
          </span>

          <ChevronRight class="section-chevron" size={16} strokeWidth={2.4} />
        </div>
      </summary>

      <div class="section-items">
        <div class="sidebar-items">
          {
            standards.IAS.map((item) => (
              <NavLink
                href={item.url}
                title={item.title}
                section="ias"
                code={item.code}
                standardTitle={item.title}
              >
                {item.code}
              </NavLink>
            ))
          }
        </div>
      </div>
    </details>

    <!-- IFRS -->

    <details
      class="section section-ifrs"
      open={currentPath.startsWith("/ifrs")}
    >
      <summary class="section-header">
        <div class="section-title">
          <LibraryBig size={17} strokeWidth={2} />
          <span>IFRS</span>
        </div>

        <div class="section-actions">
          <span class="count-badge badge-ifrs">
            {standards.IFRS.length}
          </span>

          <ChevronRight class="section-chevron" size={16} strokeWidth={2.4} />
        </div>
      </summary>

      <div class="section-items">
        <div class="sidebar-items">
          {
            standards.IFRS.map((item) => (
              <NavLink
                href={item.url}
                title={item.title}
                section="ifrs"
                code={item.code}
                standardTitle={item.title}
              >
                {item.code}
              </NavLink>
            ))
          }
        </div>
      </div>
    </details>

    <!-- Ind AS -->

    <details
      class="section section-indas"
      open={currentPath.startsWith("/indas")}
    >
      <summary class="section-header">
        <div class="section-title">
          <Files size={17} strokeWidth={2} />
          <span>Ind AS</span>
        </div>

        <div class="section-actions">
          <span class="count-badge badge-indas">
            {standards.IndAS.length}
          </span>

          <ChevronRight class="section-chevron" size={16} strokeWidth={2.4} />
        </div>
      </summary>

      <div class="section-items">
        <div class="sidebar-items">
          {
            standards.IndAS.map((item) => (
              <NavLink
                href={item.url}
                title={item.title}
                section="indas"
                code={item.code}
                standardTitle={item.title}
              >
                {item.code}
              </NavLink>
            ))
          }
        </div>
      </div>
    </details>
  </div>
  <footer class="sidebar-footer">
    <a href="#" class="footer-link">
      <Bookmark size={17} strokeWidth={2} />
      <span>Bookmarks</span>
    </a>

    <a href="#" class="footer-link">
      <Clock size={17} strokeWidth={2} />
      <span>Recent</span>
    </a>

    <a href="#" class="footer-link">
      <BookText size={17} strokeWidth={2} />
      <span>Reading</span>
    </a>

    <div class="footer-user">
      <div class="footer-avatar">G</div>

      <div class="footer-user-info">
        <div class="footer-user-name">Guest User</div>

        <div class="footer-user-subtitle">Sign in to sync progress</div>
      </div>
    </div>
  </footer>
</aside>
