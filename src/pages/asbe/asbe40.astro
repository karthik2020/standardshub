<StandardPageLayout
  code='ASBE No. 40'
  standardType='ASBE'
  title='ASBE No. 40 Ã¢â‚¬â€ Joint Venture Arrangements (Joint Arrangements)'
  description='This standard is part of the ASBE framework issued by the Chinese Ministry of Finance. It provides guidance on ASBE No. 40 Ã¢â‚¬â€ Joint Venture Arrangements (Joint Arrangements).'
  issued='2006-02'
  latestAmendment='2017-01'
  status='Active'
  summary='ASBE No. 40 Ã¢â‚¬â€ Joint Venture Arrangements (Joint Arrangements) is part of the Chinese Accounting Standards for Business Enterprises (ASBE).'
>
