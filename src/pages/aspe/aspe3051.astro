---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe3051.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "1. Conceptual Framework Linkage" },
        { id: "s2", label: "2. Scope" },
        { id: "s3", label: "3. Three Categories of Investment" },
        { id: "s4", label: "4. Significant Influence — Equity or Cost Method, a Genuine Choice" },
        { id: "s5", label: "5. THE DISTINCTIVE POINT — Contrasting With IAS 28's Mandatory Equity Method" },
        { id: "s6", label: "6. Investments in Subsidiaries — Cross-Referenced to Section 1591" },
        { id: "s7", label: "7. Portfolio Investments Without Significant Influence" },
        { id: "s8", label: "8. Worked Example — Electing the Cost Method for a Significant-Influence Investment" },
        { id: "s9", label: "9. Worked Example — a Quoted Portfolio Investment at Fair Value" },
        { id: "s10", label: "10. Disclosure Requirements" },
        { id: "s11", label: "11. Critical Judgments &amp; Estimates" },
        { id: "s12", label: "12. Relationship to IAS 28" },
        { id: "s13", label: "13. Statement Mapping" },
        { id: "s14", label: "14. Related Standards" },
        { id: "s15", label: "15. Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
</div>



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Extending ASPE's optional-consolidation philosophy to associates</div><div class="principle">ASPE Section 3051 governs the ACCOUNTING for INVESTMENTS in EQUITY and DEBT instruments — WHERE they FALL outside the SCOPE of Section 3856 (FINANCIAL Instruments) OR Section 1591 (SUBSIDIARIES). GENUINELY distinctively, THIS Section EXTENDS the SAME "COST method as a GENUINE alternative" philosophy we SAW under Section 1591 (see the COMPANION poster) even TO investments WHERE significant INFLUENCE exists (Section 4).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Equity and debt instruments not otherwise governed</div><div class="principle">This Section applies to INVESTMENTS in EQUITY and DEBT instruments GENERALLY, EXCLUDING investments in SUBSIDIARIES (SECTION 1591), interests in JOINTLY controlled ENTERPRISES (SECTION 3056), and FINANCIAL instruments WITHIN the SPECIFIC scope OF Section 3856.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Three Categories of Investment</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Classified by the degree of influence held</div>
<div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Category</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Significant influence</span><span>THE ability to AFFECT the STRATEGIC operating, INVESTING, and FINANCING policies OF an investee, WITHOUT control OR joint CONTROL (GENERALLY, but NOT exclusively, 20%–50% VOTING interest)</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Subsidiaries</span><span>WHERE control EXISTS — GOVERNED by SECTION 1591'S own THREE-way method CHOICE (see the COMPANION poster)</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Portfolio investments</span><span>WHERE neither CONTROL nor SIGNIFICANT influence EXISTS</span></div>
</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Significant Influence — Equity or Cost Method, a Genuine Choice</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Neither method is mandatory</div><div class="text-supporting">FOR investments WHERE significant INFLUENCE exists, an ENTERPRISE elects EITHER the EQUITY method (ADJUSTING the INVESTMENT for ITS share OF the investee'S profit OR loss) OR the COST method (CARRYING the INVESTMENT at COST, recognizing INCOME only TO the extent OF dividends RECEIVED) — a GENUINE, unrestricted CHOICE between the TWO.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>THE DISTINCTIVE POINT — Contrasting With IAS 28's Mandatory Equity Method</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A meaningful, practically significant divergence</div><div class="text-supporting">INTERNATIONALLY, IAS 28 MANDATES the EQUITY method FOR associates (SIGNIFICANT-influence investments), WITH NO cost-method ALTERNATIVE permitted. ASPE, BY contrast, PERMITS the COST method as a GENUINELY equal ALTERNATIVE — CONSISTENT with the SAME cost-BENEFIT philosophy WE saw under SECTION 1591'S subsidiary ACCOUNTING choice. THIS REINFORCES a BROADER pattern RUNNING throughout ASPE'S GROUP-and-investment accounting: PRIVATE enterprises are GENERALLY given the OPTION to AVOID the ADDED complexity OF reflecting an INVESTEE'S underlying PERFORMANCE, WHERE the INCREMENTAL benefit TO their OWN specific USER base is GENUINELY limited.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Investments in Subsidiaries — Cross-Referenced to Section 1591</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">The same three-way choice, in a different Section</div><div class="text-supporting">WHERE an INVESTMENT amounts TO a SUBSIDIARY (i.e. CONTROL exists), the ACCOUNTING is GOVERNED by SECTION 1591'S own THREE-way choice AMONG consolidation, THE cost method, and THE equity method — SEE the COMPANION poster FOR the FULL detail.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Portfolio Investments Without Significant Influence</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Fair value for quoted investments, cost or elected fair value for unquoted</div><div class="text-supporting">PORTFOLIO investments QUOTED in an ACTIVE market ARE measured AT fair VALUE through NET income (a MANDATORY treatment FOR quoted INSTRUMENTS). UNQUOTED portfolio INVESTMENTS are MEASURED at COST, UNLESS the ENTERPRISE elects TO measure them AT fair VALUE instead.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — Electing the Cost Method for a Significant-Influence Investment</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A simple, dividend-driven approach for a 30% stake</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A minority strategic investment</div><div class="wk-body">A private company holds a 30% interest (significant influence) in another private enterprise, originally acquired for $900,000. The investee earns $400,000 of net income during the year and pays the investor a $60,000 dividend. The investor elects the cost method.</div><div class="wk-answer">The INVESTOR'S own FINANCIAL statements SHOW the INVESTMENT at ITS ORIGINAL $900,000 COST (UNCHANGED), with INVESTMENT income OF <strong>$60,000</strong> (the DIVIDEND received) — the INVESTEE'S own $400,000 net INCOME is NOT reflected WITHIN the INVESTOR'S statements, GIVEN the COST method ELECTION.</div></div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — a Quoted Portfolio Investment at Fair Value</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Mandatory fair value for actively traded instruments</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A holding in a publicly traded company</div><div class="wk-body">A private company holds a small, 2% stake in a publicly traded company, purchased for $150,000. By year end, the quoted market value has risen to $185,000.</div><div class="wk-answer">The COMPANY MEASURES the investment AT its QUOTED fair VALUE of $185,000, RECOGNIZING a $185,000 − $150,000 = <strong>$35,000</strong> gain DIRECTLY within NET income — MANDATORY, GIVEN the INVESTMENT is QUOTED in an ACTIVE market.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 3051 requires</div><div class="check-list"><span>Accounting policy elected for significant-influence investments (equity or cost method)</span><span>Carrying amounts of investments, by category</span><span>Basis of measurement for portfolio investments (fair value or cost)</span></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether significant influence genuinely exists over a particular investee</span><span>Which method (equity or cost) best serves the enterprise's users, where significant influence is present</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Fair value of unquoted investments, where the fair value option is elected</span></div></div></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Relationship to IAS 28</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASPE Section 3051 vs IAS 28</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 3051</span><span style="color:var(--color-text-info);">IAS 28</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Significant-influence investment method</span><span>Genuine choice — equity or cost</span><span>Equity method MANDATORY, no cost alternative</span></div>
</div>
<div class="note">A GENUINELY significant, PRACTICALLY meaningful DIVERGENCE — CONSISTENT with the BROADER pattern of OPTIONAL, cost-CONSCIOUS group and INVESTMENT accounting RUNNING throughout ASPE.</div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every investment event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Cost method dividend income</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Investment unchanged; income limited to dividends received</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Quoted portfolio fair value change</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Recognized directly in net income</span></div>
</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 1591</span><span>Subsidiaries — governs the same three-way accounting choice for control-level investments</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 3856</span><span>Financial Instruments — supplies the specific classification and measurement rules for financial instruments outside this Section's scope</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Significant influence</div><div class="glossary-def">The ability to affect the strategic operating, investing, and financing policies of an investee, without amounting to control or joint control.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Portfolio investment</div><div class="glossary-def">An investment where neither control nor significant influence exists, measured at fair value if quoted, or cost (or elected fair value) if unquoted.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.aspe3051 || []} />
  </section>
</StandardPageLayout>
