---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc730.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "The General Rule — All R&D Expensed as Incurred" },
        { id: "s4", label: "Software Development Costs (350-40) — the Capitalisation Exception" },
        { id: "s5", label: "Research vs Development — the Conceptual Distinction" },
        { id: "s6", label: "Capitalisation Trigger — Technological Feasibility" },
        { id: "s7", label: "Amortisation of Capitalised Software" },
        { id: "s8", label: "Worked Example — R&D Expense Recognition" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "ASC 730 vs IAS 38 — Comprehensive Comparison" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Topics" },
        { id: "s14", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Expensing the pursuit of future economic benefits</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">ASC 730 takes a conservative approach to research and development costs: because the future economic benefits of R&D are inherently uncertain at the time the costs are incurred, the Topic REQUIRES all R&D costs to be EXPENSED as incurred. This reflects the Conceptual Framework's prudence constraint and the difficulty of reliably measuring future benefits from research activities.</div></div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope & Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">All research and development activities</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">ASC 730 applies to ALL research and development activities, including laboratory research, design and testing of new products, modification of existing products, and construction of prototypes. It covers both independently contracted R&D and R&D performed on behalf of others. Software development costs for external sale are treated under ASC 985-20, while costs for internal-use software follow ASC 350-40.</div></div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>The General Rule — All R&D Expensed as Incurred</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">No capitalisation permitted for general R&D</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">ALL research and development costs must be EXPENSED as incurred under ASC 730. This includes materials, equipment, personnel costs, and indirect costs directly related to R&D activities. Contract research is similarly expensed. The only exception is software development costs after technological feasibility is established, which follow ASC 350-40 guidance.</div></div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Software Development Costs (350-40) — the Capitalisation Exception</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">A narrow capitalisation carve-out</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">Software development costs may be CAPITALISED once TECHNOLOGICAL FEASIBILITY is established — that is, the entity has completed all planning, designing, coding, and testing activities necessary to establish that the product can be produced to meet its design specifications. Before technological feasibility, costs are expensed as R&D. After feasibility, costs are capitalised and amortised over the software's expected useful life.</div></div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Research vs Development — the Conceptual Distinction</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">Both are expensed, but the distinction matters</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">RESEARCH is planned investigation or search undertaken to discover new knowledge or to apply that knowledge to a new product or process — broad, exploratory, without a specific commercial objective. DEVELOPMENT is the translation of research findings into a plan or design for a new product or process — more focused, with a specific commercial application in mind. Both stages are EXPENSED as incurred under ASC 730, but the distinction matters for disclosure purposes and for the software capitalisation exception.</div></div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Capitalisation Trigger — Technological Feasibility</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">A high threshold for software capitalisation</div><div style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;">Technological feasibility requires evidence that the software product can be produced to meet its design specifications, including completion of a product design document, completion of a working model based on the design document, or completion of all critical coding and testing activities. This is a HIGH threshold — early-stage development work, including high-risk coding and initial design iterations, is expensed before the threshold is met.</div></div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Amortisation of Capitalised Software</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Greater of straight-line or revenue-based approach</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">Capitalised software development costs are amortised using the greater of: (1) the STRAIGHT-LINE method over the estimated useful life of the software, or (2) the REVENUE-BASED method, which amortises proportionally to the ratio of current period revenue to total anticipated revenue. The useful life generally does not exceed 3 to 5 years for most software products.</div></div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — R&D Expense Recognition</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2"><div class="ctitle cw">Expensing R&D costs during the year</div>
      <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Laboratory research costs</div><div class="wk-body">A pharmaceutical company incurs $2,400,000 in R&D costs during the year: $1,200,000 in personnel costs for research scientists, $800,000 in laboratory materials and supplies, $300,000 in clinical trial costs, and $100,000 in R&D facility depreciation.</div><div class="wk-answer">ALL costs are EXPENSED as incurred under ASC 730: Personnel ($1,200,000) + Materials ($800,000) + Clinical trials ($300,000) + Facility depreciation ($100,000) = <strong>$2,400,000</strong> R&D expense recognised in the income statement. None are capitalised as an asset.</div></div>
      </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2"><div class="ctitle cd">What ASC 730 requires</div><div class="check-list"><span>Total R&D expense for the period</span><span>Significant R&D activities, including amounts for major projects or categories</span><span>R&D costs incurred for others, if material</span><span>Software development costs capitalised and amortised</span></div>
      </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments & Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
      <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>When technological feasibility is achieved for software projects</span><span>Distinguishing between research and development phases</span><span>Whether costs are directly related to R&D activities</span></div></div>
      <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Useful life for amortisation of capitalised software</span><span>Total anticipated revenue for revenue-based amortisation</span><span>Allocation of indirect costs to R&D activities</span></div></div></div>
      </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>ASC 730 vs IAS 38 — Comprehensive Comparison</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2"><div class="ctitle ci">Comparison — ASC 730 vs IAS 38</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">US GAAP (ASC 730)</span><span style="color:var(--color-text-info);">IFRS (IAS 38)</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Research costs</span><span>Expensed as incurred</span><span>Expensed as incurred</span></div>
      <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Development costs</span><span>Expensed as incurred (except software)</span><span>Capitalised when technical feasibility and intent to complete are demonstrated</span></div>
      <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Software capitalisation</span><span>After technological feasibility (ASC 350-40)</span><span>IAS 38 criterion for software is similar</span></div>
      </div>
      <div class="note">The SINGLE BIGGEST divergence: IAS 38 permits capitalisation of DEVELOPMENT costs (other than software) when specific criteria are met, while ASC 730 does NOT permit development cost capitalisation for most industries — a genuinely fundamental difference.</div>
      </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2"><div class="ctitle cs">Where every ASC 730 event lands</div>
      <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
      <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>R&D expense</span><span><span class="badge bp">IS</span></span><span>Expensed as incurred</span></div>
      <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Capitalised software amortisation</span><span><span class="badge bp">IS</span></span><span>Amortised over useful life</span></div>
      </div>
      </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Topics</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd"><div class="ctitle cd">Cross-reference map</div>
      <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 350</span><span>Intangibles — software development costs are capitalised under ASC 350-40</span></div>
      <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASC 340</span><span>Other Assets and Deferred Costs — direct-response advertising capitalisation</span></div>
      <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 38</span><span>Intangible Assets — IFRS counterpart permitting development cost capitalisation</span></div>
      </div>
      </div>
    </div>

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.ASC730 || []} />
  </section>
</StandardPageLayout>

