---
/*
Standard card

Simple visual card for displaying a standard number and title.

Props:
- number
- title
- color (optional, defaults to "blue")

Uses the numbered slot for arbitrary summary content below the title.
*/

interface Props {
  title: string;
  color?: string;
}

const {
  number,
  title,
  color = "blue"
} = Astro.props;
---

<div class={`standard-card-block ${color}`}>

  <div class="card-number">
    {number}
  </div>

  <h3 class="card-title">
    {title}
  </h3>

  <div class="card-content">

    <div class="card-summary">
      <slot />
    </div>

  </div>

</div>