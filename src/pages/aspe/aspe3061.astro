import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe3061.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "Initial Measurement – Cost" },
        { id: "s4", label: "Componentization" },
        { id: "s5", label: "THE COST MODEL ONLY – No Revaluation Option" },
        { id: "s6", label: "Depreciation – a Systematic and Rational Basis" },
        { id: "s7", label: "Major Inspections and Overhauls" },
        { id: "s8", label: "Subsequent Expenditures" },
        { id: "s9", label: "Worked Example – Componentized Depreciation" },
        { id: "s10", label: "Worked Example – Capitalizing a Major Overhaul" },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments &amp; Estimates" },
        { id: "s13", label: "Relationship to IAS 16" },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Standards" },
        { id: "s16", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">A cost-anchored framework for tangible capital assets</div><div class="principle">ASPE Section 3061 governs the RECOGNITION, MEASUREMENT, and DEPRECIATION of PROPERTY, plant, AND equipment – TANGIBLE assets HELD for USE in the PRODUCTION or SUPPLY of GOODS and SERVICES, for RENTAL to OTHERS, or FOR administrative PURPOSES, and EXPECTED to be USED for MORE than one PERIOD. THE Section applies the COST model EXCLUSIVELY, WITHOUT the REVALUATION alternative IAS 16 permits INTERNATIONALLY (Section 5).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Tangible, long-lived operational assets</div><div class="principle">This Section applies TO tangible CAPITAL assets USED in OPERATIONS, EXCLUDING agricultural PRODUCTIVE biological ASSETS (SECTION 3041), and ASSETS subject TO their OWN specific GOVERNING Sections.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Initial Measurement – Cost</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Purchase price plus directly attributable costs</div><div class="text-supporting">PROPERTY, plant, AND equipment is INITIALLY measured AT cost – the PURCHASE price PLUS any COSTS directly ATTRIBUTABLE to BRINGING the asset TO the LOCATION and CONDITION necessary FOR it to BE capable of OPERATING in the MANNER intended by MANAGEMENT.</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Componentization</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Separately depreciating significant components with different useful lives</div><div class="text-supporting">WHERE a SIGNIFICANT component OF an item OF property, PLANT, and EQUIPMENT has a MATERIALLY different USEFUL life FROM the ASSET as a WHOLE (e.g. a BUILDING'S roof VERSUS its STRUCTURE), that COMPONENT is DEPRECIATED separately – CONSISTENT with the GENERAL componentization APPROACH also USED internationally.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>THE COST MODEL ONLY – No Revaluation Option</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A meaningful measurement simplification relative to IFRS</div><div class="text-supporting">ASPE requires the COST model EXCLUSIVELY – property, PLANT, and EQUIPMENT is CARRIED at COST less ACCUMULATED depreciation AND accumulated IMPAIRMENT losses, WITH NO alternative REVALUATION model AVAILABLE. THIS stands IN contrast TO IAS 16, WHICH permits an ENTITY to ELECT a REVALUATION model (CARRYING assets at FAIR value, WITH revaluation SURPLUSES flowing THROUGH other COMPREHENSIVE income). GIVEN ASPE'S complete ABSENCE of any OCI mechanism (see the COMPANION Section 1520 poster), a REVALUATION model would HAVE nowhere APPROPRIATE to RECOGNIZE the RESULTING surplus – REINFORCING why ASPE'S cost-ONLY approach is BOTH a DELIBERATE simplification AND a STRUCTURALLY consistent OUTCOME given the FRAMEWORK'S broader DESIGN.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Depreciation – a Systematic and Rational Basis</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Straight-line, declining balance, or units of production</div><div class="text-supporting">DEPRECIATION is RECOGNIZED on a SYSTEMATIC and RATIONAL basis OVER the ASSET'S useful LIFE – COMMON methods INCLUDE straight-LINE, declining BALANCE, and UNITS of PRODUCTION, CHOSEN to BEST reflect the PATTERN in WHICH the ASSET'S economic BENEFITS are CONSUMED.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>Major Inspections and Overhauls</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Capitalized where recognition criteria are met</div><div class="text-supporting">COSTS OF a MAJOR inspection OR overhaul ARE capitalized WHERE they MEET the GENERAL recognition CRITERIA (i.e. FUTURE economic BENEFITS are PROBABLE, and the COST can BE reliably MEASURED), WITH the CARRYING amount OF any PREVIOUSLY recognized inspection/OVERHAUL cost DERECOGNIZED at THAT time.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Subsequent Expenditures</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Capitalized only if future benefits genuinely increase</div><div class="text-supporting">SUBSEQUENT expenditures ARE capitalized ONLY where THEY increase the FUTURE economic BENEFITS the ASSET is EXPECTED to GENERATE, BEYOND its ORIGINALLY assessed STANDARD of PERFORMANCE – ROUTINE repairs and MAINTENANCE are EXPENSED as INCURRED.</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example – Componentized Depreciation</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Depreciating a roof separately from a building's structure</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A commercial building with a shorter-lived roof</div><div class="wk-body">A company acquires a commercial building for $4,000,000, with the roof component valued at $500,000 (15-year useful life) and the remaining structure valued at $3,500,000 (40-year useful life).</div><div class="wk-answer">The company DEPRECIATES the ROOF SEPARATELY at $500,000 ÷ 15 = $33,333 per year, and the STRUCTURE at $3,500,000 ÷ 40 = $87,500 per year, FOR a TOTAL annual DEPRECIATION of <strong>$120,833</strong> – REFLECTING each COMPONENT'S own DISTINCT useful LIFE.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example – Capitalizing a Major Overhaul</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Recognizing a new cost while derecognizing the old</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A manufacturing equipment overhaul</div><div class="wk-body">A company performs a major overhaul on production equipment, costing $180,000, extending the equipment's useful life and meeting the general recognition criteria. The equipment's carrying amount includes $40,000 remaining from a previous overhaul, now fully superseded.</div><div class="wk-answer">The company CAPITALIZES the NEW $180,000 overhaul COST, and DERECOGNIZES the REMAINING $40,000 carrying AMOUNT of the SUPERSEDED prior OVERHAUL, RECOGNIZING it AS an EXPENSE – <strong>NET</strong> effect on the ASSET'S carrying amount OF $180,000 − $40,000 = $140,000 increase.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 3061 requires</div><div class="check-list"><span>Cost, accumulated depreciation, and accumulated impairment, by major class of asset</span><span>Depreciation methods used and useful lives or depreciation rates</span><span>Reconciliation of the carrying amount at the beginning and end of the period</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether a component's useful life differs materially enough to require separate depreciation</span><span>Whether a subsequent expenditure genuinely increases future economic benefits</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Useful lives and residual values</span><span>Depreciation method most appropriate to the asset's consumption pattern</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IAS 16</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison – ASPE Section 3061 vs IAS 16</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 3061</span><span style="color:var(--color-text-info);">IAS 16</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Measurement model</span><span>Cost model ONLY</span><span>Cost model OR revaluation model, as a policy choice</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Componentization</span><span>Required for materially different useful lives</span><span>Required for materially different useful lives – converged</span></div>
</div>
<div class="note">A GENUINE, structurally CONSISTENT divergence – the ABSENCE of a REVALUATION option DIRECTLY reflects ASPE'S broader ABSENCE of an OCI mechanism.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every PP&amp;E event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Depreciation expense</span><span><span class="badge bs">BS</span> <span class="badge is">IS</span></span><span>Systematic allocation over useful life</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 3063</span><span>Impairment of Long-lived Assets – governs the impairment testing this Section's assets are subject to</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 3110</span><span>Asset Retirement Obligations – governs the capitalization of related decommissioning costs into this Section's assets</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Componentization</div><div class="glossary-def">Separately depreciating a significant component of an asset with a materially different useful life from the asset as a whole.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Cost model</div><div class="glossary-def">Carrying an asset at cost less accumulated depreciation and impairment, the sole measurement basis ASPE permits for property, plant, and equipment.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  <section id="history">
    <HistoryTimeline items={history.aspe3061 || []} />
  </section>
</StandardPageLayout>
