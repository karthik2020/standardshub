---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe1520.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope — the Statement of Financial Performance" },
        { id: "s3", label: "Minimum Content" },
        { id: "s4", label: "Presentation by Nature or by Function — a Genuine Choice" },
        { id: "s5", label: "Income From Continuing Operations" },
        { id: "s6", label: "Discontinued Operations" },
        { id: "s7", label: "THE DEFINING FEATURE — No Other Comprehensive Income" },
        { id: "s8", label: "Net Income as the Final Line" },
        { id: "s9", label: "Worked Example — a Function-of-Expense Presentation" },
        { id: "s10", label: "Worked Example — Separating Discontinued Operations" },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments &amp; Estimates" },
        { id: "s13", label: "Relationship to IAS 1's Income Statement Requirements" },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Standards" },
        { id: "s16", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">
</div>



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">A statement that ends at net income, and nowhere further</div><div class="principle">ASPE Section 1520 SETS OUT the MINIMUM content and PRESENTATION requirements FOR the INCOME Statement — the STATEMENT reporting an ENTERPRISE'S revenues, EXPENSES, and RESULTING net INCOME for a PERIOD. THE single MOST defining FEATURE of THIS Section, relative TO IFRS or US GAAP, is WHAT it does NOT include — THERE is NO Other Comprehensive INCOME concept ANYWHERE within ASPE (Section 7).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope — the Statement of Financial Performance</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">One of the four required primary statements</div><div class="principle">This Section applies to the PRESENTATION of the INCOME Statement — ONE of the FOUR required PRIMARY statements COMPRISING a COMPLETE set of ASPE financial STATEMENTS (ALONGSIDE the BALANCE Sheet, the STATEMENT of RETAINED Earnings or CHANGES in EQUITY, and the CASH Flow Statement).</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Minimum Content</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Revenue through net income, with discontinued operations shown separately where relevant</div>
<div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Line item</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Revenue</span><span>REVENUE recognized FOR the period, PER Section 3400</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Expenses</span><span>EXPENSES incurred, PRESENTED by NATURE or FUNCTION</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Income from continuing operations</span><span>The RESULT of ONGOING business ACTIVITIES</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Discontinued operations</span><span>RESULTS of OPERATIONS meeting the DISCONTINUED operations CRITERIA under SECTION 3475, PRESENTED separately</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Net income</span><span>The FINAL, BOTTOM-line result FOR the period</span></div>
</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Presentation by Nature or by Function — a Genuine Choice</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">No mandated single expense presentation format</div><div class="text-supporting">ASPE does NOT mandate a SINGLE expense PRESENTATION format — an ENTERPRISE may PRESENT expenses BY their NATURE (e.g. SALARIES, depreciation, RAW materials) OR by FUNCTION (e.g. COST of goods SOLD, selling EXPENSES, administrative EXPENSES), WHICHEVER presentation PROVIDES information THAT is RELIABLE and MORE relevant.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Income From Continuing Operations</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">The ordinary, ongoing results of the business</div><div class="text-supporting">INCOME from CONTINUING operations REFLECTS the RESULTS of the ENTERPRISE'S ONGOING business ACTIVITIES — PRESENTED separately FROM any DISCONTINUED operations, ALLOWING readers to ASSESS the UNDERLYING, ONGOING earning POWER of the BUSINESS distinct FROM operations BEING wound DOWN or SOLD.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Discontinued Operations</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Presented separately, per Section 3475</div><div class="text-supporting">WHERE a COMPONENT of an ENTERPRISE meets the DEFINITION of a DISCONTINUED operation UNDER Section 3475 (DISPOSAL of long-LIVED assets and DISCONTINUED operations), the RESULTS of THAT component are PRESENTED SEPARATELY from CONTINUING operations WITHIN the INCOME Statement.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>THE DEFINING FEATURE — No Other Comprehensive Income</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A structural absence that ripples throughout ASPE</div><div class="text-supporting">UNLIKE IFRS, US GAAP, OR ASBE — ALL of WHICH include an "OTHER comprehensive INCOME" concept CAPTURING certain GAINS and LOSSES OUTSIDE of net INCOME (e.g. FOREIGN currency TRANSLATION differences, CERTAIN fair VALUE remeasurements) — ASPE has NO equivalent CONCEPT whatsoever. THERE is NO "Statement of COMPREHENSIVE Income," NO OCI reserve WITHIN equity, and NO items EVER "recycled" FROM OCI into PROFIT or loss, SIMPLY because THERE is NO OCI to BEGIN with. EVERY gain OR loss an ASPE preparer RECOGNIZES flows DIRECTLY through NET income — a GENUINELY fundamental STRUCTURAL simplification, CONSISTENT with ASPE'S broader PREFERENCE for HISTORICAL cost measurement OVER fair-VALUE-driven volatility.</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>Net Income as the Final Line</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">The single bottom-line result</div><div class="text-supporting">The INCOME Statement CONCLUDES simply at "NET income" — THIS single FIGURE then FLOWS directly INTO the STATEMENT of RETAINED Earnings (or STATEMENT of CHANGES in EQUITY), COMPLETING the LINK between the TWO statements WITHOUT any INTERMEDIATE comprehensive-INCOME concept.</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — a Function-of-Expense Presentation</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Organizing expenses by their operational role</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A retail company's Income Statement</div><div class="wk-body">A private retail company presents its Income Statement with revenue of $12,000,000, cost of goods sold of $7,200,000, selling expenses of $2,100,000, and administrative expenses of $1,400,000.</div><div class="wk-answer">The COMPANY presents INCOME from CONTINUING operations of $12,000,000 − $7,200,000 − $2,100,000 − $1,400,000 = <strong>$1,300,000</strong>, using a FUNCTION-of-expense PRESENTATION, CONCLUDING at NET income WITH no FURTHER comprehensive-INCOME layer.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example — Separating Discontinued Operations</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Isolating results from a wound-down business segment</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: Winding down an unprofitable division</div><div class="wk-body">The same company sold an unprofitable division during the year, meeting the discontinued operations criteria, generating a $300,000 loss from that division's operations plus disposal costs.</div><div class="wk-answer">The COMPANY presents INCOME from CONTINUING operations of $1,300,000, SEPARATELY presents a $300,000 LOSS from DISCONTINUED operations, ARRIVING at NET income of $1,300,000 − $300,000 = <strong>$1,000,000</strong> — CLEARLY distinguishing the ONGOING business'S performance FROM the DISCONTINUED division.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 1520 requires</div><div class="check-list"><span>Revenue, expenses, income from continuing operations, and net income, presented in the Income Statement</span><span>Discontinued operations presented separately, where applicable</span><span>Basis of expense presentation (by nature or function) applied consistently</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether a component genuinely meets the discontinued operations criteria under Section 3475</span><span>Choosing between a nature-based and function-based expense presentation</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Generally minimal — this Section is primarily a presentation standard</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IAS 1's Income Statement Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASPE Section 1520 vs IAS 1</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 1520</span><span style="color:var(--color-text-info);">IAS 1</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Nature vs function expense presentation</span><span>Free choice</span><span>Free choice — converged</span></div>
<div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Other Comprehensive Income</span><span>DOES NOT EXIST</span><span>Required — single or two-statement approach</span></div>
</div>
<div class="note">THE ABSENCE of ANY OCI concept is the SINGLE most SIGNIFICANT structural DIVERGENCE between ASPE'S income STATEMENT and IAS 1'S equivalent REQUIREMENTS — a GENUINELY fundamental SIMPLIFICATION, not a MERE presentation DETAIL.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every income statement event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Net income</span><span><span class="badge is">IS</span> <span class="badge sre">SRE</span></span><span>Flows directly into the Statement of Retained Earnings, with no OCI layer</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 3400</span><span>Revenue — supplies the revenue recognition principles underlying the Income Statement's top line</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 3475</span><span>Disposal of Long-lived Assets and Discontinued Operations — governs the separate presentation of discontinued operations within this Section</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Net income</div><div class="glossary-def">The final, bottom-line result of the Income Statement, flowing directly into retained earnings with no intervening comprehensive income concept.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Discontinued operations</div><div class="glossary-def">Results of a component of an enterprise meeting specified criteria for separate presentation apart from continuing operations.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  </div>
  <section id="history">
    <HistoryTimeline items={history.aspe1520 || []} />
  </section>
</StandardPageLayout>
