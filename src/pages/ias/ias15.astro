---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ias/ias15.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "The Current Cost Accounting (CCA) Model" },
        { id: "s4", label: "Current Cost Adjustments – Depreciation & COGS" },
        { id: "s5", label: "Monetary Working Capital Adjustment" },
        { id: "s6", label: "Gearing Adjustment" },
        { id: "s7", label: "The Current Purchasing Power (CPP) Alternative" },
        { id: "s8", label: "Why Compliance Became Voluntary, Then Withdrawn" },
        { id: "s9", label: "Disclosure Requirements" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IAS 15 vs Modern IAS 29" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Quick-Reference Glossary" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="withdrawn"
    explanation="IAS 15 (issued 1981) was the IASC's most fully developed response to general price-level changes, offering guidance on both current cost accounting (CCA) and current purchasing power (CPP) approaches. Compliance was made voluntary in 1989, and the standard was formally withdrawn in 2003 as global inflation stabilised."
    historical="It is retained here purely for historical reference – for current price-level guidance, IAS 29 addresses only hyperinflationary economies specifically."
    link="/ias/ias29"
    linkText="IAS 29 Financial Reporting in Hyperinflationary Economies"
  />

  <div class="wrap">
    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">A far more developed attempt than its predecessor, IAS 6</div>
        <div class="principle">Where IAS 6 merely surveyed possible approaches without prescribing detailed mechanics, IAS 15 went considerably further – providing a genuinely worked-out current cost accounting model, including specific adjustments for depreciation, cost of sales, monetary working capital, and gearing, designed to isolate the real operating profit an entity earned after maintaining its productive capacity, distinct from mere holding gains caused by inflation.</div>
        <div class="elabel">HOW IAS 15 MAPPED TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Faithful representation</strong> – the CCA model aimed to separate genuine operating performance from illusory "profit" that merely reflected inflation-driven holding gains on inventory and fixed assets</span>
          <span><strong style="font-weight:500">Capital maintenance</strong> – IAS 15's adjustments directly embodied the Framework's physical capital maintenance concept, requiring sufficient profit to be retained to replace assets at their higher current cost before any true profit was recognised</span>
          <span><strong style="font-weight:500">Complexity as a genuine barrier</strong> – the four specific adjustments (depreciation, COGS, monetary working capital, gearing) made IAS 15 considerably more complex to apply than IAS 6's mere encouragement, ultimately becoming a burden that outweighed its benefits once inflation moderated</span>
        </div>
        <div class="note">IAS 15 represents the IASC's most ambitious attempt to formalise inflation-adjusted accounting – a level of technical sophistication never achieved before or since in mainstream IFRS, reflecting how seriously the 1970s-80s inflation crisis was taken by standard-setters at the time.</div>
      </div>

      <div class="card cs">
        <div class="ctitle cs">The four current cost adjustments, at a glance</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Adjustment</span><span>Purpose</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Depreciation adjustment</span><span>Reflects current replacement cost of fixed assets, not historical cost</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Cost of sales adjustment (COSA)</span><span>Removes inventory holding gains from reported operating profit</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Monetary working capital adjustment (MWCA)</span><span>Reflects the additional funding needed for working capital at current prices</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Gearing adjustment</span><span>Recognises that debt holders (not equity) bear the burden of financing inflation-driven capital needs</span></div>
        </div>
        <div class="callout info callout--chip" style="margin-bottom:0;">These four adjustments together aimed to isolate a "true" current cost operating profit – a genuinely sophisticated (if ultimately short-lived) accounting exercise.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IAS 15 covered</div>
        <div class="principle">IAS 15 applied to entities wishing to present information reflecting the effects of changing prices – initially encouraged broadly, though compliance was made explicitly voluntary from 1989 onward, following widespread international disagreement about the mandatory application of inflation accounting.</div>
        <div class="note">This shift from encouraged toward explicitly voluntary status in 1989 foreshadowed the standard's eventual complete withdrawal in 2003.</div>
      </div>

      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know (historical)</div>
        <div class="glossary-item">
          <div class="glossary-term">Current cost operating profit</div>
          <div class="glossary-def">Historical cost operating profit, adjusted for depreciation, cost of sales, and monetary working capital, to reflect the maintenance of the entity's operating capability at current prices.</div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Holding gain</div>
          <div class="glossary-def">The increase in the replacement cost of an asset (e.g. inventory) held during a period, arising purely from price changes rather than genuine operating activity.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>The Current Cost Accounting (CCA) Model (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Restating specific assets at current replacement cost</div>
        <div class="principle">Under CCA, specific assets (inventory, PPE) were restated to their current replacement cost, with the resulting adjustments flowing through a specifically structured current cost profit and loss statement, isolating operating profit from holding gains.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: Isolating a holding gain from operating profit</div>
          <div class="wk-body">A retailer sells inventory for $150,000 that was purchased for $100,000 (historical cost). At the time of sale, the current replacement cost of that same inventory was $115,000.</div>
          <div class="wk-answer">
            <strong>Historical cost profit</strong> = 150,000 − 100,000 = $50,000<br>
            <strong>Current cost operating profit</strong> (after the COSA) = 150,000 − 115,000 = <strong style="color:var(--color-text-info);">$35,000</strong> (the true operating margin)<br>
            <strong>Holding gain</strong> (excluded from operating profit) = 115,000 − 100,000 = <strong style="color:var(--color-text-warning);">$15,000</strong> – reflecting pure inflation, not genuine trading performance
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Current Cost Adjustments – Depreciation &amp; COGS</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Two of the four core adjustments</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The depreciation adjustment increased the depreciation charge to reflect the asset's current replacement cost rather than its original historical cost – ensuring the charge genuinely reflected the cost of maintaining productive capacity. The cost of sales adjustment (COSA) removed inventory holding gains from operating profit, as illustrated in Example 1 above – together, these two adjustments addressed the most significant sources of historical cost distortion in most businesses.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Monetary Working Capital Adjustment (MWCA)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Recognising the additional funding burden of inflation</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">The MWCA recognised that, as prices rose, an entity needed more monetary working capital (net trade receivables less payables) simply to maintain the same volume of business – this additional funding requirement was not itself a cost, but its financing burden needed separate recognition, adjusting operating profit downward to reflect this genuine economic reality.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Gearing Adjustment (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Recognising who bears the burden of inflation-driven capital needs</div>
        <div class="principle">The gearing adjustment recognised that, to the extent an entity's assets were financed by debt rather than equity, part of the additional capital maintenance burden (depreciation, COSA, MWCA adjustments) was effectively borne by lenders (whose fixed monetary claims lose real value in inflation), not by shareholders – the gearing adjustment credited back a proportion of the total adjustments, based on the entity's debt-to-total-capital ratio.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 2: Applying the gearing adjustment</div>
          <div class="wk-body">An entity's total current cost adjustments (depreciation + COSA + MWCA) reduce operating profit by $200,000. The entity is financed 40% by debt and 60% by equity.</div>
          <div class="wk-answer">
            <strong>Gearing adjustment</strong> = 200,000 × 40% = <strong style="color:var(--color-text-success);">$80,000 credited back</strong> to profit – reflecting that 40% of the additional capital maintenance burden is effectively absorbed by lenders (whose real claim value erodes with inflation), leaving equity shareholders bearing only the remaining 60% ($120,000) of the total adjustment.
          </div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>The Current Purchasing Power (CPP) Alternative</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">A simpler, general index-based alternative</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IAS 15 also permitted the simpler CPP approach – restating the entire set of financial statements using a general price index, rather than the asset-by-asset specific replacement cost adjustments of CCA. CPP was generally considered less theoretically sound (since a general index doesn't necessarily reflect specific price changes for an entity's particular assets) but was significantly easier and cheaper to apply.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Why Compliance Became Voluntary, Then Withdrawn</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Diminishing inflation, diminishing urgency</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">As global inflation rates moderated significantly through the 1980s and 1990s (following aggressive central bank tightening worldwide), the practical urgency of general price-level accounting diminished dramatically. Compliance with IAS 15 was made explicitly voluntary in 1989 – and by 2003, with most major economies experiencing low, stable inflation, the IASB judged the standard no longer necessary and formally withdrew it, leaving IAS 29's much narrower hyperinflation-specific guidance as the sole remaining IFRS response to price-level distortion.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required (voluntary) disclosures under IAS 15</div>
        <div class="check-list">
          <span>The nature of the adjustments (CCA or CPP), and the methods and price indices used</span>
          <span>Current cost operating profit, and each of the four adjustments (depreciation, COSA, MWCA, gearing) separately</span>
          <span>Supplementary current cost balance sheet information</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether to apply CCA or the simpler CPP approach, given both remained genuinely available options</span>
              <span>Selecting appropriate specific price indices for individual asset categories under CCA</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Current replacement cost of specific PPE and inventory items</span>
              <span>Debt-to-total-capital ratio used in the gearing adjustment calculation</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip" style="margin-top:8px;margin-bottom:0;">The four-adjustment CCA model was widely regarded as genuinely complex and resource-intensive to apply correctly – a significant practical barrier that, combined with moderating global inflation, ultimately outweighed the standard's theoretical benefits.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IAS 15 vs Modern IAS 29</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison – IAS 15 (1981, general inflation) vs IAS 29 (current, hyperinflation only)</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IAS 15 (withdrawn)</span><span style="color:var(--color-text-warning);">Current (IAS 29)</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Applicable environments</span><span>Any inflationary environment, entirely voluntary</span><span>Only hyperinflationary economies (broadly, ~100%+ cumulative 3-year inflation), mandatory</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Method(s) offered</span><span>CCA (four adjustments) OR the simpler CPP approach</span><span>A single, specific general purchasing power restatement method</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Level of technical sophistication</span><span>Very high (four distinct CCA adjustments)</span><span>Considerably simpler – a single index-based restatement, without CCA's granular adjustments</span></div>
        </div>
        <div class="note">IAS 15 represented the high-water mark of general inflation accounting sophistication within IFRS – its withdrawal, and the much narrower/simpler IAS 29 that remains, reflects a deliberate retreat from comprehensive general price-level accounting once global inflation stabilised.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical, Under IAS 15)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Current cost profit/loss statement (supplementary)</span><span><span class="badge bp">Notes</span></span><span>Voluntary supplementary presentation, not part of primary statements</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Depreciation adjustment</span><span><span class="badge bp">Notes</span></span><span>Increases charge to reflect current replacement cost</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Cost of sales adjustment (COSA)</span><span><span class="badge bp">Notes</span></span><span>Removes inventory holding gains from operating profit</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Monetary working capital adjustment</span><span><span class="badge bp">Notes</span></span><span>Recognises additional financing burden</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Gearing adjustment</span><span><span class="badge bp">Notes</span></span><span>Credits back the debt-financed proportion of adjustments</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Primary historical cost financial statements</span><span><span class="badge bs">SOFP</span> <span class="badge bp">SOPL</span></span><span>Remained unaffected – CCA/CPP information was purely supplementary</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 6 (also withdrawn)</span><span>The direct, less-developed predecessor standard on the same topic</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 29</span><span>The only surviving IFRS guidance on price-level distortion, narrowly confined to hyperinflationary economies</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IAS 16</span><span>Governs the normal historical cost/revaluation model that IAS 15's supplementary CCA information sat alongside, not instead of</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <Glossary entries={[
      { term: "Cost of sales adjustment (COSA)", definition: "An adjustment removing inventory holding gains (arising purely from price changes) from reported operating profit." },
      { term: "Gearing adjustment", definition: "A credit recognising that lenders, not shareholders, effectively bear the debt-financed proportion of an entity's additional capital maintenance burden under inflation." },
      { term: "Current cost operating profit", definition: "Historical cost operating profit, adjusted for depreciation, cost of sales, and monetary working capital, to reflect the maintenance of the entity's operating capability at current prices." },
      { term: "Holding gain", definition: "The increase in the replacement cost of an asset held during a period, arising purely from price changes rather than genuine operating activity." },
      { term: "Monetary working capital adjustment (MWCA)", definition: "An adjustment recognising the additional funding needed for working capital at current prices, reflecting the financing burden of inflation." }
    ]} />

    <FinancialStatementKey />
  </div>
</StandardPageLayout>
