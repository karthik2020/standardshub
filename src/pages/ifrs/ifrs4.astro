---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ifrs/ifrs4.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Insurance Risk — The Classification Gateway" },
        { id: "s4", label: "Continuation of Existing Accounting Policies" },
        { id: "s5", label: "The Liability Adequacy Test" },
        { id: "s6", label: "Prohibited Practices" },
        { id: "s7", label: "Embedded Derivatives & Unbundling" },
        { id: "s8", label: "Why IFRS 4 Was Temporary" },
        { id: "s9", label: "Disclosure (Historical)" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IFRS 4 vs IFRS 17" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
        { id: "history", label: "History & Development" },
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="superseded"
    explanation="IFRS 4 was withdrawn and replaced by IFRS 17 Insurance Contracts, effective for periods beginning on or after 1 January 2023."
    historical="It is retained here for historical reference because IFRS 4 served as an interim standard that permitted continuation of existing national insurance accounting practices while the IASB developed a comprehensive replacement. For current insurance contract accounting, always apply IFRS 17."
    link="/ifrs/ifrs17"
    linkText="IFRS 17 Insurance Contracts"
  />

  <div class="wrap">

    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why insurance was treated as a special, unfinished case</div>
        <div class="principle">Insurance contracts bundle genuinely uncertain FUTURE obligations spanning many years, making faithful, current-value measurement extremely challenging to develop QUICKLY. Rather than delaying IFRS's global adoption until a comprehensive insurance standard was ready, the IASB issued IFRS 4 as a deliberately NARROW, INTERIM standard — permitting continuation of existing national practices, subject to a few key SAFEGUARDS.</div>
        <div class="elabel">HOW IFRS 4 MAPPED TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong style="font-weight:500">Pragmatic transition, not full compliance</strong> — IFRS 4 explicitly ACKNOWLEDGED it did not achieve full comparability or faithful representation, viewing itself as a necessary STEPPING STONE toward a proper insurance standard</span>
          <span><strong style="font-weight:500">The liability adequacy test as a minimum safeguard</strong> — even while permitting diverse legacy measurement bases, IFRS 4 REQUIRED a minimum reliability check ensuring recognised liabilities were not materially UNDERSTATED</span>
          <span><strong style="font-weight:500">Prohibiting the WORST practices</strong> — IFRS 4 specifically PROHIBITED certain historically permitted practices (catastrophe and equalisation provisions for risks NOT yet incurred) that were widely seen as clearly inconsistent with the Framework's liability definition</span>
        </div>
        <div class="note">IFRS 4 is, alongside IFRS 6 and IFRS 14, one of a small GROUP of deliberately NARROW, transitional IFRS Standards the IASB issued to avoid delaying broader IFRS adoption while more comprehensive guidance was developed.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">What IFRS 4 permitted vs prohibited</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.3fr 1fr;"><span>Practice</span><span>IFRS 4's treatment</span></div>
          <div class="tr" style="grid-template-columns:1.3fr 1fr;"><span>Continuing existing insurance liability measurement</span><span>PERMITTED, subject to the liability adequacy test</span></div>
          <div class="tr alt" style="grid-template-columns:1.3fr 1fr;"><span>Catastrophe/equalisation provisions</span><span>PROHIBITED — for risks not yet incurred at the reporting date</span></div>
        </div>
        <div class="callout info" style="margin-bottom:0;">ℹ️ This "PERMIT MOST things, but prohibit the WORST things" structure reflects a genuinely PRAGMATIC, minimum-safeguard approach to an area the IASB knew it would revisit comprehensively.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRS 4 covered</div>
        <div class="principle">IFRS 4 applied to ALL insurance contracts an entity ISSUES (including reinsurance contracts held), and to financial instruments issued with a DISCRETIONARY PARTICIPATION FEATURE.</div>
        <div class="note">This scope structure — insurance contracts issued, reinsurance held, discretionary participation features — was carried forward largely UNCHANGED into IFRS 17's own scope definition.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know (historical)</div>
        <div class="glossary-item"><div class="glossary-term">Insurance contract (original)</div><div class="glossary-def">A contract under which one party (the insurer) accepts SIGNIFICANT insurance risk from another party (the policyholder), by agreeing to compensate the policyholder if a specified uncertain future event adversely affects them.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Liability adequacy test</div><div class="glossary-def">An assessment, at each reporting date, of whether recognised insurance liabilities are adequate, using current estimates of future cash flows.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Insurance Risk — The Classification Gateway (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Significant insurance risk determines whether IFRS 4 applies at all</div>
        <div class="principle">A contract qualified as an "insurance contract" ONLY if it transferred SIGNIFICANT insurance risk — a scenario in which the insurer could suffer a SIGNIFICANT LOSS on the occurrence of the insured event, compared to the scenario in which the event does NOT occur. Contracts LACKING significant insurance risk were instead accounted for as FINANCIAL INSTRUMENTS under IAS 39/IFRS 9.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 1: Testing for significant insurance risk</div>
          <div class="wk-body">A life insurance policy pays out $500,000 on death, or the accumulated account value ($480,000) on maturity if the policyholder survives — a difference of only $20,000, or roughly 4% additional payout upon death.</div>
          <div class="wk-answer">Whether this qualifies as SIGNIFICANT insurance risk depends on further analysis — the additional amount payable and the probability/timing of the insured event. IFRS 4 provided guidance suggesting even a RELATIVELY SMALL additional payout could be significant if it represented a MEANINGFUL proportion of the policy's overall economics, though contracts with genuinely trivial additional risk would instead be classified as investment contracts under IAS 39/IFRS 9.</div>
        </div>
        <div class="callout warn" style="margin-bottom:0;">⚠️ This "SIGNIFICANT insurance risk" gateway test survives, essentially UNCHANGED in principle, as the classification threshold determining IFRS 17's scope today.</div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Continuation of Existing Accounting Policies</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">The core interim mechanism</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IFRS 4's central provision permitted an insurer to CONTINUE applying its EXISTING accounting policies for insurance contracts, WITHOUT needing to justify them against the Conceptual Framework or other IFRS Standards in the way IAS 8 would normally require — a deliberate, EXPLICIT carve-out very similar in structure to IFRS 6's own treatment of exploration and evaluation expenditure.</div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>The Liability Adequacy Test (with worked example)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">A minimum reliability safeguard on top of continued legacy policies</div>
        <div class="principle">An insurer was required to ASSESS, at each reporting date, whether its recognised insurance liabilities were ADEQUATE, using CURRENT estimates of future cash flows under its insurance contracts. If the assessment showed the carrying amount was INSUFFICIENT, the ENTIRE deficiency was recognised IMMEDIATELY in profit or loss.</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">Example 2: Applying the liability adequacy test</div>
          <div class="wk-body">An insurer's recognised insurance liability (under its continued legacy GAAP policy) is $50,000,000. A current estimate of future cash flows, using up-to-date assumptions, indicates the liability should actually be $54,000,000.</div>
          <div class="wk-answer">The liability adequacy test FAILS — the recognised liability ($50,000,000) is INSUFFICIENT. The entity must recognise the FULL $4,000,000 deficiency IMMEDIATELY in profit or loss, increasing the liability to $54,000,000 — a MANDATORY minimum reliability check that applied REGARDLESS of the insurer's chosen (legacy) measurement policy.</div>
        </div>
        <div class="note">This "MINIMUM FLOOR" test was IFRS 4's single most important safeguard — ensuring that, whatever legacy accounting policy an insurer continued to apply, the resulting liability could NEVER fall below a current, reliably estimated minimum.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Prohibited Practices — Catastrophe/Equalisation Provisions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">A rare, explicit prohibition within an otherwise permissive standard</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IFRS 4 explicitly PROHIBITED recognising, as a liability, provisions for CATASTROPHES that have NOT yet occurred (e.g. setting aside a provision for a hypothetical future earthquake) or "EQUALISATION" provisions designed to smooth future claims volatility for risks NOT yet incurred — since these represented FUTURE, not present, obligations, failing the Conceptual Framework's basic liability definition even under a permissive continuation-of-legacy-policy regime.</div>
        <div class="callout danger" style="margin-bottom:0;">✕ <strong style="font-weight:600">This was ONE OF THE FEW areas where IFRS 4 overrode continued legacy practice</strong> — some national GAAPs permitted such provisions, but IFRS 4 required their DERECOGNITION on transition to IFRS, since they represented no genuine present obligation.</div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Embedded Derivatives &amp; Unbundling</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Separating out non-insurance components</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">IFRS 4 required certain EMBEDDED DERIVATIVES within insurance contracts to be separated ("bifurcated") and measured at fair value per IAS 39/IFRS 9, similar to the general financial instrument treatment. It also permitted (but did NOT require) "UNBUNDLING" — separately accounting for a DEPOSIT component within an insurance contract if it could be measured separately, and the insurer's accounting policies did not already recognise all rights/obligations from that component.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Why IFRS 4 Was Always Meant to Be Temporary</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">A deliberate stop-gap pending IFRS 17's development</div>
        <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.6;">From its very issuance, IFRS 4 was DESCRIBED and understood as "Phase I" of a two-phase insurance contracts project — the IASB always intended to develop a comprehensive, principles-based measurement model in a SUBSEQUENT "Phase II." This eventually materialised, after an unusually long development period spanning MORE than a decade, as IFRS 17.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure Requirements (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Required disclosures under IFRS 4</div>
        <div class="check-list">
          <span>Accounting policies for insurance contracts and related assets/liabilities/income/expense</span>
          <span>Recognised assets, liabilities, income, and expense arising from insurance contracts, and (if separately presented) cash flows</span>
          <span>Information about the nature and extent of risks arising from insurance contracts (broadly similar in spirit to IFRS 7's own risk disclosure requirements)</span>
          <span>Terms/conditions of insurance contracts that materially affect the amount, timing, and uncertainty of future cash flows</span>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates (Historical)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement mattered most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Whether a contract transferred SIGNIFICANT insurance risk, determining classification as insurance vs financial instrument</span>
              <span>Whether an embedded derivative required separation (bifurcation)</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Current estimates of future cash flows for the liability adequacy test</span>
              <span>Continuing legacy GAAP estimates and assumptions used under the entity's continued accounting policy</span>
            </div>
          </div>
        </div>
        <div class="callout warn" style="margin-top:8px;margin-bottom:0;">⚠️ Because IFRS 4 permitted DIVERSE legacy accounting policies to continue, COMPARABILITY between different insurers (and across jurisdictions) remained SIGNIFICANTLY limited throughout its nearly two-decade lifespan — a widely acknowledged weakness that motivated IFRS 17's eventual comprehensive reform.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRS 4 vs Modern IFRS 17</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison — IFRS 4 (2004, interim) vs current IFRS 17</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Feature</span><span style="color:var(--color-text-info);">IFRS 4 (superseded)</span><span style="color:var(--color-text-warning);">Current (IFRS 17)</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Measurement basis</span><span>CONTINUATION of diverse legacy GAAP policies, subject to a liability adequacy floor</span><span>A SINGLE, comprehensive current-value model (fulfilment cash flows + CSM), applied universally</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Profit recognition</span><span>Determined by whatever legacy policy the insurer continued</span><span>EXPLICIT deferral via the Contractual Service Margin, released as coverage is provided</span></div>
          <div class="tr" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Comparability across insurers</span><span>SIGNIFICANTLY limited, given diverse continued policies</span><span>SUBSTANTIALLY improved, given a single mandatory measurement model</span></div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1fr 1fr;"><span>Revenue presentation</span><span>Typically premiums received, per legacy policy</span><span>A genuinely new "insurance revenue" concept, excluding investment components</span></div>
        </div>
        <div class="note">The transition from IFRS 4 to IFRS 17 represents one of the MOST significant single reforms in the history of IFRS — replacing nearly two decades of PERMITTED diversity with a single, comprehensive, globally consistent measurement model.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping (Historical, Under IFRS 4)</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Comprehensive event-to-statement mapping table</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event / transaction</span><span>Statement(s) affected</span><span>Notes</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Insurance liability recognition (legacy policy continued)</span><span><span class="badge bs">SOFP</span></span><span>Per the entity's own continued accounting policy</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Liability adequacy test deficiency</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Full deficiency recognised immediately</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Embedded derivative bifurcation</span><span><span class="badge bp">SOPL</span> <span class="badge bs">SOFP</span></span><span>Separated and measured at fair value per IAS 39/IFRS 9</span></div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Premium income recognition</span><span><span class="badge bp">SOPL</span></span><span>Per the entity's own continued accounting policy</span></div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Catastrophe/equalisation provisions (prohibited)</span><span>—</span><span>NOT recognised; derecognised on IFRS transition if previously recorded</span></div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Standard</span><span>Connection</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 17</span><span>The DIRECT successor, replacing the interim continuation approach with a comprehensive current-value model</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 9</span><span>Governs financial instruments failing the significant insurance risk test, and embedded derivatives requiring bifurcation</span></div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>IFRS 6</span><span>A parallel example of a deliberately narrow, transitional IFRS Standard permitting continuation of existing policies</span></div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>IAS 8</span><span>Its normal policy-selection hierarchy was EXPLICITLY carved out by IFRS 4, similar to IFRS 6's treatment</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Discretionary participation feature</div><div class="glossary-def">A contractual right to receive supplementary benefits, in addition to guaranteed amounts, whose amount/timing is contractually at the ISSUER'S discretion.</div></div>
        <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Unbundling</div><div class="glossary-def">Separately accounting for a deposit component within an insurance contract, an OPTIONAL treatment under IFRS 4 in specific circumstances.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<Glossary entries={[
      { term: "Insurance contract (IFRS 4)", definition: "A contract under which the insurer accepts significant insurance risk from the policyholder, agreeing to compensate them if a specified uncertain future event adversely affects them." },
      { term: "Liability adequacy test", definition: "An assessment, at each reporting date, of whether recognised insurance liabilities are adequate, using current estimates of future cash flows." },
      { term: "Significant insurance risk", definition: "The transfer of risk such that the insurer could suffer a significant loss on the occurrence of an insured event compared to its non-occurrence — the gateway test determining whether a contract is an insurance contract." },
      { term: "Discretionary participation feature", definition: "A contractual right to receive supplementary benefits whose amount/timing is at the issuer's discretion — brings a financial instrument into IFRS 4's scope." },
      { term: "Unbundling", definition: "Separately accounting for a deposit component within an insurance contract where it can be measured separately." },
      { term: "Catastrophe/equalisation provision", definition: "A provision for future, not-yet-incurred risks — explicitly prohibited under IFRS 4 as it fails the Framework's liability definition." }
    ]} />

<FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRS4} />
  </section>
</StandardPageLayout>
