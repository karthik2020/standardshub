---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc210.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Classified vs Unclassified Balance Sheet" },
        { id: "s4", label: "Current/Noncurrent Classification Tests" },
        { id: "s5", label: "Order-of-Liquidity Presentation" },
        { id: "s6", label: "Offsetting — the General Rule (210-20)" },
        {
          id: "s7",
          label: "Offsetting — Derivatives & Master Netting Arrangements",
        },
        { id: "s8", label: "Required Line Items" },
        {
          id: "s9",
          label: "Worked Example — Current/Noncurrent Classification",
        },
        {
          id: "s10",
          label: "Worked Example — Offsetting a Derivative Position",
        },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments & Estimates" },
        {
          id: "s13",
          label:
            "ASC 210 vs IAS 1 / IAS 32 — the Derivative Netting Divergence",
        },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Topics" },
        { id: "s16", label: "Glossary" },
      ]}
    />
  </Fragment>
  <div class="wrap">
    <div class="section-header" id="s1">
      <span class="num">1</span><h2>Conceptual Framework Linkage</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">
          A snapshot of financial position at a point in time
        </div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">
          The Balance Sheet — the US GAAP name for the statement IFRS calls the
          Statement of Financial Position — presents an entity's assets,
          liabilities, and equity as of a specific date. ASC 210 governs its
          FORMAT and classification requirements, working alongside the
          individual asset/liability Topics (300s and 400s) that govern
          recognition and measurement of the individual line items themselves.
        </div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">
          Offsetting and the faithful representation of gross positions
        </div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">
          ASC 210-20's general prohibition on offsetting reflects a
          Conceptual-Framework-level concern: netting assets against liabilities
          that are NOT genuinely settled net would misstate the entity's true
          gross resources and obligations, reducing the faithfulness of the
          position presented — offsetting is permitted only in narrowly defined
          circumstances (Section 6).
        </div>
      </div>
    </div>

    <div class="section-header" id="s2">
      <span class="num">2</span><h2>Scope &amp; Applicability</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">What ASC 210 covers</div><div style="font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6;">
          ASC 210 applies to the presentation of the Balance Sheet for all
          entities preparing US GAAP financial statements, including the choice
          between a CLASSIFIED (current/noncurrent) and UNCLASSIFIED
          presentation, and the circumstances in which assets and liabilities
          may be OFFSET (presented net) rather than gross.
        </div>
      </div>
    </div>

    <div class="section-header" id="s3">
      <span class="num">3</span><h2>
        Classified vs Unclassified Balance Sheet
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">Most entities classify; some don't</div><div
          style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;"
        >
          Most US GAAP preparers present a CLASSIFIED balance sheet, separating
          current from noncurrent assets and liabilities — broadly consistent
          with IAS 1's own current/noncurrent default. However, an UNCLASSIFIED
          presentation (no current/noncurrent split) is used where a classified
          presentation would not be meaningful — most commonly by certain
          FINANCIAL INSTITUTIONS (banks, broker-dealers) that instead present
          assets and liabilities in approximate ORDER OF LIQUIDITY (see Section
          5), mirroring the same "order of liquidity" alternative IAS 1 itself
          explicitly permits when it provides more relevant information.
        </div>
      </div>
    </div>

    <div class="section-header" id="s4">
      <span class="num">4</span><h2>
        Current/Noncurrent Classification Tests
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">The operating cycle concept</div><div
          style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;"
        >
          An asset or liability is CURRENT if it is expected to be realised,
          consumed, or settled within the entity's normal OPERATING CYCLE, or
          WITHIN ONE YEAR if the cycle is shorter than a year — the SAME dual
          test (operating cycle vs 12 months, whichever is longer) that IAS 1
          uses, making this one of the more closely converged classification
          concepts between the two frameworks. Where the operating cycle is not
          clearly identifiable, a one-year period is generally assumed.
        </div>
      </div>
    </div>

    <div class="section-header" id="s5">
      <span class="num">5</span><h2>Order-of-Liquidity Presentation</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">
          The alternative most common in financial services
        </div><div
          style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;"
        >
          Banks, broker-dealers, and similar entities typically present assets
          and liabilities in DECREASING ORDER OF LIQUIDITY rather than as
          current/noncurrent — a presentation better suited to entities whose
          operating cycle is not clearly identifiable and where liquidity, not
          current/noncurrent timing, is the more decision-useful lens for users.
          This directly parallels how IFRS-reporting banks similarly favour an
          order-of-liquidity presentation under IAS 1's own flexibility
          provision.
        </div>
      </div>
    </div>

    <div class="section-header" id="s6">
      <span class="num">6</span><h2>
        Offsetting — the General Rule (210-20)
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">
          Presumption against netting, with a narrow exception
        </div><div
          style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;"
        >
          It is a GENERAL PRINCIPLE of US GAAP that assets and liabilities NOT
          be offset against each other in the balance sheet, EXCEPT where a
          right of SETOFF exists. A right of setoff exists when a debtor has a
          legally enforceable right to settle its obligation to a creditor by
          applying against that obligation an amount the creditor owes the
          debtor, AND (per ASC 210-20's specific criteria): both parties owe
          each other DETERMINABLE amounts, the reporting party has the RIGHT to
          set off, the reporting party INTENDS to set off, and the right is
          legally ENFORCEABLE.
        </div>
      </div>
    </div>

    <div class="section-header" id="s7">
      <span class="num">7</span><h2>
        Offsetting — Derivatives &amp; Master Netting Arrangements
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">
          A specific, narrower exception for derivatives
        </div><div
          style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;"
        >
          ASC 210-20 permits (but does NOT require) an entity to offset FAIR
          VALUE amounts recognised for DERIVATIVE INSTRUMENTS executed with the
          same counterparty under a MASTER NETTING ARRANGEMENT — even without a
          present, unconditional right of setoff in the ordinary sense —
          provided the arrangement itself meets specified conditions. This is a
          genuinely US-GAAP-SPECIFIC accommodation for derivative positions, and
          is the source of the major divergence discussed in Section 13.
        </div>
      </div>
    </div>

    <div class="section-header" id="s8">
      <span class="num">8</span><h2>Required Line Items</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">
          Less prescriptive than IAS 1's minimum line-item list
        </div><div
          style="font-size:var(--text-small);color:var(--color-text-secondary);line-height:1.6;"
        >
          Unlike IAS 1, which specifies a fairly detailed MINIMUM list of line
          items a statement of financial position must present, ASC 210 is
          comparatively LESS prescriptive about specific required line items —
          general practice (heavily influenced by SEC Regulation S-X for public
          companies) has converged on presenting broadly similar captions (cash
          and equivalents, receivables, inventory, PP&amp;E, intangibles,
          payables, debt, equity components) even without an equally detailed
          codified minimum list.
        </div>
      </div>
    </div>

    <div class="section-header" id="s9">
      <span class="num">9</span><h2>
        Worked Example — Current/Noncurrent Classification
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">
          Applying the operating-cycle test to long-term debt
        </div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">
            Example: Debt refinanced shortly after year end
          </div><div class="wk-body">
            An entity has a $10,000,000 term loan due in full in 8 months.
            Before the balance sheet is issued, the entity enters into a new
            long-term credit agreement and uses it to refinance the loan on a
            long-term basis.
          </div><div class="wk-answer">
            Because the entity has both the INTENT and the demonstrated ABILITY
            (an executed refinancing agreement completed before issuance) to
            refinance the obligation on a long-term basis, the $10,000,000 is
            classified as NONCURRENT — consistent with US GAAP's own
            long-standing refinancing classification guidance, which is broadly
            aligned with (though drafted somewhat differently from) IAS 1's own
            refinancing classification principles.
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s10">
      <span class="num">10</span><h2>
        Worked Example — Offsetting a Derivative Position
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">A master netting arrangement in practice</div>
        <div class="worked" style="margin-bottom:0;">
          <div class="wk-title">
            Example: Interest rate swaps under an ISDA master agreement
          </div><div class="wk-body">
            An entity has two interest rate swaps with the same counterparty,
            executed under an ISDA Master Agreement (a standard master netting
            arrangement). Swap A is a $2,000,000 asset (positive fair value);
            Swap B is a $1,200,000 liability (negative fair value).
          </div><div class="wk-answer">
            Under ASC 210-20's derivative-specific offsetting accommodation, the
            entity MAY elect to present these NET — a single $800,000 derivative
            asset — even without evaluating each of the four general setoff
            criteria in Section 6 individually, because the master netting
            arrangement itself satisfies the specific derivative offsetting
            conditions. Under IFRS (IAS 32), by contrast, this same fact pattern
            generally would NOT qualify for offsetting, since IAS 32 requires a
            present, UNCONDITIONAL, legally enforceable right of setoff that is
            not merely contingent on a future default event — a materially
            different (and stricter) test.
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s11">
      <span class="num">11</span><h2>Disclosure Requirements</h2><span
        class="line"></span>
    </div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">What ASC 210 requires</div><div
          class="check-list"
        >
          <span
            >Basis of classification (classified vs
            unclassified/order-of-liquidity), and the operating cycle used if
            not one year</span
          ><span
            >Gross amounts of recognised financial assets and liabilities
            subject to a master netting arrangement, amounts offset, and
            resulting net amounts presented — a detailed tabular disclosure
            introduced by ASU 2011-11/2013-01 as part of a (partial) FASB-IASB
            convergence effort</span>
        </div>
      </div>
    </div>

    <div class="section-header" id="s12">
      <span class="num">12</span><h2>
        Critical Judgments &amp; Estimates
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div><div
              class="dot-list"
            >
              <span
                >Whether a classified or order-of-liquidity presentation better
                reflects the entity's operations</span
              ><span
                >Whether the four general setoff criteria are genuinely
                satisfied for a specific arrangement</span
              ><span
                >Whether to ELECT the derivative-specific netting accommodation,
                where available</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div><div
              class="dot-list"
            >
              <span
                >Length of the operating cycle, where not obviously one year</span
              ><span
                >Fair values of derivative positions being considered for net
                presentation</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s13">
      <span class="num">13</span><h2>
        ASC 210 vs IAS 1 / IAS 32 — the Derivative Netting Divergence
      </h2><span class="line"></span>
    </div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">
          Comparison — ASC 210-20 vs IAS 32 offsetting criteria
        </div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;">
            <span>Feature</span><span style="color:var(--color-text-warning);"
              >US GAAP (ASC 210-20)</span
            ><span style="color:var(--color-text-info);">IFRS (IAS 32)</span>
          </div>
          <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;">
            <span>General setoff test</span><span
              >Legally enforceable right + intent to settle net (or
              simultaneously)</span
            ><span
              >Broadly similar: currently enforceable legal right of set-off +
              intention to settle net or simultaneously</span>
          </div>
          <div class="tr alt" style="grid-template-columns:1.2fr 1.2fr 1.2fr;">
            <span>Derivatives under a master netting arrangement</span><span
              >SPECIFIC, more permissive accommodation — net presentation
              allowed even without an unconditional present right, if the master
              netting conditions are met</span
            ><span
              >NO equivalent accommodation — IAS 32 requires the right of
              set-off to be UNCONDITIONAL and not contingent on a future event
              (such as counterparty default), which most master netting
              arrangements alone do not satisfy</span>
          </div>
          <div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;">
            <span>Practical balance sheet effect</span><span
              >US banks commonly report derivative assets/liabilities on a NET
              basis</span
            ><span
              >IFRS-reporting banks generally report the SAME underlying
              derivative books on a GROSS basis</span>
          </div>
        </div>
        <div class="callout warn callout--chip" style="margin-bottom:0;">
          ⚠️ This is one of the most widely cited real-world consequences of
          INCOMPLETE FASB-IASB convergence — a 2008–2011 joint project attempted
          to align offsetting criteria but ultimately failed to reach a common
          standard, leaving US and IFRS bank balance sheets showing dramatically
          different TOTAL ASSET figures for economically similar derivative
          books, purely due to this gross-vs-net presentation difference.
        </div>
      </div>
    </div>

    <div class="section-header" id="s14">
      <span class="num">14</span><h2>Statement Mapping</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Where every ASC 210 event lands</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Event</span><span>Statement(s) affected</span><span
              >Notes</span>
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span
              >Classification of an asset/liability as current vs noncurrent</span
            ><span><span class="badge bs">BS</span></span><span
              >Presentation only — no measurement change</span>
          </div>
          <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span>Election to offset qualifying derivative positions</span><span
              ><span class="badge bs">BS</span></span
            ><span
              >Reduces total reported assets and liabilities; disclosed gross in
              the notes regardless</span>
          </div>
          <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;">
            <span
              >Change from classified to order-of-liquidity presentation</span
            ><span><span class="badge bs">BS</span></span><span
              >A change in accounting presentation, evaluated under ASC 250 if
              it occurs after initial adoption</span>
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s15">
      <span class="num">15</span><h2>Related Topics</h2><span class="line"
      ></span>
    </div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th" style="grid-template-columns:0.8fr 2fr;">
            <span>Topic</span><span>Connection</span>
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>ASC 205</span><span
              >Supplies the overall complete-set-of-financial-statements
              framework within which the Balance Sheet sits</span>
          </div>
          <div class="tr alt" style="grid-template-columns:0.8fr 2fr;">
            <span>ASC 815</span><span
              >Governs derivative recognition and measurement — the fair value
              amounts potentially subject to offsetting under 210-20</span>
          </div>
          <div class="tr" style="grid-template-columns:0.8fr 2fr;">
            <span>ASC 860</span><span
              >Transfers and Servicing — governs repurchase agreements, another
              common category of instruments subject to master
              netting/offsetting analysis</span>
          </div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary preview</div>
        <div class="glossary-item">
          <div class="glossary-term">Master netting arrangement</div><div
            class="glossary-def"
          >
            A single agreement (e.g. an ISDA Master Agreement) governing
            multiple derivative contracts with the same counterparty, providing
            for net settlement in specified circumstances.
          </div>
        </div>
        <div class="glossary-item" style="border-bottom:none;">
          <div class="glossary-term">Right of setoff</div><div
            class="glossary-def"
          >
            A debtor's legally enforceable right to discharge its obligation to
            a creditor by applying an amount the creditor owes it against that
            obligation.
          </div>
        </div>
      </div>
    </div>

    <div class="section-header" id="s16">
      <span class="num">16</span><h2>Quick-Reference Glossary</h2><span
        class="line"></span>
    </div>
    

    <Glossary
      entries={[
        {
          term: "Operating cycle",
          definition:
            "The average time between the acquisition of materials/services and the final cash realisation from their sale, used as the alternative benchmark (if longer than one year) for the current/noncurrent classification test.",
        },
        { term: "Operating cycle", definition: "The average time between the acquisition of materials/services and the final cash realisation from their sale, used as the alternative benchmark (if longer than one year) for the current/noncurrent classification test." },
        {
          term: "Operating cycle",
          definition:
            "The average time between the acquisition of materials/services and the final cash realisation from their sale, used as the alternative benchmark (if longer than one year) for the current/noncurrent classification test.",
        },
        {
          term: "Order of liquidity",
          definition:
            "A balance sheet presentation approach listing assets and liabilities by decreasing nearness to cash, used instead of a classified current/noncurrent split, typically by financial institutions.",
        },
        {
          term: "Master netting arrangement",
          definition:
            "A single agreement (e.g. an ISDA Master Agreement) governing multiple derivative contracts with the same counterparty, providing for net settlement in specified circumstances.",
        },
        {
          term: "Right of setoff",
          definition:
            "A debtor's legally enforceable right to discharge its obligation to a creditor by applying an amount the creditor owes it against that obligation.",
        },
      ]}
    />

    <FinancialStatementKey />
  </div>
  <section id="history">
    <HistoryTimeline items={history.ASC210} />
  </section>
</StandardPageLayout>

