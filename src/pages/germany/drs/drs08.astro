---
import StandardLifecycleNotice from "../../../components/StandardLifecycleNotice.astro";
import StandardPageLayout from "../../../layouts/StandardPageLayout.astro";
import PageToc from "../../../components/PageToc.astro";
import "../../../styles/standards-poster.css";
import "../../../styles/extended.css";
import metadata from "../../../data/standards/hgb/drs08.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  subtitle={metadata.nativeTitle}
  framework="hgb"
  status={metadata.status}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Part of the DRS consolidation wave" },
        { id: "s2", label: "Why withdrawn" },
        { id: "s3", label: "Status summary" },
      ]}
    />
  </Fragment>

  <StandardLifecycleNotice
    type="withdrawn"
    explanation="This standard has been withdrawn."
    targetStatus="Replaced by DRS 26"
    link="/germany/drs/drs26"
    linkText="View DRS 26"
  />

  <div class="section-header" id="s1"><span class="num">1</span><h2>Part of the DRS consolidation wave</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card warn">
<div class="ctitle">Part of the DRS consolidation wave</div>
<div class="principle">DRS 8 elaborated the equity-method accounting for associated companies established under §§311–312 HGB, covered in detail in the earlier HGB poster series — including the initial measurement choice (book value vs. capital share method), the annual share-of-profit adjustment, and treatment of dividends received, all originally documented at the statutory level in that earlier HGB poster.</div>
</div>
  </div>

  <div class="section-header" id="s2"><span class="num">2</span><h2>Why withdrawn — modernised alongside its joint-venture counterpart</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card info">
<div class="ctitle">Why withdrawn — modernised alongside its joint-venture counterpart</div>
<div class="principle">DRS 8 was withdrawn and replaced by DRS 26 "Assoziierte Unternehmen," part of the same broader modernisation wave that also replaced DRS 9's own joint-venture standard with DRS 27 — both amended together via DRÄS 11 (2021), reflecting the DRSC's practice of treating the equity-method and proportionate-consolidation standards as a closely related pair given their shared conceptual roots in HGB §§310–312.</div>
</div>
  </div>

  <div class="section-header" id="s3"><span class="num">3</span><h2>Status summary</h2><span class="line"></span></div>
  <div class="cols-1">
    <div class="card">
<div class="ctitle">Status summary</div>
<div class="td-table">
<div class="th"><span>Field</span><span>Detail</span></div>
<div class="tr"><span>Original topic</span><span>Equity-method accounting for associated companies</span></div>
<div class="tr"><span>Successor</span><span><strong>DRS 26 — Assoziierte Unternehmen</strong></span></div>
<div class="tr"><span>Later amended (as DRS 26)</span><span>DRÄS 11, 2021</span></div>
</div>
</div>
  </div>

</StandardPageLayout>
