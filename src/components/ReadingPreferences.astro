---
import { Sun, Moon, MonitorCog } from "@lucide/astro";
---

<div id="reading-panel" class="reading-panel">
    <div class="reading-panel-header">
        <div class="reading-title">
            <span class="reading-aa">Aa</span>
            <h3>Reading</h3>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- Appearance -->
    <!-- ===================================================== -->

    <div class="reading-section">
        <div class="reading-label">Appearance</div>

        <div class="preference-grid">
            <button
                class="preference-card"
                data-theme-option="light"
                type="button"
            >
                <Sun size={24} />

                <span>Light</span>
            </button>

            <button
                class="preference-card"
                data-theme-option="dark"
                type="button"
            >
                <Moon size={24} />

                <span>Dark</span>
            </button>

            <button
                class="preference-card"
                data-theme-option="system"
                type="button"
            >
                <MonitorCog size={24} />

                <span>System</span>
            </button>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- Font Size -->
    <!-- ===================================================== -->

    <div class="reading-section">
        <div class="reading-label">Font Size</div>

        <div class="preference-grid">
            <button class="preference-card active">
                <span class="font-preview font-small"> Aa </span>

                <span class="preference-label"> Small </span>
            </button>

            <button class="preference-card">
                <span class="font-preview font-medium"> Aa </span>

                <span class="preference-label"> Medium </span>
            </button>

            <button class="preference-card">
                <span class="font-preview font-large"> Aa </span>

                <span class="preference-label"> Large </span>
            </button>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- Line Spacing -->
    <!-- ===================================================== -->

    <div class="reading-section">
        <div class="reading-label">Line Spacing</div>

        <div class="preference-grid">
            <button class="preference-card active">
                <div class="spacing-preview compact">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <span class="preference-label"> Compact </span>
            </button>

            <button class="preference-card">
                <div class="spacing-preview comfortable">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <span class="preference-label"> Comfortable </span>
            </button>

            <button class="preference-card">
                <div class="spacing-preview spacious">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <span class="preference-label"> Spacious </span>
            </button>
        </div>
    </div>

    <div class="reading-footer">
        <button class="reset-preferences" type="button">
            Restore Defaults
        </button>
    </div>
</div>
