---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/ifrs/ifrs12.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope & Applicability" },
        { id: "s3", label: "Significant Judgements" },
        { id: "s4", label: "Interests in Subsidiaries" },
        { id: "s5", label: "Joint Arrangements & Associates" },
        { id: "s6", label: "Unconsolidated Structured Entities" },
        { id: "s7", label: "Restrictions on Access" },
        { id: "s8", label: "Consolidated Structured Entities" },
        { id: "s9", label: "Investment Entities Disclosures" },
        { id: "s10", label: "Critical Judgments & Estimates" },
        { id: "s11", label: "IFRS vs US GAAP" },
        { id: "s12", label: "Statement Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" },
        { id: "history", label: "History & Development" },
      ]}
    />
  </Fragment>
  <div class="wrap">

    <!-- ============ SECTION 1 ============ -->
    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci">
        <div class="ctitle ci">Why "off-balance-sheet" exposures still need disclosure</div>
        <div class="principle">The Conceptual Framework's relevance objective requires users to understand risk exposures that may NOT be fully captured by consolidation alone — particularly for structured entities an investor is involved with but does NOT control. IFRS 12 exists purely to give users this fuller picture, consolidating (pun intended) ALL "interests in other entities" disclosures into ONE comprehensive standard.</div>
        <div class="elabel">HOW IFRS 12 MAPS TO THE FRAMEWORK</div>
        <div class="check-list">
          <span><strong>Relevance</strong> — users need to understand the nature and extent of an entity's interests, and associated risks, even where NOT consolidated</span>
          <span><strong>Faithful representation</strong> — disclosing significant judgements underlying control/joint control/significant influence conclusions helps users assess the RELIABILITY of consolidation decisions</span>
          <span><strong>A pure disclosure standard</strong> — like IFRS 7 and IFRS 8, IFRS 12 introduces no new recognition/measurement rules</span>
        </div>
        <div class="note">IFRS 12 was issued as part of the SAME 2011 consolidation package as IFRS 10 and IFRS 11 — directly responding to financial crisis-era criticism that entities' true exposure to "shadow" or off-balance-sheet vehicles was poorly disclosed.</div>
      </div>
      <div class="card cs">
        <div class="ctitle cs">The four interest categories covered</div>
        <div class="principle">IFRS 12 consolidates disclosure requirements across every type of "other entity" interest into a single standard.</div>
        <div class="td-table">
          <div class="th cols-13-1"><span>Interest type</span><span>Key disclosure focus</span></div>
          <div class="tr cols-13-1"><span>Subsidiaries</span><span>NCI, restrictions, consolidated structured entities</span></div>
          <div class="tr alt cols-13-1"><span>Joint arrangements &amp; associates</span><span>Nature, financial effects, summarised financials</span></div>
          <div class="tr cols-13-1"><span>Unconsolidated structured entities</span><span>Nature, extent, and risks of involvement</span></div>
        </div>
        <div class="callout info callout--chip callout--flush">Combining what were once scattered disclosures (across IAS 27, IAS 28, IAS 31) into ONE standard improves <strong>understandability</strong> and completeness.</div>
      </div>
    </div>

    <!-- ============ SECTION 2 ============ -->
    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope &amp; Applicability</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw">
        <div class="ctitle cw">What IFRS 12 covers</div>
        <div class="principle">IFRS 12 applies to entities with an interest in a SUBSIDIARY, a JOINT ARRANGEMENT, an ASSOCIATE, or an UNCONSOLIDATED STRUCTURED ENTITY — requiring disclosure of information enabling users to evaluate the NATURE of, and RISKS associated with, its interests, and the EFFECTS of those interests on its financial position, performance, and cash flows.</div>
        <div class="note">IFRS 12's scope DELIBERATELY extends to unconsolidated structured entities — arrangements an entity has NO controlling stake in, but which nonetheless carry disclosure-worthy risk exposure.</div>
      </div>
      <div class="card cd">
        <div class="ctitle cd">Key definitions you must know</div>
        <div class="glossary-item"><div class="glossary-term">Structured entity</div><div class="glossary-def">An entity designed so that voting/similar rights are NOT the dominant factor in deciding who controls it (per IFRS 10).</div></div>
        <div class="glossary-item"><div class="glossary-term">Interest in another entity</div><div class="glossary-def">Contractual and non-contractual involvement exposing an entity to variability of returns from the other entity's performance.</div></div>
        <div class="glossary-item"><div class="glossary-term">Sponsor of a structured entity</div><div class="glossary-def">An entity involved in the design/creation of a structured entity, even without a current interest, whose name is associated with that entity.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 3 ============ -->
    <div class="section-header" id="s3"><span class="num">3</span><h2>Significant Judgements &amp; Assumptions</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Disclosing the reasoning, not just the conclusion</div>
        <div class="principle">An entity discloses information about SIGNIFICANT JUDGEMENTS AND ASSUMPTIONS made in determining: that it has CONTROL of another entity (IFRS 10); that it has JOINT CONTROL of an arrangement, or SIGNIFICANT INFLUENCE over another entity (IFRS 11/IAS 28); and the TYPE of joint arrangement (joint operation or joint venture) when structured through a separate vehicle.</div>
        <div class="note">This is a UNIQUE disclosure requirement — it's not enough to simply STATE the consolidation conclusion; the entity must explain the REASONING, particularly for borderline cases (e.g. de facto control, principal/agent analysis).</div>
      </div>
    </div>

    <!-- ============ SECTION 4 ============ -->
    <div class="section-header" id="s4"><span class="num">4</span><h2>Interests in Subsidiaries</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">NCI and consolidated structured entity disclosures</div>
        <div class="principle">Disclosures include the composition of the group, interests NCI hold in group activities/cash flows, and — for EACH subsidiary with MATERIAL NCI — summarised financial information (dividends paid to NCI, summarised assets/liabilities/revenue/profit/cash flows).</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 1: Material NCI disclosure trigger</div>
          <div class="wk-body">A parent holds an 80% interest in a subsidiary that represents 15% of the group's total consolidated assets, with the 20% NCI stake considered material at the group level.</div>
          <div class="wk-answer">Because NCI in this subsidiary is MATERIAL, the parent must disclose SUMMARISED financial information for that subsidiary specifically (its own assets, liabilities, revenue, profit, and dividends paid to NCI) — a subsidiary-specific disclosure, not merely an aggregate NCI figure.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 5 ============ -->
    <div class="section-header" id="s5"><span class="num">5</span><h2>Interests in Joint Arrangements &amp; Associates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Nature, extent, and financial effects</div>
        <div class="text-supporting">For EACH material joint venture and associate: name, principal place of business, proportion of ownership, and whether the investment is measured at equity method or fair value. SUMMARISED financial information is required (assets, liabilities, revenue, profit/loss, other comprehensive income) — for joint ventures, additionally disaggregated by cash and cash equivalents, current/non-current assets/liabilities, and depreciation/interest/tax expense.</div>
      </div>
    </div>

    <!-- ============ SECTION 6 ============ -->
    <div class="section-header" id="s6"><span class="num">6</span><h2>Unconsolidated Structured Entities</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd span2">
        <div class="ctitle cd">The disclosure that closes the "shadow banking" gap</div>
        <div class="principle">For structured entities NOT consolidated, an entity discloses qualitative/quantitative information about its interests, including the NATURE, PURPOSE, size, and activities of the structured entity, and HOW it is financed. Where the entity has SPONSORED a structured entity in which it holds NO interest at the reporting date, it discloses how it determined which structured entities it sponsored, and income from those entities during the period.</div>
        <div class="worked worked--flush">
          <div class="wk-title">Example 2: Sponsored securitisation vehicle</div>
          <div class="wk-body">A bank sponsors (but does not control or hold an equity interest in) a securitisation vehicle that purchases and repackages loan receivables originated by the bank, generating servicing fee income for the bank.</div>
          <div class="wk-answer">Even with NO consolidation and NO current equity interest, IFRS 12 requires disclosure of the bank's SPONSORSHIP relationship, the nature/purpose of the vehicle, and the servicing fee income earned — precisely the kind of "shadow" exposure IFRS 12 was designed to surface.</div>
        </div>
      </div>
    </div>

    <!-- ============ SECTION 7 ============ -->
    <div class="section-header" id="s7"><span class="num">7</span><h2>Restrictions on Access to Group Assets</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Understanding what the group cannot freely use</div>
        <div class="text-supporting">An entity discloses SIGNIFICANT RESTRICTIONS on its ability to access or use group assets, and settle group liabilities (e.g. those arising from borrowing arrangements, regulatory requirements, or NCI protective rights) — helping users understand that consolidated total assets are NOT always freely available to the parent for group-wide use.</div>
      </div>
    </div>

    <!-- ============ SECTION 8 ============ -->
    <div class="section-header" id="s8"><span class="num">8</span><h2>Consolidated Structured Entities</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cw span2">
        <div class="ctitle cw">Support provided, and support NOT contractually required</div>
        <div class="text-supporting">Where an entity has PROVIDED financial or other support to a CONSOLIDATED structured entity WITHOUT being contractually required to (e.g. a discretionary bailout), it discloses the TYPE and AMOUNT of support provided, and the reasons — a disclosure specifically designed to surface implicit, non-contractual support arrangements that could otherwise go unnoticed.</div>
      </div>
    </div>

    <!-- ============ SECTION 9 ============ -->
    <div class="section-header" id="s9"><span class="num">9</span><h2>Investment Entities Disclosures</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Additional disclosures for the IFRS 10 investment entity exception</div>
        <div class="text-supporting">An entity qualifying as an investment entity (Section 7 of the IFRS 10 poster) discloses significant judgements/changes supporting that determination, and information about each unconsolidated subsidiary it measures at fair value instead of consolidating.</div>
      </div>
    </div>

    <!-- ============ SECTION 10 ============ -->
    <div class="section-header" id="s10"><span class="num">10</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cn span2">
        <div class="ctitle cn">Where management judgement matters most</div>
        <div class="two-col">
          <div>
            <div class="elabel">SIGNIFICANT JUDGEMENTS</div>
            <div class="dot-list">
              <span>Materiality of an individual subsidiary's NCI, triggering subsidiary-specific summarised disclosure</span>
              <span>Identifying which unconsolidated structured entities the entity has "sponsored"</span>
            </div>
          </div>
          <div>
            <div class="elabel">SIGNIFICANT ESTIMATES</div>
            <div class="dot-list">
              <span>Maximum exposure to loss from unconsolidated structured entity interests</span>
            </div>
          </div>
        </div>
        <div class="callout warn callout--chip callout--warn-flush">IFRS 12's disclosures can be extensive and data-intensive, particularly for groups with numerous structured entities or complex NCI arrangements.</div>
      </div>
    </div>

    <!-- ============ SECTION 11 ============ -->
    <div class="section-header" id="s11"><span class="num">11</span><h2>IFRS vs US GAAP</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card ci span2">
        <div class="ctitle ci">Comparison — IFRS 12 vs US GAAP</div>
        <div class="td-table">
          <div class="th cols-12-1-1"><span>Feature</span><span>IFRS (IFRS 12)</span><span>US GAAP</span></div>
          <div class="tr cols-12-1-1"><span>Consolidated disclosure standard</span><span>SINGLE comprehensive standard covering all interest types</span><span>Disclosures are SPREAD across multiple topics (ASC 810 for VIEs, ASC 323 for equity method), no single consolidated standard</span></div>
          <div class="tr alt cols-12-1-1"><span>Unconsolidated VIE/structured entity disclosure</span><span>Extensive, including sponsorship relationships</span><span>Also required under ASC 810, broadly similar in substance</span></div>
        </div>
        <div class="note">IFRS 12's single-standard structure is somewhat MORE STREAMLINED than the equivalent scattered US GAAP guidance, though the underlying disclosure PHILOSOPHY is broadly aligned.</div>
      </div>
    </div>

    <!-- ============ SECTION 12 ============ -->
    <div class="section-header" id="s12"><span class="num">12</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cs span2">
        <div class="ctitle cs">Disclosure-to-location mapping table</div>
        <div class="td-table">
          <div class="th cols-16-1-14"><span>Disclosure item</span><span>Location</span><span>Notes</span></div>
          <div class="tr cols-16-1-14"><span>Significant judgements re: control/joint control/significant influence</span><span><span class="badge bp">Notes</span></span><span>Explains the reasoning, not just the conclusion</span></div>
          <div class="tr alt cols-16-1-14"><span>Material NCI summarised financials</span><span><span class="badge bp">Notes</span></span><span>Per subsidiary with material NCI</span></div>
          <div class="tr cols-16-1-14"><span>Joint venture/associate summarised financials</span><span><span class="badge bp">Notes</span></span><span>Assets, liabilities, revenue, profit/loss, OCI</span></div>
          <div class="tr alt cols-16-1-14"><span>Unconsolidated structured entity nature/risk</span><span><span class="badge bp">Notes</span></span><span>Including sponsorship relationships and maximum loss exposure</span></div>
          <div class="tr cols-16-1-14"><span>Restrictions on group asset access</span><span><span class="badge bp">Notes</span></span><span>Explains limits on parent's free use of consolidated assets</span></div>
        </div>
        <div class="note">IFRS 12 is entirely a DISCLOSURE standard — no direct SOFP/SOPL/OCI/Equity recognition effect.</div>
      </div>
    </div>

    <!-- ============ SECTION 13 ============ -->
    <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards</h2><span class="line"></span></div>
    <div class="grid">
      <div class="card cd">
        <div class="ctitle cd">Cross-reference map</div>
        <div class="td-table">
          <div class="th cols-08-2"><span>Standard</span><span>Connection</span></div>
          <div class="tr cols-08-2"><span>IFRS 10</span><span>Supplies the control conclusions IFRS 12 requires judgement disclosure for</span></div>
          <div class="tr alt cols-08-2"><span>IFRS 11</span><span>Supplies the joint control/classification conclusions requiring disclosure</span></div>
          <div class="tr cols-08-2"><span>IAS 28</span><span>Supplies the significant influence and equity method basis for associate/JV disclosures</span></div>
          <div class="tr alt cols-08-2"><span>IFRS 7</span><span>Financial instrument disclosures may overlap with structured entity risk disclosures</span></div>
        </div>
      </div>
      <div class="card cn">
        <div class="ctitle cn">Quick-reference glossary</div>
        <div class="glossary-item"><div class="glossary-term">Maximum exposure to loss</div><div class="glossary-def">The maximum amount an entity could lose from its involvement with an unconsolidated structured entity, including from any financial support arrangements.</div></div>
        <div class="glossary-item"><div class="glossary-term">Summarised financial information</div><div class="glossary-def">Key financial figures (assets, liabilities, revenue, profit/loss) disclosed for material subsidiaries with NCI, joint ventures, and associates.</div></div>
      </div>
    </div>

    <!-- ============ SECTION 14 ============ -->
    <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<Glossary entries={[
      { term: "Structured entity", definition: "An entity designed so that voting/similar rights are NOT the dominant factor in deciding who controls it (per IFRS 10)." },
      { term: "Interest in another entity", definition: "Contractual and non-contractual involvement exposing an entity to variability of returns from the other entity's performance." },
      { term: "Sponsor of a structured entity", definition: "An entity involved in the design/creation of a structured entity, even without a current interest, whose name is associated with that entity." },
      { term: "Maximum exposure to loss", definition: "The maximum amount an entity could lose from its involvement with an unconsolidated structured entity, including from any financial support arrangements." },
      { term: "Summarised financial information", definition: "Key financial figures (assets, liabilities, revenue, profit/loss) disclosed for material subsidiaries with NCI, joint ventures, and associates." },
      { term: "Pure disclosure standard", definition: "A standard that introduces no new recognition or measurement rules — it only requires disclosure of information." }
    ]} />

<FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.IFRS12} />
  </section>
</StandardPageLayout>
