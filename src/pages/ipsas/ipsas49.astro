---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import PageToc from "../../components/PageToc.astro";
import LifecycleNotice from "../../components/StandardLifecycleNotice.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import metadata from "../../data/standards/ipsas/ipsas49.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  covers={metadata.covers}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Objective, Scope & Plan Types" },
        { id: "s2", label: "Definitions" },
        { id: "s3", label: "Recognition" },
        { id: "s4", label: "Measurement – Plan Investments & Actuarial Present Value" },
        { id: "s5", label: "Presentation – the Statement of Financial Position" },
        { id: "s6", label: "Presentation – Changes in Net Assets & Cash Flow Statement" },
        { id: "s7", label: "Changes in Retirement Benefit Obligations" },
        { id: "s8", label: "Disclosure Requirements – General" },
        { id: "s9", label: "Disclosure – Defined Benefit Specific & Plan Description" },
        { id: "s10", label: "Effective Date & Transition" },
        { id: "s11", label: "Relationship to IAS 26 & GFS" },
        { id: "s12", label: "Statement / Process Mapping" },
        { id: "s13", label: "Related Standards" },
        { id: "s14", label: "Glossary" }
      ]}
    />
  </Fragment>

  <LifecycleNotice
    type="active"
    explanation="IPSAS 49 Retirement Benefit Plans is the current, active standard issued by the IPSASB prescribing financial reporting requirements for retirement benefit plans as separate reporting entities in the public sector. Effective for periods beginning on or after 1 January 2026."
    historical="IPSAS 49 is drawn from IAS 26 Accounting and Reporting by Retirement Benefit Plans, but introduces important public sector improvements: mandating the use of projected salary levels for defined benefit obligations (removing IAS 26's current-salary alternative) and requiring a mandatory direct-method cash flow statement under IPSAS 2."
    link=""
    linkText=""
  />

  <!-- ============ SECTION 1 – OBJECTIVE, SCOPE & PLAN TYPES ============ -->
  <div class="section-header" id="s1"><span class="num">1</span><h2>Objective, Scope &amp; Plan Types (paras. 1–8)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Objective – accounting BY the plan, not the employer</div>
      <div class="principle">Prescribes accounting and reporting requirements for PUBLIC SECTOR RETIREMENT BENEFIT PLANS themselves – a genuinely distinct perspective from IPSAS 39 (which governs the EMPLOYER's own accounting for its obligations). The plan is treated as a REPORTING ENTITY SEPARATE from the employers of its participants (para. 3).</div>
      <div class="text-supporting">Covers the plan for ALL participants AS A GROUP – not individual participant benefit reports (para. 4). Excludes termination payments, deferred compensation, long-service leave, early-retirement/redundancy plans, health/welfare plans, bonus plans, and government social security arrangements (para. 5).</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Plan types, and the insurance-company carve-out</div>
      <div class="dot-list">
        <span>DEFINED BENEFIT plans EXPLICITLY include HYBRID plans (mixing both types) – all references to "defined benefit" in this Standard cover hybrids too (para. 6)</span>
        <span>Applies REGARDLESS of whether a separate fund exists, and regardless of trustees (para. 7)</span>
        <span>Insurance-invested plans &rarr; IN scope, UNLESS the contract is in a SPECIFIC participant's/group's name AND the obligation is SOLELY the insurance company's responsibility (para. 8)</span>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 2 – DEFINITIONS ============ -->
  <div class="section-header" id="s2"><span class="num">2</span><h2>Definitions (para. 9)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">The obligation-side vocabulary</div>
      <div class="glossary-item"><div class="glossary-term">Actuarial present value of promised retirement benefits</div><div class="glossary-def">The present value of expected plan payments to participants, attributable to service ALREADY rendered.</div></div>
      <div class="glossary-item"><div class="glossary-term">Retirement benefit obligations</div><div class="glossary-def">For defined benefit plans – the actuarial present value of promised benefits. For defined contribution plans – the defined contribution obligations.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Vested benefits</div><div class="glossary-def">Benefits whose rights are NOT conditional on continued employment.</div></div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">The net-position vocabulary</div>
      <div class="glossary-item">
        <div class="glossary-term">Net assets available for benefits</div>
        <div class="glossary-def">Defined benefit plans: plan assets LESS liabilities OTHER THAN the actuarial present value (and, for hybrids, the defined contribution obligation). Defined contribution plans: plan assets LESS liabilities other than the defined contribution obligations.</div>
      </div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Funding</div><div class="glossary-def">The transfer of assets to the retirement benefit plan (separate from the employer/sponsor) to meet future benefit payment obligations.</div></div>
    </div>
  </div>

  <!-- ============ SECTION 3 – RECOGNITION ============ -->
  <div class="section-header" id="s3"><span class="num">3</span><h2>Recognition (paras. 10–11)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Two plan types, two SOFP recognition treatments</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1fr 2fr;"><span>Plan type</span><span>Recognition on the SOFP</span></div>
        <div class="tr" style="grid-template-columns:1fr 2fr;"><span>Defined benefit</span><span>A PROVISION for the actuarial present value of promised retirement benefits</span></div>
        <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Defined contribution</span><span>The DEFINED CONTRIBUTION OBLIGATIONS owed to participants</span></div>
      </div>
      <div class="text-supporting">Since the plan is the reporting entity (not the employer), these obligations sit on the PLAN's own statement of financial position – a direct counterpart to the employer-side net defined benefit liability recognized under IPSAS 39.</div>
    </div>
  </div>

  <!-- ============ SECTION 4 – MEASUREMENT: PLAN INVESTMENTS & ACTUARIAL PRESENT VALUE ============ -->
  <div class="section-header" id="s4"><span class="num">4</span><h2>Measurement – Plan Investments &amp; Actuarial Present Value (paras. 12–14)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Plan investments – always fair value</div>
      <div class="formula-box">
        <div class="f-eq">Retirement benefit plan investments SHALL be measured at FAIR VALUE</div>
      </div>
      <div class="text-supporting">No accounting policy choice here – unlike IPSAS 39's dual net-interest/remeasurement mechanics for the employer, the plan itself simply fair-values its investment portfolio.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">The projected salary requirement – a genuine IAS 26 divergence</div>
      <div class="formula-box">
        <div class="f-eq">Actuarial present value = benefits promised under the plan's terms, for service rendered to date, using PROJECTED salary levels</div>
      </div>
      <div class="text-supporting">IPSAS 49 MANDATES projected salaries – IAS 26 allows a CHOICE between current and projected salary levels (&sect;11). If no current actuarial valuation exists, the most RECENT one is used, updated for material transactions/circumstance changes (para. 14).</div>
    </div>
  </div>

  <!-- ============ SECTION 5 – PRESENTATION: THE STATEMENT OF FINANCIAL POSITION ============ -->
  <div class="section-header" id="s5"><span class="num">5</span><h2>Presentation – the Statement of Financial Position (paras. 15, 17)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">The full required statement set (para. 15)</div>
      <div class="check-list">
        <span>A STATEMENT OF FINANCIAL POSITION</span>
        <span>A STATEMENT OF CHANGES IN NET ASSETS available for benefits</span>
        <span>A CASH FLOW STATEMENT</span>
        <span>NOTES to the financial statements</span>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Statement of Financial Position – line items (para. 17)</div>
      <div class="dot-list">
        <span>Plan investments (suitably classified)</span>
        <span>Contributions receivable</span>
        <span>Other assets</span>
        <span>Benefits due and payable</span>
        <span>Other liabilities (excluding retirement benefit obligations to participants)</span>
        <span>NET ASSETS AVAILABLE FOR BENEFITS</span>
        <span>Provision for the actuarial present value of promised retirement benefits (defined benefit) OR defined contribution obligation (defined contribution)</span>
        <span>EXCESS OR DEFICIT – the plan's own funded-status bottom line</span>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 6 – PRESENTATION: CHANGES IN NET ASSETS & CASH FLOW STATEMENT ============ -->
  <div class="section-header" id="s6"><span class="num">6</span><h2>Presentation – Changes in Net Assets &amp; the Cash Flow Statement (paras. 18–19)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Statement of Changes in Net Assets Available for Benefits – line items (para. 18)</div>
      <div class="dot-list">
        <span>Employer/sponsor contributions</span>
        <span>Participant contributions</span>
        <span>Investment income</span>
        <span>Other income</span>
        <span>Benefits paid or payable (analyzed, e.g. retirement/death/disability, or lump sums)</span>
        <span>Transfers from and to OTHER plans</span>
        <span>Administrative expenses</span>
        <span>Other expenses</span>
        <span>Taxes on income</span>
      </div>
      <div class="note">Opening and closing balances are always presented.</div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Cash Flow Statement – a mandatory method choice</div>
      <div class="formula-box">
        <div class="f-eq">MUST use the DIRECT method, per IPSAS 2 (para. 19)</div>
      </div>
      <div class="text-supporting">A genuinely distinctive requirement – IPSAS 2 generally permits EITHER the direct or indirect method for operating activities, but IPSAS 49 removes that choice entirely for retirement benefit plans, mandating direct-method presentation. This is ALSO a divergence from IAS 26, which doesn't require a cash flow statement at all (&sect;11).</div>
    </div>
  </div>

  <!-- ============ SECTION 7 – CHANGES IN RETIREMENT BENEFIT OBLIGATIONS ============ -->
  <div class="section-header" id="s7"><span class="num">7</span><h2>Changes in Retirement Benefit Obligations (paras. 16, 20–21)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci span2">
      <div class="ctitle ci">Statement OR note – a genuine either/or choice</div>
      <div class="formula-box">
        <div class="f-eq">Explain changes in retirement benefit obligations EITHER via a dedicated STATEMENT of changes, OR a NOTE reconciliation between opening and closing balances</div>
      </div>
      <div class="dot-list">
        <span>Amendments to the plan (e.g. changes in participant benefits)</span>
        <span>Changes in the plan's NATURE (e.g. a merger with another plan)</span>
        <span>Participant benefits allocated to DEFINED CONTRIBUTION accounts</span>
        <span>Net changes to DEFINED BENEFIT accrued benefits (e.g. actuarial movements)</span>
        <span>Employer/sponsor and participant contributions; taxes on contributions</span>
        <span>Benefits paid; administration expenses</span>
      </div>
      <div class="note">Opening and closing balances are always presented, regardless of which format is chosen (paras. 20–21).</div>
    </div>
  </div>

  <!-- ============ SECTION 8 – DISCLOSURE REQUIREMENTS: GENERAL ============ -->
  <div class="section-header" id="s8"><span class="num">8</span><h2>Disclosure Requirements – General, Both Plan Types (para. 22)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Core notes package</div>
      <div class="check-list">
        <span>A summary of significant ACCOUNTING POLICIES</span>
        <span>A DESCRIPTION of the plan (&sect;9), and the effect of any period changes</span>
        <span>The BASIS for valuing all plan assets, including fair value hierarchy disclosure per class</span>
        <span>Details of any SINGLE investment exceeding 5% of net assets available for benefits, or 5% of any security class/type</span>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Related-party and funding disclosures</div>
      <div class="dot-list">
        <span>Details of any INVESTMENT IN THE EMPLOYER/SPONSOR – a genuine conflict-of-interest transparency item</span>
        <span>Liabilities OTHER than the retirement benefit obligation itself</span>
        <span>A description of the FUNDING POLICY, including any employer/sponsor obligation to meet an actuarially-determined SHORTFALL in a funded plan</span>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 9 – DISCLOSURE: DEFINED BENEFIT SPECIFIC & PLAN DESCRIPTION ============ -->
  <div class="section-header" id="s9"><span class="num">9</span><h2>Disclosure – Defined Benefit Specific &amp; Plan Description (paras. 23–24)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Defined benefit plans – additional required items (para. 23)</div>
      <div class="check-list">
        <span>The actuarial present value, DISTINGUISHING vested vs. non-vested benefits</span>
        <span>Significant ACTUARIAL ASSUMPTIONS, and the calculation METHOD used</span>
        <span>The EFFECT of any assumption changes that significantly affected the actuarial present value</span>
        <span>The DATE of the actuarial valuation, and when the NEXT one is due</span>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Plan description – mandatory for ALL plans (para. 24)</div>
      <div class="dot-list">
        <span>Name(s) of the employer(s)/sponsor(s) and participant groups covered</span>
        <span>Number of participants receiving benefits, and other participants (classified as appropriate)</span>
        <span>Plan TYPE – defined contribution or defined benefit</span>
        <span>Whether participants CONTRIBUTE to the plan</span>
        <span>A description of the retirement benefits PROMISED</span>
        <span>Any plan TERMINATION terms</span>
        <span>Changes to ANY of the above during the period</span>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 10 – EFFECTIVE DATE & TRANSITION ============ -->
  <div class="section-header" id="s10"><span class="num">10</span><h2>Effective Date &amp; Transition (paras. 25–27)</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cn span2">
      <div class="ctitle cn">One of the newest Standards in the Handbook</div>
      <div class="principle">Periods beginning on/after <strong>1 January 2026</strong>. Earlier application permitted, with disclosure of that fact (para. 25). Applied PROSPECTIVELY from the beginning of the annual period first applied (para. 27) – no retrospective option, unlike IPSAS 48's dual-path transition.</div>
    </div>
  </div>

  <!-- ============ SECTION 11 – RELATIONSHIP TO IAS 26 & GFS ============ -->
  <div class="section-header" id="s11"><span class="num">11</span><h2>Relationship to IAS/IFRS &amp; GFS – Comparison with IAS 26</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card ci">
      <div class="ctitle ci">Comparison – IPSAS 49 vs IAS 26</div>
      <div class="principle">IPSAS 49 is drawn from IAS 26 (amendments to Feb 2021), <em>Accounting and Reporting by Retirement Benefit Plans</em>.</div>
      <div class="dot-list">
        <span>Different DEFINITIONS – e.g. defined benefit plans, net assets available for benefits</span>
        <span>IPSAS 49 MANDATES projected salary levels only; IAS 26 permits a CHOICE of current or projected (&sect;4)</span>
        <span>IPSAS 49 REQUIRES a cash flow statement; IAS 26 does NOT (&sect;6)</span>
      </div>
    </div>

    <div class="card cd">
      <div class="ctitle cd">Comparison – IPSAS 49 vs GFS</div>
      <div class="dot-list">
        <span>Both PERMIT contributions to be accounted for as EITHER revenue or a participant liability, depending on plan terms/scheme type</span>
        <span>Both REQUIRE retirement benefit obligations recognized on the balance sheet/SOFP – GFS calls this "pension entitlements"</span>
      </div>
      <div class="note">A notably CLOSE alignment with GFS compared to many other Standards in this library – reflecting how naturally pension-scheme reporting maps onto statistical frameworks.</div>
    </div>
  </div>

  <!-- ============ SECTION 12 – STATEMENT / PROCESS MAPPING ============ -->
  <div class="section-header" id="s12"><span class="num">12</span><h2>Statement / Process Mapping</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">Decision map</div>
      <ol class="ordered-list">
        <li>Is this a retirement benefit PLAN itself (the reporting entity), not the employer's own accounting? &rarr; IPSAS 49 applies; the employer's mirror-image obligation is governed by IPSAS 39 instead (&sect;1)</li>
        <li>DEFINED BENEFIT (including hybrid) or DEFINED CONTRIBUTION? &rarr; determines which liability line appears on the SOFP (&sect;3)</li>
        <li>Measure plan INVESTMENTS at fair value; measure the DEFINED BENEFIT obligation using projected salary levels (&sect;4)</li>
        <li>Prepare the FULL statement set – SOFP, changes in net assets, direct-method cash flow statement, notes (&sect;5, &sect;6)</li>
        <li>Explain OBLIGATION changes – dedicated statement, or note reconciliation (&sect;7)</li>
        <li>Disclose plan description, funding policy, and (for defined benefit) actuarial assumptions/methods (&sect;8, &sect;9)</li>
      </ol>
    </div>
  </div>

  <div class="grid grid-spaced">
    <div class="card cs span2">
      <div class="ctitle cs">Concept-to-statement mapping table</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>IPSAS 49 concept</span><span>Statement(s)</span><span>Notes</span></div>
        <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Plan investments</span><span><span class="badge bs">SOFP</span></span><span>Always at fair value</span></div>
        <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Actuarial present value provision (defined benefit)</span><span><span class="badge bs">SOFP</span></span><span>Projected salary levels, mandatory</span></div>
        <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Net assets available for benefits</span><span><span class="badge bs">SOFP</span></span><span>Key summary line item</span></div>
        <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Contributions, investment income, benefits paid</span><span>Changes in Net Assets</span><span>Opening/closing balances required</span></div>
        <div class="tr" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>All cash flows</span><span>Cash Flow</span><span>Direct method mandatory (IPSAS 2)</span></div>
        <div class="tr alt" style="grid-template-columns:1.7fr 1fr 1.3fr;"><span>Actuarial assumptions, plan description, funding policy</span><span><span class="badge be">Notes</span></span><span>Mandatory disclosures, paras. 22–24</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 13 – RELATED STANDARDS ============ -->
  <div class="section-header" id="s13"><span class="num">13</span><h2>Related Standards – Cross-Reference Map</h2><span class="line"></span></div>
  <div class="grid">
    <div class="card cd span2">
      <div class="ctitle cd">How IPSAS 49 connects across the IPSAS body of literature</div>
      <div class="td-table">
        <div class="th" style="grid-template-columns:0.7fr 2.2fr;"><span>Standard</span><span>Nature of the connection</span></div>
        <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 2</span><span>Mandatory direct-method cash flow statement basis (&sect;6)</span></div>
        <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 33</span><span>Governs when this Standard applies for entities adopting accrual IPSAS after the base effective date (&sect;10)</span></div>
        <div class="tr" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 39</span><span>Governs the EMPLOYER's own mirror-image accounting for the same retirement benefit obligations – explicitly excluded from this Standard's own scope, and vice versa (&sect;1)</span></div>
        <div class="tr alt" style="grid-template-columns:0.7fr 2.2fr;"><span>IPSAS 41 / 46</span><span>Fair value measurement methodology for plan investments (&sect;4)</span></div>
      </div>
    </div>
  </div>

  <!-- ============ SECTION 14 – GLOSSARY ============ -->
  <div class="section-header" id="s14"><span class="num">14</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
  <div class="three-col">
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Retirement benefit plan</div><div class="glossary-def">An arrangement whereby an employer/sponsor provides benefits to participants on or after termination of employment.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Actuarial present value of promised retirement benefits</div><div class="glossary-def">The present value of expected plan payments attributable to service already rendered.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Net assets available for benefits</div><div class="glossary-def">Plan assets less liabilities other than the retirement benefit obligation itself.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Vested benefits</div><div class="glossary-def">Benefits whose rights are not conditional on continued employment.</div></div>
    </div>
    <div class="card cn">
      <div class="glossary-item"><div class="glossary-term">Funding</div><div class="glossary-def">The transfer of assets to the retirement benefit plan, separate from the employer/sponsor, to meet future benefit obligations.</div></div>
      <div class="glossary-item glossary-item--last"><div class="glossary-term">Participants</div><div class="glossary-def">The members of a retirement benefit plan and others entitled to benefits under it.</div></div>
    </div>
  </div>

  <div class="legend">
    <div class="ltitle">Financial statement key</div>
    <div class="lrow">
      <span class="badge bs">SOFP</span> Statement of financial position
      <span class="badge bp">SOFPerf</span> Statement of financial performance
      <span class="badge be">Notes</span> Notes to the financial statements
    </div>
  </div>
</StandardPageLayout>
