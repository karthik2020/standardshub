---
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import FinancialStatementKey from "../../components/FinancialStatementKey.astro";
import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/usgaap/asc924.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "Chip Liability — Outstanding, Unredeemed Gaming Chips" },
        { id: "s4", label: "Progressive Jackpot Liability Accrual" },
        { id: "s5", label: "Base Jackpots vs Progressive Jackpots — the Accrual Timing Distinction" },
        { id: "s6", label: "Complimentary (Comp) Services" },
        { id: "s7", label: "Casino Credit (Markers)" },
        { id: "s8", label: "Worked Example — Progressive Jackpot Liability Accrual" },
        { id: "s9", label: "Worked Example — Comp Allocation" },
        { id: "s10", label: "Disclosure Requirements" },
        { id: "s11", label: "Critical Judgments &amp; Estimates" },
        { id: "s12", label: "No Dedicated IFRS Casino Standard — Discussion" },
        { id: "s13", label: "Statement Mapping" },
        { id: "s14", label: "Related Topics" },
        { id: "s15", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">

    <div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card ci span2"><div class="ctitle ci">Recognising genuine obligations unique to gaming operations</div><div class="principle">Casino operations create several DISTINCTIVE obligations not seen in most other industries: outstanding CHIPS represent a genuine liability to redeem them for cash; PROGRESSIVE JACKPOTS grow with every wager and must be paid out whenever won; and CASINO CREDIT extended to patrons creates a genuine receivable collection risk. ASC 924 provides industry-specific guidance for recognising and measuring these obligations and related revenue items.</div>
    </div>
    </div>

    <div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cw span2"><div class="ctitle cw">Casino and gaming operators</div><div class="principle">ASC 924 applies to entities operating casino and gaming facilities, addressing chip liabilities, jackpot accruals, complimentary services, and casino credit (markers) extended to patrons.</div>
    </div>
    </div>

    <div class="section-header" id="s3"><span class="num">3</span><h2>Chip Liability — Outstanding, Unredeemed Gaming Chips</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">Chips in patrons' hands represent a genuine obligation to the casino</div><div class="principle">Gaming CHIPS sold to patrons but NOT yet redeemed for cash (or gambled away and collected by the house) represent an OUTSTANDING LIABILITY — the "CHIP FLOAT" — since the casino remains obligated to redeem any chip presented to it. This liability is estimated based on chips in circulation and historical redemption patterns, and is periodically reconciled against physical chip inventory counts.</div>
    </div>
    </div>

    <div class="section-header" id="s4"><span class="num">4</span><h2>Progressive Jackpot Liability Accrual</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cw span2"><div class="ctitle cw">A liability that grows continuously with every qualifying wager</div><div class="principle">A PROGRESSIVE JACKPOT increases with EVERY qualifying wager made across the linked machines/tables until it is WON. The casino ACCRUES a liability for the progressive jackpot AS IT GROWS — recognising the increase in the jackpot amount as an EXPENSE and corresponding LIABILITY as each contributing wager occurs, reflecting the casino's growing, unavoidable obligation to pay out the jackpot whenever it is eventually won, regardless of WHICH specific patron wins it.</div>
    </div>
    </div>

    <div class="section-header" id="s5"><span class="num">5</span><h2>Base Jackpots vs Progressive Jackpots — the Accrual Timing Distinction</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">A meaningful distinction in when the liability arises</div>
    <div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Jackpot type</span><span>Liability accrual timing</span></div>
    <div class="tr" style="grid-template-columns:1fr 2fr;"><span>Base (fixed) jackpot</span><span>A FIXED payout amount inherent to a game's design (e.g. a fixed table-game payout for a specific hand) — generally NOT accrued as a liability until actually WON, since it's simply the game's built-in prize structure, not an accumulating pool</span></div>
    <div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Progressive jackpot</span><span>A GROWING pool funded by a PORTION of each qualifying wager — accrued as a liability CONTINUOUSLY as the pool GROWS, since the casino has a genuine, growing obligation regardless of who eventually wins</span></div>
    </div>
    </div>
    </div>

    <div class="section-header" id="s6"><span class="num">6</span><h2>Complimentary (Comp) Services</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cs span2"><div class="ctitle cs">A form of variable consideration/customer incentive, allocated under ASC 606</div><div class="principle">COMPLIMENTARY ("comp") services — free rooms, meals, or show tickets provided to gaming patrons based on their level of play — are evaluated under ASC 606 principles: where comps are provided in connection with GAMING activity, a PORTION of gaming revenue is generally allocated to the comp as a form of customer incentive/discount (rather than gaming revenue being fully recognised with a separate, full-retail-value expense recorded for the comp), reflecting that the comp is effectively PART of the overall consideration exchanged for the gaming experience.</div>
    </div>
    </div>

    <div class="section-header" id="s7"><span class="num">7</span><h2>Casino Credit (Markers)</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">A receivable, with an allowance for uncollectible amounts</div><div class="principle">CASINO CREDIT extended to patrons (via "MARKERS," a form of short-term gaming credit) is recognised as a RECEIVABLE, subject to an ALLOWANCE for expected uncollectible amounts under the general current expected credit loss (CECL) framework (ASC 326) — reflecting the genuine, often elevated, collection risk associated with gaming credit extended to patrons.</div>
    </div>
    </div>

    <div class="section-header" id="s8"><span class="num">8</span><h2>Worked Example — Progressive Jackpot Liability Accrual</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cw span2"><div class="ctitle cw">Accruing the growing obligation</div>
    <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A linked slot machine progressive jackpot</div><div class="wk-body">A casino's progressive jackpot pool begins the month at $340,000. During the month, patrons wager amounts contributing $45,000 to the jackpot pool, and the jackpot has NOT yet been won by month-end.</div><div class="wk-answer">The casino ACCRUES an additional <strong>$45,000 jackpot expense and liability</strong> during the month, bringing the total accrued jackpot liability to <strong>$385,000</strong> at month-end — reflecting the casino's growing, unavoidable obligation to eventually pay out this amount to WHOEVER wins the jackpot, regardless of which specific patron that turns out to be.</div></div>
    </div>
    </div>

    <div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Comp Allocation</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card ci span2"><div class="ctitle ci">Treating a comp as part of the gaming consideration</div>
    <div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: A free hotel room comped based on gaming play</div><div class="wk-body">A patron generates $5,000 of gaming revenue (theoretical win) for the casino during a visit, and is comped a hotel room with a $400 retail value, based on the casino's player-rating program.</div><div class="wk-answer">Rather than recognising the full $5,000 of gaming revenue and a separate $400 marketing/comp EXPENSE, the casino allocates a PORTION of the transaction price (based on relative standalone value) between the gaming activity and the comped room — recognising <strong>approximately $4,600 as gaming revenue</strong> and <strong>$400 as room revenue</strong> (with the room's cost recognised as an operating expense), reflecting that the comp is effectively part of the overall consideration for the patron's gaming activity, consistent with ASC 606's variable consideration/customer incentive principles.</div></div>
    </div>
    </div>

    <div class="section-header" id="s10"><span class="num">10</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">What ASC 924 requires</div><div class="check-list"><span>Accounting policies for chip liability, jackpot accruals, and comp allocation</span><span>Nature and amount of casino credit (markers) outstanding and the related allowance for uncollectible amounts</span></div>
    </div>
    </div>

    <div class="section-header" id="s11"><span class="num">11</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cn span2"><div class="ctitle cn">Where judgement matters most</div>
    <div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGEMENTS</div><div class="dot-list"><span>Classifying jackpots as base vs progressive for accrual timing purposes</span><span>Allocating consideration between gaming activity and comped goods/services</span></div></div>
    <div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Chip liability based on chips in circulation and historical redemption patterns</span><span>Allowance for uncollectible casino credit (markers)</span></div></div></div>
    </div>
    </div>

    <div class="section-header" id="s12"><span class="num">12</span><h2>No Dedicated IFRS Casino Standard — Discussion</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card ci span2"><div class="ctitle ci">General liability recognition and IFRS 15 principles apply instead</div><div class="principle">IFRS has NO dedicated casino industry standard. A casino operator reporting under IFRS would recognise chip and jackpot liabilities under GENERAL liability recognition principles (a present obligation from a past event, with probable outflow and reliable estimate), and would allocate comp consideration under IFRS 15's general variable consideration and customer incentive guidance — arriving at BROADLY similar practical outcomes to ASC 924, but WITHOUT the codified, casino-specific accrual conventions (e.g. the explicit base-vs-progressive jackpot distinction) that ASC 924 provides.</div>
    </div>
    </div>

    <div class="section-header" id="s13"><span class="num">13</span><h2>Statement Mapping</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cs span2"><div class="ctitle cs">Where every ASC 924 event lands</div>
    <div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
    <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Chip liability</span><span><span class="badge bs">BS</span></span><span>Estimated based on chips in circulation</span></div>
    <div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Progressive jackpot accrual</span><span><span class="badge bs">BS</span> <span class="badge bp">IS</span></span><span>Accrued continuously as the pool grows</span></div>
    <div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Casino credit (markers)</span><span><span class="badge bs">BS</span> <span class="badge bp">IS</span></span><span>Recognised as a receivable with a CECL allowance</span></div>
    </div>
    </div>
    </div>

    <div class="section-header" id="s14"><span class="num">14</span><h2>Related Topics</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
    <div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Topic</span><span>Connection</span></div>
    <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 606</span><span>Governs the allocation of consideration between gaming activity and complimentary services</span></div>
    <div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>ASC 326</span><span>Supplies the CECL framework for estimating the allowance on casino credit (markers)</span></div>
    <div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>ASC 450</span><span>Contingencies — supplies the general liability recognition framework underlying jackpot and chip liability accruals</span></div>
    </div>
    </div>
    </div>

    <div class="section-header" id="s15"><span class="num">15</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
    <div class="grid">
    <div class="card cn span2">
    <div class="glossary-item"><div class="glossary-term">Chip float</div><div class="glossary-def">The liability representing outstanding gaming chips issued but not yet redeemed for cash.</div></div>
    <div class="glossary-item"><div class="glossary-term">Progressive jackpot</div><div class="glossary-def">A jackpot that grows with each qualifying wager across linked machines/tables until it is won, accrued as a liability continuously as it grows.</div></div>
    <div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Marker</div><div class="glossary-def">A form of short-term casino credit extended to a gaming patron, recognised as a receivable subject to a CECL allowance.</div></div>
    </div>
    </div>

    <FinancialStatementKey />

  </div>
  <section id="history">
    <HistoryTimeline items={history.asc924 || []} />
  </section>
</StandardPageLayout>
