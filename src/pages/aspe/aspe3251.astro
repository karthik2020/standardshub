import Glossary from "../../components/Glossary.astro";
import PageToc from "../../components/PageToc.astro";
import "../../styles/standards-poster.css";
import "../../styles/extended.css";
import HistoryTimeline from "../../components/HistoryTimeline.astro";
import history from "../../data/history.json";
import metadata from "../../data/standards/aspe/aspe3251.json";
---

<StandardPageLayout
  code={metadata.code}
  standardType={metadata.framework}
  title={metadata.title}
  description={metadata.description}
  issued={metadata.issued}
  latestAmendment={metadata.latestAmendment}
  status={metadata.status}
  summary={metadata.summary}
  bannerNotice={metadata.bannerNotice}
>
  <Fragment slot="toc">
    <PageToc
      items={[
        { id: "s1", label: "Conceptual Framework Linkage" },
        { id: "s2", label: "Scope" },
        { id: "s3", label: "Components of Equity" },
        { id: "s4", label: "Share Capital" },
        { id: "s5", label: "Contributed Surplus" },
        { id: "s6", label: "Retained Earnings and Dividends" },
        { id: "s7", label: "THE DISTINCTIVE FEATURE — Retractable or Mandatorily Redeemable Shares" },
        { id: "s8", label: "The Retained-Earnings Charge, Not Net Income" },
        { id: "s9", label: "Worked Example — Recording a Dividend Declaration" },
        { id: "s10", label: "Worked Example — Applying the RoMRS Relief" },
        { id: "s11", label: "Disclosure Requirements" },
        { id: "s12", label: "Critical Judgments &amp; Estimates" },
        { id: "s13", label: "Relationship to IAS 32" },
        { id: "s14", label: "Statement Mapping" },
        { id: "s15", label: "Related Standards" },
        { id: "s16", label: "Glossary" }
      ]}
    />
  </Fragment>
  <div class="wrap">



<div class="section-header" id="s1"><span class="num">1</span><h2>Conceptual Framework Linkage</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">The owners' residual interest, with a distinctive tax-planning-driven relief</div><div class="principle">ASPE Section 3251 governs the PRESENTATION of EQUITY — the RESIDUAL interest IN an enterprise'S assets AFTER deducting ITS liabilities. GENUINELY distinctively, THIS Section INCLUDES specific RELIEF for RETRACTABLE or MANDATORILY redeemable SHARES issued IN tax PLANNING arrangements — a FEATURE reflecting a GENUINELY common CANADIAN private-COMPANY structuring PRACTICE (Section 7).</div>
</div>
</div>

<div class="section-header" id="s2"><span class="num">2</span><h2>Scope</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">The owners' residual claim on the enterprise</div><div class="principle">This Section applies TO the PRESENTATION of SHARE capital, CONTRIBUTED surplus, RETAINED earnings, and OTHER components OF owners' EQUITY within a PRIVATE enterprise'S financial STATEMENTS.</div>
</div>
</div>

<div class="section-header" id="s3"><span class="num">3</span><h2>Components of Equity</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A simpler structure than IFRS's equity section, given the absence of OCI</div>
<div class="td-table"><div class="th" style="grid-template-columns:1fr 2fr;"><span>Component</span><span>Description</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Share capital</span><span>AMOUNTS received FROM issuing SHARES, at THEIR stated OR par VALUE</span></div>
<div class="tr alt" style="grid-template-columns:1fr 2fr;"><span>Contributed surplus</span><span>ADDITIONAL amounts CONTRIBUTED by SHAREHOLDERS beyond SHARE capital (e.g. SHARE premium, DONATED capital)</span></div>
<div class="tr" style="grid-template-columns:1fr 2fr;"><span>Retained earnings</span><span>ACCUMULATED net INCOME, less DIVIDENDS declared, SINCE the ENTERPRISE'S inception</span></div>
</div>
</div>
</div>

<div class="section-header" id="s4"><span class="num">4</span><h2>Share Capital</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Recorded at the proceeds received on issuance</div><div class="text-supporting">SHARE capital is RECORDED at the FAIR value OF consideration RECEIVED upon ISSUANCE — WHERE shares ARE issued for NON-cash consideration, THE fair VALUE of the CONSIDERATION received (OR the SHARES issued, WHICHEVER is MORE reliably MEASURABLE) is USED.</div>
</div>
</div>

<div class="section-header" id="s5"><span class="num">5</span><h2>Contributed Surplus</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Additional paid-in amounts beyond stated share capital</div><div class="text-supporting">CONTRIBUTED surplus CAPTURES amounts CONTRIBUTED by SHAREHOLDERS beyond THE stated VALUE of SHARE capital — SUCH as SHARE premium ON issuance, GAINS on THE reacquisition and CANCELLATION of SHARES below THEIR original ISSUE price, and DONATED capital.</div>
</div>
</div>

<div class="section-header" id="s6"><span class="num">6</span><h2>Retained Earnings and Dividends</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Accumulated profits, reduced by declared distributions</div><div class="text-supporting">RETAINED earnings ACCUMULATES net INCOME (FLOWING directly FROM the INCOME Statement, GIVEN ASPE'S absence OF any OCI LAYER — see the COMPANION Section 1520 poster), REDUCED by DIVIDENDS declared TO shareholders. A DIVIDEND is RECOGNIZED as a REDUCTION of RETAINED earnings ONCE it IS declared BY the board, REGARDLESS of WHEN it IS actually PAID.</div>
</div>
</div>

<div class="section-header" id="s7"><span class="num">7</span><h2>THE DISTINCTIVE FEATURE — Retractable or Mandatorily Redeemable Shares</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">A specific relief tied to Canadian tax planning practice</div><div class="text-supporting">UNDER strict APPLICATION of FINANCIAL instrument PRINCIPLES (SECTION 3856), SHARES that ARE puttable OR mandatorily REDEEMABLE would NORMALLY require CLASSIFICATION as a FINANCIAL liability, RATHER than EQUITY. HOWEVER, SPECIFIC relief EXISTS for RETRACTABLE or MANDATORILY redeemable SHARES (RoMRS) issued IN a TAX planning ARRANGEMENT — a GENUINELY common PRACTICE in CANADIAN private-COMPANY "ESTATE freeze" and SIMILAR structuring TRANSACTIONS, WHERE preferred SHARES with a FIXED redemption AMOUNT are ISSUED to LOCK in VALUE for SUCCESSION or TAX purposes. RATHER than SIMPLY classifying SUCH shares as ORDINARY equity DESPITE their LIABILITY-like SUBSTANCE, ASPE REQUIRES them to BE presented AS a financial LIABILITY at THEIR full REDEMPTION amount — WITH the SPECIFIC relief LYING in WHERE the RESULTING adjustment IS recognized (Section 8).</div>
</div>
</div>

<div class="section-header" id="s8"><span class="num">8</span><h2>The Retained-Earnings Charge, Not Net Income</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">Bypassing the Income Statement entirely</div><div class="text-supporting">THE difference BETWEEN the REDEMPTION amount OF the RoMRS (NOW classified AS a LIABILITY) and the AMOUNT that WOULD otherwise HAVE been INCLUDED within EQUITY is CHARGED directly TO retained EARNINGS — <strong>NOT</strong> recognized AS an EXPENSE within NET income. THIS avoids THE potentially MISLEADING outcome OF a routine TAX-planning share STRUCTURE distorting THE enterprise'S REPORTED operating PERFORMANCE, WHILE STILL faithfully REFLECTING the SHARES' genuine LIABILITY substance ON the BALANCE Sheet — CONSISTENT with the FACE-of-statement DISCLOSURE requirement WE covered EARLIER under SECTION 1521 (see the COMPANION poster).</div>
</div>
</div>

<div class="section-header" id="s9"><span class="num">9</span><h2>Worked Example — Recording a Dividend Declaration</h2><span class="line"></span></div>
<div class="grid">
<div class="card cw span2"><div class="ctitle cw">A straightforward reduction of retained earnings</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: An annual dividend declaration</div><div class="wk-body">A private company's board declares a $200,000 dividend to shareholders, payable in 60 days.</div><div class="wk-answer">The COMPANY reduces RETAINED earnings by <strong>$200,000</strong> IMMEDIATELY upon DECLARATION, recognizing a CORRESPONDING dividend PAYABLE liability — REGARDLESS of the 60-day GAP before ACTUAL payment.</div></div>
</div>
</div>

<div class="section-header" id="s10"><span class="num">10</span><h2>Worked Example — Applying the RoMRS Relief</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Reclassifying shares to a liability without touching net income</div>
<div class="worked" style="margin-bottom:0;"><div class="wk-title">Example: An estate freeze preferred share structure</div><div class="wk-body">A family business owner implements an estate freeze, issuing $3,000,000 of retractable preferred shares (redeemable at their $3,000,000 stated value) in exchange for common shares originally recorded at $50,000 within share capital.</div><div class="wk-answer">The COMPANY reclassifies the SHARES as a $3,000,000 FINANCIAL liability, CHARGING the $3,000,000 − $50,000 = <strong>$2,950,000</strong> difference DIRECTLY to RETAINED earnings — <strong>NOT</strong> through NET income — WITH the $2,950,000 amount DISCLOSED on the FACE of the BALANCE Sheet PER Section 1521.</div></div>
</div>
</div>

<div class="section-header" id="s11"><span class="num">11</span><h2>Disclosure Requirements</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">What Section 3251 requires</div><div class="check-list"><span>Description of each class of share capital, including rights, privileges, and restrictions</span><span>Dividends declared during the period, by class of share</span><span>Amount charged to retained earnings for retractable or mandatorily redeemable shares (cross-referenced to Section 1521's face-of-statement requirement)</span></div>
</div>
</div>

<div class="section-header" id="s12"><span class="num">12</span><h2>Critical Judgments &amp; Estimates</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2"><div class="ctitle cn">Where judgment matters most</div>
<div class="two-col"><div><div class="elabel">SIGNIFICANT JUDGMENTS</div><div class="dot-list"><span>Whether shares genuinely qualify for the RoMRS tax-planning relief</span></div></div>
<div><div class="elabel">SIGNIFICANT ESTIMATES</div><div class="dot-list"><span>Fair value of non-cash consideration received for share issuances</span></div></div></div>
</div>
</div>

<div class="section-header" id="s13"><span class="num">13</span><h2>Relationship to IAS 32</h2><span class="line"></span></div>
<div class="grid">
<div class="card ci span2"><div class="ctitle ci">Comparison — ASPE Section 3251 vs IAS 32</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Feature</span><span style="color:var(--color-text-warning);">ASPE Section 3251</span><span style="color:var(--color-text-info);">IAS 32</span></div>
<div class="tr" style="grid-template-columns:1.2fr 1.2fr 1.2fr;"><span>Puttable/redeemable share liability classification</span><span>YES, with a narrow tax-planning exception on WHERE the adjustment is charged</span><span>YES, with narrower puttable-instrument exceptions of its own</span></div>
</div>
<div class="note">BROADLY converged ON the CORE liability CLASSIFICATION principle, but ASPE'S retained-EARNINGS charging MECHANISM for the RoMRS SCENARIO is a GENUINELY distinctive, PRACTICALLY significant feature TAILORED to CANADIAN private-enterprise TAX planning practice.</div>
</div>
</div>

<div class="section-header" id="s14"><span class="num">14</span><h2>Statement Mapping</h2><span class="line"></span></div>
<div class="grid">
<div class="card cs span2"><div class="ctitle cs">Where every equity event lands</div>
<div class="td-table"><div class="th" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Event</span><span>Statement(s) affected</span><span>Notes</span></div>
<div class="tr" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>Dividend declaration</span><span><span class="badge bs">BS</span> <span class="badge sre">SRE</span></span><span>Reduces retained earnings, recognizes a liability</span></div>
<div class="tr alt" style="grid-template-columns:1.6fr 1fr 1.4fr;"><span>RoMRS reclassification</span><span><span class="badge bs">BS</span> <span class="badge sre">SRE</span></span><span>Charged to retained earnings, bypassing net income</span></div>
</div>
</div>
</div>

<div class="section-header" id="s15"><span class="num">15</span><h2>Related Standards</h2><span class="line"></span></div>
<div class="grid">
<div class="card cd span2"><div class="ctitle cd">Cross-reference map</div>
<div class="td-table"><div class="th" style="grid-template-columns:0.8fr 2fr;"><span>Section</span><span>Connection</span></div>
<div class="tr" style="grid-template-columns:0.8fr 2fr;"><span>Section 1521</span><span>Balance Sheet — requires the specific face-of-statement disclosure for the RoMRS amount charged to retained earnings</span></div>
<div class="tr alt" style="grid-template-columns:0.8fr 2fr;"><span>Section 3856</span><span>Financial Instruments — supplies the underlying liability classification principles this Section's RoMRS relief modifies</span></div>
</div>
</div>
</div>

<div class="section-header" id="s16"><span class="num">16</span><h2>Quick-Reference Glossary</h2><span class="line"></span></div>
<div class="grid">
<div class="card cn span2">
<div class="glossary-item"><div class="glossary-term">Retractable or mandatorily redeemable shares (RoMRS)</div><div class="glossary-def">Shares issued in a tax planning arrangement classified as a financial liability, with the resulting adjustment charged to retained earnings rather than net income.</div></div>
<div class="glossary-item" style="border-bottom:none;"><div class="glossary-term">Contributed surplus</div><div class="glossary-def">Amounts contributed by shareholders beyond the stated value of share capital.</div></div>
</div>
</div>

<div class="legend"><div class="ltitle">Financial statement key (ASPE terminology)</div><div class="lrow"><div class="litem"><span class="badge bs">BS</span> Balance Sheet </div><div class="litem"><span class="badge is">IS</span> Income Statement </div><div class="litem"><span class="badge sre">SRE</span> Statement of Retained Earnings / Statement of Changes in Equity </div><div class="litem"><span class="badge scf">SCF</span> Cash Flow Statement</div></div></div>


</div>
  <section id="history">
    <HistoryTimeline items={history.aspe3251 || []} />
  </section>
</StandardPageLayout>
